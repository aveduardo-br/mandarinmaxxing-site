---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WhatItIs from '../components/sections/WhatItIs.astro';
import Topics from '../components/sections/Topics.astro';
import Chunks from '../components/sections/Chunks.astro';
import Lesson from '../components/sections/Lesson.astro';
import Course from '../components/sections/Course.astro';
import Install from '../components/sections/Install.astro';
import Faq from '../components/sections/Faq.astro';
---

<Base>
  <Hero />
  <div class="body">
    <WhatItIs />
    <Topics />
    <Chunks />
    <Lesson />
    <Course />
    <Install />
    <Faq />
  </div>
</Base>

<style>
  /* Paper node 1B-0 */
  .body {
    display: flex;
    flex-direction: column;
    gap: 80px;
    padding-bottom: 120px;
  }
</style>
