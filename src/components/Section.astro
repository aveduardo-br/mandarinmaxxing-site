---
// Numbered section: pixel numeral (orange) + display title (white).
// With `tiled`, the pixel numeral is replaced by a number tile (docs/ladrilhos.md) before the usual
// display title. While the section is not the active one the number tile is black with the number
// in hanzi in grey (一); when the section becomes active (SideNav adds .is-active) it flips to orange
// with the digit in black (1), like the side nav. Being
// tried on section 01 first.
import { numerals } from '../data/numerals';

interface Props {
  id: string;
  num: string;
  title: string;
  tiled?: boolean;
}
const { id, num, title, tiled } = Astro.props;
const n = numerals[num];
const NUM_ZH = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
const tileTitle = tiled ? { digit: String(Number(num)), num: NUM_ZH[Number(num)] } : null;
---

<section id={id} class="section" data-section>
  {
    tileTitle ? (
      <h2 class="title-row tiled" data-tile-title>
        <span class="tt num" data-num data-digit={tileTitle.digit} data-zh={tileTitle.num} aria-hidden="true"><span>{tileTitle.num}</span></span>
        <span class="title display">{title}</span>
      </h2>
    ) : (
  <h2 class="title-row">
    {
      n && (
        <span class="numeral" aria-hidden="true">
          <svg viewBox={n.viewBox} preserveAspectRatio="none" style={`width:${n.w}px;height:${n.h}px`}>
            {n.paths.map((p) => (
              <path d={p.d} transform={p.t} fill="#B53902" />
            ))}
          </svg>
        </span>
      )
    }
    <span class="title display">{title}</span>
  </h2>
    )
  }
  <slot />
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 48px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .numeral {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 26px;
  }
  .numeral svg {
    display: block;
    overflow: visible;
  }

  .title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--text);
  }

  /* ---- title in tiles ---- */
  .tt {
    position: relative;
    flex: none;
    user-select: none;
    -webkit-user-select: none;
    width: 28px;
    height: 28px;
    background: #000;
  }
  /* hanzi: Zpix like every tile, 3 px from the left and 1 px from the top */
  .tt > span {
    position: absolute;
    left: 3px;
    top: 1px;
    font-family: 'Zpix', var(--f-display);
    font-size: 24px;
    line-height: 24px;
    font-weight: 500;
    white-space: pre;
  }
  /* number tile: black with the hanzi in grey while the section is not active, orange with the
     digit in black when it is */
  .tt.num > span {
    color: var(--muted);
  }
  /* the digit is set in Geist, like the title (the pixel 1 reads as an I) */
  .tt.num.on > span {
    left: 0;
    right: 0;
    top: 0;
    text-align: center;
    font-family: var(--f-body);
    font-size: 17px;
    line-height: 28px;
    font-weight: 600;
  }
  .tt.num.on {
    background: var(--accent);
  }
  .tt.num.on > span {
    color: #161616;
  }
</style>

<script>
  // Tiled section titles: the number tile flips to orange while its section is the active one.
  // SideNav marks the active section with .is-active.
  import { DUR, EASE_CLOSE, EASE_OPEN } from '../scripts/tiles';
  const OUT = [{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }];
  const IN = [{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-tile-title]').forEach((h) => {
    const sec = h.closest<HTMLElement>('[data-section]')!;
    const tile = h.querySelector<HTMLElement>('[data-num]')!;
    let gen = 0;
    let target = false;
    const set = (on: boolean) => {
      if (target === on) return;
      target = on;
      const g = ++gen;
      if (reduce) {
        tile.classList.toggle('on', on);
        tile.firstElementChild!.textContent = on ? tile.dataset.digit! : tile.dataset.zh!;
        return;
      }
      const a = tile.animate(OUT, { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
      a.onfinish = () => {
        a.cancel();
        if (g !== gen) return;
        tile.classList.toggle('on', on);
        tile.firstElementChild!.textContent = on ? tile.dataset.digit! : tile.dataset.zh!;
        tile.animate(IN, { duration: DUR, easing: EASE_OPEN });
      };
    };
    const sync = () => set(sec.classList.contains('is-active'));
    new MutationObserver(sync).observe(sec, { attributes: true, attributeFilter: ['class'] });
    sync();
  });
</script>
