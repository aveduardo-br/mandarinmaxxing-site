---
// Sound on/off as a tile (src/scripts/sound.ts wires every [data-sound-toggle]).
// Off: a grey tile with a grey speaker and an x. On: the same tile with a thin white outline and a
// white speaker with two waves. The icons are Phosphor's speaker-high and speaker-x, fill weight
// (phosphoricons.com, MIT License). `size` is the drawn tile (20 in the side nav, 28 in the top bar menu);
// the button around it is at least 44px tall so it is easy to tap.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<button class="snd" type="button" data-sound-toggle data-cuelume-toggle aria-pressed="true" aria-label="Sound" style={`--s:${size}px`}>
  <span class="stile" aria-hidden="true">
    <svg class="i-on" viewBox="0 0 256 256"><path d="M160,32.25V223.69a8.29,8.29,0,0,1-3.91,7.18,8,8,0,0,1-9-.56l-65.57-51A4,4,0,0,1,80,176.16V79.84a4,4,0,0,1,1.55-3.15l65.57-51a8,8,0,0,1,10,.16A8.27,8.27,0,0,1,160,32.25ZM60,80H32A16,16,0,0,0,16,96v64a16,16,0,0,0,16,16H60a4,4,0,0,0,4-4V84A4,4,0,0,0,60,80Zm126.77,20.84a8,8,0,0,0-.72,11.3,24,24,0,0,1,0,31.72,8,8,0,1,0,12,10.58,40,40,0,0,0,0-52.88A8,8,0,0,0,186.74,100.84Zm40.89-26.17a8,8,0,1,0-11.92,10.66,64,64,0,0,1,0,85.34,8,8,0,1,0,11.92,10.66,80,80,0,0,0,0-106.66Z" /></svg>
    <svg class="i-off" viewBox="0 0 256 256"><path d="M245.66,146.34a8,8,0,0,1-11.32,11.32L216,139.31l-18.34,18.35a8,8,0,0,1-11.32-11.32L204.69,128l-18.35-18.34a8,8,0,0,1,11.32-11.32L216,116.69l18.34-18.35a8,8,0,0,1,11.32,11.32L227.31,128ZM60,80H32A16,16,0,0,0,16,96v64a16,16,0,0,0,16,16H60a4,4,0,0,0,4-4V84A4,4,0,0,0,60,80Zm97.15-54.15a8,8,0,0,0-10-.16l-65.57,51A4,4,0,0,0,80,79.84v96.32a4,4,0,0,0,1.55,3.15l65.57,51a8,8,0,0,0,9,.56,8.29,8.29,0,0,0,3.91-7.18V32.25A8.27,8.27,0,0,0,157.12,25.85Z" /></svg>
  </span>
</button>

<style>
  .snd {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .stile {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    background: #1e1e1e;
    box-shadow: inset 0 0 0 1px transparent;
    transition: box-shadow 0.15s ease;
  }
  .stile svg {
    width: calc(var(--s) * 0.65);
    height: calc(var(--s) * 0.65);
    fill: #8a8a8a;
  }
  .i-on {
    display: none;
  }
  .snd[aria-pressed='true'] .stile {
    box-shadow: inset 0 0 0 1px var(--text);
  }
  .snd[aria-pressed='true'] svg {
    fill: var(--text);
  }
  .snd[aria-pressed='true'] .i-on {
    display: block;
  }
  .snd[aria-pressed='true'] .i-off {
    display: none;
  }
  @media (hover: hover) {
    .snd[aria-pressed='false']:hover svg {
      fill: var(--text);
    }
  }
  .snd:focus-visible {
    outline: none;
  }
  .snd:focus-visible .stile {
    outline: 1px dashed var(--outline);
    outline-offset: 2px;
  }
</style>
