---
// Sound on/off as a tile (src/scripts/sound.ts wires every [data-sound-toggle]).
// Off: a grey tile with a grey speaker and a small x. On: the same tile with a thin white outline and
// a white speaker with a wave. `size` is the drawn tile (20 in the side nav, 28 in the top bar menu);
// the button around it is at least 44px tall so it is easy to tap.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<button class="snd" type="button" data-sound-toggle data-cuelume-toggle aria-pressed="true" aria-label="Sound" style={`--s:${size}px`}>
  <span class="stile" aria-hidden="true">
    <svg class="i-on" viewBox="0 0 7 7" shape-rendering="crispEdges"><path d="M0 2h2v3h-2zM2 1h1v5h-1zM3 0h1v7h-1zM5 2h1v3h-1z" /></svg>
    <svg class="i-off" viewBox="0 0 7 7" shape-rendering="crispEdges"><path d="M0 2h2v3h-2zM2 1h1v5h-1zM3 0h1v7h-1zM5 2h1v1h-1zM6 3h1v1h-1zM5 4h1v1h-1z" /></svg>
  </span>
</button>

<style>
  .snd {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .stile {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    background: #1e1e1e;
    box-shadow: inset 0 0 0 1px transparent;
    transition: box-shadow 0.15s ease;
  }
  .stile svg {
    width: calc(var(--s) / 2);
    height: calc(var(--s) / 2);
    fill: #8a8a8a;
  }
  .i-on {
    display: none;
  }
  .snd[aria-pressed='true'] .stile {
    box-shadow: inset 0 0 0 1px var(--text);
  }
  .snd[aria-pressed='true'] svg {
    fill: var(--text);
  }
  .snd[aria-pressed='true'] .i-on {
    display: block;
  }
  .snd[aria-pressed='true'] .i-off {
    display: none;
  }
  @media (hover: hover) {
    .snd[aria-pressed='false']:hover svg {
      fill: var(--text);
    }
  }
  .snd:focus-visible {
    outline: none;
  }
  .snd:focus-visible .stile {
    outline: 1px dashed var(--outline);
    outline-offset: 2px;
  }
</style>
