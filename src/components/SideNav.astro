---
import { sections, faq, SKILL_REPO } from '../data/site';
---

<nav class="sidenav pixel" aria-label="Sections">
  <div class="block">
  <p class="group">How it works</p>
  <ul>
    {sections.map((s) => (
      <li>
        <a href={`#${s.id}`} data-nav={s.id}>{s.num} {s.title}</a>
      </li>
    ))}
  </ul>
  </div>

  <div class="block">
  <p class="group">FAQ</p>
  <ul>
    {faq.map((q) => (
      <li>
        <a href={`#${q.id}`} data-nav={q.id}>{q.title}</a>
      </li>
    ))}
  </ul>
  </div>

  <ul class="end">
    <li><a href="#install">Install ↓</a></li>
    <li><a href={SKILL_REPO} target="_blank" rel="noopener">GitHub ↗</a></li>
  </ul>
</nav>

<style>
  /* Paper node 50-0 */
  .sidenav {
    position: fixed;
    top: 50%;
    left: var(--nav-left);
    transform: translateY(-50%);
    z-index: 10;
    width: 200px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .group {
    font-size: 12px;
    line-height: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  a {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-dim);
    white-space: pre;
    transition: color 0.15s ease;
  }

  a:hover,
  a.active {
    color: var(--text);
  }

  /* Desktop-first; mobile behavior to be defined with Eduarda. */
  @media (max-width: 1180px) {
    .sidenav {
      display: none;
    }
  }
</style>

<script>
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
    links.set(a.dataset.nav!, a);
  });

  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let current: string | null = null;
  const setActive = (id: string | null) => {
    if (id === current) return;
    if (current) links.get(current)?.classList.remove('active');
    if (id) links.get(id)?.classList.add('active');
    current = id;
  };

  // Active = last target whose top has crossed 40% of the viewport.
  const sectionEls = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  let currentSection: HTMLElement | null = null;
  const update = () => {
    const line = window.innerHeight * 0.4;
    let active: string | null = null;
    for (const el of targets) {
      if (el.getBoundingClientRect().top <= line) active = el.id;
    }
    // At the very bottom the last items can't reach the line: pick the last one.
    const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atBottom && targets.length) active = targets[targets.length - 1].id;
    setActive(active);

    // Section titles light up while their section is on screen
    let sec: HTMLElement | null = null;
    for (const el of sectionEls) {
      if (el.getBoundingClientRect().top <= line) sec = el;
    }
    if (sec && sec.getBoundingClientRect().bottom < line * 0.5) sec = null;
    if (sec !== currentSection) {
      currentSection?.classList.remove('is-active');
      sec?.classList.add('is-active');
      currentSection = sec;
    }
  };

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    },
    { passive: true },
  );
  window.addEventListener('resize', update);
  update();
</script>
