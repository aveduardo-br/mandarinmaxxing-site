---
import { sections, faq, SKILL_REPO } from '../data/site';
import SoundToggle from './SoundToggle.astro';
---

<nav class="sidenav" aria-label="Sections" data-cuelume-emphasis="subtle">
  <div class="block">
  <p class="group">How it works</p>
  <ul>
    {sections.map((s) => (
      <li>
        <a class="numbered" href={`#${s.id}`} data-nav={s.id} data-num={Number(s.num)} data-cuelume-navigate>
          <span class="ntile" aria-hidden="true"></span><span>{s.title}</span>
        </a>
      </li>
    ))}
  </ul>
  </div>

  <div class="block">
  <p class="group">FAQ</p>
  <ul>
    {faq.map((q) => (
      <li>
        <a href={`#${q.id}`} data-nav={q.id} data-cuelume-navigate>{q.title}</a>
      </li>
    ))}
  </ul>
  </div>

  <ul class="end">
    <li><a href="#install">Install ↓</a></li>
    <li><a href={SKILL_REPO} target="_blank" rel="noopener">GitHub ↗</a></li>
    <li class="snd-li"><SoundToggle size={20} /></li>
  </ul>
</nav>

<style>
  /* Paper node 50-0 */
  .sidenav {
    position: fixed;
    top: 0;
    bottom: 0;
    margin-block: auto;
    height: fit-content;
    left: var(--nav-left);
    z-index: 10;
    width: 200px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    /* over the footer the nav closes from the bottom up (Footer.astro toggles .closed); the insets
       are negative so hover states and tiles aren't clipped while it's open */
    clip-path: inset(-24px -120px -24px -24px);
    transition:
      clip-path 0.55s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.3s ease 0.2s;
  }
  .sidenav.closed {
    clip-path: inset(-24px -120px calc(100% + 24px) -24px);
    opacity: 0;
    pointer-events: none;
    transition:
      clip-path 0.55s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.25s ease 0.3s;
  }
  @media (prefers-reduced-motion: reduce) {
    .sidenav,
    .sidenav.closed {
      transition: opacity 0.2s ease;
    }
  }

  .group {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  a {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-dim);
    white-space: pre;
    transition: color 0.15s ease;
  }

  a:hover,
  a.active {
    color: var(--text);
  }
  /* the sound tile sits with the links, without the 44px tap height adding space around it */
  .snd-li {
    margin-block: -12px;
  }

  /* Numbered sections: the number is a small tile (docs/ladrilhos.md). Grey with the number in
     hanzi while inactive; when the section becomes active it flips to orange with the digit. */
  a.numbered {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ntile {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }
  .ntile :global(.tile) {
    --tile-gap: 0px; /* a single tile, nothing to space from */
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 20px;
  }
  /* Zpix draws every glyph from the left of its box with a gap on the right (4 px at 24 px), and
     hanzi and digits share the same vertical centre (13/24 of the size from the top). So: centre the
     box, push it right by half that gap, and set top so the ink's centre lands on the tile's centre. */
  .ntile :global(.tile > span) {
    /* a box wider than the tile, so the 19.5 px wide hanzi box can be centred too */
    left: -10px;
    right: -10px;
    padding-left: 3px; /* 2/24 of 18 px, twice, because centring halves it */
    text-align: center;
    top: 0.5px; /* 10 − 18 × 13/24, rounded to the half pixel the renderer lands on */
    font-size: 18px;
    line-height: 18px;
  }

  /* Desktop-first; mobile behavior to be defined with Eduardo. */
  @media (max-width: 1180px) {
    .sidenav {
      display: none;
    }
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, ORANGE, DIM, type Slot } from '../scripts/tiles';

  // number tiles: hanzi on grey while inactive, digit on orange while active
  const HANZI_NUM = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
  const numTiles = new Map<string, { slot: Slot; n: number }>();
  document.querySelectorAll<HTMLAnchorElement>('a.numbered').forEach((a) => {
    const n = Number(a.dataset.num);
    const slot = makeSlot(a.querySelector<HTMLElement>('.ntile')!);
    applyTile(slot, { ch: HANZI_NUM[n] ?? String(n), bg: DIM.bg, fg: DIM.fg });
    numTiles.set(a.dataset.nav!, { slot, n });
  });
  const tileFor = (id: string | null, on: boolean) => {
    const t = id ? numTiles.get(id) : undefined;
    if (!t) return;
    flipTile(t.slot, on ? { ch: String(t.n), bg: ORANGE } : { ch: HANZI_NUM[t.n] ?? String(t.n), bg: DIM.bg, fg: DIM.fg });
  };

  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
    links.set(a.dataset.nav!, a);
  });

  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let current: string | null = null;
  const setActive = (id: string | null) => {
    if (id === current) return;
    if (current) links.get(current)?.classList.remove('active');
    if (id) links.get(id)?.classList.add('active');
    tileFor(current, false);
    tileFor(id, true);
    current = id;
  };

  // Active = the last item whose top has passed the middle of the screen, the "top center" trigger of
  // GSAP ScrollTrigger: a section turns active as its title crosses the centre, scrolling down or up.
  const sectionEls = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  let pinned: string | null = null;
  links.forEach((a, id) =>
    a.addEventListener('click', () => {
      pinned = id;
      update(); // the page may not scroll at all (already at the bottom)
    }),
  );
  const unpin = () => (pinned = null);
  for (const ev of ['wheel', 'touchstart', 'keydown', 'mousedown']) addEventListener(ev, unpin, { passive: true });
  let currentSection: HTMLElement | null = null;
  const lastPast = <T extends HTMLElement>(els: T[], line: number) => {
    let best: T | null = null;
    for (const el of els) if (el.getBoundingClientRect().top <= line) best = el;
    return best;
  };
  const update = () => {
    const line = window.innerHeight * 0.5;
    let activeEl = lastPast(targets, line);
    // At the very bottom the last items can't reach the middle: pick the last one.
    const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atBottom && targets.length) activeEl = targets[targets.length - 1];
    // a link just clicked stays active until the person scrolls by themselves
    const id = pinned ?? (activeEl ? activeEl.id : null);
    setActive(id);

    // Section titles light up with the same rule; while a link is pinned, its own section does
    const pinnedEl = pinned ? document.getElementById(pinned) : null;
    const sec = pinnedEl
      ? pinnedEl.closest<HTMLElement>('[data-section]')
      : atBottom
        ? sectionEls[sectionEls.length - 1] ?? null
        : lastPast(sectionEls, line);
    if (sec !== currentSection) {
      currentSection?.classList.remove('is-active');
      sec?.classList.add('is-active');
      currentSection = sec;
    }
  };

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    },
    { passive: true },
  );
  window.addEventListener('resize', update);
  update();
</script>
