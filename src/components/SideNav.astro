---
import { sections, faq, SKILL_REPO } from '../data/site';
---

<nav class="sidenav" aria-label="Sections">
  <div class="block">
  <p class="group">How it works</p>
  <ul>
    {sections.map((s) => (
      <li>
        <a href={`#${s.id}`} data-nav={s.id}>{s.num} {s.title}</a>
      </li>
    ))}
  </ul>
  </div>

  <div class="block">
  <p class="group">FAQ</p>
  <ul>
    {faq.map((q) => (
      <li>
        <a href={`#${q.id}`} data-nav={q.id}>{q.title}</a>
      </li>
    ))}
  </ul>
  </div>

  <ul class="end">
    <li><a href="#install">Install ↓</a></li>
    <li><a href={SKILL_REPO} target="_blank" rel="noopener">GitHub ↗</a></li>
  </ul>
</nav>

<style>
  /* Paper node 50-0 */
  .sidenav {
    position: fixed;
    top: 0;
    bottom: 0;
    margin-block: auto;
    height: fit-content;
    left: var(--nav-left);
    z-index: 10;
    width: 200px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .group {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  a {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-dim);
    white-space: pre;
    transition: color 0.15s ease;
  }

  a:hover,
  a.active {
    color: var(--text);
  }

  /* Desktop-first; mobile behavior to be defined with Eduardo. */
  @media (max-width: 1180px) {
    .sidenav {
      display: none;
    }
  }
</style>

<script>
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
    links.set(a.dataset.nav!, a);
  });

  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let current: string | null = null;
  const setActive = (id: string | null) => {
    if (id === current) return;
    if (current) links.get(current)?.classList.remove('active');
    if (id) links.get(id)?.classList.add('active');
    current = id;
  };

  // Active = the item that fills most of the top 40% of the screen (each item runs from its top
  // to the next item's top). A short section scrolled to the top stays active even when the next
  // one's top is also in that band.
  const sectionEls = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  let pinned: string | null = null;
  links.forEach((a, id) =>
    a.addEventListener('click', () => {
      pinned = id;
      setActive(id); // the page may not scroll at all (already at the bottom)
    }),
  );
  const unpin = () => (pinned = null);
  for (const ev of ['wheel', 'touchstart', 'keydown', 'mousedown']) addEventListener(ev, unpin, { passive: true });
  let currentSection: HTMLElement | null = null;
  const pick = <T extends HTMLElement>(els: T[], line: number, endOf: (el: T, i: number) => number) => {
    let best: T | null = null;
    let bestCover = 0;
    els.forEach((el, i) => {
      const top = el.getBoundingClientRect().top;
      const end = endOf(el, i);
      const cover = Math.min(end, line) - Math.max(top, 0);
      if (cover > 0 && cover >= bestCover) {
        best = el;
        bestCover = cover;
      }
    });
    return best as T | null;
  };
  const update = () => {
    const line = window.innerHeight * 0.4;
    const docEnd = document.documentElement.scrollHeight - window.scrollY;
    let activeEl = pick(targets, line, (_, i) =>
      i + 1 < targets.length ? targets[i + 1].getBoundingClientRect().top : docEnd,
    );
    // At the very bottom the last items can't reach the band: pick the last one.
    const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atBottom && targets.length) activeEl = targets[targets.length - 1];
    // a link just clicked stays active until the person scrolls by themselves
    setActive(pinned ?? (activeEl ? activeEl.id : null));

    // Section titles light up while their section is on screen
    const sec = pick(sectionEls, line, (el) => el.getBoundingClientRect().bottom);
    if (sec !== currentSection) {
      currentSection?.classList.remove('is-active');
      sec?.classList.add('is-active');
      currentSection = sec;
    }
  };

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    },
    { passive: true },
  );
  window.addEventListener('resize', update);
  update();
</script>
