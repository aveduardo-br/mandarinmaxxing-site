---
// Footer.
// Left: what the page offers again, as links. Right: 中文 in tiles with MAXXING under it
// (ZhongwenTiles.astro), above the links on narrower screens; on phones it is in the hero instead.
import { SKILL_REPO, SKILL_RELEASES, SKILL_ISSUES, SKILL_ZIP, SKILL_VERSION, SKILL_LICENSE } from '../data/site';
import ZhongwenTiles from './ZhongwenTiles.astro';
---

<footer class="footer">
  <div class="info">
    <div class="head">
      <p class="name">mandarinmaxxing</p>
      <p class="tagline">The same HSK words, reorganized around everyday conversations.</p>
    </div>
    <div class="cols">
      <div class="colm">
        <p class="label">The skill</p>
        <a href={SKILL_ZIP}>Download for Claude</a>
        <a href="#install">How to install</a>
        <a href={SKILL_REPO} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={SKILL_RELEASES} target="_blank" rel="noopener">Releases ↗</a>
      </div>
      <div class="colm">
        <p class="label">How it works</p>
        <a href="#what-it-is">What it is</a>
        <a href="#topics">Situations, not chapters</a>
        <a href="#chunks">Chunks</a>
        <a href="#lesson">A lesson, step by step</a>
        <a href="#course">Your course</a>
        <a href="#faq">Questions</a>
        <a href="#research">Sources</a>
      </div>
      <div class="colm wide">
        <p class="label">Join in</p>
        <p class="note">Free forever, and yours to keep. The maps grow with the people who use them: suggest a situation, improve a lesson, or point out a mistake.</p>
        <a class="issue" href={SKILL_ISSUES} target="_blank" rel="noopener">Contribute on GitHub ↗</a>
      </div>
    </div>
    <div class="fine">
      <p>The community writes the maps. Claude teaches the lessons. {SKILL_VERSION}</p>
      <p class="dim">
        An independent project, not affiliated with the organization that runs the test. Word lists from the November
        2025 HSK syllabus, converted from <a class="credit" href="https://github.com/ofou/hsk" target="_blank" rel="noopener">ofou/hsk ↗</a> (MIT License).
      </p>
      <p class="dim">
        © 2026 Gautech. Free to study with; the maps and lesson texts belong to the project.
        <a class="credit" href={SKILL_LICENSE} target="_blank" rel="noopener">License ↗</a>
      </p>
    </div>
  </div>
  <div class="footer-zw"><ZhongwenTiles /></div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>('footer.footer')!;
  // The side nav is fixed at mid-height on the left: it closes from the bottom up while the footer
  // is under it (styles in SideNav.astro). Its box keeps its place, so the check uses that.
  const nav = document.querySelector<HTMLElement>('.sidenav');
  if (nav) {
    const check = () => {
      const under = footer.getBoundingClientRect().top < nav.getBoundingClientRect().bottom + 24;
      nav.classList.toggle('closed', under);
    };
    addEventListener('scroll', check, { passive: true });
    addEventListener('resize', check);
    check();
  }
</script>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0;
    padding: 0 max(48px, calc((100vw - 1200px) / 2)) 64px;
    border-top: 1px solid var(--outline);
    overflow: clip;
  }

  .info {
    flex: 0 0 610px; /* the links keep their width; the drawing takes what is left */
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-top: 88px;
  }
  p {
    margin: 0;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .name {
    font-family: var(--f-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--tr-display);
    color: var(--text);
  }
  .tagline {
    max-width: 560px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: 300;
    color: var(--text-80);
  }

  .cols {
    display: flex;
    gap: 25px;
  }
  .colm {
    flex: none;
    width: 170px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .colm.wide {
    width: 220px;
  }
  .label {
    font-size: var(--fs-label);
    line-height: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .colm a,
  .note {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: 300;
    color: var(--text-soft);
  }
  .colm a {
    transition: color 0.15s ease;
  }
  .colm a:hover {
    color: var(--text);
  }
  .colm a.issue {
    font-weight: 400;
    color: var(--accent-light);
  }

  .fine {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 20px;
    border-top: 1px solid var(--divider);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: 300;
    color: var(--text-dim);
  }
  .fine .dim {
    color: var(--muted-2);
  }
  .fine .credit {
    color: var(--text-dim);
    transition: color 0.15s ease;
  }
  .fine .credit:hover {
    color: var(--text);
  }

  /* 中文 in tiles at the top right, like the info's first line (src/components/ZhongwenTiles.astro);
     on phones it is in the hero instead */
  .footer-zw {
    flex: 0 1 var(--zw-w, 1288px);
    min-width: 0;
    margin-top: 88px;
    margin-left: 48px;
  }
  /* not enough width for both: 中文 on top, text under it */
  @media (max-width: 1279px) {
    .footer {
      flex-direction: column-reverse;
      align-items: center;
      padding-inline: 32px;
    }
    .info {
      flex: none;
      width: 100%;
      max-width: 610px;
      padding-top: 24px;
    }
    .cols {
      flex-wrap: wrap;
    }
    .footer-zw {
      flex: none;
      width: 100%;
      max-width: 610px;
      margin-top: 56px;
      margin-left: 0;
    }
  }
  /* phones: the links in two columns, the note across both */
  @media (max-width: 720px) {
    /* on phones the drawing opens the page, in the hero */
    .footer-zw {
      display: none;
    }
    .footer {
      padding-inline: 20px;
      padding-bottom: calc(48px + env(safe-area-inset-bottom));
    }
    .info {
      gap: 36px;
    }
    .name {
      font-size: 24px;
      line-height: 32px;
    }
    .cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
    }
    .colm,
    .colm.wide {
      width: auto;
    }
    .colm.wide {
      grid-column: 1 / -1;
    }
    .colm a {
      padding-block: 4px; /* a little more to tap between neighbouring links */
    }
  }
</style>
