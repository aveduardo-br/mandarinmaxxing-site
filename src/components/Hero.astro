---
// Hero. MANDARIN is written in tiles (docs/ladrilhos.md), with the pixel word "maxxing" under it.
// Some tiles flip to another hanzi on their own; hovering flips the tile under the cursor and its
// neighbours in a short wave, with the same flap transition as the rest of the site. The top tile of
// each column now and then lets go and rises, already opaque, fading near the top; the cursor pushes
// the rising tiles away, more strongly the higher they are. The page opens with tiles already rising.
import { SKILL_ZIP, SKILL_VERSION } from '../data/site';
import art from '../../public/hero-art.json';
const maxxing = (art as { maxxing: string }).maxxing;
---
<header class="hero">
  <div class="stage" id="hero-stage">
    <canvas aria-hidden="true"></canvas>
    <div class="art" role="img" aria-label="mandarinmaxxing: the word MANDARIN written in tiles with Chinese characters, above the pixel word maxxing">
      <div class="board-box"><div class="board" data-board aria-hidden="true"></div></div>
      <svg class="maxxing" aria-hidden="true" data-maxxing><path d={maxxing}></path></svg>
    </div>
  </div>
  <div class="cta">
    <div class="text">
      <p class="kicker">a skill for Claude</p>
      <h1 class="lede">
        The same HSK words, reorganized around everyday conversations.
      </h1>
    </div>

    <div class="buttons">
      <a class="btn solid" href={SKILL_ZIP}>Download for Claude</a>
      <a class="btn outline" href="#install">How to install ↓</a>
    </div>
  </div>

  <p class="meta">
    <span>HSK 3.0</span><span>·</span><span>by Eduardo</span><span>·</span><span>{SKILL_VERSION}</span><span>·</span><span
      >Free</span
    ><span>·</span><a href="#what-it-is">How it works ↓</a>
  </p>
</header>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding-block: 40px 64px;
  }

  /* Art + headroom above it for the rising tiles. The art is wider than the text column, so the
     stage breaks out of it and stays centred on the page. */
  .stage {
    position: relative;
    width: min(1120px, 100vw - 48px);
    margin-left: 50%;
    transform: translateX(-50%);
    padding-top: 120px;
  }
  /* the canvas reaches up to the top of the hero (height set by the script) */
  .stage canvas {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .art {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }
  .art.ready {
    opacity: 1;
  }
  /* the board is drawn with the standard 28 px tile and scaled to the stage width (--k set by the script) */
  .board-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1260 / 196;
  }
  .board {
    position: absolute;
    left: 0;
    top: 0;
    width: 1260px;
    height: 196px;
    transform: scale(var(--k, 1));
    transform-origin: 0 0;
  }
  .maxxing {
    display: block;
    width: 40%;
    height: auto;
    fill: var(--text);
    overflow: visible;
  }

  .cta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .kicker {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-dim);
  }
  .lede {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: 300;
    color: var(--text-soft);
  }

  .buttons {
    display: flex;
    gap: 12px;
  }
  .btn {
    font: 500 var(--fs-small) / var(--lh-small) var(--f-body);
    padding: 12px 20px;
    border: 1px solid var(--text);
    cursor: pointer;
  }
  .btn.solid {
    background: var(--text);
    color: var(--bg);
  }
  .btn.outline {
    background: transparent;
    color: var(--text);
  }
  .btn.outline:hover {
    background: rgba(242, 242, 242, 0.06);
  }
  .btn.solid:hover {
    background: var(--text-soft);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-dim);
  }
  .meta a:hover {
    color: var(--text);
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, ORANGE, MUTED, WAVE, TILE, type Slot } from '../scripts/tiles';

  // ---------- the letters: 5 × 7 (I is 3 wide), one empty column between letters ----------
  const LETTERS: Record<string, string[]> = {
    M: ['X...X', 'XX.XX', 'X.X.X', 'X.X.X', 'X...X', 'X...X', 'X...X'],
    A: ['.XXX.', 'X...X', 'X...X', 'XXXXX', 'X...X', 'X...X', 'X...X'],
    N: ['X...X', 'XX..X', 'XX..X', 'X.X.X', 'X..XX', 'X..XX', 'X...X'],
    D: ['XXXX.', 'X...X', 'X...X', 'X...X', 'X...X', 'X...X', 'XXXX.'],
    R: ['XXXX.', 'X...X', 'X...X', 'XXXX.', 'X.X..', 'X..X.', 'X...X'],
    I: ['XXX', '.X.', '.X.', '.X.', '.X.', '.X.', 'XXX'],
  };
  const WORD = 'MANDARIN';
  const ROWS = 7;
  // hanzi from the HSK 1 situations, all present in the site's Zpix subset
  const HANZI = [
    ...'你好谢再见对不起没关系要喝吃茶喜欢叫名字什么谁请问中国哪儿去今天文朋友认识高兴我们他岁几年十大家爸妈哥妹电话手机打给喂孩子女狗猫月号星期明现在点床睡觉时间早饭米饺水果买钱贵便宜超市衣服穿看新漂亮住房找桌里来回火车出租飞影听唱玩视气冷热下雨雪学写汉题知道校老师生上课同工作公司忙班脑病医院得左边那个红色的是',
  ];

  const SWAPS_PER_SEC = 4; // tiles that flip on their own
  const HOVER_R = 1.6; // wave radius around the cursor, in tiles
  const COOLDOWN = 380; // ms before the same tile can flip again from the cursor
  const RADIUS = 3 * TILE, FORCE = 9000; // cursor push on the rising tiles (board units)

  const stage = document.getElementById('hero-stage')!;
  const hero = stage.closest<HTMLElement>('.hero') ?? stage;
  const artEl = stage.querySelector<HTMLElement>('.art')!;
  const board = stage.querySelector<HTMLElement>('[data-board]')!;
  const mx = stage.querySelector<SVGSVGElement>('[data-maxxing]')!;
  const canvas = stage.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const pick = () => HANZI[(Math.random() * HANZI.length) | 0];

  // fit the pixel word's own outline
  const mp = mx.querySelector('path')!;
  const bb = mp.getBBox();
  mx.setAttribute('viewBox', `${bb.x} ${bb.y} ${bb.width} ${bb.height}`);

  // ---------- build the board ----------
  type T = { slot: Slot; c: number; r: number; bg: string; until: number };
  const tiles: T[] = [];
  const at = new Map<number, T>();
  const key = (c: number, r: number) => r * 1000 + c;
  let COLS = 0;
  {
    let x = 0;
    for (const ch of WORD) {
      const g = LETTERS[ch];
      g.forEach((row, r) =>
        [...row].forEach((v, c) => {
          if (v === 'X') tiles.push({ slot: null as unknown as Slot, c: x + c, r, bg: '', until: 0 });
        }),
      );
      x += g[0].length + 1;
    }
    COLS = x - 1;
  }
  // colours: runs of 3 to 6 tiles in reading order (left to right), cycling the muted colours with
  // an orange run now and then, like the official list regrouped into lessons in section 01.
  // A fixed seed keeps the same pattern on every visit.
  {
    let seed = 7;
    const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    const order = [...tiles].sort((a, b) => a.c - b.c || a.r - b.r);
    let left = 0, m = 0, bg = MUTED[0];
    for (const t of order) {
      if (left <= 0) {
        left = 3 + ((rand() * 4) | 0);
        bg = rand() < 0.14 ? ORANGE : MUTED[m++ % MUTED.length];
      }
      t.bg = bg;
      left--;
    }
  }
  for (const t of tiles) {
    t.slot = makeSlot(board, 'abs');
    t.slot.el.style.left = `${t.c * TILE}px`;
    t.slot.el.style.top = `${t.r * TILE}px`;
    applyTile(t.slot, { ch: pick(), bg: t.bg });
    at.set(key(t.c, t.r), t);
  }

  function fit() {
    board.style.setProperty('--k', String(board.parentElement!.clientWidth / (COLS * TILE)));
  }
  fit();
  artEl.classList.add('ready');

  if (!reduce) run();

  function run() {
    const flip = (t: T, delay = 0) => flipTile(t.slot, { ch: pick(), bg: t.bg }, delay);

    // ---------- rising tiles ----------
    type Part = { x: number; y: number; y0: number; ch: string; bg: string; speed: number; life: number; vx: number; vy: number; rot: number; vr: number };
    let parts: Part[] = [];
    // emitters: the top tile of every column
    const tops = new Map<number, T>();
    for (const t of tiles) {
      const o = tops.get(t.c);
      if (!o || t.r < o.r) tops.set(t.c, t);
    }
    const emitters = [...tops.values()].map((t) => ({ t, left: 0, since: 0, wait: rnd(0, 6), speed: 0 }));
    const PITCH = TILE * 1.5;

    let k = 1, ox = 0, oy = 0, dpr = 1, headroom = 200;
    function layout() {
      fit();
      const st = stage.getBoundingClientRect();
      const extra = Math.max(0, st.top - hero.getBoundingClientRect().top);
      canvas.style.height = `${st.height + extra}px`;
      const cr = canvas.getBoundingClientRect();
      const br = board.parentElement!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(cr.width * dpr);
      canvas.height = Math.round(cr.height * dpr);
      k = br.width / (COLS * TILE);
      ox = br.left - cr.left;
      oy = br.top - cr.top;
      headroom = oy / k;
    }

    let warming = false;
    function step(dt: number) {
      for (const e of emitters) {
        if (e.left > 0) {
          e.since += dt;
          const gap = PITCH / e.speed;
          if (e.since >= gap) {
            e.since -= gap;
            e.left--;
            const t = e.t;
            const y = t.r * TILE;
            parts.push({ x: t.c * TILE, y, y0: y, ch: t.slot.val?.ch ?? pick(), bg: t.bg, speed: e.speed, life: y + headroom * rnd(0.7, 1), vx: 0, vy: 0, rot: 0, vr: 0 });
            if (warming) applyTile(t.slot, { ch: pick(), bg: t.bg });
            else {
              // the tile lets go and comes back with another hanzi
              applyTile(t.slot, null);
              flipTile(t.slot, { ch: pick(), bg: t.bg }, gap * 1000 * 0.85);
            }
          }
        } else {
          e.wait -= dt;
          if (e.wait <= 0) {
            e.left = 1 + ((Math.random() * 3) | 0);
            e.speed = rnd(1.1, 1.8) * TILE;
            e.since = PITCH / e.speed;
            e.wait = rnd(4, 14);
          }
        }
      }

      const damp = Math.exp(-6 * dt), dampR = Math.exp(-3 * dt);
      for (const p of parts) {
        if (pointer.active) {
          const dx = p.x + TILE / 2 - pointer.x, dy = p.y + TILE / 2 - pointer.y;
          const d = Math.hypot(dx, dy);
          if (d < RADIUS && d > 0.001) {
            const h = Math.min(1, (p.y0 - p.y) / (p.life * 0.75));
            const lift = 0.25 + 0.75 * h * h;
            const fall = 1 - d / RADIUS;
            const f = FORCE * fall * fall * lift;
            p.vx += (dx / d) * f * dt + pointer.vx * 0.02 * fall * lift;
            p.vy += (dy / d) * f * dt + pointer.vy * 0.02 * fall * lift;
            p.vr += (dx / d) * f * dt * 0.004 * (Math.random() < 0.5 ? -1 : 1);
          }
        }
        p.vx *= damp; p.vy *= damp; p.vr *= dampR;
        p.x += p.vx * dt;
        p.y += (p.vy - p.speed) * dt;
        p.rot += p.vr * dt;
      }
      const W = COLS * TILE;
      parts = parts.filter((p) => p.y0 - p.y < p.life && p.y > -headroom - TILE && p.y < ROWS * TILE && p.x > -3 * TILE && p.x < W + 3 * TILE);
      if (warming) return;

      pointer.vx *= Math.exp(-10 * dt);
      pointer.vy *= Math.exp(-10 * dt);
      swapClock += dt * SWAPS_PER_SEC;
      while (swapClock >= 1) {
        swapClock--;
        const t = tiles[(Math.random() * tiles.length) | 0];
        if (t.slot.el.style.visibility === 'visible') flip(t);
      }
    }
    let swapClock = 0;

    function draw() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const s = k * dpr;
      ctx.textBaseline = 'top';
      ctx.font = `500 24px Zpix, sans-serif`;
      for (const p of parts) {
        // opaque while rising, fading out over the last part of the way
        const a = Math.max(0, 1 - Math.pow((p.y0 - p.y) / p.life, 2.2));
        if (a <= 0.01) continue;
        ctx.globalAlpha = a;
        const cs = Math.cos(p.rot) * s, sn = Math.sin(p.rot) * s;
        const cx = (ox + (p.x + TILE / 2) * k) * dpr, cy = (oy + (p.y + TILE / 2) * k) * dpr;
        ctx.setTransform(cs, sn, -sn, cs, cx, cy);
        ctx.fillStyle = p.bg;
        ctx.fillRect(-TILE / 2, -TILE / 2, TILE, TILE);
        ctx.fillStyle = '#161616';
        ctx.fillText(p.ch, -TILE / 2 + 3, -TILE / 2 + 1);
      }
      ctx.globalAlpha = 1;
    }

    // ---------- cursor: flip the tile under it and its neighbours ----------
    const pointer = { x: 0, y: 0, vx: 0, vy: 0, active: false, t: 0 };
    let lastCell = -1;
    hero.addEventListener('pointermove', (ev) => {
      const cr = canvas.getBoundingClientRect();
      const x = (ev.clientX - cr.left - ox) / k, y = (ev.clientY - cr.top - oy) / k;
      const now = ev.timeStamp || performance.now(), dt = Math.max(8, now - pointer.t) / 1000;
      if (pointer.active) { pointer.vx = (x - pointer.x) / dt; pointer.vy = (y - pointer.y) / dt; }
      pointer.vx = Math.max(-900, Math.min(900, pointer.vx));
      pointer.vy = Math.max(-900, Math.min(900, pointer.vy));
      Object.assign(pointer, { x, y, t: now, active: true });

      const c = Math.floor(x / TILE), r = Math.floor(y / TILE);
      const cell = key(c, r);
      if (cell === lastCell) return;
      lastCell = cell;
      if (!at.has(cell)) return;
      const R = Math.ceil(HOVER_R);
      for (let dr = -R; dr <= R; dr++)
        for (let dc = -R; dc <= R; dc++) {
          const d = Math.hypot(dc, dr);
          if (d > HOVER_R) continue;
          const t = at.get(key(c + dc, r + dr));
          if (!t || now < t.until || t.slot.el.style.visibility !== 'visible') continue;
          t.until = now + COOLDOWN;
          flip(t, Math.round(d * WAVE * 1.5));
        }
    });
    hero.addEventListener('pointerleave', () => { pointer.active = false; pointer.vx = pointer.vy = 0; lastCell = -1; });

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(stage);
    new ResizeObserver(() => { layout(); draw(); }).observe(hero);
    layout();

    // start mid-flow, so the page opens with tiles already rising
    warming = true;
    const warmFor = (ROWS * TILE + headroom) / (1.1 * TILE) + 6;
    for (let t = 0; t < warmFor; t += 1 / 20) step(1 / 20);
    warming = false;

    let last = performance.now();
    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (visible && !document.hidden) { step(dt); draw(); }
      requestAnimationFrame(frame);
    }
    // the canvas draws text in Zpix: wait for the font so the first frames are not in a fallback
    document.fonts.load('500 24px Zpix', '你').finally(() => requestAnimationFrame(frame));
  }
</script>
