---
// Hero. MANDARIN is written in tiles (docs/ladrilhos.md) over the outline of the old hanzi hero, with
// MAXXING in black tiles overlapping its bottom edge. Settings come from the lab artifact
// "Hero em ladrilhos — laboratório". Tiles flip on their own; the cursor flips MANDARIN tiles orange
// (they go back to a colour a moment later) and turns MAXXING letters into hanzi for a while. The top
// tile of each column lets go and rises, pushed by the cursor, and the column under it moves up one
// place like a conveyor, with a new tile opening at the bottom. All seven MAXXING letters turned at
// once read 学汉语很有意思, "Learning Chinese is fun".
import { SKILL_ZIP, SKILL_VERSION } from '../data/site';
---
<header class="hero">
  <div class="stage" id="hero-stage">
    <canvas aria-hidden="true"></canvas>
    <div class="art" role="img" aria-label="mandarinmaxxing: the word MANDARIN written in tiles with Chinese characters, and MAXXING in black tiles">
      <div class="fit" data-fit>
        <div class="inner" data-inner aria-hidden="true">
          <div class="board" data-board></div>
          <div class="mx" data-mx>
            <div class="mx-row" data-mx-row></div>
            <p class="mx-cap" data-mx-cap lang="zh-Hans">学汉语很有意思 <span lang="en">· Learning Chinese is fun.</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="cta">
    <div class="text">
      <p class="kicker">a skill for Claude</p>
      <h1 class="lede">
        The same HSK words, reorganized around everyday conversations.
      </h1>
      <p class="sub">
        A tutor in your Claude chat for the official word list of the Chinese proficiency test. Built in the open
        and shaped by the people who study with it.
      </p>
    </div>

    <div class="buttons">
      <a class="btn solid" href={SKILL_ZIP}>Download for Claude</a>
      <a class="btn ghost" href="#install" data-install>How to install <span class="itile" data-itile aria-hidden="true"><svg class="plus" viewBox="0 0 7 7" shape-rendering="crispEdges"><path d="M3 1h1v5h-1zM1 3h5v1h-5z" /></svg><svg class="arrow" viewBox="0 0 7 6" shape-rendering="crispEdges"><path d="M3 0h1v3h-1zM1 3h1v1h-1zM5 3h1v1h-1zM2 4h3v1h-3zM3 3h1v3h-1z" /></svg></span></a>
    </div>
  </div>

  <p class="meta">
    <span>HSK 3.0</span><span>·</span><span>by Eduardo</span><span>·</span><span>{SKILL_VERSION}</span><span>·</span><a href="#what-it-is">How it works ↓</a>
  </p>
</header>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px; /* art → text and buttons → meta */
    padding-block: 40px 64px;
  }

  /* Art + headroom above it for the rising tiles. Wider than the content column (the script sets
     --stage-w, kept clear of the side nav); the hero's align-items: center keeps it centred on the
     column even when it is wider. */
  .stage {
    position: relative;
    width: var(--stage-w, 100%);
    flex: none;
    padding-top: 120px;
  }
  /* the canvas reaches up to the top of the hero (height set by the script) */
  .stage canvas {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .art {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }
  .art.ready {
    opacity: 1;
  }
  /* the art is laid out with the standard 28 px tile and scaled to the stage width (by the script) */
  .fit {
    position: relative;
    width: 100%;
  }
  .inner {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }
  .board {
    position: relative;
    /* the art is drawn at 28 px and shown at about 13 px: 1.5 px here is a hair over 1 px of gap
       between tiles on screen */
    --tile-gap: 1.5px;
  }
  .mx {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }
  .mx-row {
    display: flex;
  }
  .mx-row :global(.mxt) {
    position: relative;
    flex: none;
    background: #000;
    /* MAXXING gets the same air between its tiles as MANDARIN */
    padding: 1px;
    background-clip: content-box;
  }
  .mx-row :global(.mxt > span) {
    position: absolute;
    right: 0;
    white-space: pre;
    text-align: center;
    font-family: var(--f-body);
    font-weight: 600;
    color: var(--text);
  }
  /* hanzi sit like on every other tile: 3/28 from the left, 1/28 from the top */
  .mx-row :global(.mxt.han > span) {
    right: auto;
    text-align: left;
    font-family: 'Zpix', var(--f-display);
    font-weight: 500;
    color: #161616;
  }
  .mx-cap {
    margin-top: 10px;
    font-size: 26px;
    line-height: 32px;
    font-weight: 300;
    color: var(--text-dim);
    white-space: pre;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .mx-cap :global(.on),
  .mx-cap.on {
    opacity: 1;
  }

  .cta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px; /* text → buttons */
  }

  .btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px; /* kicker sits with the title; the title gets 4 more below it */
    text-align: center;
  }
  .kicker {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-dim);
  }
  .lede {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: 300;
    color: var(--text-soft);
    padding-bottom: 4px;
  }
  .sub {
    max-width: 520px;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-dim);
  }

  .buttons {
    display: flex;
    gap: 12px;
  }
  .btn {
    font: 500 var(--fs-small) / var(--lh-small) var(--f-body);
    padding: 12px 20px;
    border: 1px solid var(--text);
    cursor: pointer;
  }
  .btn.solid {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  /* How to install: no frame, grey text and an off tile with +; on hover the text turns white and
     the tile flips to orange with the arrow */
  .btn.ghost {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0 7px 12px;
    border-color: transparent;
    background: transparent;
    color: var(--text-dim);
    transition: color 0.2s;
  }
  .btn.ghost:hover,
  .btn.ghost:focus-visible {
    color: var(--text);
  }
  /* the same tile as the FAQ arrow: off (grey, light +) by default, orange with a dark down arrow on
     hover; it flips with the same close-and-open as every tile */
  .itile {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: #1e1e1e;
  }
  .itile svg {
    grid-area: 1 / 1;
    fill: #8a8a8a;
  }
  .itile .plus {
    width: 14px;
    height: 14px;
  }
  .itile .arrow {
    width: 14px;
    height: 12px;
    display: none;
  }
  .itile.on {
    background: var(--accent);
  }
  .itile.on .plus {
    display: none;
  }
  .itile.on .arrow {
    display: block;
    fill: #161616;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-dim);
  }
  .meta a:hover {
    color: var(--text);
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, ORANGE, MUTED_HERO as MUTED, WAVE, TILE, DUR, EASE_CLOSE, EASE_OPEN, type Slot } from '../scripts/tiles';

  import CELLS from '../data/hero-cells.json';

  // How to install: the tile flips from the off + to the orange arrow on hover or focus (same flip as
  // the FAQ tiles)
  {
    const btn = document.querySelector<HTMLElement>('[data-install]');
    const tile = btn?.querySelector<HTMLElement>('[data-itile]');
    if (btn && tile) {
      let target = false, gen = 0;
      const set = (on: boolean) => {
        if (target === on) return;
        target = on;
        const g = ++gen;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return void tile.classList.toggle('on', on);
        const a = tile.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }], { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
        a.onfinish = () => {
          a.cancel();
          if (g !== gen) return;
          tile.classList.toggle('on', target);
          tile.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], { duration: DUR, easing: EASE_OPEN });
        };
      };
      btn.addEventListener('mouseenter', () => set(true));
      btn.addEventListener('mouseleave', () => set(false));
      btn.addEventListener('focus', () => set(true));
      btn.addEventListener('blur', () => set(false));
    }
  }

  // Settings approved in the lab artifact "Hero em ladrilhos — laboratório" (14/11/2026).
  const CFG = {
    cols: 86, thr: 45, offX: 0, offY: 0, // grid over the shape
    run: 6, orange: 14, seed: 7, // colour runs
    swaps: 40, hover: 2.5, rise: 40, // motion
    mxSize: 2.8, mxBack: 1.9, mxGap: -2, // MAXXING tiles (in MANDARIN tiles)
  };
  const HANZI = [
    ...'你好谢再见对不起没关系要喝吃茶喜欢叫名字什么谁请问中国哪儿去今天文朋友认识高兴我们他岁几年十大家爸妈哥妹电话手机打给喂孩子女狗猫月号星期明现在点床睡觉时间早饭米饺水果买钱贵便宜超市衣服穿看新漂亮住房找桌里来回火车出租飞影听唱玩视气冷热下雨雪学写汉题知道校老师生上课同工作公司忙班脑病医院得左边那个红色的是',
  ];
  // the easter egg: all seven MAXXING tiles turned at once read 学汉语很有意思, "Learning Chinese is fun"
  const MX_PHRASE = [...'学汉语很有意思'];
  const OUT = [{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }];
  const IN = [{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }];

  const stage = document.getElementById('hero-stage')!;
  const hero = stage.closest<HTMLElement>('.hero') ?? stage;
  const artEl = stage.querySelector<HTMLElement>('.art')!;
  const fitEl = stage.querySelector<HTMLElement>('[data-fit]')!;
  const inner = stage.querySelector<HTMLElement>('[data-inner]')!;
  const board = stage.querySelector<HTMLElement>('[data-board]')!;
  const mxEl = stage.querySelector<HTMLElement>('[data-mx]')!;
  const mxRow = stage.querySelector<HTMLElement>('[data-mx-row]')!;
  const mxCap = stage.querySelector<HTMLElement>('[data-mx-cap]')!;
  const canvas = stage.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const pick = () => HANZI[(Math.random() * HANZI.length) | 0];

  // ---------- the shape: the 750 hanzi cells of the old hero, as a mask cropped to the ink ----------
  const MASK_W = 2400;
  function mask(): HTMLCanvasElement {
    const P = 8.53, W = 742, H = 162, k = MASK_W / W;
    const cv = document.createElement('canvas');
    cv.width = MASK_W;
    cv.height = Math.round(H * k);
    const c = cv.getContext('2d')!;
    c.fillStyle = '#000';
    for (const [x, y] of CELLS as [number, number][]) c.fillRect((x - P / 2) * k, (y - P / 2) * k, P * k + 0.5, P * k + 0.5);
    const d = c.getImageData(0, 0, cv.width, cv.height).data;
    let x0 = cv.width, y0 = cv.height, x1 = -1, y1 = -1;
    for (let y = 0; y < cv.height; y++)
      for (let x = 0; x < cv.width; x++)
        if (d[(y * cv.width + x) * 4 + 3] > 127) {
          if (x < x0) x0 = x;
          if (x > x1) x1 = x;
          if (y < y0) y0 = y;
          if (y > y1) y1 = y;
        }
    const out = document.createElement('canvas');
    const cw = x1 - x0 + 1, ch = y1 - y0 + 1, s = MASK_W / cw;
    out.width = MASK_W;
    out.height = Math.max(1, Math.round(ch * s));
    out.getContext('2d')!.drawImage(cv, x0, y0, cw, ch, 0, 0, out.width, out.height);
    return out;
  }

  // ---------- grid: a cell becomes a tile when enough of it is inside the shape ----------
  // The number of columns follows the width: tiles stay close to the 13 px seen in the lab (86
  // columns at the lab's width), with 86 as the most and 60 as the fewest.
  type T = { slot: Slot; c: number; r: number; bg: string; until: number; cool?: number };
  let tiles: T[] = [];
  let at = new Map<number, T>();
  const key = (c: number, r: number) => r * 4096 + c;
  const TARGET_TILE = 13;
  const MIN_COLS = 60; // fewer columns and the letters stop reading as MANDARIN
  let COLS = 0, ROWS = 0, W = 0, H = 0;
  const M = mask();
  const MW = M.width, MH = M.height, W1 = MW + 1;
  const sat = new Float64Array(W1 * (MH + 1));
  {
    const d = M.getContext('2d')!.getImageData(0, 0, MW, MH).data;
    for (let y = 1; y <= MH; y++) {
      let row = 0;
      for (let x = 1; x <= MW; x++) {
        row += d[((y - 1) * MW + (x - 1)) * 4 + 3] / 255;
        sat[y * W1 + x] = sat[(y - 1) * W1 + x] + row;
      }
    }
  }
  const clamp = (v: number, hi: number) => Math.max(0, Math.min(hi, Math.round(v)));
  const area = (ax: number, ay: number, bx: number, by: number) => {
    ax = clamp(ax, MW); bx = clamp(bx, MW); ay = clamp(ay, MH); by = clamp(by, MH);
    if (bx <= ax || by <= ay) return 0;
    return sat[by * W1 + bx] - sat[ay * W1 + bx] - sat[by * W1 + ax] + sat[ay * W1 + ax];
  };
  const colsFor = (width: number) => Math.max(MIN_COLS, Math.min(CFG.cols, Math.round(width / TARGET_TILE)));
  let onGrid: () => void = () => {};

  function buildGrid(cols: number) {
    COLS = cols;
    const cell = MW / COLS;
    const ox = (CFG.offX / 100) * cell, oy = (CFG.offY / 100) * cell;
    const need = (CFG.thr / 100) * cell * cell;
    const rows = Math.ceil(MH / cell) + 1;
    const cand: [number, number][] = [];
    let minR = Infinity, maxR = -1;
    for (let r = -1; r < rows; r++)
      for (let c = -1; c <= COLS; c++) {
        const x0 = c * cell - ox, y0 = r * cell - oy;
        if (area(x0, y0, x0 + cell, y0 + cell) >= need) {
          cand.push([c, r]);
          minR = Math.min(minR, r);
          maxR = Math.max(maxR, r);
        }
      }
    ROWS = maxR - minR + 1;
    tiles.forEach((t) => clearTimeout(t.cool));
    tiles = cand.map(([c, r]) => ({ slot: null as unknown as Slot, c, r: r - minR, bg: '', until: 0 }));
    // colour runs in reading order, cycling the muted colours with an orange run now and then
    let seed = CFG.seed;
    const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const order = [...tiles].sort((a, b) => a.c - b.c || a.r - b.r);
    let left = 0, m = 0, bg = MUTED[0];
    for (const t of order) {
      if (left <= 0) {
        left = Math.max(1, Math.round(CFG.run * (0.5 + rand())));
        bg = rand() < CFG.orange / 100 ? ORANGE : MUTED[m++ % MUTED.length];
      }
      t.bg = bg;
      left--;
    }
    // laid out at the natural 28 px tile; the whole art is scaled to the stage
    W = COLS * TILE;
    H = ROWS * TILE;
    board.replaceChildren();
    Object.assign(board.style, { width: `${W}px`, height: `${H}px` });
    inner.style.width = `${W}px`;
    at = new Map();
    for (const t of tiles) {
      t.slot = makeSlot(board, 'abs');
      t.slot.el.style.left = `${t.c * TILE}px`;
      t.slot.el.style.top = `${t.r * TILE}px`;
      applyTile(t.slot, { ch: pick(), bg: t.bg });
      at.set(key(t.c, t.r), t);
    }
    onGrid();
  }

  // MAXXING keeps its size on screen (about 26 px a tile) whatever the number of columns; it overlaps
  // the bottom of MANDARIN by the same share of its height as in the lab (2 of 2.8 tiles)
  let MXS = CFG.mxSize * TILE;
  const MX_PX = 26;
  const MX_OVERLAP = -CFG.mxGap / CFG.mxSize;

  // MAXXING: one black tile per letter, each hiding one character of the phrase
  type M = { el: HTMLElement; span: HTMLElement; letter: string; han: string; isHan: boolean; target: boolean; gen: number; back?: number; lock: number };
  const mx: M[] = [...'MAXXING'].map((letter, i) => {
    const el = document.createElement('div');
    el.className = 'mxt';
    const span = document.createElement('span');
    el.appendChild(span);
    mxRow.appendChild(el);
    const m = { el, span, letter, han: MX_PHRASE[i], isHan: false, target: false, gen: 0, lock: 0 };
    mxSet(m, false);
    return m;
  });
  let egg = false;
  function newColor(old: string) {
    if (old !== ORANGE && Math.random() < CFG.orange / 100) return ORANGE;
    const opts = MUTED.filter((c) => c !== old);
    return opts[(Math.random() * opts.length) | 0];
  }
  function mxSet(m: M, han: boolean) {
    m.isHan = han;
    m.el.classList.toggle('han', han);
    if (han) {
      m.span.textContent = m.han;
      m.el.style.backgroundColor = egg ? ORANGE : newColor('');
    } else {
      m.span.textContent = m.letter;
      m.el.style.backgroundColor = '#000';
    }
    mxFont(m);
  }
  function mxFont(m: M) {
    const s = m.span.style;
    if (m.isHan) {
      const fs = (MXS * 24) / 28;
      Object.assign(s, { fontSize: `${fs}px`, lineHeight: `${fs}px`, left: `${(MXS * 3) / 28}px`, top: `${MXS / 28}px` });
    } else Object.assign(s, { fontSize: `${MXS * 0.62}px`, lineHeight: `${MXS}px`, left: '0', top: '0' });
  }
  function mxFlip(m: M, han: boolean, delay = 0) {
    const gen = ++m.gen;
    m.target = han;
    window.setTimeout(() => {
      if (m.gen !== gen) return;
      if (reduce) return mxSet(m, han);
      const a = m.el.animate(OUT, { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
      a.onfinish = () => {
        a.cancel();
        if (m.gen !== gen) return;
        mxSet(m, han);
        m.el.animate(IN, { duration: DUR, easing: EASE_OPEN });
      };
    }, delay);
  }
  mx.forEach((m, i) =>
    m.el.addEventListener('pointerenter', () => {
      if (egg) return;
      for (const [j, d] of [[i, 0], [i - 1, 1], [i + 1, 1]]) {
        const n = mx[j];
        // locked while it shows the hanzi and until it has turned back into the letter
        if (!n || n.target || performance.now() < n.lock) continue;
        mxFlip(n, true, d * WAVE * 1.5);
        n.back = window.setTimeout(() => {
          mxFlip(n, false);
          n.lock = performance.now() + 2 * DUR + 60;
        }, CFG.mxBack * 1000 + d * WAVE * 1.5);
      }
      window.setTimeout(checkEgg, 3 * WAVE + 2 * DUR + 20);
    }),
  );
  function checkEgg() {
    if (egg || !mx.every((m) => m.target)) return;
    egg = true;
    mx.forEach((m, i) => {
      clearTimeout(m.back);
      m.gen++;
      window.setTimeout(() => {
        const a = m.el.animate(OUT, { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
        a.onfinish = () => { a.cancel(); mxSet(m, true); m.el.animate(IN, { duration: DUR, easing: EASE_OPEN }); };
      }, i * WAVE * 1.5);
    });
    mxCap.classList.add('on');
    window.setTimeout(() => {
      mxCap.classList.remove('on');
      egg = false;
      mx.forEach((m, i) => {
        mxFlip(m, false, i * WAVE * 1.5);
        m.lock = performance.now() + i * WAVE * 1.5 + 2 * DUR + 60;
      });
    }, 3200);
  }

  let k = 1;
  // as wide as possible up to 1120 px, centred on the column, never under the side nav
  const nav = document.querySelector<HTMLElement>('.sidenav');
  function stageWidth() {
    const col = hero.getBoundingClientRect();
    const vw = document.documentElement.clientWidth;
    const nr = nav && getComputedStyle(nav).display !== 'none' ? nav.getBoundingClientRect().right + 24 : 24;
    const half = Math.min(col.left + col.width / 2 - nr, vw - 24 - (col.left + col.width / 2));
    return Math.max(col.width, Math.min(1120, 2 * half));
  }
  function fit() {
    const sw = stageWidth();
    stage.style.setProperty('--stage-w', `${sw}px`);
    const want = colsFor(sw);
    if (!COLS || Math.abs(want - COLS) >= 3) buildGrid(want);
    k = fitEl.clientWidth / W;
    inner.style.transform = `scale(${k})`;
    MXS = Math.min(MX_PX, sw / 30) / k;
    const mxTop = H - MX_OVERLAP * MXS;
    mxEl.style.top = `${mxTop}px`;
    for (const m of mx) {
      m.el.style.width = m.el.style.height = `${MXS}px`;
      mxFont(m);
    }
    const naturalH = Math.max(H, mxTop + MXS) + 36 / k; // room for the easter egg's line
    inner.style.height = `${naturalH}px`;
    fitEl.style.height = `${naturalH * k}px`;
    mxCap.style.fontSize = `${13 / k}px`;
    mxCap.style.lineHeight = `${18 / k}px`;
    mxCap.style.marginTop = `${8 / k}px`;
  }
  fit();
  artEl.classList.add('ready');

  if (!reduce) run();
  else new ResizeObserver(fit).observe(hero);

  function run() {
    const flip = (t: T, bg: string, delay = 0) => flipTile(t.slot, { ch: pick(), bg }, delay);

    // ---------- rising tiles (positions in tiles) ----------
    type Part = { x: number; y: number; y0: number; ch: string; bg: string; speed: number; life: number; vx: number; vy: number; rot: number; vr: number };
    let parts: Part[] = [];
    // a rising tile travels 6 to 14 tiles before it fades out (never past the top of the hero), and at
    // most 90 fly at once
    const LIFE = [6, 14];
    const MAX_PARTS = 90;
    type E = { t: T; left: number; since: number; wait: number; speed: number; inner?: boolean };
    let emitters: E[] = [];
    // Every column is a small conveyor (approved 16/11/2026). When the top tile lets go and rises, the
    // tiles under it move up one place and a new tile opens at the bottom. A letter with a hole (A, D,
    // R) has more than one stack in a column; the lower stacks move too, without a flying tile. A tile
    // carries its colour with it.
    const SLIDE = 420;
    function lift(top: T, warming: boolean) {
      const col: T[] = [];
      for (let r = top.r; ; r++) {
        const n = at.get(key(top.c, r));
        if (!n) break;
        col.push(n);
      }
      const bump = (t: T) => (t.slot.gen = (t.slot.gen ?? 0) + 1); // drops a flip that is still on its way
      for (let i = 0; i + 1 < col.length; i++) {
        const a = col[i], b = col[i + 1];
        bump(a);
        a.bg = b.bg;
        applyTile(a.slot, { ch: b.slot.val?.ch ?? pick(), bg: b.bg });
        if (!warming) a.slot.el.animate([{ translate: `0 ${TILE}px` }, { translate: '0 0' }], { duration: SLIDE, easing: 'cubic-bezier(.3,0,.2,1)' });
      }
      const last = col[col.length - 1];
      bump(last);
      if (Math.random() < 1 / CFG.run) last.bg = newColor(last.bg); // now and then a new colour run starts
      if (warming) applyTile(last.slot, { ch: pick(), bg: last.bg });
      else {
        applyTile(last.slot, null);
        flip(last, last.bg, SLIDE * 0.55);
      }
    }
    // emitters: the top tile of every column (redone when the grid is rebuilt)
    onGrid = () => {
      const tops = new Map<number, T>();
      for (const t of tiles) {
        const o = tops.get(t.c);
        if (!o || t.r < o.r) tops.set(t.c, t);
      }
      emitters = [...tops.values()].map((t) => ({ t, left: 0, since: 0, wait: rnd(0, 8), speed: 0 }));
      for (const t of tiles)
          if (tops.get(t.c) !== t && !at.has(key(t.c, t.r - 1)) && at.has(key(t.c, t.r + 1)))
            emitters.push({ t, left: 0, since: 0, wait: rnd(0, 12), speed: 0, inner: true });
      parts = [];
    };
    onGrid();
    const pointer = { x: 0, y: 0, vx: 0, vy: 0, active: false, t: 0 };

    let ts = TILE, bx = 0, by = 0, dpr = 1; // screen size of a tile, board origin in the canvas
    function layout() {
      fit();
      ts = TILE * k;
      const st = stage.getBoundingClientRect();
      const extra = Math.max(0, st.top - hero.getBoundingClientRect().top);
      canvas.style.height = `${st.height + extra}px`;
      const cr = canvas.getBoundingClientRect();
      const br = board.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(cr.width * dpr);
      canvas.height = Math.round(cr.height * dpr);
      bx = br.left - cr.left;
      by = br.top - cr.top;
    }

    let swapClock = 0;
    function step(dt: number, warming: boolean) {
      const rate = CFG.rise / 100;
      for (const e of emitters) {
        if (e.left > 0) {
          e.since += dt;
          const gap = 1.5 / e.speed;
          if (e.since >= gap) {
            e.since -= gap;
            e.left--;
            const t = e.t;
            if (!e.inner && parts.length < MAX_PARTS) parts.push({ x: t.c, y: t.r, y0: t.r, ch: t.slot.val?.ch ?? pick(), bg: t.bg, speed: e.speed, life: rnd(LIFE[0], LIFE[1]), vx: 0, vy: 0, rot: 0, vr: 0 });
            lift(t, warming);
          }
        } else if (rate > 0) {
          e.wait -= dt * rate;
          if (e.wait <= 0) {
            e.left = 1 + ((Math.random() * 3) | 0);
            e.speed = rnd(1.1, 1.8) * (28 / ts) ** 0.5;
            e.since = 1.5 / e.speed;
            e.wait = rnd(2, 8);
          }
        }
      }
      const R = 3 * (28 / ts) ** 0.6, FORCE = 320 * (28 / ts) ** 0.4;
      const damp = Math.exp(-6 * dt), dampR = Math.exp(-3 * dt);
      for (const p of parts) {
        if (pointer.active) {
          const dx = p.x + 0.5 - pointer.x, dy = p.y + 0.5 - pointer.y, d = Math.hypot(dx, dy);
          if (d < R && d > 0.001) {
            const h = Math.min(1, (p.y0 - p.y) / (p.life * 0.75));
            const lift = 0.25 + 0.75 * h * h, fall = 1 - d / R, f = FORCE * fall * fall * lift;
            p.vx += (dx / d) * f * dt + pointer.vx * 0.02 * fall * lift;
            p.vy += (dy / d) * f * dt + pointer.vy * 0.02 * fall * lift;
            p.vr += (dx / d) * f * dt * 0.1 * (Math.random() < 0.5 ? -1 : 1);
          }
        }
        p.vx *= damp; p.vy *= damp; p.vr *= dampR;
        p.x += p.vx * dt;
        p.y += (p.vy - p.speed) * dt;
        p.rot += p.vr * dt;
      }
      parts = parts.filter((p) => p.y0 - p.y < p.life && p.y > -by / ts - 1 && p.x > -4 && p.x < COLS + 4);
      if (warming) return;

      pointer.vx *= Math.exp(-10 * dt);
      pointer.vy *= Math.exp(-10 * dt);
      swapClock += dt * CFG.swaps;
      while (swapClock >= 1) {
        swapClock--;
        const t = tiles[(Math.random() * tiles.length) | 0];
        if (t.slot.el.style.visibility === 'visible') flip(t, t.bg);
      }
    }

    function draw() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.textBaseline = 'top';
      ctx.font = '500 24px Zpix, sans-serif';
      const s = (ts / 28) * dpr;
      for (const p of parts) {
        // opaque while rising, fading out over the last part of the way
        const a = Math.max(0, 1 - Math.pow((p.y0 - p.y) / p.life, 2.2));
        if (a <= 0.01) continue;
        ctx.globalAlpha = a;
        const cs = Math.cos(p.rot) * s, sn = Math.sin(p.rot) * s;
        ctx.setTransform(cs, sn, -sn, cs, (bx + (p.x + 0.5) * ts) * dpr, (by + (p.y + 0.5) * ts) * dpr);
        ctx.fillStyle = p.bg;
        ctx.fillRect(-14, -14, 28.4, 28.4);
        ctx.fillStyle = '#161616';
        ctx.fillText(p.ch, -11, -13);
      }
      ctx.globalAlpha = 1;
    }

    // ---------- cursor over MANDARIN: the tile and its neighbours turn orange, then go back to colour ----------
    let lastCell = -1;
    hero.addEventListener('pointermove', (ev) => {
      const br = board.getBoundingClientRect();
      const x = (ev.clientX - br.left) / ts, y = (ev.clientY - br.top) / ts;
      const now = performance.now(), dt = Math.max(8, now - pointer.t) / 1000;
      if (pointer.active) {
        pointer.vx = Math.max(-60, Math.min(60, (x - pointer.x) / dt));
        pointer.vy = Math.max(-60, Math.min(60, (y - pointer.y) / dt));
      }
      Object.assign(pointer, { x, y, t: now, active: true });
      const c = Math.floor(x), r = Math.floor(y), cell = key(c, r);
      if (cell === lastCell) return;
      lastCell = cell;
      if (!at.has(cell)) return;
      const RR = Math.ceil(CFG.hover);
      for (let dr = -RR; dr <= RR; dr++)
        for (let dc = -RR; dc <= RR; dc++) {
          const d = Math.hypot(dc, dr);
          if (d > CFG.hover) continue;
          const t = at.get(key(c + dc, r + dr));
          if (!t || now < t.until || t.slot.el.style.visibility !== 'visible') continue;
          t.until = now + 380;
          t.bg = ORANGE;
          const delay = Math.round(d * WAVE * 1.5);
          flip(t, ORANGE, delay);
          clearTimeout(t.cool);
          t.cool = window.setTimeout(() => {
            t.bg = newColor(ORANGE);
            flip(t, t.bg);
          }, delay + rnd(1500, 4000));
        }
    });
    hero.addEventListener('pointerleave', () => {
      pointer.active = false;
      pointer.vx = pointer.vy = 0;
      lastCell = -1;
    });

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(stage);
    new ResizeObserver(() => { layout(); draw(); }).observe(hero);
    layout();

    // start mid-flow, so the page opens with tiles already rising
    for (let t = 0; t < 30; t += 1 / 20) step(1 / 20, true);

    let last = performance.now();
    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (visible && !document.hidden) {
        step(dt, false);
        draw();
      }
      requestAnimationFrame(frame);
    }
    // the canvas draws text in Zpix: wait for the font so the first frames are not in a fallback
    document.fonts.load('500 24px Zpix', '你').finally(() => requestAnimationFrame(frame));
  }
</script>
