---
// Section 06 — Paper node 3Z-0. Design not reviewed yet by Eduarda (built as-is, marked for review).
import Section from '../Section.astro';
import { SKILL_REPO, SKILL_ZIP } from '../../data/site';
---

<Section id="install" num="06" title="Install">
  <p class="lead pixel">Claude on the web or desktop. Download the ZIP and import it as a custom skill.</p>
  <a class="btn" href={SKILL_ZIP}>Download for Claude</a>

  <div class="cli">
    <p class="lead pixel">
      Claude Code or Codex. You'll need Node.js 22.20.0 or newer and a working npx. Run the command in your study folder.
    </p>
    <pre class="code"><code><span class="c"># Claude Code — then open it with /mandarinmaxxing</span>
npx skills add aveduardo-br/mandarinmaxxing --skill mandarinmaxxing -a claude-code

<span class="c"># Codex — then call it with $mandarinmaxxing</span>
npx skills add aveduardo-br/mandarinmaxxing --skill mandarinmaxxing -a codex</code></pre>
    <a class="more" href={SKILL_REPO} target="_blank" rel="noopener">Full instructions on GitHub ↗</a>
  </div>
</Section>

<style>
  .lead {
    font-size: 17px;
    line-height: 28px;
    color: var(--text-soft);
  }
  .btn {
    align-self: flex-start;
    padding: 12px 20px;
    background: var(--text);
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
    line-height: 28px;
  }
  .btn:hover {
    background: var(--text-soft);
  }
  .cli {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .code {
    margin: 0;
    padding: 14px 16px;
    background: #1a1a1a;
    overflow-x: auto;
  }
  .code code {
    font-family: var(--f-mono);
    font-size: 13px;
    line-height: 22px;
    color: var(--text);
  }
  .more {
    font-size: 15px;
    line-height: 18px;
    color: var(--text-dim);
  }
  .more:hover {
    color: var(--text);
  }
</style>
