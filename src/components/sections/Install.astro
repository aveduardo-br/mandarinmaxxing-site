---
// Section 06 — Install. Four numbered steps for the Claude app (the main path), audio as an
// optional extra, and the terminal command as a footnote for people who use coding agents.
// Button and menu names are the ones in the Claude app; check them against the skill's README.
import Section from '../Section.astro';
import { SKILL_REPO, SKILL_ZIP } from '../../data/site';

const INSTRUCTIONS = 'Use the mandarinmaxxing skill. My course is saved in course.md.';
const START = 'start mandarinmaxxing';
---

<Section id="install" num="06" title="Install">
  <p class="prose">You need a Claude account where you can add skills and create projects. It takes about five minutes.</p>

  <ol class="steps">
    <li class="step">
      <span class="n display" aria-hidden="true">1</span>
      <div class="body">
        <h3 class="display">Download the skill</h3>
        <p>One ZIP file. You don’t need to open it.</p>
        <a class="btn" href={SKILL_ZIP}>Download for Claude</a>
      </div>
    </li>
    <li class="step">
      <span class="n display" aria-hidden="true">2</span>
      <div class="body">
        <h3 class="display">Add it to Claude</h3>
        <p>
          Open <b>Customize → Skills</b>, click <b>+</b>, choose <b>Create skill</b>, then <b>Upload a skill</b>, and
          pick the ZIP.
        </p>
      </div>
    </li>
    <li class="step">
      <span class="n display" aria-hidden="true">3</span>
      <div class="body">
        <h3 class="display">Create a project</h3>
        <p>Name it whatever you like, for example “Mandarin”. In the project’s instructions, paste this line:</p>
        <div class="copy" data-copy-box>
          <code>{INSTRUCTIONS}</code>
          <button type="button" data-copy={INSTRUCTIONS}>Copy</button>
        </div>
        <p>The project is where your course is saved. Keep all your lessons in it.</p>
      </div>
    </li>
    <li class="step">
      <span class="n display" aria-hidden="true">4</span>
      <div class="body">
        <h3 class="display">Start</h3>
        <p>Open a chat inside the project and write:</p>
        <div class="copy" data-copy-box>
          <code>{START}</code>
          <button type="button" data-copy={START}>Copy</button>
        </div>
      </div>
    </li>
  </ol>

  <div class="extra">
    <h3 class="display">Audio, if you want it</h3>
    <p>
      Create an account at <a href="https://elevenlabs.io" target="_blank" rel="noopener">elevenlabs.io</a>. In Claude,
      open <b>Customize → Connectors</b>, find <b>ElevenLabs</b> and connect it. Then tell the skill you want audio.
      Each lesson generates one short clip.
    </p>
  </div>

  <p class="foot">
    Using Claude Code or Codex? The skill runs there too, installed from the terminal.
    <a href={`${SKILL_REPO}#other-ways-to-run-it`} target="_blank" rel="noopener">Instructions on GitHub ↗</a>
  </p>
</Section>

<script>
  document.querySelectorAll<HTMLButtonElement>('#install [data-copy]').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = label), 1600);
    });
  });
</script>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .step {
    display: flex;
    gap: 20px;
    padding-block: 20px;
    border-top: 1px solid var(--outline);
  }
  .step:last-child {
    border-bottom: 1px solid var(--outline);
  }
  .n {
    flex-shrink: 0;
    width: 24px;
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--accent);
  }
  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  h3 {
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    color: var(--text);
  }
  .body p,
  .extra p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-soft);
    opacity: 0.8;
  }
  b {
    font-weight: 500;
    color: var(--text);
  }
  .btn {
    padding: 12px 20px;
    background: var(--text);
    color: var(--bg);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: var(--lh-small);
  }
  .btn:hover {
    background: var(--text-soft);
  }
  .copy {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    background: #1a1a1a;
  }
  .copy code {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-family: var(--f-mono);
    font-size: 13px;
    line-height: 22px;
    color: var(--text);
  }
  .copy button {
    flex-shrink: 0;
    background: none;
    border: 0;
    padding: 0;
    font: 500 var(--fs-caption) / var(--lh-caption) var(--f-body);
    color: var(--text-dim);
    cursor: pointer;
  }
  .copy button:hover {
    color: var(--text);
  }
  .copy button:focus-visible,
  .btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
  .extra {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 8px;
  }
  .extra a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .foot {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-dim);
  }
  .foot a:hover {
    color: var(--text);
  }
</style>
