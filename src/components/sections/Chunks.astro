---
// Section 03 — Paper "03 Chunks" (tiles). See docs/ladrilhos.md.
// A staircase of tiles (Paper "v4 · B Tradução na borda"). The first step is the chunk itself, in
// orange, with an empty dashed slot. On the five steps below the chunk turns grey and only the word
// that enters the slot is in colour. Each step moves one tile to the right. The English sits on the
// right edge of the column, joined to its step by a thin dashed line; the chunk's own line is bold.
// On a narrow column the English goes under each step instead. Clicking the staircase moves to the
// next chunk: every tile flips in place, in a wave, and the steps grow or shrink.
import Section from '../Section.astro';

// Every word here is in the HSK 1 list. The tiles use the pixel font: after changing a phrase,
// regenerate public/fonts/zpix-site.woff with scripts/subset-zpix.py.
const chunks = [
  {
    pre: '太',
    post: '了',
    label: 'So …!',
    ex: ['太贵了', 'while shopping', 'say', '太热了', 'about the weather'],
    words: [
      ['贵', 'expensive'],
      ['热', 'hot'],
      ['早', 'early'],
      ['好吃', 'delicious'],
      ['漂亮', 'pretty'],
    ],
  },
  {
    pre: '我想',
    post: '一下',
    label: 'I’d like to …',
    ex: ['我想看一下', 'in a shop', 'say', '我想问一下', 'to someone on the street'],
    words: [
      ['看', 'have a look'],
      ['问', 'ask something'],
      ['找', 'look for it'],
      ['听', 'have a listen'],
      ['休息', 'rest a bit'],
    ],
  },
  {
    pre: '你什么时候',
    post: '',
    label: 'When do you …?',
    ex: ['你什么时候来', 'making plans', 'ask', '你什么时候下班', 'at work'],
    words: [
      ['来', 'come'],
      ['下班', 'get off work'],
      ['回家', 'go home'],
      ['起床', 'get up'],
      ['睡觉', 'go to bed'],
    ],
  },
];
// The sentence under the staircase changes with the chunk: learn it in one situation, reuse it in another.
const lead = (ex: string[]) =>
  `Learn <span class="hanzi" lang="zh-Hans">${ex[0]}</span> ${ex[1]} and you can already ${ex[2]} <span class="hanzi" lang="zh-Hans">${ex[3]}</span> ${ex[4]}.`;
const leads = chunks.map((c) => lead(c.ex));
---

<Section id="chunks" num="03" title="Chunks" tiled>
  <p class="prose">
    Words are only half of it. Every lesson also teaches chunks: short phrases you can lift out and reuse in another
    situation, with one word swapped.
  </p>

  <div class="viz" data-chunks={JSON.stringify(chunks)} data-leads={JSON.stringify(leads)}>
    <div class="fit" data-fit>
      <div class="stage" data-stage role="button" tabindex="0" data-cuelume-tap aria-label="Show the next chunk"></div>
    </div>
    <p class="sr-only" aria-live="polite" data-live>
      {chunks[0].label} {chunks[0].words.map((w) => `${chunks[0].pre}${w[0]}${chunks[0].post} (${w[1]})`).join(', ')}
    </p>
  </div>

  <p class="prose after">
    <span class="lead" data-lead set:html={leads[0]} /> Each chunk shows up in your translations and in the text
    that closes the lesson, then comes back later in new sentences.
  </p>
</Section>

<style>
  .viz {
    position: relative;
    margin-top: 40px;
  }
  .fit {
    height: 168px;
    overflow: hidden;
  }
  .stage {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .stage:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
  /* the empty slot of the chunk */
  .stage :global(.hole) {
    position: absolute;
    top: 0;
    width: 28px;
    height: 28px;
    box-sizing: border-box;
    border: 1.5px dashed var(--muted);
    transition: opacity 0.12s linear;
  }
  /* the English for one step: a dashed leader, then the sentence on the right edge */
  .stage :global(.en) {
    position: absolute;
    right: 0;
    height: 28px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 14px;
    transition: opacity 0.12s linear;
  }
  .stage :global(.en .lead) {
    flex: 1;
    min-width: 24px;
    border-top: 1px dashed #3a3a3a;
  }
  .stage :global(.en .txt) {
    font-family: var(--f-body);
    font-size: 15px;
    line-height: 28px;
    font-weight: 300;
    color: var(--muted);
    white-space: nowrap;
  }
  .stage :global(.en .txt b) {
    color: var(--text);
    font-weight: 500;
  }
  .stage :global(.en.head .txt) {
    color: var(--text);
    font-weight: 600;
  }
  /* narrow column: the English under each step, no leader */
  .stage.stack :global(.en) {
    height: 18px;
    padding-left: 0;
  }
  .stage.stack :global(.en .lead) {
    display: none;
  }
  .stage.stack :global(.en .txt) {
    font-size: 13px;
    line-height: 18px;
  }

  /* the changing sentence's words: the rewrite effect in global.css (src/scripts/write.ts) */
  .after {
    margin-top: 40px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, reduceMotion, withFlipSound, TILE, ORANGE, MUTED, DIM, WAVE, FLIP } from '../../scripts/tiles';
  import type { Slot, TileVal } from '../../scripts/tiles';
  import { makeInlineWriter } from '../../scripts/write';

  type Chunk = { pre: string; post: string; label: string; words: [string, string][] };

  const viz = document.querySelector<HTMLElement>('[data-chunks]');
  if (viz) {
    const chunks: Chunk[] = JSON.parse(viz.dataset.chunks!);
    const stage = viz.querySelector<HTMLElement>('[data-stage]')!;
    const fit = viz.querySelector<HTMLElement>('[data-fit]')!;
    const live = viz.querySelector<HTMLElement>('[data-live]')!;
    const leads: string[] = JSON.parse(viz.dataset.leads!);
    const leadEl = document.querySelector<HTMLElement>('#chunks [data-lead]');
    // The first sentence under the staircase changes with the chunk, rewritten word by word
    // (src/scripts/write.ts): the new words follow right behind the old ones.
    const write = leadEl ? makeInlineWriter(leadEl) : null;
    const swapLead = (k: number) => write?.(leads[k]);
    const WORDS = 5;
    const ROWS = WORDS + 1; // the chunk itself, then one step per word
    const STEP = TILE; // each step starts one tile further right
    const MAXC = Math.max(...chunks.flatMap((c) => c.words.map((w) => [...c.pre, ...w[0], ...c.post].length)));
    const GREY: TileVal = { ch: '', ...DIM };
    const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');

    // row 0: the chunk in orange with an empty slot; rows 1-5: the chunk in grey, the word in colour.
    const rowsOf = (k: number): TileVal[][] => {
      const c = chunks[k];
      const grey = (ch: string): TileVal => ({ ...GREY!, ch });
      return [
        [...[...c.pre].map((ch) => ({ ch, bg: ORANGE })), { ch: '', bg: 'transparent' }, ...[...c.post].map((ch) => ({ ch, bg: ORANGE }))],
        ...c.words.map((w, r) => [
          ...[...c.pre].map(grey),
          ...[...w[0]].map((ch) => ({ ch, bg: MUTED[r % MUTED.length] })),
          ...[...c.post].map(grey),
        ]),
      ];
    };
    // "I'd like to …" on the chunk's line; "I'd like to <b>have a look</b>" on each step
    const enOf = (k: number, r: number) => {
      const label = chunks[k].label;
      if (r === 0) return esc(label);
      const [a, b] = label.split('…');
      return `${esc(a)}<b>${esc(chunks[k].words[r - 1][1])}</b>${esc(b ?? '')}`;
    };

    const slots: Slot[][] = [];
    const ens: HTMLElement[] = [];
    for (let r = 0; r < ROWS; r++) {
      slots.push([]);
      for (let c = 0; c < MAXC; c++) slots[r].push(makeSlot(stage, 'abs'));
      const en = document.createElement('div');
      en.className = r === 0 ? 'en head' : 'en';
      en.innerHTML = '<span class="lead"></span><span class="txt"></span>';
      stage.appendChild(en);
      ens.push(en);
    }
    const hole = document.createElement('div');
    hole.className = 'hole';
    stage.appendChild(hole);

    let stack = false; // narrow column: English under each step
    const pitch = () => (stack ? TILE + 22 : TILE);
    const lens: number[] = Array(ROWS).fill(0);
    const placeEn = (r: number) => {
      const en = ens[r];
      if (stack) {
        en.style.left = `${r * STEP}px`;
        en.style.top = `${r * pitch() + TILE + 2}px`;
      } else {
        en.style.left = `${r * STEP + lens[r] * TILE}px`;
        en.style.top = `${r * pitch()}px`;
      }
    };
    const setEn = (r: number, k: number, len: number) => {
      lens[r] = len;
      ens[r].querySelector('.txt')!.innerHTML = enOf(k, r);
      placeEn(r);
    };
    const place = () => {
      slots.forEach((row, r) =>
        row.forEach((slot, c) => {
          slot.el.style.left = `${r * STEP + c * TILE}px`;
          slot.el.style.top = `${r * pitch()}px`;
        }),
      );
      ens.forEach((_, r) => placeEn(r));
      fit.style.height = `${(ROWS - 1) * pitch() + (stack ? TILE + 22 : TILE)}px`;
    };
    const setHole = (k: number) => (hole.style.left = `${[...chunks[k].pre].length * TILE}px`);
    // Narrow column (English under each step): the staircase is centred, and glides left or right
    // when the next chunk is longer or shorter. Its width is its widest step, tiles or English.
    let measureEn: (k: number, r: number) => number = () => 0;
    const centre = (k: number) => {
      if (!stack) return void (stage.style.transform = '');
      const w = Math.max(...rowsOf(k).map((row, r) => r * STEP + Math.max(row.length * TILE, measureEn(k, r))));
      stage.style.transform = `translateX(${Math.max(0, (fit.clientWidth - w) / 2)}px)`;
    };

    let cur = 0;
    let busy = false;

    function render(k: number) {
      rowsOf(k).forEach((row, r) => {
        slots[r].forEach((slot, c) => applyTile(slot, row[c] ?? null));
        setEn(r, k, row.length);
        ens[r].style.opacity = '1';
      });
      setHole(k);
    }

    function go(k: number) {
      if (busy || k === cur) return;
      cur = k;
      const c = chunks[k];
      live.textContent = `${c.label} ${c.words.map((w) => `${c.pre}${w[0]}${c.post} (${w[1]})`).join(', ')}`;
      swapLead(k);
      centre(k);
      if (reduceMotion()) return render(k);
      busy = true;
      let last = 0;
      hole.style.opacity = '0';
      rowsOf(k).forEach((row, r) => {
        ens[r].style.opacity = '0';
        let rowEnd = 0;
        slots[r].forEach((slot, col) => {
          const v = row[col] ?? null;
          if (!slot.val && !v) return;
          const d = (2 * r + col) * WAVE;
          rowEnd = Math.max(rowEnd, d);
          flipTile(slot, v, d);
        });
        window.setTimeout(() => {
          setEn(r, k, row.length);
          ens[r].style.opacity = '1';
          if (r === 0) {
            setHole(k);
            hole.style.opacity = '1';
          }
        }, rowEnd + FLIP * 0.6);
        last = Math.max(last, rowEnd + FLIP);
      });
      window.setTimeout(() => (busy = false), last + 40);
    }

    const next = () => go((cur + 1) % chunks.length);
    stage.addEventListener('click', () => withFlipSound(next));
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        withFlipSound(next);
      }
    });

    // the English goes under the steps when the longest step plus its sentence won't fit beside it
    const measure = document.createElement('span');
    measure.className = 'txt';
    measure.style.cssText = 'position:absolute;visibility:hidden;left:0;top:0';
    const probe = document.createElement('div');
    probe.className = 'en';
    probe.style.visibility = 'hidden';
    probe.appendChild(measure);
    stage.appendChild(probe);
    const fitStage = () => {
      stage.classList.remove('stack');
      let need = 0;
      chunks.forEach((_, k) =>
        rowsOf(k).forEach((row, r) => {
          measure.innerHTML = enOf(k, r);
          need = Math.max(need, r * STEP + row.length * TILE + 14 + 24 + 14 + measure.offsetWidth);
        }),
      );
      stack = fit.clientWidth < need;
      stage.classList.toggle('stack', stack);
      place();
      centre(cur);
    };
    measureEn = (k, r) => {
      measure.innerHTML = enOf(k, r);
      return measure.offsetWidth;
    };
    addEventListener('resize', fitStage);
    render(0);
    fitStage();
    document.fonts?.ready.then(fitStage);
  }
</script>
