---
// Section 03 — Paper node 2C-0.
// Slot with two independent, infinite columns. Each click, wheel swipe, drag or ↑/↓ moves a column
// exactly one item (click above the centre = up, below = down). The English tags follow the combination.
import Section from '../Section.astro';

const left = [
  { zh: '我走路去', en: 'I walk to' },
  { zh: '我坐出租车去', en: 'I take a taxi to' },
  { zh: '我坐地铁去', en: 'I take the subway to' },
  { zh: '我骑自行车去', en: 'I ride my bike to' },
  { zh: '我开车去', en: 'I drive to' },
];
const right = [
  { zh: '医院', en: 'the hospital' },
  { zh: '学校', en: 'school' },
  { zh: '公司', en: 'the office' },
  { zh: '机场', en: 'the airport' },
  { zh: '超市', en: 'the supermarket' },
];
const START = 2; // 我坐地铁去 + 公司, as in Paper

// Each list is rendered twice so the column can wrap around without items flying across.
const doubled = <T,>(a: T[]) => [...a, ...a];
---

<Section id="chunks" num="03" title="Chunks">
  <p class="prose">
    Grouping is only half of it. Every lesson also teaches chunks: short phrases and sentence patterns you can lift out
    and reuse in other situations.
  </p>
  <p class="prose">
    You see how the words work together, try them in your own translations, then meet them again in a dialogue. Words
    and chunks from earlier lessons come back in new contexts when they fit.
  </p>

  <div class="slot" data-slot data-start={START}>
    <div class="half left">
    <div class="tag left" data-tag="left" aria-hidden="true">{left[START].en}</div>

    <div
      class="col left"
      data-col="left"
      tabindex="0"
      role="spinbutton"
      aria-label="First half of the sentence"
      aria-valuetext={left[START].zh}
      data-en={JSON.stringify(left.map((x) => x.en))}
      data-zh={JSON.stringify(left.map((x) => x.zh))}
    >
      {doubled(left).map((x, i) => <span class="item" data-i={i}>{x.zh}</span>)}
    </div>
    </div>

    <div class="half right">
    <div
      class="col right"
      data-col="right"
      tabindex="0"
      role="spinbutton"
      aria-label="Second half of the sentence"
      aria-valuetext={right[START].zh}
      data-en={JSON.stringify(right.map((x) => x.en))}
      data-zh={JSON.stringify(right.map((x) => x.zh))}
    >
      {doubled(right).map((x, i) => <span class="item" data-i={i}>{x.zh}</span>)}
    </div>

    <div class="tag right" data-tag="right" aria-hidden="true">{right[START].en}</div>
    </div>

    <p class="sr-only" aria-live="polite" data-live></p>
  </div>
</Section>

<style>
  /* The seam between the two columns never moves: the left column is always right-aligned
     against it and the right column always left-aligned. The English tags sit next to their
     column and get pushed outwards when a chunk is longer. */
  .slot {
    --seam: 430px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 32px;
    user-select: none;
    -webkit-user-select: none;
  }
  .half {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0; /* let a long phrase overflow outwards instead of moving the seam */
  }
  .half.left {
    flex: 0 0 calc(var(--seam) - 8px);
    justify-content: flex-end;
  }
  .half.right {
    flex: 1 1 0;
    justify-content: flex-start;
  }
  .tag {
    flex: none;
    font-size: var(--fs-caption);
    line-height: 18px;
    white-space: nowrap;
    transition: opacity 0.12s ease;
  }
  .tag.left {
    color: var(--text-dim);
  }
  .tag.right {
    color: var(--accent);
    text-align: right;
  }

  /* Column: 5 visible slots (32 / 44 / 64 / 44 / 32 px, 10px gaps) = 256px tall */
  .col {
    position: relative;
    flex-shrink: 0;
    height: 256px;
    cursor: pointer;
    outline: none;
    transition: width 0.22s ease;
    touch-action: none;
  }
  .col.left {
    color: var(--text);
  }
  .col.right {
    color: var(--accent);
  }
  .col:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 8px;
  }

  .item {
    position: absolute;
    top: 0;
    white-space: pre;
    font-family: var(--f-display);
    font-weight: var(--fw-display);
    font-size: 24px;
    line-height: 32px;
    opacity: 0;
    pointer-events: none;
    /* Movement is animated in JS (easeOutBack): position and scale overshoot together, and
       the font swaps (display ↔ Kaiti) partway through the move. */
  }
  .col.left .item {
    right: 0;
    transform-origin: right center;
  }
  .col.right .item {
    left: 0;
    transform-origin: left center;
  }

  /* slot positions (set by data-s) */
  .item[data-s='-3'] {
    translate: 0 -42px;
  }
  .item[data-s='-2'] {
    translate: 0 0px;
  }
  .item[data-s='-1'] {
    translate: 0 42px;
    font-size: 36px;
    line-height: 44px;
  }
  .item[data-s='0'] {
    translate: 0 96px;
    font-family: var(--f-brush);
    font-weight: 700;
    font-size: 56px;
    line-height: 64px;
    opacity: 1;
  }
  .item[data-s='1'] {
    translate: 0 170px;
    font-size: 36px;
    line-height: 44px;
  }
  .item[data-s='2'] {
    translate: 0 224px;
  }
  .item[data-s='3'] {
    translate: 0 266px;
  }
  .item[data-s='-1'],
  .item[data-s='1'],
  .item[data-s='-2'],
  .item[data-s='2'] {
    pointer-events: auto;
    cursor: pointer;
  }
  .col.left .item[data-s='-1'],
  .col.left .item[data-s='1'] {
    opacity: 0.18;
  }
  .col.left .item[data-s='-2'],
  .col.left .item[data-s='2'] {
    opacity: 0.07;
  }
  .col.right .item[data-s='-1'],
  .col.right .item[data-s='1'] {
    opacity: 0.25;
  }
  .col.right .item[data-s='-2'],
  .col.right .item[data-s='2'] {
    opacity: 0.1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .item,
    .col,
    .tag {
      transition: none;
    }
  }
</style>

<script>
  const slot = document.querySelector<HTMLElement>('[data-slot]')!;
  const live = slot.querySelector<HTMLElement>('[data-live]')!;
  const START = Number(slot.dataset.start);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Motion: Robert Penner's easeOutBack (c1 = 1.70158), the standard overshoot curve.
  // Position and size both follow it, so the chunk overshoots its spot and its scale, then settles.
  const DURATION = 380;
  const C1 = 1.70158;
  const C3 = C1 + 1;
  const easeOutBack = (t: number) => 1 + C3 * Math.pow(t - 1, 3) + C1 * Math.pow(t - 1, 2);
  const SWAP_AT = 0.5; // font switches when the eased progress passes this point

  // Geometry per slot (matches the CSS): top, line height, font size
  const TOP: Record<number, number> = { [-3]: -42, [-2]: 0, [-1]: 42, 0: 96, 1: 170, 2: 224, 3: 266 };
  const LH: Record<number, number> = { [-3]: 32, [-2]: 32, [-1]: 44, 0: 64, 1: 44, 2: 32, 3: 32 };
  const SIZE: Record<number, number> = { [-3]: 24, [-2]: 24, [-1]: 36, 0: 56, 1: 36, 2: 24, 3: 24 };
  const OPACITY = {
    left: { [-3]: 0, [-2]: 0.07, [-1]: 0.18, 0: 1, 1: 0.18, 2: 0.07, 3: 0 } as Record<number, number>,
    right: { [-3]: 0, [-2]: 0.1, [-1]: 0.25, 0: 1, 1: 0.25, 2: 0.1, 3: 0 } as Record<number, number>,
  };
  const centre = (s: number) => TOP[s] + LH[s] / 2;

  type Col = { el: HTMLElement; items: HTMLElement[]; en: string[]; zh: string[]; tag: HTMLElement; idx: number; step: (d: number) => void };

  const cols: Record<string, Col> = {};

  function sentence() {
    const l = cols.left, r = cols.right;
    live.textContent = `${l.zh[l.idx]}${r.zh[r.idx]} — ${l.en[l.idx]} ${r.en[r.idx]}`;
  }

  for (const side of ['left', 'right'] as const) {
    const el = slot.querySelector<HTMLElement>(`[data-col="${side}"]`)!;
    const tag = slot.querySelector<HTMLElement>(`[data-tag="${side}"]`)!;
    const items = [...el.querySelectorAll<HTMLElement>('.item')];
    const en: string[] = JSON.parse(el.dataset.en!);
    const zh: string[] = JSON.parse(el.dataset.zh!);
    const N = items.length; // 2 × list length
    const n = en.length;
    let pos = START; // index into the doubled list, kept in [0, N)

    // relative slot of item i for the current position, in [-N/2, N/2)
    const rel = (i: number) => {
      let s = (((i - pos) % N) + N) % N;
      if (s >= N / 2) s -= N;
      return s;
    };
    const clampSlot = (s: number) => Math.max(-3, Math.min(3, s));

    let anim = 0;
    let finish: (() => void) | null = null;

    function animate(prev: number[], next: number[]) {
      finish?.();
      const op = OPACITY[side];
      const moving = items
        .map((it, i) => ({ it, from: prev[i], to: next[i] }))
        .filter((m) => m.from !== m.to && Math.abs(m.from - m.to) <= 3);
      // items that wrap between the hidden ends jump straight there
      items.forEach((it, i) => {
        if (Math.abs(prev[i] - next[i]) > 3) it.dataset.s = String(next[i]);
      });
      const done = () => {
        cancelAnimationFrame(anim);
        for (const m of moving) {
          m.it.dataset.s = String(m.to);
          m.it.style.translate = m.it.style.scale = m.it.style.opacity = '';
        }
        finish = null;
      };
      if (reduce) return done();
      finish = done;
      const t0 = performance.now();
      const frame = (now: number) => {
        const t = Math.min(1, (now - t0) / DURATION);
        const e = easeOutBack(t);
        const fade = t * t * (3 - 2 * t); // opacity eases without overshoot
        for (const { it, from, to } of moving) {
          const s = e < SWAP_AT ? from : to;
          if (it.dataset.s !== String(s)) it.dataset.s = String(s);
          const c = centre(from) + (centre(to) - centre(from)) * e;
          const size = SIZE[from] + (SIZE[to] - SIZE[from]) * e;
          it.style.translate = `0 ${(c - LH[s] / 2).toFixed(2)}px`;
          it.style.scale = (size / SIZE[s]).toFixed(4);
          it.style.opacity = String(op[from] + (op[to] - op[from]) * fade);
        }
        if (t < 1) anim = requestAnimationFrame(frame);
        else done();
      };
      anim = requestAnimationFrame(frame);
    }

    function render(prev?: number[]) {
      const next = items.map((_, i) => clampSlot(rel(i)));
      if (prev) animate(prev, next);
      else items.forEach((it, i) => (it.dataset.s = String(next[i])));
      const mid = items[next.indexOf(0)];
      if (mid) {
        // column width follows the centre chunk so the tags have room
        el.style.width = `${measure(mid)}px`;
      }
      const k = pos % n;
      el.setAttribute('aria-valuetext', zh[k]);
      if (!prev) tag.dataset.text = en[k];
      else if (tag.dataset.text !== en[k]) typeTag(tag, en[k]);
    }

    // The English tag is cleared and typed in again once the new chunk has settled.
    function typeTag(t: HTMLElement, text: string) {
      t.dataset.text = text;
      clearTimeout(Number(t.dataset.timer));
      t.textContent = '';
      let i = 0;
      const tick = () => {
        if (t.dataset.text !== text) return;
        t.textContent = text.slice(0, ++i);
        if (i < text.length) t.dataset.timer = String(setTimeout(tick, 28));
      };
      t.dataset.timer = String(setTimeout(tick, reduce ? 0 : DURATION));
    }

    // width the item will have once it sits in the centre slot
    function measure(it: HTMLElement) {
      const probe = it.cloneNode(true) as HTMLElement;
      probe.style.cssText = 'position:absolute;visibility:hidden;translate:none;scale:none';
      probe.dataset.s = '0';
      el.appendChild(probe);
      const w = Math.ceil(probe.getBoundingClientRect().width);
      probe.remove();
      return w;
    }

    function step(d: number) {
      const prev = items.map((_, i) => clampSlot(rel(i)));
      pos = (((pos + d) % N) + N) % N;
      col.idx = pos % n;
      render(prev);
      sentence();
    }

    const col: Col = { el, items, en, zh, tag, idx: START % n, step };
    cols[side] = col;

    // One gesture = one step. A wheel/trackpad swipe moves exactly one item, then waits until the
    // gesture ends (no wheel events for a moment) before accepting the next.
    let wheelLocked = false;
    let wheelIdle = 0;
    el.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        if (!wheelLocked && Math.abs(e.deltaY) >= 4) {
          step(e.deltaY > 0 ? 1 : -1);
          wheelLocked = true;
        }
        clearTimeout(wheelIdle);
        wheelIdle = window.setTimeout(() => (wheelLocked = false), 220);
      },
      { passive: false },
    );

    // Drag: one step per drag.
    let dragY: number | null = null;
    let moved = false;
    el.addEventListener('pointerdown', (e) => {
      dragY = e.clientY;
      moved = false;
      el.setPointerCapture(e.pointerId);
    });
    el.addEventListener('pointermove', (e) => {
      if (dragY === null || moved) return;
      const dy = e.clientY - dragY;
      if (Math.abs(dy) >= 24) {
        step(dy < 0 ? 1 : -1);
        moved = true;
      }
    });
    const endDrag = () => {
      dragY = null;
    };
    el.addEventListener('pointerup', endDrag);
    el.addEventListener('pointercancel', endDrag);

    // Click: above the centre goes up one, below goes down one.
    el.addEventListener('click', (e) => {
      if (moved) return;
      const r = el.getBoundingClientRect();
      const centreTop = r.top + 96;
      const centreBottom = centreTop + 64;
      if (e.clientY < centreTop) step(-1);
      else if (e.clientY > centreBottom) step(1);
    });

    // keyboard
    el.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        step(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        step(-1);
      }
    });

    render();
  }

  // fonts change item widths: re-measure once they're in
  document.fonts?.ready.then(() => {
    cols.left.step(0);
    cols.right.step(0);
  });
</script>
