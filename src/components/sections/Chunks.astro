---
// Section 03 — Paper node 2C-0.
// Slot with two independent, infinite columns. Scroll (wheel/trackpad), drag, click a neighbour
// or use ↑/↓ on a focused column to spin it. The English tags follow the combination.
import Section from '../Section.astro';

const left = [
  { zh: '我走路去', en: 'I walk to' },
  { zh: '我坐出租车去', en: 'I take a taxi to' },
  { zh: '我坐地铁去', en: 'I take the subway to' },
  { zh: '我骑自行车去', en: 'I ride my bike to' },
  { zh: '我开车去', en: 'I drive to' },
];
const right = [
  { zh: '医院', en: 'the hospital' },
  { zh: '学校', en: 'school' },
  { zh: '公司', en: 'the office' },
  { zh: '机场', en: 'the airport' },
  { zh: '超市', en: 'the supermarket' },
];
const START = 2; // 我坐地铁去 + 公司, as in Paper

// Each list is rendered twice so the column can wrap around without items flying across.
const doubled = <T,>(a: T[]) => [...a, ...a];
---

<Section id="chunks" num="03" title="Chunks">
  <p class="prose">
    Grouping is only half of it. Every lesson also teaches chunks: short phrases and sentence patterns you can lift out
    and reuse in other situations.
  </p>
  <p class="prose">
    You see how the words work together, try them in your own translations, then meet them again in a dialogue. Words
    and chunks from earlier lessons come back in new contexts when they fit.
  </p>

  <div class="slot" data-slot data-start={START}>
    <div class="tag left pixel" data-tag="left" aria-hidden="true">{left[START].en}</div>

    <div
      class="col left"
      data-col="left"
      tabindex="0"
      role="spinbutton"
      aria-label="First half of the sentence"
      aria-valuetext={left[START].zh}
      data-en={JSON.stringify(left.map((x) => x.en))}
      data-zh={JSON.stringify(left.map((x) => x.zh))}
    >
      {doubled(left).map((x, i) => <span class="item" data-i={i}>{x.zh}</span>)}
    </div>

    <div
      class="col right"
      data-col="right"
      tabindex="0"
      role="spinbutton"
      aria-label="Second half of the sentence"
      aria-valuetext={right[START].zh}
      data-en={JSON.stringify(right.map((x) => x.en))}
      data-zh={JSON.stringify(right.map((x) => x.zh))}
    >
      {doubled(right).map((x, i) => <span class="item" data-i={i}>{x.zh}</span>)}
    </div>

    <div class="tag right pixel" data-tag="right" aria-hidden="true">{right[START].en}</div>

    <p class="sr-only" aria-live="polite" data-live></p>
  </div>
</Section>

<style>
  .slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-block: 32px;
    user-select: none;
    -webkit-user-select: none;
  }
  .tag {
    flex: 1 1 0;
    min-width: 0;
    font-size: 12px; /* Paper 14 → 12 */
    line-height: 18px;
    white-space: nowrap;
    transition: opacity 0.12s ease;
  }
  .tag.left {
    color: var(--text-dim);
  }
  .tag.right {
    color: var(--accent);
    text-align: right;
  }
  .tag.swap {
    opacity: 0;
  }

  /* Column: 5 visible slots (32 / 44 / 64 / 44 / 32 px, 10px gaps) = 256px tall */
  .col {
    position: relative;
    flex-shrink: 0;
    height: 256px;
    cursor: ns-resize;
    outline: none;
    transition: width 0.22s ease;
    touch-action: none;
  }
  .col.left {
    color: var(--text);
  }
  .col.right {
    color: var(--accent);
  }
  .col:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 8px;
  }

  .item {
    position: absolute;
    top: 0;
    white-space: pre;
    font-family: var(--f-pixel);
    font-weight: 500;
    font-size: 24px;
    line-height: 32px;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.22s ease,
      opacity 0.22s ease;
  }
  .col.left .item {
    right: 0;
  }
  .col.right .item {
    left: 0;
  }
  .item.no-anim {
    transition: none;
  }

  /* slot positions (set by data-s) */
  .item[data-s='-3'] {
    transform: translateY(-42px);
  }
  .item[data-s='-2'] {
    transform: translateY(0);
  }
  .item[data-s='-1'] {
    transform: translateY(42px);
    font-size: 36px;
    line-height: 44px;
  }
  .item[data-s='0'] {
    transform: translateY(96px);
    font-family: var(--f-brush);
    font-weight: 700;
    font-size: 56px;
    line-height: 64px;
    opacity: 1;
  }
  .item[data-s='1'] {
    transform: translateY(170px);
    font-size: 36px;
    line-height: 44px;
  }
  .item[data-s='2'] {
    transform: translateY(224px);
  }
  .item[data-s='3'] {
    transform: translateY(266px);
  }
  .item[data-s='-1'],
  .item[data-s='1'],
  .item[data-s='-2'],
  .item[data-s='2'] {
    pointer-events: auto;
    cursor: pointer;
  }
  .col.left .item[data-s='-1'],
  .col.left .item[data-s='1'] {
    opacity: 0.18;
  }
  .col.left .item[data-s='-2'],
  .col.left .item[data-s='2'] {
    opacity: 0.07;
  }
  .col.right .item[data-s='-1'],
  .col.right .item[data-s='1'] {
    opacity: 0.25;
  }
  .col.right .item[data-s='-2'],
  .col.right .item[data-s='2'] {
    opacity: 0.1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .item,
    .col,
    .tag {
      transition: none;
    }
  }
</style>

<script>
  const slot = document.querySelector<HTMLElement>('[data-slot]')!;
  const live = slot.querySelector<HTMLElement>('[data-live]')!;
  const START = Number(slot.dataset.start);
  const STEP_WHEEL = 40; // px of wheel delta per step
  const STEP_DRAG = 42; // px of drag per step
  const COOLDOWN = 140; // ms between wheel steps

  type Col = { el: HTMLElement; items: HTMLElement[]; en: string[]; zh: string[]; tag: HTMLElement; idx: number; step: (d: number) => void };

  const cols: Record<string, Col> = {};

  function sentence() {
    const l = cols.left, r = cols.right;
    live.textContent = `${l.zh[l.idx]}${r.zh[r.idx]} — ${l.en[l.idx]} ${r.en[r.idx]}`;
  }

  for (const side of ['left', 'right'] as const) {
    const el = slot.querySelector<HTMLElement>(`[data-col="${side}"]`)!;
    const tag = slot.querySelector<HTMLElement>(`[data-tag="${side}"]`)!;
    const items = [...el.querySelectorAll<HTMLElement>('.item')];
    const en: string[] = JSON.parse(el.dataset.en!);
    const zh: string[] = JSON.parse(el.dataset.zh!);
    const N = items.length; // 2 × list length
    const n = en.length;
    let pos = START; // index into the doubled list, kept in [0, N)

    // relative slot of item i for the current position, in [-N/2, N/2)
    const rel = (i: number) => {
      let s = (((i - pos) % N) + N) % N;
      if (s >= N / 2) s -= N;
      return s;
    };
    const clampSlot = (s: number) => Math.max(-3, Math.min(3, s));

    function render(prev?: number[]) {
      items.forEach((it, i) => {
        const s = clampSlot(rel(i));
        // an item that wraps from one hidden end to the other must not animate across
        if (prev && Math.abs(prev[i] - s) > 3) it.classList.add('no-anim');
        it.dataset.s = String(s);
      });
      requestAnimationFrame(() => items.forEach((it) => it.classList.remove('no-anim')));
      const centre = items.find((it) => it.dataset.s === '0');
      if (centre) {
        // column width follows the centre chunk so the tags have room
        el.style.width = `${measure(centre)}px`;
      }
      const k = pos % n;
      el.setAttribute('aria-valuetext', zh[k]);
      if (tag.textContent !== en[k]) {
        tag.classList.add('swap');
        setTimeout(() => {
          tag.textContent = en[k];
          tag.classList.remove('swap');
        }, 110);
      }
    }

    // width the item will have once it sits in the centre slot
    function measure(it: HTMLElement) {
      const probe = it.cloneNode(true) as HTMLElement;
      probe.style.cssText = 'position:absolute;visibility:hidden;transition:none;transform:none';
      probe.dataset.s = '0';
      el.appendChild(probe);
      const w = Math.ceil(probe.getBoundingClientRect().width);
      probe.remove();
      return w;
    }

    function step(d: number) {
      const prev = items.map((it) => Number(it.dataset.s));
      pos = (((pos + d) % N) + N) % N;
      col.idx = pos % n;
      render(prev);
      sentence();
    }

    const col: Col = { el, items, en, zh, tag, idx: START % n, step };
    cols[side] = col;

    // wheel / trackpad
    let acc = 0;
    let last = 0;
    el.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        acc += e.deltaY;
        const now = performance.now();
        if (Math.abs(acc) >= STEP_WHEEL && now - last > COOLDOWN) {
          step(acc > 0 ? 1 : -1);
          acc = 0;
          last = now;
        }
      },
      { passive: false },
    );

    // drag
    let dragY: number | null = null;
    el.addEventListener('pointerdown', (e) => {
      dragY = e.clientY;
      el.setPointerCapture(e.pointerId);
    });
    el.addEventListener('pointermove', (e) => {
      if (dragY === null) return;
      const dy = e.clientY - dragY;
      if (Math.abs(dy) >= STEP_DRAG) {
        step(dy < 0 ? 1 : -1);
        dragY = e.clientY;
        moved = true;
      }
    });
    let moved = false;
    const endDrag = () => {
      dragY = null;
      setTimeout(() => (moved = false), 0);
    };
    el.addEventListener('pointerup', endDrag);
    el.addEventListener('pointercancel', endDrag);

    // click a neighbour to bring it to the centre
    el.addEventListener('click', (e) => {
      if (moved) return;
      const it = (e.target as HTMLElement).closest<HTMLElement>('.item');
      if (!it) return;
      const s = Number(it.dataset.s);
      if (s && Math.abs(s) <= 2) step(s);
    });

    // keyboard
    el.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        step(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        step(-1);
      }
    });

    render();
  }

  // fonts change item widths: re-measure once they're in
  document.fonts?.ready.then(() => {
    cols.left.step(0);
    cols.right.step(0);
  });
</script>
