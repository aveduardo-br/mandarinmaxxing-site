---
// Section 03 — Paper "03 Chunks" (tiles). See docs/ladrilhos.md.
// A staircase of tiles: one chunk repeated on five steps, each with a different word in its slot.
// The orange tiles are the chunk (they stay), the coloured ones are the word that changes. Black
// labels give the English. Clicking the staircase moves to the next chunk: every tile flips in place,
// in a wave, and the steps grow or shrink. The small block on the right shows the chunk on its own,
// with the slot empty, and changes with it.
import Section from '../Section.astro';

// Every word here is in the HSK 1 list. The tiles use the pixel font: after changing a phrase,
// regenerate public/fonts/zpix-site.woff with scripts/subset-zpix.py.
const chunks = [
  {
    pre: '太',
    post: '了',
    label: 'So …!',
    words: [
      ['贵', 'expensive'],
      ['热', 'hot'],
      ['早', 'early'],
      ['好吃', 'delicious'],
      ['漂亮', 'pretty'],
    ],
  },
  {
    pre: '我想',
    post: '一下',
    label: 'I’d like to …',
    words: [
      ['看', 'have a look'],
      ['问', 'ask something'],
      ['找', 'look for it'],
      ['听', 'have a listen'],
      ['休息', 'rest a bit'],
    ],
  },
  {
    pre: '你什么时候',
    post: '',
    label: 'When do you …?',
    words: [
      ['来', 'come'],
      ['下班', 'get off work'],
      ['回家', 'go home'],
      ['起床', 'get up'],
      ['睡觉', 'go to bed'],
    ],
  },
];
---

<Section id="chunks" num="03" title="Chunks">
  <p class="prose">
    Words are only half of it. Every lesson also teaches chunks: short phrases you can lift out and reuse in another
    situation, with one word swapped.
  </p>

  <div class="viz" data-chunks={JSON.stringify(chunks)}>
    <div class="fit" data-fit>
      <div class="stage" data-stage role="button" tabindex="0" aria-label="Show the next chunk"></div>
    </div>
    <div class="legend" aria-hidden="true">
      <div class="tile-label">The chunk</div>
      <div class="lrow" data-legend></div>
      <p>It <b>stays the same</b>. Only the word in the slot changes.</p>
    </div>
    <p class="sr-only" aria-live="polite" data-live>
      {chunks[0].label} {chunks[0].words.map((w) => `${chunks[0].pre}${w[0]}${chunks[0].post} (${w[1]})`).join(', ')}
    </p>
  </div>

  <p class="prose after">
    You see how the words work together, use them in your own translations, then meet them again in the text that
    closes the lesson. Chunks from earlier lessons come back later, in new sentences.
  </p>
</Section>

<style>
  .viz {
    position: relative;
    margin-top: 40px;
  }
  /* 20px of room above the tiles for the label that sits on the first step */
  .fit {
    height: 160px;
    padding-top: 20px;
    margin-top: -20px;
    overflow: hidden;
  }
  .stage {
    position: relative;
    width: 680px;
    height: 140px;
    transform-origin: 0 0;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .stage:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
  .stage :global(.tile-tag) {
    position: absolute;
    transition: opacity 0.12s linear;
  }

  .legend {
    position: absolute;
    left: 512px;
    top: 0;
    width: 168px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lrow {
    display: flex;
    height: 28px;
  }
  .legend p {
    font-size: 15px;
    line-height: 22px;
    color: var(--text-80);
  }
  .legend b {
    font-weight: 500;
    color: var(--text);
  }

  .after {
    margin-top: 40px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .legend {
      position: static;
      width: auto;
      margin-top: 28px;
    }
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, reduceMotion, TILE, ORANGE, MUTED, WAVE, FLIP } from '../../scripts/tiles';
  import type { Slot, TileVal } from '../../scripts/tiles';

  type Chunk = { pre: string; post: string; label: string; words: [string, string][] };

  const viz = document.querySelector<HTMLElement>('[data-chunks]');
  if (viz) {
    const chunks: Chunk[] = JSON.parse(viz.dataset.chunks!);
    const stage = viz.querySelector<HTMLElement>('[data-stage]')!;
    const fit = viz.querySelector<HTMLElement>('[data-fit]')!;
    const legendRow = viz.querySelector<HTMLElement>('[data-legend]')!;
    const live = viz.querySelector<HTMLElement>('[data-live]')!;
    const ROWS = 5;
    const MAXC = Math.max(...chunks.flatMap((c) => c.words.map((w) => [...c.pre, ...w[0], ...c.post].length)));
    const LEGEND = Math.max(...chunks.map((c) => [...c.pre, ...c.post].length + 1));

    // every step keeps its left edge in all chunks, so the tiles only ever change in place
    const rowsOf = (k: number): TileVal[][] => {
      const c = chunks[k];
      return c.words.map((w, r) => [
        ...[...c.pre].map((ch) => ({ ch, bg: ORANGE })),
        ...[...w[0]].map((ch) => ({ ch, bg: MUTED[r % MUTED.length] })),
        ...[...c.post].map((ch) => ({ ch, bg: ORANGE })),
      ]);
    };
    const legendOf = (k: number): TileVal[] => {
      const c = chunks[k];
      return [
        ...[...c.pre].map((ch) => ({ ch, bg: ORANGE })),
        { ch: '', bg: '#1E1E1E' },
        ...[...c.post].map((ch) => ({ ch, bg: ORANGE })),
      ];
    };

    const slots: Slot[][] = [];
    const tips: HTMLElement[] = [];
    for (let r = 0; r < ROWS; r++) {
      slots.push([]);
      for (let c = 0; c < MAXC; c++) {
        const slot = makeSlot(stage, 'abs');
        slot.el.style.left = `${(2 * r + c) * TILE}px`;
        slot.el.style.top = `${r * TILE}px`;
        slots[r].push(slot);
      }
      const tip = document.createElement('div');
      tip.className = 'tile-tag';
      tip.style.top = `${r * TILE + 4}px`;
      stage.appendChild(tip);
      tips.push(tip);
    }
    const startTag = document.createElement('div');
    startTag.className = 'tile-tag';
    startTag.style.left = '0px';
    startTag.style.top = '-20px';
    stage.appendChild(startTag);
    const legendSlots: Slot[] = Array.from({ length: LEGEND }, () => makeSlot(legendRow));

    const setTip = (r: number, k: number, len: number) => {
      tips[r].textContent = chunks[k].words[r][1];
      tips[r].style.left = `${(2 * r + len) * TILE}px`;
    };

    let cur = 0;
    let busy = false;

    function render(k: number) {
      const rows = rowsOf(k);
      rows.forEach((row, r) => {
        slots[r].forEach((slot, c) => applyTile(slot, row[c] ?? null));
        setTip(r, k, row.length);
        tips[r].style.opacity = '1';
      });
      startTag.textContent = chunks[k].label;
      const lr = legendOf(k);
      legendSlots.forEach((slot, i) => applyTile(slot, lr[i] ?? null));
    }

    function go(k: number) {
      if (busy || k === cur) return;
      cur = k;
      const c = chunks[k];
      live.textContent = `${c.label} ${c.words.map((w) => `${c.pre}${w[0]}${c.post} (${w[1]})`).join(', ')}`;
      if (reduceMotion()) return render(k);
      busy = true;
      const rows = rowsOf(k);
      let last = 0;
      startTag.style.opacity = '0';
      window.setTimeout(() => {
        startTag.textContent = c.label;
        startTag.style.opacity = '1';
      }, 130);
      rows.forEach((row, r) => {
        tips[r].style.opacity = '0';
        let rowEnd = 0;
        slots[r].forEach((slot, col) => {
          const v = row[col] ?? null;
          if (!slot.val && !v) return;
          const d = (2 * r + col) * WAVE;
          rowEnd = Math.max(rowEnd, d);
          flipTile(slot, v, d);
        });
        window.setTimeout(() => {
          setTip(r, k, row.length);
          tips[r].style.opacity = '1';
        }, rowEnd + FLIP * 0.6);
        last = Math.max(last, rowEnd + FLIP);
      });
      const lr = legendOf(k);
      legendSlots.forEach((slot, i) => flipTile(slot, lr[i] ?? null, 120 + i * WAVE));
      window.setTimeout(() => (busy = false), last + 40);
    }

    const next = () => go((cur + 1) % chunks.length);
    stage.addEventListener('click', next);
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        next();
      }
    });

    // on narrow screens the staircase scales down to fit the column
    const fitStage = () => {
      const s = Math.min(1, fit.clientWidth / 560);
      stage.style.transform = s < 1 ? `scale(${s})` : '';
      fit.style.height = `${140 * s + 20}px`;
    };
    addEventListener('resize', fitStage);
    fitStage();
    render(0);
  }
</script>
