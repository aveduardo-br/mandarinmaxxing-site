---
// Section 03 — Paper "03 Chunks" (tiles). See docs/ladrilhos.md.
// A staircase of tiles: one chunk repeated on five steps, each with a different word in its slot.
// The orange tiles are the chunk (they stay), the coloured ones are the word that changes. Black
// labels give the English. The first step is the chunk itself, in orange, with an empty slot and a
// black label with its meaning on top. On the steps below the chunk turns grey and only the word
// that enters the slot is in colour. Clicking the staircase moves to the next chunk: every tile flips
// in place, in a wave, and the steps grow or shrink.
import Section from '../Section.astro';

// Every word here is in the HSK 1 list. The tiles use the pixel font: after changing a phrase,
// regenerate public/fonts/zpix-site.woff with scripts/subset-zpix.py.
const chunks = [
  {
    pre: '太',
    post: '了',
    label: 'So …!',
    words: [
      ['贵', 'expensive'],
      ['热', 'hot'],
      ['早', 'early'],
      ['好吃', 'delicious'],
      ['漂亮', 'pretty'],
    ],
  },
  {
    pre: '我想',
    post: '一下',
    label: 'I’d like to …',
    words: [
      ['看', 'have a look'],
      ['问', 'ask something'],
      ['找', 'look for it'],
      ['听', 'have a listen'],
      ['休息', 'rest a bit'],
    ],
  },
  {
    pre: '你什么时候',
    post: '',
    label: 'When do you …?',
    words: [
      ['来', 'come'],
      ['下班', 'get off work'],
      ['回家', 'go home'],
      ['起床', 'get up'],
      ['睡觉', 'go to bed'],
    ],
  },
];
---

<Section id="chunks" num="03" title="Chunks" tiled>
  <p class="prose">
    Words are only half of it. Every lesson also teaches chunks: short phrases you can lift out and reuse in another
    situation, with one word swapped.
  </p>

  <div class="viz" data-chunks={JSON.stringify(chunks)}>
    <div class="fit" data-fit>
      <div class="stage" data-stage role="button" tabindex="0" aria-label="Show the next chunk"></div>
    </div>
    <p class="sr-only" aria-live="polite" data-live>
      {chunks[0].label} {chunks[0].words.map((w) => `${chunks[0].pre}${w[0]}${chunks[0].post} (${w[1]})`).join(', ')}
    </p>
  </div>

  <p class="prose after">
    You see how the words work together, use them in your own translations, then meet them again in the text that
    closes the lesson. Chunks from earlier lessons come back later, in new sentences.
  </p>
</Section>

<style>
  .viz {
    position: relative;
    margin-top: 40px;
  }
  /* 20px of room above the tiles for the label on the first step (the chunk) */
  .fit {
    height: 188px;
    padding-top: 20px;
    overflow: hidden;
  }
  .stage {
    position: relative;
    width: 680px;
    height: 168px;
    transform-origin: 0 0;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .stage:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
  .stage :global(.tile-tag) {
    position: absolute;
    transition: opacity 0.12s linear;
  }

  .after {
    margin-top: 40px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

</style>

<script>
  import { makeSlot, applyTile, flipTile, reduceMotion, TILE, ORANGE, MUTED, DIM, WAVE, FLIP } from '../../scripts/tiles';
  import type { Slot, TileVal } from '../../scripts/tiles';

  type Chunk = { pre: string; post: string; label: string; words: [string, string][] };

  const viz = document.querySelector<HTMLElement>('[data-chunks]');
  if (viz) {
    const chunks: Chunk[] = JSON.parse(viz.dataset.chunks!);
    const stage = viz.querySelector<HTMLElement>('[data-stage]')!;
    const fit = viz.querySelector<HTMLElement>('[data-fit]')!;
    const live = viz.querySelector<HTMLElement>('[data-live]')!;
    const WORDS = 5;
    const ROWS = WORDS + 1; // the chunk itself, then one step per word
    const MAXC = Math.max(...chunks.flatMap((c) => c.words.map((w) => [...c.pre, ...w[0], ...c.post].length)));
    const GREY: TileVal = { ch: '', ...DIM };

    // each step starts 2 tiles further right; on a narrow column only half a tile, so it fits
    let STEP = 2 * TILE;
    // row 0: the chunk in orange with an empty slot; rows 1-5: the chunk in grey, the word in colour.
    // Every step keeps its left edge in all chunks, so the tiles only ever change in place.
    const rowsOf = (k: number): TileVal[][] => {
      const c = chunks[k];
      const grey = (ch: string): TileVal => ({ ...GREY!, ch });
      return [
        [...[...c.pre].map((ch) => ({ ch, bg: ORANGE })), { ch: '', bg: '#1E1E1E' }, ...[...c.post].map((ch) => ({ ch, bg: ORANGE }))],
        ...c.words.map((w, r) => [
          ...[...c.pre].map(grey),
          ...[...w[0]].map((ch) => ({ ch, bg: MUTED[r % MUTED.length] })),
          ...[...c.post].map(grey),
        ]),
      ];
    };
    const tipOf = (k: number, r: number) => (r === 0 ? '' : chunks[k].words[r - 1][1]);

    const slots: Slot[][] = [];
    const tips: HTMLElement[] = [];
    for (let r = 0; r < ROWS; r++) {
      slots.push([]);
      for (let c = 0; c < MAXC; c++) {
        const slot = makeSlot(stage, 'abs');
        slot.el.style.top = `${r * TILE}px`;
        slots[r].push(slot);
      }
      const tip = document.createElement('div');
      tip.className = 'tile-tag';
      if (r === 0) tip.hidden = true; // the chunk's row needs no label beside it: its meaning is on top
      tip.style.top = `${r * TILE + 4}px`;
      stage.appendChild(tip);
      tips.push(tip);
    }
    // the chunk's meaning, on top of the first step
    const startTag = document.createElement('div');
    startTag.className = 'tile-tag';
    startTag.style.left = '0px';
    startTag.style.top = '-20px';
    stage.appendChild(startTag);

    const lens: number[] = Array(ROWS).fill(0);
    const setTip = (r: number, k: number, len: number) => {
      lens[r] = len;
      tips[r].textContent = tipOf(k, r);
      tips[r].style.left = `${r * STEP + len * TILE}px`;
    };
    const place = () => {
      slots.forEach((row, r) => row.forEach((slot, c) => (slot.el.style.left = `${r * STEP + c * TILE}px`)));
      tips.forEach((tip, r) => (tip.style.left = `${r * STEP + lens[r] * TILE}px`));
    };

    let cur = 0;
    let busy = false;

    function render(k: number) {
      rowsOf(k).forEach((row, r) => {
        slots[r].forEach((slot, c) => applyTile(slot, row[c] ?? null));
        setTip(r, k, row.length);
        tips[r].style.opacity = '1';
      });
      startTag.textContent = `The chunk · ${chunks[k].label}`;
    }

    function go(k: number) {
      if (busy || k === cur) return;
      cur = k;
      const c = chunks[k];
      live.textContent = `${c.label} ${c.words.map((w) => `${c.pre}${w[0]}${c.post} (${w[1]})`).join(', ')}`;
      if (reduceMotion()) return render(k);
      busy = true;
      let last = 0;
      startTag.style.opacity = '0';
      window.setTimeout(() => {
        startTag.textContent = `The chunk · ${c.label}`;
        startTag.style.opacity = '1';
      }, 130);
      rowsOf(k).forEach((row, r) => {
        tips[r].style.opacity = '0';
        let rowEnd = 0;
        slots[r].forEach((slot, col) => {
          const v = row[col] ?? null;
          if (!slot.val && !v) return;
          const d = (2 * r + col) * WAVE;
          rowEnd = Math.max(rowEnd, d);
          flipTile(slot, v, d);
        });
        window.setTimeout(() => {
          setTip(r, k, row.length);
          tips[r].style.opacity = '1';
        }, rowEnd + FLIP * 0.6);
        last = Math.max(last, rowEnd + FLIP);
      });
      window.setTimeout(() => (busy = false), last + 40);
    }

    const next = () => go((cur + 1) % chunks.length);
    stage.addEventListener('click', next);
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        next();
      }
    });

    // on a narrow column the steps get shorter (half a tile); if it still doesn't fit, it scales down
    const fitStage = () => {
      const w = fit.clientWidth;
      STEP = w >= 560 ? 2 * TILE : TILE / 2;
      place();
      const need = (ROWS - 1) * STEP + MAXC * TILE + 120;
      const s = Math.min(1, w / need);
      stage.style.transform = s < 1 ? `scale(${s})` : '';
      fit.style.height = `${(ROWS * TILE + 20) * s + 20 * (1 - s)}px`;
    };
    addEventListener('resize', fitStage);
    fitStage();
    render(0);
  }
</script>
