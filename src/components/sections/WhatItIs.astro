---
import Section from '../Section.astro';
---

<Section id="what-it-is" num="01" title="What it is" tiled>
  <p class="prose">
    mandarinmaxxing is a skill for Claude. It turns the chat into a tutor for the HSK vocabulary, the official word list
    of the Chinese proficiency test. Each lesson it gives you a few new words, asks you to translate, and corrects
    you. It remembers where you stopped.
  </p>

  <div class="belt">
    <div class="heads">
      <span class="tile-tag">The official list</span>
      <span class="tile-tag mm">mandarinmaxxing</span>
    </div>
    <div class="crop">
      <div class="board" data-belt aria-hidden="true"></div>
    </div>
    <p class="note">The official list, regrouped into situations.</p>
  </div>

  <p class="prose">
    It isn’t a complete method. It’s a guide to what to study next, like an HSK textbook, with the same official words
    in a different order.
  </p>
</Section>

<style>
  .belt {
    margin: 32px 0;
  }
  .heads {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .mm {
    background: #d2430e;
    color: #0e0e0e;
  }
  /* The belt reaches past the column on both sides (up to 120 px, never under the side nav). There is
     no fade: tiles flip in on the left and flip out on the right, each row at its own point, and that
     point wanders a little, so both ends are ragged. The board is at least 680 px wide; on a narrow
     screen it is cropped evenly on both sides, so the sorting in the middle stays in view. */
  .crop {
    --ext: clamp(0px, (100vw - 100%) / 2 - 330px, 120px);
    width: calc(100% + 2 * var(--ext));
    margin-left: calc(-1 * var(--ext));
    overflow: hidden;
  }
  @media (max-width: 1180px) {
    /* no side nav here: the belt can use the margins */
    .crop {
      --ext: clamp(0px, (100vw - 100%) / 2 - 16px, 120px);
    }
  }
  .board {
    position: relative;
    width: max(100%, 680px);
    height: 140px;
    margin-left: min(0px, calc(50% - 340px));
    overflow: hidden;
  }
  .board :global(.tile) {
    left: 0;
    top: 0;
    will-change: transform;
  }
  .note {
    margin-top: 14px;
    font-size: var(--fs-caption);
    line-height: 20px;
    color: var(--muted);
  }
</style>

<script>
  import { makeSlot, ORANGE, MUTED, TILE as C, reduceMotion } from '../../scripts/tiles';

  // The first five lessons of HSK 1: word, lesson, position in the official list.
  const RAW =
    '你好:1:146 再见:1:270 谢谢:1:240 不客气:1:13 对不起:1:44 没关系:1:119 您:1:149 好:1:70 没事:1:120 ' +
    '我:2:220 要:2:251 水:2:191 茶:2:16 你:2:145 吗:2:114 不:2:12 喝:2:76 吃:2:20 饭:2:49 请:2:164 想:2:232 喜欢:2:224 做:2:298 ' +
    '叫:3:90 什么:3:181 名字:3:127 请问:3:165 是:3:187 他:3:199 她:3:203 谁:3:180 也:3:252 ' +
    '中国:4:288 人:4:169 在:4:271 哪:4:130 国:4:65 哪儿:4:133 去:4:166 说:4:195 中文:4:289 今天:4:93 明天:4:129 昨天:4:296 会:4:81 汉语:4:68 ' +
    '这:5:278 那:5:135 朋友:5:155 的:5:29 认识:5:170 很:5:78 高兴:5:56 先生:5:230 女士:5:154 呢:5:143 我们:5:221 你们:5:147 们:5:123 他们:5:200 她们:5:204 都:5:40';
  type Word = { w: string; l: number; o: number };
  type Item = { w: Word; el: HTMLElement; y: number; py: number; state: 0 | 1 | 2 }; // 0 not in yet, 1 showing, 2 gone
  type Col = { x: number; px: number; items: Item[] }; // one item per lesson

  const B = document.querySelector<HTMLElement>('[data-belt]');
  if (B) {
    const WORDS: Word[] = RAW.split(' ').map((s) => {
      const [w, l, o] = s.split(':');
      return { w, l: +l, o: +o };
    });
    const COLORS = [ORANGE, ...MUTED]; // one colour per lesson
    const reduce = reduceMotion();
    const ROWS = 5, TICK = 650;
    const byLesson = Array.from({ length: ROWS }, (_, i) => WORDS.filter((w) => w.l === i + 1));

    // The belt is made of columns. Each column that comes in from the left holds exactly one word of
    // each of the five lessons, in a shuffled order, so the left side is fully mixed. In the sorting
    // zone (five columns in the middle) neighbours in a column swap when they are out of order, one
    // round per beat (odd-even transposition sort: five rounds always sort five tiles). Past the zone
    // every column reads lesson 1 to 5 from top to bottom, so the rows on the right are full and clean.
    // There are no empty columns: the belt is solid from end to end.
    let BC = 25, ZS = 10, ZE = 15, OX = -10;
    // Where each row starts and ends. A tile shows from column inAt[row] on and is gone past column
    // outAt[row]. Both wander by at most one column a beat, inside a band of JIT columns next to the
    // visible edge, so the two ends are never a straight line and never the same twice. A step of one
    // column can only delay a tile or bring two in (or out) together: the belt between the two ends
    // stays solid, and nothing ever stops.
    let L0 = 1, R0 = 23, JIT = 3;
    let inAt: number[] = [], outAt: number[] = [];
    let quiet = false; // true while the belt is laid out before the first frame: no flips
    const rnd = (n: number) => Math.floor(Math.random() * (n + 1));
    const size = () => {
      const w = B.clientWidth;
      BC = Math.max(25, Math.ceil(w / C));
      const mid = Math.floor(BC / 2);
      ZS = mid - 3;
      ZE = ZS + ROWS;
      OX = (w - BC * C) / 2; // centred: the same crop on both sides
      // the columns that are whole inside the crop (a tile glides from column x - 1 to x over a beat)
      const b = B.getBoundingClientRect(), c = B.parentElement!.getBoundingClientRect();
      const first = Math.max(0, Math.ceil((c.left - b.left - OX) / C));
      const lastCol = Math.min(BC - 1, Math.floor((c.right - b.left - OX) / C) - 1);
      JIT = lastCol - first < 18 ? 2 : 3;
      L0 = first + 1;
      R0 = lastCol - 1;
      inAt = Array.from({ length: ROWS }, () => L0 + rnd(JIT));
      outAt = Array.from({ length: ROWS }, () => R0 - rnd(JIT));
    };
    size();
    const wander = () => {
      for (let r = 0; r < ROWS; r++) {
        if (Math.random() < 0.4) inAt[r] = Math.min(L0 + JIT, Math.max(L0, inAt[r] + (Math.random() < 0.5 ? -1 : 1)));
        if (Math.random() < 0.4) outAt[r] = Math.min(R0, Math.max(R0 - JIT, outAt[r] + (Math.random() < 0.5 ? -1 : 1)));
      }
    };
    // The tile opens and closes like a flap, on `scale` so it rides on top of the glide. Here it is slow
    // and smooth (not the stepped flap of the other tiles), so it reads clearly on a moving belt.
    const FLAP = 380;
    const flap = (o: Item, show: boolean) => {
      const el = o.el;
      o.state = show ? 1 : 2;
      if (quiet || reduce) { el.style.visibility = show ? 'visible' : 'hidden'; return; }
      const delay = Math.random() * TICK * 0.5; // not on the beat
      if (show) {
        window.setTimeout(() => {
          el.style.visibility = 'visible';
          el.animate([{ scale: '1 0' }, { scale: '1 1' }], { duration: FLAP, easing: 'cubic-bezier(.2,.7,.2,1)' });
        }, delay);
      } else {
        const a = el.animate([{ scale: '1 1' }, { scale: '1 0' }], { duration: FLAP, easing: 'cubic-bezier(.6,0,.8,.3)', delay, fill: 'forwards' });
        a.onfinish = () => { el.style.visibility = 'hidden'; a.cancel(); };
      }
    };
    let cols: Col[] = [];
    let timer: number | null = null;
    let last: number[] = [];

    const mk = (w: Word) => {
      const slot = makeSlot(B, 'abs');
      slot.span.textContent = w.w[0];
      slot.el.style.backgroundColor = COLORS[w.l - 1];
      slot.el.style.visibility = 'hidden'; // it flips in when it reaches its row's starting point
      return slot.el;
    };
    // each lesson deals its words like a shuffled deck: every word shows once before any repeats, and
    // the same character never comes twice in a row on its row (some words share a first character)
    const decks: Word[][] = Array.from({ length: ROWS }, () => []);
    const lastCh: string[] = Array(ROWS).fill('');
    const pick = (l: number): Word => {
      if (!decks[l].length) decks[l] = [...byLesson[l]].sort(() => Math.random() - 0.5);
      let i = decks[l].findIndex((w) => w.w[0] !== lastCh[l]);
      if (i < 0) i = 0;
      const [w] = decks[l].splice(i, 1);
      lastCh[l] = w.w[0];
      return w;
    };
    // a shuffled order of the five lessons, with no lesson on the same row as in the previous column
    const shuffle = () => {
      let order: number[] = [];
      for (let t = 0; t < 30; t++) {
        order = [0, 1, 2, 3, 4].sort(() => Math.random() - 0.5);
        if (!order.some((l, r) => l === last[r])) break;
      }
      last = order;
      return order;
    };

    // x glides linearly over a whole beat; a row change rides on top with its own ease-in-out
    const place = (c: Col, o: Item) => {
      const el = o.el;
      el.style.translate = `${c.x * C + OX}px 0px`;
      el.style.transform = `translate(0px,${o.y * C}px)`;
      // `scale` is applied before `transform`, so its origin has to sit on the tile's own centre in its
      // row; otherwise the flap would grow down from the top of the board
      el.style.transformOrigin = `${C / 2}px ${o.y * C + C / 2}px`;
      if (!reduce) {
        el.animate([{ translate: `${c.px * C + OX}px 0px` }, { translate: `${c.x * C + OX}px 0px` }], { duration: TICK, easing: 'linear' });
        if (o.py !== o.y)
          el.animate([{ transform: `translate(0px,${o.py * C}px)` }, { transform: `translate(0px,${o.y * C}px)` }], { duration: TICK * 0.9, easing: 'cubic-bezier(.65,0,.35,1)' });
      }
      o.py = o.y;
    };

    const tick = () => {
      // move every column one cell to the right; drop the ones that left the board
      cols = cols.filter((c) => {
        c.px = c.x;
        c.x++;
        if (c.x > BC) { c.items.forEach((o) => o.el.remove()); return false; }
        return true;
      });
      // sorting zone: one round of neighbour swaps, alternating pairs (0-1, 2-3) and (1-2, 3-4)
      for (const c of cols) {
        if (c.x < ZS || c.x >= ZE || !c.items.length) continue;
        const rows = [...c.items].sort((a, b) => a.y - b.y);
        for (let r = (c.x - ZS) % 2; r + 1 < ROWS; r += 2) {
          const a = rows[r], b = rows[r + 1];
          if (a.w.l > b.w.l) {
            a.y = r + 1;
            b.y = r;
            rows[r] = b;
            rows[r + 1] = a;
          }
        }
      }
      // a new full column on the left
      const c: Col = { x: 0, px: -1, items: [] };
      c.items = shuffle().map((l, y) => {
        const w = pick(l);
        return { w, el: mk(w), y, py: y, state: 0 as const };
      });
      cols.push(c);
      wander();
      for (const col of cols)
        for (const o of col.items) {
          place(col, o);
          if (o.state === 0 && col.x >= inAt[o.y]) flap(o, true);
          else if (o.state === 1 && col.x > outAt[o.y]) flap(o, false);
        }
    };

    // start with the belt already full
    const fill = () => {
      quiet = true;
      for (let i = 0; i < BC + 2; i++) tick();
      quiet = false;
    };
    fill();
    const start = () => { if (!timer && !reduce) timer = window.setInterval(tick, TICK); };
    const stop = () => { if (timer) clearInterval(timer); timer = null; };
    // always running, wherever the page is scrolled; it only rests while the tab is in the background
    start();
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    // a wider or narrower belt: start over with the new number of columns
    let lastW = B.clientWidth;
    new ResizeObserver(() => {
      const w = B.clientWidth;
      if (Math.abs(w - lastW) < C) return;
      lastW = w;
      cols.forEach((col) => col.items.forEach((o) => o.el.remove()));
      cols = [];
      last = [];
      size();
      fill();
    }).observe(B);
  }
</script>
