---
import Section from '../Section.astro';
---

<Section id="what-it-is" num="01" title="What it is" tiled>
  <p class="prose">
    mandarinmaxxing is a skill for Claude. It turns the chat into a tutor that takes you through the HSK vocabulary one
    lesson at a time: new words, sentences to translate, corrections. It remembers where you stopped.
  </p>

  <div class="belt">
    <div class="heads">
      <span class="tile-tag">The official list</span>
      <span class="tile-tag mm">mandarinmaxxing</span>
    </div>
    <div class="crop">
      <div class="board" data-belt aria-hidden="true"></div>
    </div>
    <p class="note">The official list, regrouped into lessons.</p>
  </div>

  <p class="prose">
    It isn’t a complete method. It’s a guide to what to study next, like an HSK textbook, with the same official words
    in a different order.
  </p>
</Section>

<style>
  .belt {
    margin: 32px 0;
  }
  .heads {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .mm {
    background: #d2430e;
    color: #0e0e0e;
  }
  /* The belt reaches past the column on both sides (up to 120 px, never under the side nav) and fades
     out at both ends, so it reads as endless. The board is at least 680 px wide; on a narrow screen
     it is cropped evenly on both sides, so the sorting in the middle stays in view. */
  .crop {
    --ext: clamp(0px, (100vw - 100%) / 2 - 330px, 120px);
    --fade: calc(var(--ext) + 72px);
    width: calc(100% + 2 * var(--ext));
    margin-left: calc(-1 * var(--ext));
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
    mask-image: linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
  }
  @media (max-width: 1180px) {
    /* no side nav here: the belt can use the margins */
    .crop {
      --ext: clamp(0px, (100vw - 100%) / 2 - 16px, 120px);
    }
  }
  .board {
    position: relative;
    width: max(100%, 680px);
    height: 140px;
    margin-left: min(0px, calc(50% - 340px));
    overflow: hidden;
  }
  .board :global(.tile) {
    left: 0;
    top: 0;
    visibility: visible;
    will-change: transform;
  }
  .note {
    margin-top: 14px;
    font-size: var(--fs-caption);
    line-height: 20px;
    color: var(--muted);
  }
</style>

<script>
  import { makeSlot, ORANGE, MUTED, TILE as C, reduceMotion } from '../../scripts/tiles';

  // The first five lessons of HSK 1: word, lesson, position in the official list.
  const RAW =
    '你好:1:146 再见:1:270 谢谢:1:240 不客气:1:13 对不起:1:44 没关系:1:119 您:1:149 好:1:70 没事:1:120 ' +
    '我:2:220 要:2:251 水:2:191 茶:2:16 你:2:145 吗:2:114 不:2:12 喝:2:76 吃:2:20 饭:2:49 请:2:164 想:2:232 喜欢:2:224 做:2:298 ' +
    '叫:3:90 什么:3:181 名字:3:127 请问:3:165 是:3:187 他:3:199 她:3:203 谁:3:180 也:3:252 ' +
    '中国:4:288 人:4:169 在:4:271 哪:4:130 国:4:65 哪儿:4:133 去:4:166 说:4:195 中文:4:289 今天:4:93 明天:4:129 昨天:4:296 会:4:81 汉语:4:68 ' +
    '这:5:278 那:5:135 朋友:5:155 的:5:29 认识:5:170 很:5:78 高兴:5:56 先生:5:230 女士:5:154 呢:5:143 我们:5:221 你们:5:147 们:5:123 他们:5:200 她们:5:204 都:5:40';
  type Word = { w: string; l: number; o: number };
  type Item = { w: Word; el: HTMLElement; y: number; py: number };
  type Col = { x: number; px: number; items: Item[] }; // one item per lesson

  const B = document.querySelector<HTMLElement>('[data-belt]');
  if (B) {
    const WORDS: Word[] = RAW.split(' ').map((s) => {
      const [w, l, o] = s.split(':');
      return { w, l: +l, o: +o };
    });
    const COLORS = [ORANGE, ...MUTED]; // one colour per lesson
    const reduce = reduceMotion();
    const ROWS = 5, TICK = 650;
    const byLesson = Array.from({ length: ROWS }, (_, i) => WORDS.filter((w) => w.l === i + 1));

    // The belt is made of columns. Each column that comes in from the left holds exactly one word of
    // each of the five lessons, in a shuffled order, so the left side is fully mixed. In the sorting
    // zone (five columns in the middle) neighbours in a column swap when they are out of order, one
    // round per beat (odd-even transposition sort: five rounds always sort five tiles). Past the zone
    // every column reads lesson 1 to 5 from top to bottom, so the rows on the right are full and clean.
    // There are no empty columns: the belt is solid from end to end.
    let BC = 25, ZS = 10, ZE = 15, OX = -10;
    const size = () => {
      const w = B.clientWidth;
      BC = Math.max(25, Math.ceil(w / C));
      const mid = Math.floor(BC / 2);
      ZS = mid - 3;
      ZE = ZS + ROWS;
      OX = (w - BC * C) / 2; // centred: the same crop on both sides
    };
    size();
    let cols: Col[] = [];
    let timer: number | null = null;
    let last: number[] = [];

    const mk = (w: Word) => {
      const slot = makeSlot(B, 'abs');
      slot.span.textContent = w.w[0];
      slot.el.style.backgroundColor = COLORS[w.l - 1];
      return slot.el;
    };
    const pick = (l: number) => byLesson[l][(Math.random() * byLesson[l].length) | 0];
    // a shuffled order of the five lessons, with no lesson on the same row as in the previous column
    const shuffle = () => {
      let order: number[] = [];
      for (let t = 0; t < 30; t++) {
        order = [0, 1, 2, 3, 4].sort(() => Math.random() - 0.5);
        if (!order.some((l, r) => l === last[r])) break;
      }
      last = order;
      return order;
    };

    // x glides linearly over a whole beat; a row change rides on top with its own ease-in-out
    const place = (c: Col, o: Item) => {
      const el = o.el;
      el.style.translate = `${c.x * C + OX}px 0px`;
      el.style.transform = `translate(0px,${o.y * C}px)`;
      if (!reduce) {
        el.animate([{ translate: `${c.px * C + OX}px 0px` }, { translate: `${c.x * C + OX}px 0px` }], { duration: TICK, easing: 'linear' });
        if (o.py !== o.y)
          el.animate([{ transform: `translate(0px,${o.py * C}px)` }, { transform: `translate(0px,${o.y * C}px)` }], { duration: TICK * 0.9, easing: 'cubic-bezier(.65,0,.35,1)' });
      }
      o.py = o.y;
    };

    const tick = () => {
      // move every column one cell to the right; drop the ones that left the board
      cols = cols.filter((c) => {
        c.px = c.x;
        c.x++;
        if (c.x > BC) { c.items.forEach((o) => o.el.remove()); return false; }
        return true;
      });
      // sorting zone: one round of neighbour swaps, alternating pairs (0-1, 2-3) and (1-2, 3-4)
      for (const c of cols) {
        if (c.x < ZS || c.x >= ZE || !c.items.length) continue;
        const rows = [...c.items].sort((a, b) => a.y - b.y);
        for (let r = (c.x - ZS) % 2; r + 1 < ROWS; r += 2) {
          const a = rows[r], b = rows[r + 1];
          if (a.w.l > b.w.l) {
            a.y = r + 1;
            b.y = r;
            rows[r] = b;
            rows[r + 1] = a;
          }
        }
      }
      // a new full column on the left
      const c: Col = { x: 0, px: -1, items: [] };
      c.items = shuffle().map((l, y) => {
        const w = pick(l);
        return { w, el: mk(w), y, py: y };
      });
      cols.push(c);
      for (const col of cols) for (const o of col.items) place(col, o);
    };

    const fill = () => { for (let i = 0; i < BC + 2; i++) tick(); }; // start with the belt already full
    fill();
    const start = () => { if (!timer && !reduce) timer = window.setInterval(tick, TICK); };
    const stop = () => { if (timer) clearInterval(timer); timer = null; };
    new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop()))).observe(B);
    // a wider or narrower belt: start over with the new number of columns
    let lastW = B.clientWidth;
    new ResizeObserver(() => {
      const w = B.clientWidth;
      if (Math.abs(w - lastW) < C) return;
      lastW = w;
      cols.forEach((col) => col.items.forEach((o) => o.el.remove()));
      cols = [];
      last = [];
      size();
      fill();
    }).observe(B);
  }
</script>
