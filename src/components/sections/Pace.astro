---
// Section 05 — Paper node 3F-0.
import Section from '../Section.astro';

const paces = [
  { name: 'Light', zh: '轻松', items: '1–4 items per lesson', tone: 'light' },
  { name: 'Standard', zh: '标准', items: '5–7 items per lesson', extra: 'default', tone: 'standard' },
  { name: 'Intensive', zh: '强化', items: '8–10 items per lesson', tone: 'intensive' },
];
---

<Section id="pace" num="05" title="Pace and audio">
  <p class="prose">
    In the first conversation you pick your HSK 3.0 level, a pace, and whether you want audio. If you've studied
    before, you can start further in after seeing the lesson plan.
  </p>

  <div class="paces">
    {
      paces.map((p) => (
        <div class={`pace ${p.tone}`}>
          <div class="txt">
            <span class="zh" lang="zh-Hans" aria-label={p.zh}>
              {[...p.zh].map((c) => (
                <span class="ch" data-ch={c} aria-hidden="true">
                  <span class="static">{c}</span>
                </span>
              ))}
            </span>
            <span class="name display">{p.name}</span>
            <span class="items">
              {p.items}
              {p.extra && (
                <>
                  <br />
                  {p.extra}
                </>
              )}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <p class="prose">
    Audio is optional, but recommended. Hearing the chunks in a conversation is the point of the dialogues. ElevenLabs
    is the first suggestion for two-voice dialogues, and you can connect another compatible provider. Without audio, the
    dialogue appears in the chat in hanzi, without pinyin, followed by the questions.
  </p>
  <p class="prose">
    Hanzi you can actually see. Where the chat supports it, the vocabulary table shows characters at 2.5× the base
    size. The system font works fine. If you want strokes closer to careful handwriting, the skill suggests Kaiti SC
    Bold on Mac or AR PL KaitiM GB on Windows.
  </p>
</Section>

<script>
  // Each pace's name is written in real stroke order (Hanzi Writer, SVG). When the row reaches reading
  // height the three columns appear one after another, and each writes itself as it appears: Light,
  // then Standard, then Intensive. Stroke data comes from the hanzi-writer-data CDN; if it fails to load,
  // or reduced motion is on, the characters stay as static text in the brush font.
  import HanziWriter from 'hanzi-writer';

  const wrap = document.querySelector<HTMLElement>('#pace .paces');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wrap && !reduce) {
    wrap.classList.add('writing');
    const SIZE = 44;
    const paces = [...wrap.querySelectorAll<HTMLElement>('.pace')];
    const writers = paces.map((pace) => {
      const color = getComputedStyle(pace).color;
      return [...pace.querySelectorAll<HTMLElement>('.ch')].map((el) => {
        const w = HanziWriter.create(el, el.dataset.ch!, {
          width: SIZE,
          height: SIZE,
          padding: 2,
          showCharacter: false,
          showOutline: false,
          strokeColor: color,
          strokeAnimationSpeed: 9,
          delayBetweenStrokes: 0,
          onLoadCharDataSuccess: () => el.classList.add('drawn'),
          onLoadCharDataError: () => el.classList.add('failed'),
        });
        return { el, w };
      });
    });

    // Each column appears and starts writing; the next one follows shortly after, so they overlap.
    const NEXT = 350; // ms between columns
    const write = async (i: number) => {
      paces[i].classList.add('on');
      if (i + 1 < paces.length) setTimeout(() => write(i + 1), NEXT);
      for (const { el, w } of writers[i]) {
        try {
          await w.animateCharacter();
        } catch {
          el.classList.add('failed');
        }
      }
    };

    // Start when the row's reveal fires (Base.astro adds .in to the block).
    const start = () => {
      if (!wrap.classList.contains('in')) return false;
      mo.disconnect();
      write(0);
      return true;
    };
    const mo = new MutationObserver(start);
    mo.observe(wrap, { attributes: true, attributeFilter: ['class'] });
    start();
  }
</script>

<style>
  .paces {
    display: flex;
    gap: 24px;
    padding-block: 16px;
  }
  .pace {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .pace.light {
    color: var(--text);
  }
  .pace.standard {
    color: var(--accent-light);
  }
  .pace.intensive {
    color: var(--accent);
  }
  .txt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .zh {
    display: flex;
    gap: 2px;
    margin-bottom: 4px;
  }
  .ch {
    position: relative;
    display: block;
    width: 44px;
    height: 44px;
  }
  .ch :global(svg) {
    position: absolute;
    inset: 0;
  }
  .static {
    display: block;
    font-family: var(--f-brush);
    font-weight: var(--fw-brush);
    font-size: 40px;
    line-height: 44px;
    text-align: center;
  }
  /* While writing, the static text hides once the stroke data is in (it stays if loading failed). */
  .writing .ch.drawn:not(.failed) .static {
    visibility: hidden;
  }
  .writing .pace {
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.4s cubic-bezier(0.65, 0, 0.35, 1),
      translate 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .writing .pace.on {
    opacity: 1;
    translate: 0 0;
  }
  .name {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .items {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    opacity: 0.7;
  }
</style>
