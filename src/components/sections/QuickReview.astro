---
// Bento card "01 Quick review" — visual part.
// Shows what the review does. The first example is already finished: the line of thought (last
// lesson's word, today's word, mixing them), the question, and two tags saying where each word came
// from, with a light-orange "Next ↓". Clicking it plays the next example below and pushes the chat
// up, like the Written translation card: a single shimmering status line swaps its text in place
// (like Claude thinking), then opens up into the line of thought and the question lands.

type Round = {
  old: string; // word brought back from an earlier lesson
  oldEn: string;
  now: string; // word from today's lesson
  nowEn: string;
  q: [string, string, string, string, string]; // plain, today's phrase, plain, yesterday's phrase, plain
};

const rounds: Round[] = [
  { old: '茶', oldEn: 'tea', now: '买', nowEn: 'buy', q: ['Say you want to ', 'buy', ' some ', 'tea', '.'] },
  { old: '明天', oldEn: 'tomorrow', now: '商店', nowEn: 'shop', q: ['Say you’re going to ', 'the shop', ' ', 'tomorrow', '.'] },
  { old: '喜欢', oldEn: 'like', now: '贵', nowEn: 'expensive', q: ['Say it’s ', 'expensive', ', but you ', 'like', ' it.'] },
];
---

<div class="qr" data-qr data-rounds={JSON.stringify(rounds)}>
  <div class="qr-track" data-track></div>
  <p class="qr-sr" aria-live="polite" data-live></p>
</div>

<style is:global>
  /* Quick review (global: everything is built by the script) */
  .qr {
    position: relative;
    flex-grow: 1;
    min-height: 220px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 36px);
    mask-image: linear-gradient(180deg, transparent 0, #000 36px);
  }
  /* anchored to the bottom like a chat */
  .qr-track {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
  }
  /* gap between rounds only once the new one has content (no jump when it's added) */
  .qr-block + .qr-block:not(:empty) {
    margin-top: 20px;
  }
  .qr-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  /* thinking: three dots pulsing one after the other (neutral, not any app's logo) */
  .qr-dots {
    display: flex;
    gap: 3px;
    flex-shrink: 0;
  }
  .qr-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    animation: qr-dot 1.2s ease-in-out infinite;
  }
  .qr-dots i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .qr-dots i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes qr-dot {
    0%,
    60%,
    100% {
      opacity: 0.3;
      translate: 0 0;
    }
    30% {
      opacity: 1;
      translate: 0 -2px;
    }
  }
  .qr .zh {
    font-family: var(--f-brush);
    font-weight: var(--fw-brush);
  }
  /* yesterday's and today's words stay plain white everywhere (classes kept for structure) */
  .qr .old,
  .qr .old :is(.zh, .lb),
  .qr .now,
  .qr .now :is(.zh, .lb) {
    color: var(--text) !important;
    transition: color 0.15s ease;
  }
  /* hovering a tag lights it and its word in the question (and in the steps): yesterday dark
     orange, today light orange */
  .qr-tag {
    cursor: default;
  }
  .qr .qr-block.show-old .old,
  .qr .qr-block.show-old .old :is(.zh, .lb) {
    color: var(--accent) !important;
  }
  .qr .qr-block.show-now .now,
  .qr .qr-block.show-now .now :is(.zh, .lb) {
    color: var(--accent-light) !important;
  }

  /* status line while thinking */
  .qr-status {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 20px;
  }
  .qr-status-text {
    font-size: 13px;
    line-height: 20px;
    white-space: nowrap;
    color: transparent;
    background-image: linear-gradient(90deg, #5c5c5c 0%, #5c5c5c 35%, #f2f2f2 50%, #5c5c5c 65%, #5c5c5c 100%);
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    animation: qr-shimmer 1.6s linear infinite;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease;
  }
  .qr-status-text.swap {
    opacity: 0;
    translate: 0 4px;
  }
  .qr-status-text .zh {
    font-size: 16px;
  }
  @keyframes qr-shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  /* the line of thought, opened up once the question is ready */
  .qr-thought {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 12px;
    border-left: 1px solid var(--outline);
  }
  .qr-thought > p {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    line-height: 20px;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .qr-thought .ck {
    width: 14px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--ok);
  }
  .qr-thought .zh {
    font-size: 18px;
    color: var(--text);
  }
  .qr-thought .en {
    color: var(--muted-2);
  }
  .qr-thought > p.in {
    animation: qr-in 0.3s ease both;
  }
  @keyframes qr-in {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  /* the question */
  .qr .bubble.ai {
    max-width: 100%;
    transform-origin: 0% 100%;
  }
  .qr .qr-q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .qr-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 2px;
    min-height: 24px;
  }
  .qr-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 6px;
    background: #1a1a1a;
    transform-origin: 0% 50%;
  }
  .qr-tag .zh {
    font-size: 14px;
    line-height: 18px;
    color: var(--text);
  }
  .qr-tag .lb {
    font-family: var(--f-mono);
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .qr-next {
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    line-height: 20px;
    color: var(--accent-light);
    cursor: pointer;
    white-space: nowrap;
  }
  .qr-next:hover {
    color: #f8b68c;
  }
  .qr-next:focus-visible {
    outline: 1px dashed var(--accent-light);
    outline-offset: 2px;
  }
  .qr-next[disabled] {
    color: var(--muted-2);
    cursor: default;
  }
  .qr-next.in {
    animation: qr-in 0.3s ease both;
  }

  .qr .pop {
    animation: qr-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes qr-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .qr-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .qr-dots i,
    .qr-status-text,
    .qr .pop,
    .qr .in {
      animation: none;
    }
    .qr-status-text {
      color: var(--text-dim);
      background: none;
    }
  }
</style>

<script>
  type Round = { old: string; oldEn: string; now: string; nowEn: string; q: string[] };

  const root = document.querySelector<HTMLElement>('[data-qr]');
  if (root) {
    const rounds: Round[] = JSON.parse(root.dataset.rounds!);
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, reduce ? 0 : ms));

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', txt = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (txt) e.textContent = txt;
      return e;
    };
    const zh = (s: string) => el('span', 'zh', s);
    const NS = 'http://www.w3.org/2000/svg';
    const star = () => {
      const d = el('span', 'qr-dots');
      d.setAttribute('aria-hidden', 'true');
      d.append(el('i'), el('i'), el('i'));
      return d;
    };
    const zhOld = (s: string) => el('span', 'zh old', s);
    const zhNow = (s: string) => el('span', 'zh now', s);
    // what the status line says while thinking
    const status = (r: Round): (string | Node)[][] => [
      ['Last lesson: ', zhOld(r.old), '…'],
      ['Today: ', zhNow(r.now), '…'],
      ['Mixing both into one sentence…'],
    ];
    // the line of thought once it's done
    function thought(r: Round, animate: boolean) {
      const box = el('div', 'qr-thought');
      const rows: (string | Node)[][] = [
        [el('span', '', 'Last lesson:'), zhOld(r.old), el('span', 'en', r.oldEn)],
        [el('span', '', 'Today:'), zhNow(r.now), el('span', 'en', r.nowEn)],
        [el('span', '', 'Mixed both into one sentence')],
      ];
      rows.forEach((row, k) => {
        const p = el('p', animate ? 'in' : '');
        p.append(el('span', 'ck', '✓'), ...row);
        if (animate) p.style.animationDelay = `${k * 0.08}s`;
        box.append(p);
      });
      return box;
    }

    function bubble(r: Round) {
      const b = el('div', 'bubble ai');
      const p = el('p', 'qr-q');
      // q = [plain, today's phrase, plain, yesterday's phrase, plain]
      r.q.forEach((s, i) =>
        p.append(i === 1 ? el('span', 'now', s) : i === 3 ? el('span', 'old', s) : document.createTextNode(s)),
      );
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'tail');
      svg.setAttribute('viewBox', '0 0 8 10');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', 'M8 0 L8 10 L0 10 Z');
      path.setAttribute('style', 'fill: var(--bubble-ai)');
      svg.appendChild(path);
      b.append(p, svg);
      return b;
    }
    function tag(word: string, label: string, today: boolean) {
      const t = el('span', `qr-tag ${today ? 'now' : 'old'}`);
      t.append(zh(word), el('span', 'lb', label));
      const cls = today ? 'show-now' : 'show-old';
      t.addEventListener('mouseenter', () => t.closest('.qr-block')?.classList.add(cls));
      t.addEventListener('mouseleave', () => t.closest('.qr-block')?.classList.remove(cls));
      return t;
    }
    const pop = (e: Element) => {
      if (!reduce) e.classList.add('pop');
    };

    // Put something into the current block: the chat (anchored to the bottom) slides up by however
    // much it grew, so new content pushes the older content up instead of jumping.
    function add(block: HTMLElement, node: Node, replace?: Element) {
      const before = track.offsetHeight;
      if (replace) replace.replaceWith(node);
      else block.append(node);
      const grow = track.offsetHeight - before;
      if (reduce || !grow) return;
      track.style.transition = 'none';
      track.style.transform = `translateY(${grow}px)`;
      void track.offsetHeight;
      track.style.transition = 'transform 0.42s cubic-bezier(0.22, 1, 0.36, 1)';
      track.style.transform = 'translateY(0)';
    }

    let cur = 0;
    let busy = false;
    let next: HTMLButtonElement | null = null;

    function nextButton(tags: HTMLElement, animate: boolean) {
      next = el('button', `qr-next${animate ? ' in' : ''}`, 'Next ↓') as HTMLButtonElement;
      next.type = 'button';
      next.addEventListener('click', advance);
      tags.append(next);
    }

    // a finished round, shown at once (the first one, before any click)
    function show(i: number) {
      const r = rounds[i];
      const block = el('div', 'qr-block');
      const tags = el('div', 'qr-tags');
      tags.append(tag(r.old, 'YESTERDAY', false), tag(r.now, 'TODAY', true));
      nextButton(tags, false);
      block.append(thought(r, false), bubble(r), tags);
      track.append(block);
    }

    async function play(i: number) {
      busy = true;
      const r = rounds[i];
      const block = el('div', 'qr-block');
      // keep only the previous round above the new one
      while (track.children.length > 1) track.firstElementChild!.remove();
      track.append(block);

      // 1. one status line, text swapping in place
      const line = el('div', 'qr-status');
      const text = el('span', 'qr-status-text');
      line.append(star(), text);
      const steps = status(r);
      text.append(...steps[0]);
      add(block, line);
      await wait(1400);
      for (const st of steps.slice(1)) {
        text.classList.add('swap');
        await wait(200);
        text.replaceChildren(...st);
        text.classList.remove('swap');
        await wait(1400);
      }

      // 2. the line of thought opens up where the status line was
      add(block, thought(r, true), line);
      await wait(350);

      // 3. the question lands
      const b = bubble(r);
      add(block, b);
      pop(b);
      live.textContent = `${r.q.join('')} (${r.old} from yesterday, ${r.now} from today)`;
      await wait(650);

      // 4. where the words came from, one after the other, then Next
      const tags = el('div', 'qr-tags');
      add(block, tags);
      const t1 = tag(r.old, 'YESTERDAY', false);
      tags.append(t1);
      pop(t1);
      await wait(450);
      const t2 = tag(r.now, 'TODAY', true);
      tags.append(t2);
      pop(t2);
      await wait(450);
      nextButton(tags, true);
      busy = false;
    }

    function advance(this: HTMLButtonElement) {
      if (busy || this !== next) return;
      this.disabled = true;
      this.tabIndex = -1;
      cur = (cur + 1) % rounds.length;
      play(cur);
    }

    // the first example is already done; the process plays on Next
    show(cur);
  }
</script>
