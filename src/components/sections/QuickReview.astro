---
// Bento card "01 Quick review" — visual part.
// Shows what the review does: a single status line (shimmering, like Claude thinking) swaps its
// text in place — opening yesterday's lesson, bringing back an old word, mixing it with one of
// today's — then the question lands with two small tags saying where each word came from.
// Three examples loop forever.

type Round = {
  old: string; // word brought back from an earlier lesson
  now: string; // word from today's lesson
  q: [string, string, string, string, string]; // plain, highlighted, plain, highlighted, plain
};

const rounds: Round[] = [
  { old: '坐地铁', now: '打包', q: ['Say you’ll get it ', 'to go', ' and ', 'take the subway', ' home.'] },
  { old: '打车', now: '菜单', q: ['Ask for ', 'the menu', ', then say you’ll ', 'take a taxi', ' back.'] },
  { old: '有点儿', now: '味道', q: ['Tell the waiter ', 'the taste', ' is ', 'a bit', ' too salty.'] },
];
---

<div class="qr" data-qr data-rounds={JSON.stringify(rounds)}>
  <div class="qr-stage" data-stage>
    <div class="qr-status" data-status>
      <svg class="qr-star" viewBox="0 0 12 12" aria-hidden="true">
        <path d="M6 1v10M1 6h10M2.5 2.5l7 7M9.5 2.5l-7 7"></path>
      </svg>
      <span class="qr-status-text" data-status-text>Opening yesterday’s lesson…</span>
    </div>
  </div>
  <p class="qr-sr" aria-live="polite" data-live></p>
</div>

<style is:global>
  /* Quick review (global: the message is built by the script) */
  .qr {
    position: relative;
    flex-grow: 1;
    min-height: 200px;
  }
  .qr-stage {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  /* status line */
  .qr-status {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 20px;
  }
  .qr-status.out {
    display: none;
  }
  .qr-star {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    animation: qr-spin 2.4s linear infinite;
  }
  .qr-star path {
    fill: none;
    stroke: var(--accent-light);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  @keyframes qr-spin {
    to {
      rotate: 360deg;
    }
  }
  .qr-status-text {
    font-size: 13px;
    line-height: 20px;
    white-space: nowrap;
    color: transparent;
    background-image: linear-gradient(90deg, #5c5c5c 0%, #5c5c5c 35%, #f2f2f2 50%, #5c5c5c 65%, #5c5c5c 100%);
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    animation: qr-shimmer 1.6s linear infinite;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease;
  }
  .qr-status-text.swap {
    opacity: 0;
    translate: 0 4px;
  }
  .qr-status-text .zh {
    font-family: var(--f-brush);
    font-weight: 700;
    font-size: 16px;
  }
  @keyframes qr-shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  /* the question */
  .qr .bubble.ai {
    max-width: 100%;
    transform-origin: 0% 100%;
  }
  .qr .qr-q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .qr .qr-q .hl-light {
    color: var(--accent-light);
  }
  .qr-tags {
    display: flex;
    gap: 8px;
    padding-left: 2px;
  }
  .qr-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 6px;
    background: #1a1a1a;
  }
  .qr-tag .zh {
    font-family: var(--f-brush);
    font-weight: 700;
    font-size: 14px;
    line-height: 18px;
    color: var(--text);
  }
  .qr-tag .lb {
    font-family: var(--f-mono);
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .qr-tag.today .lb {
    color: var(--accent-light);
  }

  .qr .pop {
    animation: qr-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .qr-tag.pop {
    transform-origin: 0% 50%;
  }
  @keyframes qr-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  .qr-stage.leave > * {
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity 0.3s ease,
      translate 0.3s ease;
  }

  .qr-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .qr-star,
    .qr-status-text,
    .qr .pop {
      animation: none;
    }
    .qr-status-text {
      color: var(--text-dim);
      background: none;
    }
  }
</style>

<script>
  type Round = { old: string; now: string; q: string[] };

  const root = document.querySelector<HTMLElement>('[data-qr]');
  if (root) {
    const rounds: Round[] = JSON.parse(root.dataset.rounds!);
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const text = root.querySelector<HTMLElement>('[data-status-text]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', txt = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (txt) e.textContent = txt;
      return e;
    };
    const zh = (s: string) => el('span', 'zh', s);

    // swap the status text in place: fade the old one down, put the new one in
    async function say(parts: (string | Node)[]) {
      if (!reduce) {
        text.classList.add('swap');
        await wait(200);
      }
      text.replaceChildren(...parts);
      text.classList.remove('swap');
    }

    function bubble(r: Round) {
      const b = el('div', 'bubble ai');
      const p = el('p', 'qr-q');
      r.q.forEach((s, i) => p.append(i % 2 ? el('span', 'hl-light', s) : document.createTextNode(s)));
      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'tail');
      svg.setAttribute('viewBox', '0 0 8 10');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', 'M8 0 L8 10 L0 10 Z');
      path.setAttribute('style', 'fill: var(--bubble-ai)');
      svg.appendChild(path);
      b.append(p, svg);
      return b;
    }
    function tag(word: string, label: string, today: boolean) {
      const t = el('span', `qr-tag${today ? ' today' : ''}`);
      t.append(zh(word), el('span', 'lb', label));
      return t;
    }
    const pop = (e: HTMLElement) => {
      if (!reduce) e.classList.add('pop');
    };

    async function loop() {
      for (let i = 0; ; i = (i + 1) % rounds.length) {
        const r = rounds[i];
        // status line
        stage.replaceChildren(status);
        status.classList.remove('out');
        stage.classList.remove('leave');
        await say(['Opening yesterday’s lesson…']);
        await wait(1400);
        await say(['Bringing back ', zh(r.old), '…']);
        await wait(1400);
        await say(['Mixing it with today’s ', zh(r.now), '…']);
        await wait(1500);
        // the question lands, then the two tags
        status.classList.add('out');
        const b = bubble(r);
        stage.append(b);
        pop(b);
        live.textContent = `${r.q.join('')} (${r.old} from yesterday, ${r.now} from today)`;
        await wait(380);
        const tags = el('div', 'qr-tags');
        const t1 = tag(r.old, 'YESTERDAY', false);
        const t2 = tag(r.now, 'TODAY', true);
        tags.append(t1, t2);
        t2.style.animationDelay = '0.11s';
        stage.append(tags);
        pop(t1);
        pop(t2);
        // time to read, then clear for the next one
        await wait(4800);
        stage.classList.add('leave');
        await wait(400);
      }
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          io.disconnect();
          loop();
        }
      },
      { threshold: 0.5 },
    );
    io.observe(root);
  }
</script>
