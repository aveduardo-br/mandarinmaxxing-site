---
// Bento card "01 Quick review" — visual part.
// Shows what the review does. A single status line (shimmering, like Claude thinking) swaps its
// text in place — opening yesterday's lesson, bringing back an old word, mixing it with one of
// today's. Then the line of thought opens up as a list, the question lands under it, and two tags
// say where each word came from, with a light-orange "Next ↓". Clicking it plays the next example
// below and pushes the chat up, like the Written translation card.

type Round = {
  old: string; // word brought back from an earlier lesson
  now: string; // word from today's lesson
  q: [string, string, string, string, string]; // plain, highlighted, plain, highlighted, plain
};

const rounds: Round[] = [
  { old: '坐地铁', now: '打包', q: ['Say you’ll get it ', 'to go', ' and ', 'take the subway', ' home.'] },
  { old: '打车', now: '菜单', q: ['Ask for ', 'the menu', ', then say you’ll ', 'take a taxi', ' back.'] },
  { old: '有点儿', now: '味道', q: ['Tell the waiter ', 'the taste', ' is ', 'a bit', ' too salty.'] },
];
---

<div class="qr" data-qr data-rounds={JSON.stringify(rounds)}>
  <div class="qr-track" data-track></div>
  <p class="qr-sr" aria-live="polite" data-live></p>
</div>

<style is:global>
  /* Quick review (global: everything is built by the script) */
  .qr {
    position: relative;
    flex-grow: 1;
    min-height: 220px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 8%, #000 46%);
    mask-image: linear-gradient(180deg, transparent 0%, transparent 8%, #000 46%);
  }
  /* anchored to the bottom like a chat */
  .qr-track {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
  }
  /* gap between rounds only once the new one has content (no jump when it's added) */
  .qr-block + .qr-block:not(:empty) {
    margin-top: 20px;
  }
  .qr-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .qr-star {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .qr-star path {
    fill: none;
    stroke: var(--accent-light);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .qr .zh {
    font-family: var(--f-brush);
    font-weight: 700;
  }

  /* status line while thinking */
  .qr-status {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 20px;
  }
  .qr-status .qr-star {
    animation: qr-spin 2.4s linear infinite;
  }
  @keyframes qr-spin {
    to {
      rotate: 360deg;
    }
  }
  .qr-status-text {
    font-size: 13px;
    line-height: 20px;
    white-space: nowrap;
    color: transparent;
    background-image: linear-gradient(90deg, #5c5c5c 0%, #5c5c5c 35%, #f2f2f2 50%, #5c5c5c 65%, #5c5c5c 100%);
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    animation: qr-shimmer 1.6s linear infinite;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease;
  }
  .qr-status-text.swap {
    opacity: 0;
    translate: 0 4px;
  }
  .qr-status-text .zh {
    font-size: 16px;
  }
  @keyframes qr-shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  /* the line of thought, opened up once the question is ready */
  .qr-thought {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 12px;
    border-left: 1px solid var(--outline);
  }
  .qr-thought > p {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 20px;
    color: var(--muted);
    white-space: nowrap;
  }
  .qr-thought .zh {
    font-size: 16px;
    color: var(--text-soft);
  }
  .qr-thought > p.in {
    animation: qr-in 0.3s ease both;
  }
  @keyframes qr-in {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  /* the question */
  .qr .bubble.ai {
    max-width: 100%;
    transform-origin: 0% 100%;
  }
  .qr .qr-q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .qr .qr-q .hl-light {
    color: var(--accent-light);
  }
  .qr-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 2px;
    min-height: 24px;
  }
  .qr-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 6px;
    background: #1a1a1a;
    transform-origin: 0% 50%;
  }
  .qr-tag .zh {
    font-size: 14px;
    line-height: 18px;
    color: var(--text);
  }
  .qr-tag .lb {
    font-family: var(--f-mono);
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .qr-tag.today .lb {
    color: var(--accent-light);
  }
  .qr-next {
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    line-height: 20px;
    color: var(--accent-light);
    cursor: pointer;
    white-space: nowrap;
  }
  .qr-next:hover {
    color: #f8b68c;
  }
  .qr-next:focus-visible {
    outline: 1px dashed var(--accent-light);
    outline-offset: 2px;
  }
  .qr-next[disabled] {
    color: var(--muted-2);
    cursor: default;
  }
  .qr-next.in {
    animation: qr-in 0.3s ease both;
  }

  .qr .pop {
    animation: qr-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes qr-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .qr-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .qr-status .qr-star,
    .qr-status-text,
    .qr .pop,
    .qr .in {
      animation: none;
    }
    .qr-status-text {
      color: var(--text-dim);
      background: none;
    }
  }
</style>

<script>
  type Round = { old: string; now: string; q: string[] };

  const root = document.querySelector<HTMLElement>('[data-qr]');
  if (root) {
    const rounds: Round[] = JSON.parse(root.dataset.rounds!);
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, reduce ? 0 : ms));

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', txt = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (txt) e.textContent = txt;
      return e;
    };
    const zh = (s: string) => el('span', 'zh', s);
    const NS = 'http://www.w3.org/2000/svg';
    const star = () => {
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'qr-star');
      svg.setAttribute('viewBox', '0 0 12 12');
      svg.setAttribute('aria-hidden', 'true');
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', 'M6 1v10M1 6h10M2.5 2.5l7 7M9.5 2.5l-7 7');
      svg.appendChild(p);
      return svg;
    };
    // the three thoughts of a round
    const thoughts = (r: Round): (string | Node)[][] => [
      ['Opening yesterday’s lesson…'],
      ['Bringing back ', zh(r.old), '…'],
      ['Mixing it with today’s ', zh(r.now), '…'],
    ];

    function bubble(r: Round) {
      const b = el('div', 'bubble ai');
      const p = el('p', 'qr-q');
      r.q.forEach((s, i) => p.append(i % 2 ? el('span', 'hl-light', s) : document.createTextNode(s)));
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'tail');
      svg.setAttribute('viewBox', '0 0 8 10');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', 'M8 0 L8 10 L0 10 Z');
      path.setAttribute('style', 'fill: var(--bubble-ai)');
      svg.appendChild(path);
      b.append(p, svg);
      return b;
    }
    function tag(word: string, label: string, today: boolean) {
      const t = el('span', `qr-tag${today ? ' today' : ''}`);
      t.append(zh(word), el('span', 'lb', label));
      return t;
    }
    const pop = (e: Element) => {
      if (!reduce) e.classList.add('pop');
    };

    // Put something into the current block: the chat (anchored to the bottom) slides up by however
    // much it grew, so new content pushes the older content up instead of jumping.
    function add(block: HTMLElement, node: Node, replace?: Element) {
      const before = track.offsetHeight;
      if (replace) replace.replaceWith(node);
      else block.append(node);
      const grow = track.offsetHeight - before;
      if (reduce || !grow) return;
      track.style.transition = 'none';
      track.style.transform = `translateY(${grow}px)`;
      void track.offsetHeight;
      track.style.transition = 'transform 0.42s cubic-bezier(0.22, 1, 0.36, 1)';
      track.style.transform = 'translateY(0)';
    }

    let cur = 0;
    let busy = false;
    let next: HTMLButtonElement | null = null;

    async function play(i: number) {
      busy = true;
      const r = rounds[i];
      const block = el('div', 'qr-block');
      // keep only the previous round above the new one
      while (track.children.length > 1) track.firstElementChild!.remove();
      track.append(block);

      // 1. one status line, text swapping in place
      const status = el('div', 'qr-status');
      const text = el('span', 'qr-status-text');
      status.append(star(), text);
      const steps = thoughts(r);
      text.append(...steps[0]);
      add(block, status);
      await wait(1400);
      for (const s of steps.slice(1)) {
        text.classList.add('swap');
        await wait(200);
        text.replaceChildren(...s);
        text.classList.remove('swap');
        await wait(1400);
      }

      // 2. the line of thought opens up where the status line was
      const thought = el('div', 'qr-thought');
      thoughts(r).forEach((s, k) => {
        const p = el('p', 'in');
        p.append(...s);
        (p as HTMLElement).style.animationDelay = `${k * 0.08}s`;
        thought.append(p);
      });
      add(block, thought, status);
      await wait(350);

      // 3. the question lands
      const b = bubble(r);
      add(block, b);
      pop(b);
      live.textContent = `${r.q.join('')} (${r.old} from yesterday, ${r.now} from today)`;
      await wait(650);

      // 4. where the words came from, one after the other, then Next
      const tags = el('div', 'qr-tags');
      add(block, tags);
      const t1 = tag(r.old, 'YESTERDAY', false);
      tags.append(t1);
      pop(t1);
      await wait(450);
      const t2 = tag(r.now, 'TODAY', true);
      tags.append(t2);
      pop(t2);
      await wait(450);
      next = el('button', 'qr-next in', 'Next ↓') as HTMLButtonElement;
      next.type = 'button';
      next.addEventListener('click', advance);
      tags.append(next);
      busy = false;
    }

    function advance(this: HTMLButtonElement) {
      if (busy || this !== next) return;
      this.disabled = true;
      this.tabIndex = -1;
      cur = (cur + 1) % rounds.length;
      play(cur);
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          io.disconnect();
          play(cur);
        }
      },
      { threshold: 0.5 },
    );
    io.observe(root);
  }
</script>
