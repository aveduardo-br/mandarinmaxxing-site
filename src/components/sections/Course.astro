---
// Section 05 — Paper "05 Your course" (tiles). See docs/ladrilhos.md.
// The number of lessons in a level, drawn with tiles on a three-place scoreboard (a faint 8 under
// every digit). Right under it, two tile selectors: HSK (1 to 6) and words per lesson (3, 5 or 7).
// Changing either flips the tiles into the new number. Two black labels are the only text: LESSONS
// above the number, and when you would finish at one lesson a day, counted from today, below it.
//
// HSK 1 to 4 use the real numbers of their maps (HSK 1: 97, 58 and 42 lessons at 3, 5 and 7 words).
// Only HSK 1 carries its situations on the tiles. HSK 5 and 6 have no hand-made map, so their number is
// the word count divided by the pace, and the finish date is marked as an estimate. The tiles are a
// showcase: which hanzi each one carries is not meant to match the data one to one.
import Section from '../Section.astro';
import { situations } from '../../data/situations';
import { hskLevels } from '../../data/levels';

const ORANGE = '#D2430E';
const MUTED = ['#7FA3B0', '#9A9C5C', '#C29A5B', '#A0938B', '#E8835A'];

// Digits like a stadium scoreboard: seven segments on a 7 × 11 grid, one tile thick, the outer corners
// left out so the shape reads as rounded. Every digit is part of the 8, so the three places always show
// a grey 8 underneath and the number lights up on top of it.
const SEG: Record<string, [number, number][]> = {
  a: [1, 2, 3, 4, 5].map((x) => [x, 0]),
  g: [1, 2, 3, 4, 5].map((x) => [x, 5]),
  d: [1, 2, 3, 4, 5].map((x) => [x, 10]),
  f: [1, 2, 3, 4, 5].map((y) => [0, y]),
  e: [5, 6, 7, 8, 9].map((y) => [0, y]),
  b: [1, 2, 3, 4, 5].map((y) => [6, y]),
  c: [5, 6, 7, 8, 9].map((y) => [6, y]),
};
const LIT: Record<string, string> = {
  '0': 'abcdef', '1': 'bc', '2': 'abged', '3': 'abgcd', '4': 'fgbc',
  '5': 'afgcd', '6': 'afgedc', '7': 'abc', '8': 'abcdefg', '9': 'abcdfg',
};
const DIGITS: Record<string, string[]> = Object.fromEntries(
  Object.entries(LIT).map(([d, segs]) => {
    const g = Array.from({ length: 11 }, () => Array(7).fill('.'));
    for (const k of segs) for (const [x, y] of SEG[k]) g[y][x] = 'X';
    return [d, g.map((r) => r.join(''))];
  }),
);

// HSK 1: the situations in order, with the jump start in orange and one muted colour per situation
// after it. `end` is the running word count, so a tile can be matched to the situation it falls in.
let end = 0;
let muted = 0;
const info = situations.map((s) => ({
  name: s.name,
  bg: s.jumpStart ? ORANGE : MUTED[muted++ % MUTED.length],
  chars: s.words.map((w) => w.hanzi).join(''),
  end: (end += s.count),
}));

// Lessons at each pace for the levels mapped by hand (HSK 1 to 4): the parts of each map, from the
// header of maps/hsk-N.md in the skill repository (v0.4.0). HSK 5 and 6 are estimated.
const MAPS: Record<number, Record<string, number>> = {
  1: { '3': 97, '5': 58, '7': 42 },
  2: { '3': 66, '5': 38, '7': 29 },
  3: { '3': 168, '5': 94, '7': 69 },
  4: { '3': 319, '5': 173, '7': 130 },
};
const MAPPED = MAPS[1];
const levels = hskLevels.map((l) => ({ words: l.words, sample: l.sample, fixed: MAPS[l.level] ?? null }));
const paces = [
  { key: '3', zh: '三', words: 'three' },
  { key: '5', zh: '五', words: 'five' },
  { key: '7', zh: '七', words: 'seven' },
];
const START = '5';
const levelZh = ['一', '二', '三', '四', '五', '六'];
const data = { digits: DIGITS, levels, info, muted: MUTED };
---

<Section id="course" num="05" title="Your course" tiled>
  <p class="prose">
    The course is yours. Pick a level and a pace and watch it take shape. Every tile is one lesson.
  </p>

  <div class="board" data-course={JSON.stringify(data)} data-start={START}>
    <div class="tile-tag top">Lessons</div>
    <div class="num" data-num role="img" aria-label={`${MAPPED[START]} lessons`}></div>
    <div class="controls">
      <div class="sel">
        <div class="tile-label">HSK</div>
        <div class="tiles" role="group" aria-label="HSK level" data-level-group>
          {
            levelZh.map((zh, i) => (
              <button class="st" type="button" data-level={i + 1} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`HSK ${i + 1}`}>
                <span aria-hidden="true">{zh}</span>
              </button>
            ))
          }
        </div>
      </div>
      <div class="sel">
        <div class="tile-label">Words / lesson</div>
        <div class="tiles" role="group" aria-label="New words a lesson" data-pace-group>
          {
            paces.map((p) => (
              <button class="st" type="button" data-pace={p.key} aria-pressed={p.key === START ? 'true' : 'false'} aria-label={`${p.words} new words a lesson`}>
                <span aria-hidden="true">{p.zh}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <div class="tile-tag end" data-end aria-live="polite"></div>
  </div>
</Section>

<style>
  /* one block: the label, the scoreboard, the selectors right under it, the finish date */
  .board {
    position: relative;
    width: 644px;
    margin-top: 32px;
    padding-top: 20px; /* room for the LESSONS label */
  }
  .num {
    position: relative;
    width: 644px; /* always three places, like a scoreboard: a faint 8 under every digit */
    height: 308px;
  }
  /* an unlit tile of the scoreboard: only a faint dashed outline, 2px inside the tile */
  .num :global(.tile > span:empty)::before {
    content: '';
    position: absolute;
    left: -1px; /* the span sits at 3px, 1px inside the tile: this puts the square 2px in */
    top: 1px;
    width: 24px;
    height: 24px;
    box-sizing: border-box;
    border: 1px dashed #2a2a2a;
  }
  .board > .tile-tag {
    position: absolute;
    z-index: 1;
  }
  .top {
    left: 0;
    top: 0;
  }
  /* the finish date hangs out of the block, bottom right */
  .end {
    right: -32px;
    bottom: 4px;
    transition: opacity 0.12s linear;
  }

  .controls {
    display: flex;
    gap: 32px;
    margin-top: 16px;
  }
  .sel {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tiles {
    display: flex;
  }
  /* a tile you can pick: dimmed until chosen, orange when it is */
  .st {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: #1e1e1e;
    cursor: pointer;
  }
  .st span {
    position: absolute;
    left: 3px;
    top: 1px;
    font-family: 'Zpix', var(--f-display);
    font-size: 24px;
    line-height: 24px;
    font-weight: 500;
    color: #8a8a8a;
  }
  .st[aria-pressed='true'] {
    background: var(--accent);
  }
  .st[aria-pressed='true'] span {
    color: #161616;
  }
  .st:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
    z-index: 1;
  }

  /* narrow column: the scoreboard at half size, the finish date under the selectors, inside */
  @media (max-width: 720px) {
    .board {
      width: auto;
    }
    .num {
      zoom: 0.5;
    }
    .end {
      position: static !important;
      display: inline-block;
      margin-top: 16px;
    }
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, reduceMotion, FLIP } from '../../scripts/tiles';
  import type { Slot, TileVal } from '../../scripts/tiles';

  type Info = { name: string; bg: string; chars: string; end: number };
  type Level = { words: number; sample: string; fixed: Record<string, number> | null };
  type Tile = { x: number; y: number; ch: string; bg: string; lesson: number; name: string };

  const root = document.querySelector<HTMLElement>('[data-course]');
  if (root) {
    const D: { digits: Record<string, string[]>; levels: Level[]; info: Info[]; muted: string[] } = JSON.parse(root.dataset.course!);
    const num = root.querySelector<HTMLElement>('[data-num]')!;
    const endTag = root.querySelector<HTMLElement>('[data-end]')!;
    const COLS = 23; // room for three digits of 7, with one empty column between them
    const ROWS = 11;
    const STEP = 14; // the wave runs diagonally across the whole number

    const slots: Slot[] = [];
    for (let i = 0; i < COLS * ROWS; i++) {
      const slot = makeSlot(num, 'abs');
      slot.el.dataset.i = String(i);
      slots.push(slot);
    }
    const size = 28;
    slots.forEach((slot, i) => {
      slot.el.style.left = `${(i % COLS) * size}px`;
      slot.el.style.top = `${Math.floor(i / COLS) * size}px`;
    });

    // the unlit scoreboard: an 8 in each of the three places
    const board = [0, 1, 2].flatMap((p) =>
      D.digits['8'].flatMap((row, y) => [...row].flatMap((c, x) => (c === 'X' ? [{ x: p * 8 + x, y }] : []))),
    );
    const lessonsOf = (level: number, pace: string) => {
      const L = D.levels[level - 1];
      return L.fixed?.[pace] ?? Math.ceil(L.words / Number(pace));
    };

    // Tiles follow reading order (top to bottom, left to right, one digit after the other) and walk
    // through the level from its first lesson to its last.
    function build(level: number, pace: string): { n: number; tiles: Tile[]; pad: { x: number; y: number }[] } {
      const n = lessonsOf(level, pace);
      const L = D.levels[level - 1];
      // always three places, right-aligned, over the grey scoreboard
      const str = String(n);
      const off = 3 - str.length;
      const cells = [...str].flatMap((d, di) =>
        D.digits[d].flatMap((row, y) => [...row].flatMap((c, x) => (c === 'X' ? [{ x: (off + di) * 8 + x, y }] : []))),
      );
      const last = cells.length - 1;
      const used = new Map<number, number>();
      const sample = [...L.sample];
      const tiles = cells.map((cell, t) => {
        const lesson = Math.round((t * (n - 1)) / last) + 1;
        if (level === 1) {
          const word = Math.floor((t * (L.words - 1)) / last);
          const si = D.info.findIndex((i) => word < i.end);
          const k = used.get(si) ?? 0;
          used.set(si, k + 1);
          const chars = [...D.info[si].chars];
          return { ...cell, lesson, ch: chars[k % chars.length], bg: D.info[si].bg, name: D.info[si].name };
        }
        // no map yet: bands of colour stand in for the situations the skill will lay out
        const band = Math.floor((t * 10) / cells.length);
        return { ...cell, lesson, ch: sample[t % sample.length], bg: D.muted[band % D.muted.length], name: '' };
      });
      return { n, tiles, pad: board };
    }

    // the finish date, counted from today at one lesson a day; the year shows once it is far enough
    const dateOf = (lesson: number) => {
      const d = new Date(Date.now() + (lesson - 1) * 864e5);
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', ...(lesson > 300 ? { year: 'numeric' } : {}) });
    };

    let level = 1;
    let pace = root.dataset.start!;
    let busy = 0;

    function show(animate: boolean) {
      const next = build(level, pace);
      const moving = animate && !reduceMotion();
      const want = new Map<number, TileVal>([
        ...next.pad.map((c): [number, TileVal] => [c.y * COLS + c.x, { ch: '', bg: 'transparent' }]),
        ...next.tiles.map((t): [number, TileVal] => [t.y * COLS + t.x, { ch: t.ch, bg: t.bg }]),
      ]);
      const mapped = !!D.levels[level - 1].fixed;
      const delay = (i: number) => ((i % COLS) + Math.floor(i / COLS)) * STEP;
      const last = Math.max(...[...want.keys()].map(delay));

      const label = () => {
        endTag.textContent = `One a day · ${mapped ? '' : '≈ '}done by ${dateOf(next.n)}`;
        endTag.style.opacity = '1';
      };
      slots.forEach((slot, i) => {
        const v = want.get(i) ?? null;
        if (moving) flipTile(slot, v, delay(i));
        else applyTile(slot, v);
      });
      if (!moving) label();
      else {
        const token = ++busy;
        endTag.style.opacity = '0';
        window.setTimeout(() => token === busy && label(), last + FLIP);
      }
      num.setAttribute('aria-label', `${mapped ? '' : 'about '}${next.n} lessons`);
    }

    // ---- selectors ----
    const press = (group: HTMLElement, btn: HTMLElement) =>
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

    const levelGroup = document.querySelector<HTMLElement>('[data-level-group]')!;
    levelGroup.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-level]');
      if (!btn || Number(btn.dataset.level) === level) return;
      level = Number(btn.dataset.level);
      press(levelGroup, btn);
      show(true);
    });

    const paceGroup = document.querySelector<HTMLElement>('[data-pace-group]')!;
    paceGroup.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-pace]');
      if (!btn || btn.dataset.pace === pace) return;
      pace = btn.dataset.pace!;
      press(paceGroup, btn);
      show(true);
    });

    show(false);
  }
</script>
