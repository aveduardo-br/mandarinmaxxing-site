---
// Section 05 — "Your course" (layout of the pace row from Paper node 3F-0).
import Section from '../Section.astro';

const paces = [
  { name: 'Light', zh: '轻松', items: '3 new words', tone: 'light' },
  { name: 'Standard', zh: '标准', items: '5 new words', extra: 'recommended', tone: 'standard' },
  { name: 'Intensive', zh: '强化', items: '7 new words', tone: 'intensive' },
];
---

<Section id="course" num="05" title="Your course">
  <p class="prose">
    The course is yours. The first message makes three suggestions, and you can change any of them, then or later.
  </p>

  <h3 class="sub display">Level</h3>
  <p class="prose">
    New to Mandarin? Start with HSK 1, lesson 1. If you’ve studied before, name the level or the lesson you want to
    pick up from. Before the first lesson you see the whole list for your level, and you can move lessons around: food
    before phone calls, if that’s what you need first.
  </p>

  <h3 class="sub display">Pace</h3>
  <p class="prose">How many new words each time you sit down to study. Any other number works too.</p>

  <div class="paces">
    {
      paces.map((p) => (
        <div class={`pace ${p.tone}`}>
          <div class="txt">
            <span class="zh" lang="zh-Hans" aria-label={p.zh}>
              {[...p.zh].map((c) => (
                <span class="ch" data-ch={c} aria-hidden="true">
                  <span class="static">{c}</span>
                </span>
              ))}
            </span>
            <span class="name display">{p.name}</span>
            <span class="items">
              {p.items}
              {p.extra && (
                <>
                  <br />
                  {p.extra}
                </>
              )}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <p class="prose">
    At the standard pace, HSK 1 is 58 sittings. One a day gets you through all 300 words in about two months.
  </p>

  <h3 class="sub display">Audio</h3>
  <p class="prose">
    Optional. Every lesson closes with a short text made of the words you just learned. With audio, you hear it in a
    natural voice without seeing it written, then answer what you understood. It’s the course’s listening practice.
  </p>
  <p class="prose">
    Most people use ElevenLabs, which has a free account, and you can bring another voice provider. Without audio
    there’s nothing to set up: you read the text instead.
  </p>

  <h3 class="sub display">Your language</h3>
  <p class="prose">
    The skill explains, asks and corrects in the language you write in. You answer in Mandarin from the first lesson.
    You can start by typing pinyin, and turn on your Chinese keyboard when you want the next step.
  </p>
</Section>

<script>
  // Each pace's name is written in real stroke order (Hanzi Writer, SVG). When the row reaches reading
  // height the three columns appear one after another, and each writes itself as it appears: Light,
  // then Standard, then Intensive. Stroke data comes from the hanzi-writer-data CDN; if it fails to load,
  // or reduced motion is on, the characters stay as static text in the brush font.
  import HanziWriter from 'hanzi-writer';

  const wrap = document.querySelector<HTMLElement>('#course .paces');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wrap && !reduce) {
    wrap.classList.add('writing');
    const SIZE = 44;
    const paces = [...wrap.querySelectorAll<HTMLElement>('.pace')];
    const writers = paces.map((pace) => {
      const color = getComputedStyle(pace).color;
      return [...pace.querySelectorAll<HTMLElement>('.ch')].map((el) => {
        const w = HanziWriter.create(el, el.dataset.ch!, {
          width: SIZE,
          height: SIZE,
          padding: 2,
          showCharacter: false,
          showOutline: false,
          strokeColor: color,
          strokeAnimationSpeed: 9,
          delayBetweenStrokes: 0,
          onLoadCharDataSuccess: () => el.classList.add('drawn'),
          onLoadCharDataError: () => el.classList.add('failed'),
        });
        return { el, w };
      });
    });

    // Each column appears and starts writing; the next one follows shortly after, so they overlap.
    const NEXT = 350; // ms between columns
    const write = async (i: number) => {
      paces[i].classList.add('on');
      if (i + 1 < paces.length) setTimeout(() => write(i + 1), NEXT);
      for (const { el, w } of writers[i]) {
        try {
          await w.animateCharacter();
        } catch {
          el.classList.add('failed');
        }
      }
    };

    // Start when the row's reveal fires (Base.astro adds .in to the block).
    const start = () => {
      if (!wrap.classList.contains('in')) return false;
      mo.disconnect();
      write(0);
      return true;
    };
    const mo = new MutationObserver(start);
    mo.observe(wrap, { attributes: true, attributeFilter: ['class'] });
    start();
  }
</script>

<style>
  .sub {
    margin-top: 16px;
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    color: var(--text);
  }
  .paces {
    display: flex;
    gap: 24px;
    padding-block: 16px;
  }
  .pace {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .pace.light {
    color: var(--text);
  }
  .pace.standard {
    color: var(--accent-light);
  }
  .pace.intensive {
    color: var(--accent);
  }
  .txt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .zh {
    display: flex;
    gap: 2px;
    margin-bottom: 4px;
  }
  .ch {
    position: relative;
    display: block;
    width: 44px;
    height: 44px;
  }
  .ch :global(svg) {
    position: absolute;
    inset: 0;
  }
  .static {
    display: block;
    font-family: var(--f-brush);
    font-weight: var(--fw-brush);
    font-size: 40px;
    line-height: 44px;
    text-align: center;
  }
  /* While writing, the static text hides once the stroke data is in (it stays if loading failed). */
  .writing .ch.drawn:not(.failed) .static {
    visibility: hidden;
  }
  .writing .pace {
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.4s cubic-bezier(0.65, 0, 0.35, 1),
      translate 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .writing .pace.on {
    opacity: 1;
    translate: 0 0;
  }
  .name {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .items {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    opacity: 0.7;
  }
</style>
