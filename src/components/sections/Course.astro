---
// Section 05 — Paper "05 Your course" (tiles). See docs/ladrilhos.md.
// The number of lessons in a level is drawn with tiles. Below it, three tile selectors:
// - Level (HSK 1 to 6) and Pace (3, 5 or 7 new words a lesson) redraw the number: the tiles flip into
//   the new digits, and the text beside it says how long it takes at one lesson a day and when you
//   would finish, counted from today.
// - Audio (listen or read) only changes the last sentence.
// Hovering a tile shows which lesson it is, its date, and (HSK 1) the situation it belongs to.
//
// HSK 1 to 4 use the real numbers of their maps (HSK 1: 97, 58 and 42 lessons at 3, 5 and 7 words).
// Only HSK 1 carries its situations on the tiles. HSK 5 and 6 have no hand-made map, so their number is
// the word count divided by the pace, and the text says
// it is an estimate. The tiles are a showcase: how many there are, and which hanzi each one carries,
// is not meant to match the data one to one.
import Section from '../Section.astro';
import { situations } from '../../data/situations';
import { hskLevels } from '../../data/levels';

const ORANGE = '#D2430E';
const MUTED = ['#7FA3B0', '#9A9C5C', '#C29A5B', '#A0938B', '#E8835A'];

// Digits on a 7 × 11 grid, one tile thick, outer corners left out so the shape reads as rounded.
const DIGITS: Record<string, string[]> = {
  '0': ['.XXXXX.', 'X.....X', 'X.....X', 'X.....X', 'X.....X', 'X.....X', 'X.....X', 'X.....X', 'X.....X', 'X.....X', '.XXXXX.'],
  '1': ['..XX...', '...X...', '...X...', '...X...', '...X...', '...X...', '...X...', '...X...', '...X...', '...X...', '.XXXXX.'],
  '2': ['.XXXXX.', 'X.....X', '......X', '......X', '......X', '.XXXXX.', 'X......', 'X......', 'X......', 'X......', 'XXXXXXX'],
  '3': ['.XXXXX.', 'X.....X', '......X', '......X', '......X', '..XXXX.', '......X', '......X', '......X', 'X.....X', '.XXXXX.'],
  '4': ['X....X.', 'X....X.', 'X....X.', 'X....X.', 'X....X.', 'X....X.', 'XXXXXXX', '.....X.', '.....X.', '.....X.', '.....X.'],
  '5': ['XXXXXXX', 'X......', 'X......', 'X......', 'X......', 'XXXXXX.', '......X', '......X', '......X', 'X.....X', '.XXXXX.'],
  '6': ['.XXXXX.', 'X......', 'X......', 'X......', 'X......', 'XXXXXX.', 'X.....X', 'X.....X', 'X.....X', 'X.....X', '.XXXXX.'],
  '7': ['XXXXXXX', '......X', '......X', '.....X.', '.....X.', '....X..', '....X..', '...X...', '...X...', '...X...', '...X...'],
  '8': ['.XXXXX.', 'X.....X', 'X.....X', 'X.....X', 'X.....X', '.XXXXX.', 'X.....X', 'X.....X', 'X.....X', 'X.....X', '.XXXXX.'],
  '9': ['.XXXXX.', 'X.....X', 'X.....X', 'X.....X', 'X.....X', '.XXXXXX', '......X', '......X', '......X', '......X', '.XXXXX.'],
};

// HSK 1: the situations in order, with the jump start in orange and one muted colour per situation
// after it. `end` is the running word count, so a tile can be matched to the situation it falls in.
let end = 0;
let muted = 0;
const info = situations.map((s) => ({
  name: s.name,
  bg: s.jumpStart ? ORANGE : MUTED[muted++ % MUTED.length],
  chars: s.words.map((w) => w.hanzi).join(''),
  end: (end += s.count),
}));

// Lessons at each pace for the levels mapped by hand (HSK 1 to 4): the parts of each map, from the
// header of maps/hsk-N.md in the skill repository (v0.4.0). HSK 5 and 6 are estimated.
const MAPS: Record<number, Record<string, number>> = {
  1: { '3': 97, '5': 58, '7': 42 },
  2: { '3': 66, '5': 38, '7': 29 },
  3: { '3': 168, '5': 94, '7': 69 },
  4: { '3': 319, '5': 173, '7': 130 },
};
const MAPPED = MAPS[1];
const levels = hskLevels.map((l) => ({ words: l.words, sample: l.sample, fixed: MAPS[l.level] ?? null }));
const paces = [
  { key: '3', zh: '三', words: 'three' },
  { key: '5', zh: '五', words: 'five' },
  { key: '7', zh: '七', words: 'seven' },
];
const START = '5';
const levelZh = ['一', '二', '三', '四', '五', '六'];
const data = { digits: DIGITS, levels, info, muted: MUTED };
---

<Section id="course" num="05" title="Your course">
  <p class="prose">
    The course is yours. Pick a level, a pace and whether you want audio, and watch it take shape. Every tile is one
    lesson.
  </p>

  <div class="shape" data-course={JSON.stringify(data)} data-start={START}>
    <div class="num" data-num role="img" aria-label={`${MAPPED[START]} lessons`}>
      <div class="tile-tag start" data-start-tag>Today · Say hello</div>
      <div class="tile-tag end" data-end></div>
      <div class="tile-tag hover" data-hover aria-hidden="true"></div>
    </div>
    <div class="live" aria-live="polite">
      <div class="word display">lessons</div>
      <p data-main>
        HSK 1, about five new words each. One a day takes about two months.
      </p>
      <p>Each lesson ends with a short text to <b data-audio>listen to</b>.</p>
      <p class="note" data-note hidden></p>
      <div class="legend">
        <div class="lg" data-jump><span class="sw" style={`background:${ORANGE}`}></span>Jump start: the basics first</div>
        <div class="lg">
          <span class="sw3">{MUTED.slice(0, 3).map((c) => <i style={`background:${c}`} />)}</span>Then one color per situation
        </div>
      </div>
    </div>
  </div>

  <div class="selectors">
    <div class="sel">
      <div class="tile-label">Level</div>
      <div class="tiles" role="group" aria-label="Level" data-level-group>
        {
          levelZh.map((zh, i) => (
            <button class="st" type="button" data-level={i + 1} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`HSK ${i + 1}`}>
              <span aria-hidden="true">{zh}</span>
            </button>
          ))
        }
      </div>
      <p>HSK 1 to 4, mapped by hand. New? Start at one. Studied before? Pick where to begin.</p>
    </div>
    <div class="sel">
      <div class="tile-label">Pace</div>
      <div class="tiles" role="group" aria-label="Pace" data-pace-group>
        {
          paces.map((p) => (
            <button class="st" type="button" data-pace={p.key} aria-pressed={p.key === START ? 'true' : 'false'} aria-label={`${p.words} new words a lesson`}>
              <span aria-hidden="true">{p.zh}</span>
            </button>
          ))
        }
      </div>
      <p>Three, five or seven new words a lesson. Any other number works too.</p>
    </div>
    <div class="sel">
      <div class="tile-label">Audio</div>
      <div class="tiles" role="group" aria-label="Audio" data-audio-group>
        <button class="st" type="button" data-mode="listen to" aria-pressed="true" aria-label="Listen"><span aria-hidden="true">听</span></button>
        <button class="st" type="button" data-mode="read" aria-pressed="false" aria-label="Read"><span aria-hidden="true">读</span></button>
      </div>
      <p>Listen or read. Every lesson ends with a short text. Hearing it is optional.</p>
    </div>
  </div>
</Section>

<style>
  .shape {
    display: flex;
    align-items: flex-start;
    gap: 32px;
    margin-top: 12px;
    padding-top: 20px; /* room for the label on the first tile */
  }
  .num {
    position: relative;
    flex: none;
    width: 420px; /* two digits; the script widens it for three, which pushes the text right */
    height: 308px;
    transition: width 0.22s steps(4, end);
  }
  /* three digits: the text runs past the column on wide screens, and drops below on narrower ones */
  @media (max-width: 1160px) {
    .shape.wide {
      flex-direction: column;
    }
    .shape.wide .live {
      width: auto;
    }
  }
  .num .tile-tag {
    position: absolute;
    transition: opacity 0.12s linear;
  }
  .num .start {
    left: 0;
    top: -20px;
  }
  /* hovering a tile: its situation stays lit, the rest steps back, and a label names the lesson */
  .num :global(.tile) {
    transition: opacity 0.12s linear;
  }
  .num.hovering :global(.tile) {
    opacity: 0.3;
  }
  .num.hovering :global(.tile.lit) {
    opacity: 1;
  }
  .num.hovering .start,
  .num.hovering .end {
    opacity: 0 !important;
  }
  .num .hover {
    z-index: 2;
    pointer-events: none;
    opacity: 0;
  }
  .num.hovering .hover {
    opacity: 1;
  }

  .live {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: none;
    width: 228px;
    padding-top: 4px;
  }
  .word {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--text);
  }
  .live p {
    font-size: 15px;
    line-height: 24px;
    color: var(--text-80);
  }
  .live :global(b) {
    font-weight: 500;
    color: var(--text);
  }
  .live .note {
    font-size: var(--fs-caption);
    line-height: 18px;
    color: var(--muted);
  }
  .legend {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 4px;
  }
  .lg {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-caption);
    line-height: 16px;
    font-weight: 400;
    color: var(--text-dim);
  }
  .sw {
    flex: none;
    width: 12px;
    height: 12px;
  }
  .sw3 {
    display: flex;
    flex: none;
  }
  .sw3 i {
    width: 4px;
    height: 12px;
  }

  .selectors {
    display: flex;
    gap: 24px;
    margin-top: 40px;
  }
  .sel {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .tiles {
    display: flex;
  }
  .sel p {
    font-size: var(--fs-small);
    line-height: 22px;
    color: var(--text-soft);
    opacity: 0.8;
  }
  /* a tile you can pick: dimmed until chosen, orange when it is */
  .st {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: #1e1e1e;
    cursor: pointer;
  }
  .st span {
    position: absolute;
    left: 3px;
    top: 1px;
    font-family: 'Zpix', var(--f-display);
    font-size: 24px;
    line-height: 24px;
    font-weight: 500;
    color: #8a8a8a;
  }
  .st[aria-pressed='true'] {
    background: var(--accent);
  }
  .st[aria-pressed='true'] span {
    color: #161616;
  }
  .st:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
    z-index: 1;
  }

  @media (max-width: 760px) {
    .shape {
      flex-direction: column;
    }
    .num {
      zoom: 0.75;
    }
    .shape.wide .num {
      zoom: 0.5;
    }
    .live {
      width: auto;
    }
    .selectors {
      flex-direction: column;
    }
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, reduceMotion, FLIP } from '../../scripts/tiles';
  import type { Slot, TileVal } from '../../scripts/tiles';

  type Info = { name: string; bg: string; chars: string; end: number };
  type Level = { words: number; sample: string; fixed: Record<string, number> | null };
  type Tile = { x: number; y: number; ch: string; bg: string; lesson: number; name: string };

  const root = document.querySelector<HTMLElement>('[data-course]');
  if (root) {
    const D: { digits: Record<string, string[]>; levels: Level[]; info: Info[]; muted: string[] } = JSON.parse(root.dataset.course!);
    const num = root.querySelector<HTMLElement>('[data-num]')!;
    const startTag = root.querySelector<HTMLElement>('[data-start-tag]')!;
    const endTag = root.querySelector<HTMLElement>('[data-end]')!;
    const hoverTag = root.querySelector<HTMLElement>('[data-hover]')!;
    const mainEl = root.querySelector<HTMLElement>('[data-main]')!;
    const noteEl = root.querySelector<HTMLElement>('[data-note]')!;
    const jumpEl = root.querySelector<HTMLElement>('[data-jump]')!;
    const audioEl = root.querySelector<HTMLElement>('[data-audio]')!;
    const COLS = 23; // room for three digits of 7, with one empty column between them
    const ROWS = 11;
    const STEP = 14; // the wave runs diagonally across the whole number
    const WORDS: Record<string, string> = { '3': 'three', '5': 'five', '7': 'seven' };
    const NUMS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven'];

    const slots: Slot[] = [];
    for (let i = 0; i < COLS * ROWS; i++) {
      const slot = makeSlot(num, 'abs');
      slot.el.dataset.i = String(i);
      slots.push(slot);
    }
    const size = 28;
    slots.forEach((slot, i) => {
      slot.el.style.left = `${(i % COLS) * size}px`;
      slot.el.style.top = `${Math.floor(i / COLS) * size}px`;
    });
    let width = 420;

    const lessonsOf = (level: number, pace: string) => {
      const L = D.levels[level - 1];
      return L.fixed?.[pace] ?? Math.ceil(L.words / Number(pace));
    };

    // Tiles follow reading order (top to bottom, left to right, one digit after the other) and walk
    // through the level from its first lesson to its last.
    function build(level: number, pace: string): { n: number; tiles: Tile[] } {
      const n = lessonsOf(level, pace);
      const L = D.levels[level - 1];
      const cells = [...String(n)].flatMap((d, di) =>
        D.digits[d].flatMap((row, y) => [...row].flatMap((c, x) => (c === 'X' ? [{ x: di * 8 + x, y }] : []))),
      );
      const last = cells.length - 1;
      const used = new Map<number, number>();
      const sample = [...L.sample];
      const tiles = cells.map((cell, t) => {
        const lesson = Math.round((t * (n - 1)) / last) + 1;
        if (level === 1) {
          const word = Math.floor((t * (L.words - 1)) / last);
          const si = D.info.findIndex((i) => word < i.end);
          const k = used.get(si) ?? 0;
          used.set(si, k + 1);
          const chars = [...D.info[si].chars];
          return { ...cell, lesson, ch: chars[k % chars.length], bg: D.info[si].bg, name: D.info[si].name };
        }
        // no map yet: bands of colour stand in for the situations the skill will lay out
        const band = Math.floor((t * 10) / cells.length);
        return { ...cell, lesson, ch: sample[t % sample.length], bg: D.muted[band % D.muted.length], name: '' };
      });
      return { n, tiles };
    }

    const span = (days: number) => {
      if (days <= 45) return `about ${NUMS[Math.round(days / 7)]} weeks`;
      if (days < 345) return `about ${NUMS[Math.round(days / 30.4)]} months`;
      const y = days / 365;
      return y < 1.25 ? 'about a year' : y < 1.75 ? 'about a year and a half' : 'about two years';
    };
    // dates count from today, one lesson a day; the year shows once it is far enough to be unclear
    const dateOf = (lesson: number, month: 'short' | 'long') => {
      const d = new Date(Date.now() + (lesson - 1) * 864e5);
      return d.toLocaleDateString('en-US', { month, day: 'numeric', ...(lesson > 300 ? { year: 'numeric' } : {}) });
    };

    let level = 1;
    let pace = root.dataset.start!;
    let current: { n: number; tiles: Tile[] } = { n: 0, tiles: [] };
    let byIndex = new Map<number, Tile>();
    let busy = 0;

    function show(animate: boolean) {
      const next = build(level, pace);
      const digits = String(next.n).length;
      width = (digits * 8 - 1) * size;
      num.style.width = `${width}px`;
      root.classList.toggle('wide', digits > 2);
      const moving = animate && !reduceMotion();
      const want = new Map<number, TileVal>(next.tiles.map((t) => [t.y * COLS + t.x, { ch: t.ch, bg: t.bg }]));
      const lastTile = next.tiles[next.tiles.length - 1];
      const mapped = !!D.levels[level - 1].fixed;
      // only HSK 1 carries its situations on the tiles (names, colours, jump start)
      const named = level === 1;
      const delay = (i: number) => ((i % COLS) + Math.floor(i / COLS)) * STEP;

      clearHover();
      current = next;
      byIndex = new Map(next.tiles.map((t) => [t.y * COLS + t.x, t]));

      const labels = () => {
        startTag.textContent = named ? 'Today · Say hello' : 'Today · Lesson 1';
        endTag.textContent = `${dateOf(next.n, 'short')} · ${named ? lastTile.name : `Lesson ${next.n}`}`;
        // beside the last tile when it fits; otherwise under it, so it never covers the text
        const edge = (lastTile.x + 1) * size;
        const under = edge + endTag.offsetWidth > width + 24;
        endTag.style.left = `${edge}px`;
        endTag.style.transform = under ? 'translateX(-100%)' : '';
        endTag.style.top = under ? `${(lastTile.y + 1) * size + 4}px` : `${lastTile.y * size + (size - 20) / 2}px`;
        endTag.style.opacity = '1';
        startTag.style.opacity = '1';
      };
      const fill = (offset: number) =>
        slots.forEach((slot, i) => {
          const v = want.get(i) ?? null;
          if (moving) flipTile(slot, v, offset + delay(i));
          else applyTile(slot, v);
        });

      if (!moving) {
        fill(0);
        labels();
      } else {
        const token = ++busy;
        endTag.style.opacity = '0';
        fill(0);
        window.setTimeout(() => token === busy && labels(), delay(lastTile.y * COLS + lastTile.x) + FLIP);
      }

      const finish = dateOf(next.n, 'long');
      mainEl.innerHTML =
        `HSK ${level}, about ${WORDS[pace]} new words each. One a day takes ${span(next.n)}: start today, finish ` +
        `${mapped ? 'on' : 'around'} <b>${finish}</b>.`;
      noteEl.hidden = mapped;
      noteEl.textContent = mapped
        ? ''
        : `An estimate: HSK ${level} adds ${D.levels[level - 1].words.toLocaleString('en-US')} words. HSK 1 to 4 are mapped by hand; for 5 and 6 the skill builds the map when you start.`;
      jumpEl.hidden = !named;
      num.setAttribute('aria-label', `${mapped ? '' : 'about '}${next.n} lessons`);
    }

    // ---- hover: which lesson is this tile? ----
    function clearHover() {
      num.classList.remove('hovering');
      slots.forEach((s) => s.el.classList.remove('lit'));
    }
    num.addEventListener('pointerover', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      const t = el && byIndex.get(Number(el.dataset.i));
      if (!el || !t) return;
      slots.forEach((s, i) => {
        const o = byIndex.get(i);
        s.el.classList.toggle('lit', !!o && (t.name ? o.name === t.name : o === t));
      });
      hoverTag.textContent = `Lesson ${t.lesson} · ${dateOf(t.lesson, 'short')}${t.name ? ` · ${t.name}` : ''}`;
      num.classList.add('hovering');
      // above the tile; flipped to the left when it would run into the text beside the number
      const left = t.x * size;
      const w = hoverTag.offsetWidth;
      hoverTag.style.left = `${left + w > width + 32 ? Math.max(0, (t.x + 1) * size - w) : left}px`;
      hoverTag.style.top = `${t.y * size - 20}px`;
    });
    num.addEventListener('pointerleave', clearHover);

    // ---- selectors ----
    const press = (group: HTMLElement, btn: HTMLElement) =>
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

    const levelGroup = document.querySelector<HTMLElement>('[data-level-group]')!;
    levelGroup.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-level]');
      if (!btn || Number(btn.dataset.level) === level) return;
      level = Number(btn.dataset.level);
      press(levelGroup, btn);
      show(true);
    });

    const paceGroup = document.querySelector<HTMLElement>('[data-pace-group]')!;
    paceGroup.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-pace]');
      if (!btn || btn.dataset.pace === pace) return;
      pace = btn.dataset.pace!;
      press(paceGroup, btn);
      show(true);
    });

    const audioGroup = document.querySelector<HTMLElement>('[data-audio-group]')!;
    audioGroup.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-mode]');
      if (!btn) return;
      press(audioGroup, btn);
      audioEl.textContent = btn.dataset.mode!;
    });

    show(false);
  }
</script>
