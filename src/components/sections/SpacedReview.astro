---
// Bento card "+ Spaced review" — visual part. Approved prototype: artifact "Spaced review — três
// versões", version B2 (https://claude.ai/artifact/M9tu4VTVRgnQ4xhfhT5o69).
// One lesson at a time: its new word on top (orange tiles), and under "Coming back" the old words that
// return in it, each with its meaning and the lesson it came from. Words come back 1, 3, 7 and 14
// lessons after the one where they were learned. Empty rows show dashed placeholder tiles (as in Your
// course); lesson 1 has nothing to review yet. Two arrow tiles (or ← →) change the lesson; on its own
// the card moves forward while it is on screen and the pointer is not over it. Hovering an old word
// dims the others and says how many lessons ago it was learned.
// Every tile change uses the shared flip (src/scripts/tiles.ts). The tiles use the pixel font: every
// hanzi here must be in public/fonts/zpix-site.woff.

// one word per lesson, lessons 1–16
const words = [
  ['你好', 'hello'], ['朋友', 'friend'], ['喝茶', 'drink tea'], ['多少钱', 'how much'],
  ['米饭', 'rice'], ['好吃', 'tasty'], ['便宜', 'cheap'], ['医院', 'hospital'],
  ['认识', 'know someone'], ['明天', 'tomorrow'], ['工作', 'work'], ['看书', 'read'],
  ['睡觉', 'sleep'], ['回家', 'go home'], ['下班', 'get off work'], ['起床', 'get up'],
].map(([zh, en]) => ({ zh, en }));
const GAPS = [1, 3, 7, 14];
const START = 8;
---

<div class="sr" data-sr data-words={JSON.stringify(words)} data-gaps={JSON.stringify(GAPS)} data-start={START} tabindex="0" aria-label="Spaced review: lessons and the words that come back in them. Use the arrow keys to change the lesson.">
  <div class="stage" data-stage>
    <span class="tile-tag head" data-head>Lesson {START}</span>
    <button class="atile prev" type="button" data-step="-1" aria-label="Previous lesson">
      <svg viewBox="0 0 7 7" shape-rendering="crispEdges"><path d="M1 3h6v1h-6zM0 3h1v1h-1zM1 2h1v1h-1zM1 4h1v1h-1zM2 1h1v1h-1zM2 5h1v1h-1z" /></svg>
    </button>
    <button class="atile next" type="button" data-step="1" aria-label="Next lesson">
      <svg viewBox="0 0 7 7" shape-rendering="crispEdges"><path d="M1 3h6v1h-6zM0 3h1v1h-1zM1 2h1v1h-1zM1 4h1v1h-1zM2 1h1v1h-1zM2 5h1v1h-1z" /></svg>
    </button>
    <span class="tile-label back-label">Coming back</span>
    <span class="rule" aria-hidden="true"></span>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<style>
  .sr {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 0;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .sr:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: -6px;
  }
  /* 236px card: everything is placed in px from the stage's top-left corner (20px side margins) */
  .stage {
    position: relative;
    width: 236px;
    height: 256px;
    flex: none;
  }
  .head {
    position: absolute;
    left: 20px;
    top: 4px;
  }
  /* arrow tiles: grey like an unlit tile, orange on hover (same pixel arrow style as the FAQ tile) */
  .atile {
    position: absolute;
    top: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: #1e1e1e;
    background-clip: content-box;
    padding: var(--tile-gap, 1px);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .atile.prev {
    left: 160px;
  }
  .atile.next {
    left: 188px;
  }
  .atile svg {
    width: 14px;
    height: 14px;
    fill: #8a8a8a;
    transition: fill 0.15s ease;
  }
  .atile.next svg {
    transform: scaleX(-1);
  }
  @media (hover: hover) {
    .atile:hover {
      background-color: var(--accent);
    }
    .atile:hover svg {
      fill: #161616;
    }
  }
  .atile:active {
    background-color: var(--accent);
  }
  .atile:active svg {
    fill: #161616;
  }
  /* a taller area to tap than the 28px drawn */
  .atile::after {
    content: '';
    position: absolute;
    inset: -8px 0;
  }
  .atile:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 2px;
  }
  .back-label {
    position: absolute;
    left: 20px;
    top: 98px;
  }
  .rule {
    position: absolute;
    left: 112px;
    right: 20px;
    top: 105px;
    border-top: 1px dashed #333;
  }
  /* placeholder for a word still to come: a faint dashed square 2px inside the tile */
  .stage :global(.ghost) {
    position: absolute;
    width: 28px;
    height: 28px;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .stage :global(.ghost)::before {
    content: '';
    position: absolute;
    inset: 2px;
    border: 1px dashed #3a3a3a;
  }
  .stage :global(.tile) {
    transition: opacity 0.18s ease;
  }
  /* the text beside a row: meaning, then where it comes from */
  .stage :global(.rtxt) {
    position: absolute;
    height: 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .stage :global(.rtxt b) {
    font-weight: 400;
    font-size: 13px;
    line-height: 15px;
    color: var(--text);
  }
  .stage :global(.rtxt i) {
    font-style: normal;
    font-family: var(--f-mono);
    font-size: 10.5px;
    line-height: 12px;
    color: var(--muted);
  }
  .stage :global(.rtxt em) {
    font-style: normal;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stage :global(.hit) {
    position: absolute;
    left: 0;
    width: 236px;
    height: 36px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { makeSlot, applyTile, flipTile, reduceMotion, TILE, ORANGE, MUTED, WAVE, FLIP } from '../../scripts/tiles';
  import type { Slot } from '../../scripts/tiles';

  type Word = { zh: string; en: string };
  type Item = { w: Word; learned: number; gap?: number };
  type Row = { ghosts: HTMLElement[]; slots: Slot[]; txt: HTMLElement; item: Item | null; shown: boolean; token: number };

  const root = document.querySelector<HTMLElement>('[data-sr]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const head = root.querySelector<HTMLElement>('[data-head]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const words: Word[] = JSON.parse(root.dataset.words!);
    const GAPS: number[] = JSON.parse(root.dataset.gaps!);
    const N = words.length;
    const X = 20;
    const NEW_Y = 50;
    const OLD_Y = 120;
    const PITCH = 36;
    const at = (el: HTMLElement, x: number, y: number) => {
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
    };
    const el = (cls: string) => {
      const d = document.createElement('div');
      d.className = cls;
      stage.appendChild(d);
      return d;
    };

    // row 0: the lesson's new word; rows 1–4: the old words coming back (empty rows show placeholders)
    const rows: Row[] = [NEW_Y, ...[0, 1, 2, 3].map((r) => OLD_Y + r * PITCH)].map((y, k) => {
      const ghosts = k ? [0, 1].map((c) => { const g = el('ghost'); at(g, X + c * TILE, y); return g; }) : [];
      const slots = [0, 1, 2].map((c) => {
        const s = makeSlot(stage, 'abs');
        at(s.el, X + c * TILE, y);
        return s;
      });
      const txt = el('rtxt');
      txt.innerHTML = '<b></b><i></i>';
      at(txt, X + 3 * TILE + 12, y);
      const row: Row = { ghosts, slots, txt, item: null, shown: false, token: 0 };
      if (k) {
        const hit = el('hit');
        hit.style.top = `${y - 4}px`;
        // with a mouse, hovering shows it; on a touch screen, a tap shows it and a second tap hides it
        hit.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && focus(row));
        hit.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && focus(null));
        hit.addEventListener('click', (e) => {
          if ((e as PointerEvent).pointerType !== 'mouse') focus(focused === row ? null : row);
        });
      }
      return row;
    });

    const lessonOf = (L: number) => ({
      fresh: words[L - 1] ? { w: words[L - 1], learned: L } : null,
      back: GAPS.flatMap((g) => (words[L - g - 1] ? [{ w: words[L - g - 1], learned: L - g, gap: g }] : [])),
    });

    let cur = 0;
    let focused: Row | null = null;

    function paint(r: Row) {
      const dim = !!focused && r !== focused;
      r.slots.forEach((s) => (s.el.style.opacity = dim ? '.25' : ''));
      r.txt.style.opacity = r.shown ? (dim ? '.25' : '1') : '0';
      if (r.shown && r.item?.gap) {
        const g = r.item.gap;
        r.txt.lastElementChild!.textContent = r === focused ? `${g} lesson${g > 1 ? 's' : ''} ago` : `from lesson ${r.item.learned}`;
      }
    }
    function focus(row: Row | null) {
      focused = row?.item ? row : null;
      rows.forEach(paint);
    }

    // Each write gets a token: text scheduled by an older write is dropped, so fast clicks can never
    // leave another lesson's text on a row whose tiles have changed.
    function writeRow(row: Row, it: Item | null, isNew: boolean, delay: number, animate: boolean, msg: [string, string] | null) {
      const token = ++row.token;
      row.item = it;
      const chars = it ? [...it.w.zh] : [];
      const bg = isNew ? ORANGE : MUTED[((it?.learned ?? 1) - 1) % MUTED.length];
      row.slots.forEach((s, c) => {
        const v = c < chars.length ? { ch: chars[c], bg } : null;
        if (animate) flipTile(s, v, delay + c * WAVE);
        else applyTile(s, v);
      });
      row.shown = false;
      row.txt.style.opacity = '0';
      // placeholders leave as soon as a word starts coming in, and come back once the tiles have left
      if (it) row.ghosts.forEach((g) => (g.style.opacity = '0'));
      const set = () => {
        if (row.token !== token) return;
        row.ghosts.forEach((g) => (g.style.opacity = it ? '0' : '1'));
        if (!it && !msg) return;
        row.txt.style.left = `${X + (it ? chars.length : 2) * TILE + 12}px`;
        const [b, i] = [row.txt.firstElementChild!, row.txt.lastElementChild!];
        if (!it) {
          b.textContent = msg![0];
          i.textContent = msg![1];
        } else {
          b.textContent = it.w.en;
          if (isNew) i.innerHTML = '<em>new</em>';
          else i.textContent = `from lesson ${it.learned}`;
        }
        row.shown = true;
        paint(row);
      };
      if (animate && !reduceMotion()) window.setTimeout(set, delay + 2 * WAVE + FLIP * 0.6);
      else set();
    }

    function show(L: number, animate = true) {
      if (L === cur) return;
      cur = L;
      focused = null;
      head.textContent = `Lesson ${L}`;
      const { fresh, back } = lessonOf(L);
      writeRow(rows[0], fresh, true, 0, animate, null);
      rows.slice(1).forEach((row, r) =>
        writeRow(row, back[r] ?? null, false, (r + 2) * 2 * WAVE, animate, !back.length && r === 0 ? ['Nothing yet', 'back from lesson 2'] : null),
      );
      rows.forEach(paint);
      live.textContent =
        `Lesson ${L}: new word ${fresh?.w.zh} (${fresh?.w.en}). ` +
        (back.length ? `Coming back: ${back.map((b) => `${b.w.zh} (${b.w.en}, from lesson ${b.learned})`).join(', ')}.` : 'Nothing to review yet.');
    }
    const step = (d: number) => show(((cur - 1 + d + N) % N) + 1);

    root.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
    });

    // on its own: one lesson forward every few seconds, only while the card is on screen and the
    // pointer is not over it
    let over = false;
    let visible = false;
    root.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && (over = true));
    root.addEventListener('pointerleave', () => (over = false));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
    window.setInterval(() => {
      if (visible && !over && !focused && !document.hidden) step(1);
    }, 2400);

    show(Number(root.dataset.start), false);
  }
</script>
