---
// Bento card "+ Spaced review" — visual part.
// The word under review is a short row of orange tiles (src/scripts/tiles.ts), with its English below.
// Clicking the card (or Enter / Space) moves to the next word: the tiles flip in place, in a wave, and
// the row grows or shrinks, the same change as in Chunks. The English is rewritten (src/scripts/write.ts).
// The timeline below is fixed (lessons 0–20); its bars change to show when the word was learned and
// when it comes back. Reviews always come +1, +3, +7 and +14 lessons after the lesson where it was learned.
// The tiles use the pixel font: every hanzi here must be in public/fonts/zpix-site.woff.

const words = [
  { zh: '多少钱', en: 'how much', learned: 4 },
  { zh: '喝茶', en: 'drink tea', learned: 2 },
  { zh: '认识', en: 'know someone', learned: 3 },
  { zh: '朋友', en: 'friend', learned: 1 },
  { zh: '便宜', en: 'cheap', learned: 5 },
  { zh: '医院', en: 'hospital', learned: 6 },
  { zh: '米饭', en: 'rice', learned: 2 },
  { zh: '好吃', en: 'tasty', learned: 4 },
];
const GAPS = [1, 3, 7, 14];
const LESSONS = 21; // 0–20
const CENTER = 10;

const reviewsOf = (learned: number) => GAPS.map((g) => learned + g);
const fade = (i: number) => Math.max(0.06, 1 - ((i - CENTER) / CENTER) ** 2);
const kindOf = (i: number, learned: number) =>
  i === learned ? 'learned' : reviewsOf(learned).includes(i) ? 'review' : 'idle';

const first = words[0];
---

<div
  class="sr"
  data-sr
  data-words={JSON.stringify(words)}
  data-gaps={JSON.stringify(GAPS)}
  role="button"
  tabindex="0"
  aria-label="Show the next word"
>
  <div class="sr-slot">
    <div class="sr-row" data-row aria-hidden="true"></div>
    <span class="sr-en" data-en>{first.en}</span>
    <span class="sr-only" aria-live="polite" data-live>{first.zh}, {first.en}</span>
  </div>

  <div class="timeline" data-timeline aria-label={`Learned in lesson ${first.learned}, reviewed in lessons ${reviewsOf(first.learned).join(', ')}`}>
    {
      Array.from({ length: LESSONS }, (_, i) => {
        const kind = kindOf(i, first.learned);
        const op = kind === 'idle' ? fade(i) : Math.max(fade(i), 0.9);
        return (
          <div class={`tcol ${kind}`} data-lesson={i} style={`opacity:${op.toFixed(2)};--i:${i}`}>
            <i />
            <span>{kind === 'review' ? i : '·'}</span>
          </div>
        );
      })
    }
  </div>

  <div class="sr-legend label">
    <span><i class="learned"></i>learned</span>
    <span><i class="review"></i>review</span>
  </div>
</div>

<style>
  .sr {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 44px 0 12px;
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .sr:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: -6px;
  }
  .sr-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  /* the word: tiles absolutely placed around the centre by setRow */
  .sr-row {
    position: relative;
    width: 100%;
    height: 28px;
  }

  /* fixed-height line for the rewrite effect (layers overlap while one word replaces the other) */
  .sr-en {
    display: grid; /* .wline: old and new word share the cell */
    justify-items: center;
    width: 100%;
    font-size: 13px;
    line-height: 18px;
    height: 18px;
    color: var(--text);
    opacity: 0.7;
    white-space: pre;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Timeline: fixed lessons 0–20; bars change kind with an overshoot, one by one */
  .timeline {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    width: 100%;
  }
  .tcol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 7px;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }
  .tcol i {
    display: block;
    width: 7px;
    height: 14px;
    background: #2e2e2e;
    transition:
      height 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.2s ease;
    transition-delay: calc(var(--i) * 12ms);
  }
  .tcol span {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: 18px;
    color: var(--outline);
    white-space: pre;
  }
  .tcol.learned i {
    background: var(--muted);
  }
  .tcol.review i {
    height: 20px;
    background: var(--accent);
  }
  .tcol.review span {
    color: var(--accent);
  }

  .sr-legend {
    display: flex;
    gap: 16px;
    line-height: 14px;
    color: var(--muted-2);
  }
  .sr-legend span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sr-legend i {
    display: block;
    width: 6px;
    height: 6px;
  }
  .sr-legend .learned {
    background: var(--muted);
  }
  .sr-legend .review {
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .tcol,
    .tcol i {
      transition: none;
    }
  }
</style>

<script>
  import { makeSlot, setRow, ORANGE, WAVE, FLIP } from '../../scripts/tiles';
  import type { Slot, TileVal } from '../../scripts/tiles';
  import { writeLine } from '../../scripts/write';

  type Word = { zh: string; en: string; learned: number };

  const root = document.querySelector<HTMLElement>('[data-sr]');
  if (root) {
    const row = root.querySelector<HTMLElement>('[data-row]')!;
    const enEl = root.querySelector<HTMLElement>('[data-en]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const timeline = root.querySelector<HTMLElement>('[data-timeline]')!;
    const cols = [...timeline.querySelectorAll<HTMLElement>('.tcol')];
    const words: Word[] = JSON.parse(root.dataset.words!);
    const GAPS: number[] = JSON.parse(root.dataset.gaps!);

    const MAXC = Math.max(...words.map((w) => [...w.zh].length));
    const slots: Slot[] = Array.from({ length: MAXC }, () => makeSlot(row, 'abs'));
    const valsOf = (w: Word): TileVal[] => [...w.zh].map((ch) => ({ ch, bg: ORANGE }));

    function updateTimeline(w: Word) {
      const reviews = GAPS.map((g) => w.learned + g);
      cols.forEach((c) => {
        const i = Number(c.dataset.lesson);
        const kind = i === w.learned ? 'learned' : reviews.includes(i) ? 'review' : 'idle';
        const fade = Math.max(0.06, 1 - ((i - 10) / 10) ** 2);
        c.classList.remove('learned', 'review', 'idle');
        c.classList.add(kind);
        c.style.opacity = (kind === 'idle' ? fade : Math.max(fade, 0.9)).toFixed(2);
        c.querySelector('span')!.textContent = kind === 'review' ? String(i) : '·';
      });
      timeline.setAttribute('aria-label', `Learned in lesson ${w.learned}, reviewed in lessons ${reviews.join(', ')}`);
    }

    let cur = 0;
    let busy = false;
    setRow(row, slots, valsOf(words[0]), false);
    writeLine(enEl, words[0].en, false);

    function next() {
      if (busy) return;
      busy = true;
      cur = (cur + 1) % words.length;
      const w = words[cur];
      setRow(row, slots, valsOf(w));
      writeLine(enEl, w.en);
      updateTimeline(w);
      live.textContent = `${w.zh}, ${w.en}`;
      window.setTimeout(() => (busy = false), (MAXC - 1) * WAVE + FLIP + 40);
    }

    root.addEventListener('click', next);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        next();
      }
    });
  }
</script>
