---
// Bento card "+ Spaced review" — visual part (Paper node AM8-0).
// An infinite carousel of three chunks seen through a fisheye: the centre chunk is big, the neighbours
// (orange) sit close by, turned away like on a drum, and the line fades out towards both edges.
// Embla Carousel runs the carousel (loop, drag/swipe, click a neighbour, ←/→); the fisheye is applied
// from Embla's scroll position on every frame. The timeline below is
// fixed (lessons 0–20); its bars change to show when the centre chunk was learned and reviewed.
// Reviews always come +1, +3, +7 and +14 lessons after the lesson where the chunk was learned.

const words = [
  { zh: '打包', en: 'take away', learned: 2 },
  { zh: '坐地铁', en: 'take the subway', learned: 4 },
  { zh: '推荐', en: 'recommend', learned: 3 },
];
const START = 1;
const GAPS = [1, 3, 7, 14];
const LESSONS = 21; // 0–20
const CENTER = 10;

const reviewsOf = (learned: number) => GAPS.map((g) => learned + g);
const fade = (i: number) => Math.max(0.06, 1 - ((i - CENTER) / CENTER) ** 2);
const kindOf = (i: number, learned: number) =>
  i === learned ? 'learned' : reviewsOf(learned).includes(i) ? 'review' : 'idle';

const first = words[START];
// each word appears twice so the carousel can wrap without items flying across
const doubled = [...words, ...words];
const slotOf = (i: number) => {
  const N = doubled.length;
  let r = (((i - START) % N) + N) % N;
  if (r >= N / 2) r -= N;
  return Math.max(-2, Math.min(2, r));
};
---

<div
  class="sr"
  data-sr
  data-start={START}
  data-words={JSON.stringify(words)}
  data-gaps={JSON.stringify(GAPS)}
>
  <div class="sr-slot">
    <div class="sr-line" tabindex="0" role="spinbutton" aria-label="Chunk" aria-valuetext={first.zh}>
      <div class="sr-track">
        {
          doubled.map((w, i) => (
            <div class="sr-slide">
              <span class="w" data-i={i} data-s={slotOf(i)}>
                {w.zh}
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <span class="sr-en" data-en>{first.en}</span>
  </div>

  <div class="timeline" data-timeline aria-live="polite" aria-label={`Learned in lesson ${first.learned}, reviewed in lessons ${reviewsOf(first.learned).join(', ')}`}>
    {
      Array.from({ length: LESSONS }, (_, i) => {
        const kind = kindOf(i, first.learned);
        const op = kind === 'idle' ? fade(i) : Math.max(fade(i), 0.9);
        return (
          <div class={`tcol ${kind}`} data-lesson={i} style={`opacity:${op.toFixed(2)};--i:${i}`}>
            <i />
            <span>{kind === 'review' ? i : '·'}</span>
          </div>
        );
      })
    }
  </div>

  <div class="sr-legend label">
    <span><i class="learned"></i>learned</span>
    <span><i class="review"></i>review</span>
  </div>
</div>

<style>
  .sr {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 44px 0 12px;
    overflow: hidden;
  }
  .sr-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 100%;
  }

  /* Carousel line: 40px tall; items are absolutely placed around the centre by the script */
  .sr-line {
    position: relative;
    width: 100%;
    height: 40px;
    overflow: hidden; /* Embla viewport */
    outline: none;
    user-select: none;
    -webkit-user-select: none;
    /* fade out towards both edges */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 42%, #000 58%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 42%, #000 58%, transparent 100%);
  }
  .sr-line:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 2px;
  }
  /* Embla track: every slide is 80px wide, the centre slide sits in the middle of the line */
  .sr-track {
    display: flex;
    height: 100%;
    touch-action: pan-y pinch-zoom;
  }
  /* landing "tchuk": slides overshoot a little past their spot and snap back (on top of Embla's
     own transform, which moves the track) */
  .sr-line.tchuk .sr-slide {
    animation: sr-tchuk 0.32s cubic-bezier(0.3, 0, 0.2, 1);
  }
  @keyframes sr-tchuk {
    30% {
      translate: calc(var(--dir, 1) * 7px) 0;
    }
    60% {
      translate: calc(var(--dir, 1) * -2px) 0;
    }
    100% {
      translate: 0 0;
    }
  }
  .sr-slide {
    flex: 0 0 80px;
    min-width: 0;
    display: grid;
    place-items: center;
    cursor: grab;
  }
  .sr-line:active .sr-slide {
    cursor: grabbing;
  }
  .w {
    white-space: pre;
    font-family: var(--f-display);
    font-weight: var(--fw-display);
    font-size: 24px;
    line-height: 32px;
    color: var(--accent);
    /* fisheye (set per frame by the script): neighbours turn away like on a drum */
    transform: perspective(110px) rotateY(var(--ry, 0deg)) scale(var(--sc, 1));
    pointer-events: none;
  }
  .w[data-s='0'] {
    font-family: var(--f-brush);
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
    color: var(--text);
  }

  .sr-en {
    font-size: 13px;
    line-height: 18px;
    color: var(--text);
    opacity: 0.7;
    white-space: pre;
    min-height: 18px;
    transition: opacity 0.15s ease;
  }

  /* Timeline: fixed lessons 0–20; bars change kind with an overshoot, one by one */
  .timeline {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    width: 100%;
  }
  .tcol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 7px;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }
  .tcol i {
    display: block;
    width: 7px;
    height: 14px;
    background: #2e2e2e;
    transition:
      height 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.2s ease;
    transition-delay: calc(var(--i) * 12ms);
  }
  .tcol span {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: 18px;
    color: var(--outline);
    white-space: pre;
  }
  .tcol.learned i {
    background: var(--muted);
  }
  .tcol.review i {
    height: 20px;
    background: var(--accent);
  }
  .tcol.review span {
    color: var(--accent);
  }

  .sr-legend {
    display: flex;
    gap: 16px;
    line-height: 14px;
    color: var(--muted-2);
  }
  .sr-legend span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sr-legend i {
    display: block;
    width: 6px;
    height: 6px;
  }
  .sr-legend .learned {
    background: var(--muted);
  }
  .sr-legend .review {
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .tcol,
    .tcol i {
      transition: none;
    }
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  type Word = { zh: string; en: string; learned: number };

  const root = document.querySelector<HTMLElement>('[data-sr]')!;
  const line = root.querySelector<HTMLElement>('.sr-line')!;
  const enEl = root.querySelector<HTMLElement>('[data-en]')!;
  const timeline = root.querySelector<HTMLElement>('[data-timeline]')!;
  const cols = [...timeline.querySelectorAll<HTMLElement>('.tcol')];
  const words: Word[] = JSON.parse(root.dataset.words!);
  const GAPS: number[] = JSON.parse(root.dataset.gaps!);
  const n = words.length;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Roulette feel: a quick fling can spin past many words (skipSnaps) and glides longer before it
  // stops (duration); when it comes to rest it lands with a small "tchuk" (see settle below).
  const embla = EmblaCarousel(line, {
    loop: true,
    align: 'center',
    startIndex: Number(root.dataset.start),
    skipSnaps: true,
    duration: reduce ? 0 : 45,
    dragThreshold: 4,
  });
  const slides = embla.slideNodes();
  const ws = slides.map((s) => s.querySelector<HTMLElement>('.w')!);

  // Fisheye from Embla's position: d = how many slides away from the centre each word is.
  function fisheye() {
    const engine = embla.internalEngine();
    const progress = embla.scrollProgress();
    const snaps = embla.scrollSnapList();
    snaps.forEach((snap, snapIndex) => {
      let diff = snap - progress;
      engine.slideRegistry[snapIndex].forEach((slideIndex) => {
        if (engine.options.loop) {
          engine.slideLooper.loopPoints.forEach((loopItem) => {
            const target = loopItem.target();
            if (slideIndex === loopItem.index && target !== 0) {
              const sign = Math.sign(target);
              if (sign === -1) diff = snap - (1 + progress);
              if (sign === 1) diff = snap + (1 - progress);
            }
          });
        }
        const d = diff * snaps.length; // in slides
        const a = Math.abs(d);
        const w = ws[slideIndex];
        const s = a < 0.5 ? 0 : Math.sign(d);
        if (w.dataset.s !== String(s)) w.dataset.s = String(s);
        // size eases from 32 (centre) to 24 (neighbour); scale compensates for the current font
        const size = 32 - 8 * Math.min(a, 1);
        w.style.setProperty('--sc', (size / (s === 0 ? 32 : 24)).toFixed(4));
        w.style.setProperty('--ry', `${(-Math.max(-78, Math.min(78, d * 56))).toFixed(2)}deg`);
        w.style.opacity = String(a <= 1 ? 1 - 0.15 * a : Math.max(0, 0.85 * (2 - a)));
      });
    });
  }

  function updateTimeline(w: Word) {
    const reviews = GAPS.map((g) => w.learned + g);
    cols.forEach((c) => {
      const i = Number(c.dataset.lesson);
      const kind = i === w.learned ? 'learned' : reviews.includes(i) ? 'review' : 'idle';
      const fade = Math.max(0.06, 1 - ((i - 10) / 10) ** 2);
      c.classList.remove('learned', 'review', 'idle');
      c.classList.add(kind);
      c.style.opacity = (kind === 'idle' ? fade : Math.max(fade, 0.9)).toFixed(2);
      c.querySelector('span')!.textContent = kind === 'review' ? String(i) : '·';
    });
    timeline.setAttribute('aria-label', `Learned in lesson ${w.learned}, reviewed in lessons ${reviews.join(', ')}`);
  }

  let enTimer = 0;
  let shown = embla.selectedScrollSnap() % n;
  embla.on('select', () => {
    const k = embla.selectedScrollSnap() % n;
    if (k === shown) return;
    shown = k;
    const w = words[k];
    line.setAttribute('aria-valuetext', w.zh);
    updateTimeline(w);
    // English line swaps as the new chunk settles
    clearTimeout(enTimer);
    enEl.style.opacity = '0';
    enTimer = window.setTimeout(
      () => {
        enEl.textContent = w.en;
        enEl.style.opacity = '';
      },
      reduce ? 0 : 230,
    );
  });
  // direction of travel, so the landing kicks the right way
  let lastProgress = embla.scrollProgress();
  let dir = 1;
  embla.on('scroll', () => {
    const p = embla.scrollProgress();
    let d = p - lastProgress;
    if (d > 0.5) d -= 1; // wrapped around the loop
    if (d < -0.5) d += 1;
    if (Math.abs(d) > 0.0005) dir = d > 0 ? 1 : -1;
    lastProgress = p;
    fisheye();
  });
  embla.on('reInit', fisheye);
  // landing: overshoot a few px past the word, then click back into place
  embla.on('settle', () => {
    if (reduce) return;
    line.style.setProperty('--dir', String(-dir));
    line.classList.remove('tchuk');
    void line.offsetWidth;
    line.classList.add('tchuk');
  });
  embla.on('pointerDown', () => line.classList.remove('tchuk'));

  // click a neighbour to bring it to the centre
  slides.forEach((slide, i) =>
    slide.addEventListener('click', () => {
      if (embla.clickAllowed()) embla.scrollTo(i);
    }),
  );
  line.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      embla.scrollNext();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      embla.scrollPrev();
    }
  });

  fisheye();
</script>
