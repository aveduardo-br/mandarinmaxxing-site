---
// Bento card "+ Spaced review" — visual part (Paper node AM8-0).
// An infinite carousel of three chunks seen through a fisheye: the centre chunk is big, the neighbours
// (orange) sit close by, turned away like on a drum, and the line fades out towards both edges.
// Clicking a neighbour moves the carousel one step with the same easeOutBack overshoot as the Chunks slot. The timeline below is
// fixed (lessons 0–20); its bars change to show when the centre chunk was learned and reviewed.
// Reviews always come +1, +3, +7 and +14 lessons after the lesson where the chunk was learned.

const words = [
  { zh: '打包', en: 'take away', learned: 2 },
  { zh: '坐地铁', en: 'take the subway', learned: 4 },
  { zh: '推荐', en: 'recommend', learned: 3 },
];
const START = 1;
const GAPS = [1, 3, 7, 14];
const LESSONS = 21; // 0–20
const CENTER = 10;

const reviewsOf = (learned: number) => GAPS.map((g) => learned + g);
const fade = (i: number) => Math.max(0.06, 1 - ((i - CENTER) / CENTER) ** 2);
const kindOf = (i: number, learned: number) =>
  i === learned ? 'learned' : reviewsOf(learned).includes(i) ? 'review' : 'idle';

const first = words[START];
// each word appears twice so the carousel can wrap without items flying across
const doubled = [...words, ...words];
const slotOf = (i: number) => {
  const N = doubled.length;
  let r = (((i - START) % N) + N) % N;
  if (r >= N / 2) r -= N;
  return Math.max(-2, Math.min(2, r));
};
---

<div
  class="sr"
  data-sr
  data-start={START}
  data-words={JSON.stringify(words)}
  data-gaps={JSON.stringify(GAPS)}
>
  <div class="sr-slot">
    <div class="sr-line" tabindex="0" role="spinbutton" aria-label="Chunk" aria-valuetext={first.zh}>
      {doubled.map((w, i) => <span class="w" data-i={i} data-s={slotOf(i)}>{w.zh}</span>)}
    </div>
    <span class="sr-en" data-en>{first.en}</span>
  </div>

  <div class="timeline" data-timeline aria-live="polite" aria-label={`Learned in lesson ${first.learned}, reviewed in lessons ${reviewsOf(first.learned).join(', ')}`}>
    {
      Array.from({ length: LESSONS }, (_, i) => {
        const kind = kindOf(i, first.learned);
        const op = kind === 'idle' ? fade(i) : Math.max(fade(i), 0.9);
        return (
          <div class={`tcol ${kind}`} data-lesson={i} style={`opacity:${op.toFixed(2)};--i:${i}`}>
            <i />
            <span class="pixel">{kind === 'review' ? i : '·'}</span>
          </div>
        );
      })
    }
  </div>

  <div class="sr-legend label">
    <span><i class="learned"></i>learned</span>
    <span><i class="review"></i>review</span>
  </div>
</div>

<style>
  .sr {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 44px 0 12px;
    overflow: hidden;
  }
  .sr-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 100%;
  }

  /* Carousel line: 40px tall; items are absolutely placed around the centre by the script */
  .sr-line {
    position: relative;
    width: 100%;
    height: 40px;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
    /* fade out towards both edges */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 42%, #000 58%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 42%, #000 58%, transparent 100%);
  }
  .sr-line:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 2px;
  }
  .w {
    position: absolute;
    left: 50%;
    top: 50%;
    white-space: pre;
    font-family: var(--f-pixel);
    font-weight: 500;
    font-size: 12px;
    line-height: 18px;
    color: var(--accent);
    opacity: 0;
    pointer-events: none;
    translate: calc(-50% + var(--x, 0px)) -50%;
    /* fisheye: neighbours turn away from the viewer like on a drum */
    transform: perspective(160px) rotateY(var(--ry, 0deg));
  }
  .w[data-s='-2'] {
    --x: -112px;
    --ry: -70deg;
  }
  .w[data-s='-1'] {
    --x: -68px;
    --ry: -42deg;
    opacity: 0.7;
  }
  .w[data-s='0'] {
    font-family: var(--f-brush);
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
    color: var(--text);
    opacity: 1;
  }
  .w[data-s='1'] {
    --x: 68px;
    --ry: 42deg;
    opacity: 0.7;
  }
  .w[data-s='2'] {
    --x: 112px;
    --ry: 70deg;
  }
  .w[data-s='-1'],
  .w[data-s='1'] {
    pointer-events: auto;
    cursor: pointer;
  }
  .w[data-s='-1']:hover,
  .w[data-s='1']:hover {
    opacity: 1;
  }

  .sr-en {
    font-size: 13px;
    line-height: 18px;
    color: var(--text);
    opacity: 0.7;
    white-space: pre;
    min-height: 18px;
    transition: opacity 0.15s ease;
  }

  /* Timeline: fixed lessons 0–20; bars change kind with an overshoot, one by one */
  .timeline {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    width: 100%;
  }
  .tcol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 7px;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }
  .tcol i {
    display: block;
    width: 7px;
    height: 14px;
    background: #2e2e2e;
    transition:
      height 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.2s ease;
    transition-delay: calc(var(--i) * 12ms);
  }
  .tcol span {
    font-size: 12px;
    line-height: 18px;
    color: var(--outline);
    white-space: pre;
  }
  .tcol.learned i {
    background: var(--muted);
  }
  .tcol.review i {
    height: 20px;
    background: var(--accent);
  }
  .tcol.review span {
    color: var(--accent);
  }

  .sr-legend {
    display: flex;
    gap: 16px;
    line-height: 14px;
    color: var(--muted-2);
  }
  .sr-legend span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sr-legend i {
    display: block;
    width: 6px;
    height: 6px;
  }
  .sr-legend .learned {
    background: var(--muted);
  }
  .sr-legend .review {
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .tcol,
    .tcol i {
      transition: none;
    }
  }
</style>

<script>
  type Word = { zh: string; en: string; learned: number };

  const root = document.querySelector<HTMLElement>('[data-sr]')!;
  const line = root.querySelector<HTMLElement>('.sr-line')!;
  const enEl = root.querySelector<HTMLElement>('[data-en]')!;
  const timeline = root.querySelector<HTMLElement>('[data-timeline]')!;
  const cols = [...timeline.querySelectorAll<HTMLElement>('.tcol')];
  const items = [...line.querySelectorAll<HTMLElement>('.w')];
  const words: Word[] = JSON.parse(root.dataset.words!);
  const GAPS: number[] = JSON.parse(root.dataset.gaps!);
  const n = words.length;
  const N = items.length; // 2n
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Same motion as the Chunks slot: Penner's easeOutBack, font swaps partway through.
  const DURATION = 380;
  const C1 = 1.70158;
  const C3 = C1 + 1;
  const easeOutBack = (t: number) => 1 + C3 * Math.pow(t - 1, 3) + C1 * Math.pow(t - 1, 2);
  const X: Record<number, number> = { [-2]: -112, [-1]: -68, 0: 0, 1: 68, 2: 112 };
  const RY: Record<number, number> = { [-2]: -70, [-1]: -42, 0: 0, 1: 42, 2: 70 };
  const SIZE: Record<number, number> = { [-2]: 12, [-1]: 12, 0: 32, 1: 12, 2: 12 };
  const OP: Record<number, number> = { [-2]: 0, [-1]: 0.7, 0: 1, 1: 0.7, 2: 0 };

  let pos = Number(root.dataset.start);
  const rel = (i: number) => {
    let s = (((i - pos) % N) + N) % N;
    if (s >= N / 2) s -= N;
    return Math.max(-2, Math.min(2, s));
  };

  function place() {
    items.forEach((it, i) => (it.dataset.s = String(rel(i))));
  }

  let raf = 0;
  let finish: (() => void) | null = null;

  function animate(prev: number[], next: number[]) {
    finish?.();
    const moving = items
      .map((it, i) => ({ it, from: prev[i], to: next[i] }))
      .filter((m) => m.from !== m.to && Math.abs(m.from - m.to) <= 2);
    items.forEach((it, i) => {
      if (Math.abs(prev[i] - next[i]) > 2) it.dataset.s = String(next[i]);
    });
    const done = () => {
      cancelAnimationFrame(raf);
      for (const m of moving) {
        m.it.dataset.s = String(m.to);
        m.it.style.removeProperty('--x');
        m.it.style.removeProperty('--ry');
        m.it.style.scale = m.it.style.opacity = '';
      }
      finish = null;
    };
    if (reduce) return done();
    finish = done;
    const t0 = performance.now();
    const frame = (now: number) => {
      const t = Math.min(1, (now - t0) / DURATION);
      const e = easeOutBack(t);
      const f = t * t * (3 - 2 * t);
      for (const { it, from, to } of moving) {
        const s = e < 0.5 ? from : to;
        if (it.dataset.s !== String(s)) it.dataset.s = String(s);
        const size = SIZE[from] + (SIZE[to] - SIZE[from]) * e;
        it.style.setProperty('--x', `${(X[from] + (X[to] - X[from]) * e).toFixed(2)}px`);
        it.style.setProperty('--ry', `${(RY[from] + (RY[to] - RY[from]) * e).toFixed(2)}deg`);
        it.style.scale = (size / SIZE[s]).toFixed(4);
        it.style.opacity = String(OP[from] + (OP[to] - OP[from]) * f);
      }
      if (t < 1) raf = requestAnimationFrame(frame);
      else done();
    };
    raf = requestAnimationFrame(frame);
  }

  function updateTimeline(w: Word) {
    const reviews = GAPS.map((g) => w.learned + g);
    cols.forEach((c) => {
      const i = Number(c.dataset.lesson);
      const kind = i === w.learned ? 'learned' : reviews.includes(i) ? 'review' : 'idle';
      const fade = Math.max(0.06, 1 - ((i - 10) / 10) ** 2);
      c.classList.remove('learned', 'review', 'idle');
      c.classList.add(kind);
      c.style.opacity = (kind === 'idle' ? fade : Math.max(fade, 0.9)).toFixed(2);
      c.querySelector('span')!.textContent = kind === 'review' ? String(i) : '·';
    });
    timeline.setAttribute(
      'aria-label',
      `Learned in lesson ${w.learned}, reviewed in lessons ${reviews.join(', ')}`,
    );
  }

  let enTimer = 0;
  function step(d: number) {
    const prev = items.map((_, i) => rel(i));
    pos = (((pos + d) % N) + N) % N;
    const next = items.map((_, i) => rel(i));
    animate(prev, next);
    const w = words[pos % n];
    line.setAttribute('aria-valuetext', w.zh);
    updateTimeline(w);
    // English line swaps when the new chunk settles
    clearTimeout(enTimer);
    enEl.style.opacity = '0';
    enTimer = window.setTimeout(
      () => {
        enEl.textContent = w.en;
        enEl.style.opacity = '';
      },
      reduce ? 0 : DURATION * 0.6,
    );
  }

  line.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const w = t.closest<HTMLElement>('.w');
    if (w && (w.dataset.s === '-1' || w.dataset.s === '1')) step(Number(w.dataset.s));
  });
  line.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      step(1);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      step(-1);
    }
  });

  place();
</script>
