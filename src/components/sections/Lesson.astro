---
// Section 04 — Paper node 2M-0 (bento 9KE-0). Card interactions are added one by one.
import Section from '../Section.astro';
import QuickReview from './QuickReview.astro';
import SpacedReview from './SpacedReview.astro';
import TranslationChat from './TranslationChat.astro';
import DialogueCard from './DialogueCard.astro';

// Vocabulary card: hovering a row makes it active (the last one hovered stays) and swaps the useful
// chunk below for one that uses that word. [before, word, after] so the word can be highlighted.
// The chunk is shown in tiles (docs/ladrilhos.md): the row's word in orange, the rest dimmed.
// Punctuation is left out of the tiles; the English line keeps it.
// Words from Lesson 13 of the HSK 1 map, "Shopping and paying".
const vocab = [
  {
    hanzi: '买',
    pinyin: 'mǎi',
    meaning: 'buy',
    zh: ['我想', '买', '这个'],
    en: ['I want to ', 'buy', ' this one.'],
  },
  {
    hanzi: '钱',
    pinyin: 'qián',
    meaning: 'money',
    zh: ['我没有', '钱', ''],
    en: ['I don’t have ', 'money', '.'],
  },
  {
    hanzi: '贵',
    pinyin: 'guì',
    meaning: 'expensive',
    zh: ['太', '贵', '了'],
    en: ['Too ', 'expensive', '!'],
  },
  {
    hanzi: '便宜',
    pinyin: 'piányi',
    meaning: 'cheap',
    zh: ['', '便宜', '一点儿，可以吗？'],
    en: ['A bit ', 'cheaper', ', OK?'],
  },
];

---

<Section id="lesson" num="04" title="Every lesson follows the same four steps">
  <p class="prose">
    Each situation is studied over a few lessons, with a few new words each time. Every lesson goes review, new
    words, translation, and a short text. Same order every time, so you always know what comes next.
  </p>

  <div class="bento">
    <div class="bento-row">
      <!-- 01 Quick review -->
      <article class="card grow">
        <div class="visual">
          <QuickReview />
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag display">01</span><h3>Quick review</h3></div>
          <p>A few sentences to translate with the words from your last lesson, mixed with older ones.</p>
        </footer>
      </article>

      <!-- + Spaced review -->
      <article class="card spaced">
        <SpacedReview />
        <footer class="foot">
          <div class="foot-head"><span class="tag display">+</span><h3>Spaced review</h3></div>
          <p>Words from 3, 7 and 14 lessons ago come back in the exercises.</p>
        </footer>
      </article>
    </div>

    <div class="bento-row">
      <!-- 02 Vocabulary and chunks -->
      <article class="card half">
        <div class="visual vocab">
          <div class="vtable" data-vocab={JSON.stringify(vocab.map((v) => ({ zh: v.zh, en: v.en })))}>
            <div class="vrow vhead label"><span>Hanzi</span><span>Pinyin</span><span>Meaning</span></div>
            {
              vocab.map((v, i) => (
                <div class:list={['vrow', { active: i === 0 }]} data-row={i} tabindex="0">
                  <span class="hanzi">{v.hanzi}</span>
                  <span>{v.pinyin}</span>
                  <span>{v.meaning}</span>
                </div>
              ))
            }
          </div>
          <div class="fieldset chunk">
            <div class="edge top">
              <span class="line"></span><span class="cap label cap-label">USEFUL CHUNK</span><span class="line"></span>
            </div>
            <div class="body chunk-body">
              <div class="chunk-tiles" data-chunk-zh lang="zh-Hans" aria-label={vocab[0].zh.join('')}></div>
            </div>
            <div class="edge bottom">
              <span class="line"></span><span class="cap cap-en" data-chunk-en>{vocab[0].en[0]}<span class="hl">{vocab[0].en[1]}</span>{vocab[0].en[2]}</span><span
                class="line"></span>
            </div>
          </div>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag display">02</span><h3>New words and chunks</h3></div>
          <p>A table with hanzi, pinyin and meaning, then the phrases they make.</p>
        </footer>
      </article>

      <!-- 03 Written translation -->
      <article class="card half">
        <TranslationChat />
        <footer class="foot">
          <div class="foot-head"><span class="tag display">03</span><h3>Written translation</h3></div>
          <p>One sentence at a time, from your language into Mandarin. You see what to change and the corrected sentence.</p>
        </footer>
      </article>
    </div>

    <!-- 04 Dialogue and comprehension -->
    <article class="card">
      <DialogueCard />
      <footer class="foot">
        <div class="foot-head"><span class="tag display">04</span><h3>A short text to close</h3></div>
        <p>With audio, you listen without seeing the text and answer what you understood. Without it, you read the text and rewrite it with a few changes.</p>
      </footer>
    </article>
  </div>
</Section>

<style>
  .bento {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bento-row {
    display: flex;
    gap: 12px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--card-border);
  }
  .card.grow,
  .card.half {
    flex: 1 1 0;
    min-width: 0;
  }
  .card.spaced {
    width: 236px;
    flex-shrink: 0;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px 20px;
  }
  .foot-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .foot .tag {
    font-size: var(--fs-caption);
    line-height: var(--lh-h4);
    color: var(--muted);
  }
  .foot h3 {
    font-family: var(--f-display);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    font-weight: var(--fw-display);
    letter-spacing: var(--tr-display);
    color: var(--text);
  }
  .foot p {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
  }

  .visual {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  /* chat cards */
  .chat {
    gap: 10px;
    padding: 24px 20px 20px;
  }
  .chat.center {
    padding: 20px;
    justify-content: center;
  }
  .step {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-block: 5px;
    font-size: 12px;
    line-height: 16px;
    color: var(--muted);
    white-space: pre;
  }
  .step .chev {
    color: var(--muted-2);
  }
  .q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .fb {
    font-size: 13px;
    line-height: 20px;
    color: var(--text-dim);
  }
  /* hanzi in bubbles share the 20px line of the other messages, so every one-line bubble
     has the same height */
  .a24 {
    font-size: 18px;
    line-height: 20px;
    color: var(--text);
    white-space: pre;
  }
  .a20 {
    font-size: 18px;
    line-height: 20px;
    color: var(--text);
  }
  .ok {
    color: var(--ok);
  }
  /* inside the orange user bubble, highlighted words go dark so they still stand out */
  .chat :global(.bubble.user) .hl-light,
  .chat :global(.bubble.user) .hl-mid {
    color: rgba(242, 242, 242, 0.7);
  }
  .hl-light {
    color: var(--accent-light);
  }
  .hl-mid {
    color: var(--accent-mid);
  }
  .hl {
    color: var(--accent);
  }
  .muted2 {
    color: var(--muted-2);
  }
  /* two-line bubbles: same 20px lines and gap, so they match each other too */
  .chat :global(.bubble.stack) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .chat :global(.bubble.stack) .label {
    line-height: 20px;
  }

  /* vocabulary */
  .vocab {
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .vtable {
    display: flex;
    flex-direction: column;
    width: 268px;
  }
  .vrow {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    border-bottom: 1px solid var(--divider);
    opacity: 0.35;
  }
  .vrow > span {
    width: 84px;
    flex-shrink: 0;
    text-align: center;
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
  }
  .vrow > .hanzi {
    font-size: 24px;
    line-height: 30px;
    white-space: pre;
  }
  .vrow:not(.vhead) {
    cursor: default;
    outline: none;
    transition: opacity 0.18s ease;
  }
  .vrow > span {
    transition: color 0.18s ease;
  }
  .vrow.active {
    opacity: 1;
  }
  .vrow.active > span {
    color: var(--text-soft);
  }
  .vrow.active > .hanzi {
    color: var(--accent);
  }
  .vrow.vhead {
    align-items: flex-start;
    height: 25px;
    padding-bottom: 10px;
    opacity: 1;
  }
  .vrow.vhead > span {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: 14px;
    color: var(--muted-2);
  }
  .chunk {
    width: 252px;
    margin-top: 24px;
  }
  .cap-label {
    font-size: var(--fs-label);
    line-height: 18px;
    color: var(--muted-2);
  }
  .cap-en {
    font-size: var(--fs-caption);
    line-height: 18px;
    color: var(--muted);
    white-space: pre;
  }
  /* the glitch rebuilds these spans in JS, so the highlight must be global */
  .chunk-body :global(.hl),
  .cap-en :global(.hl) {
    color: var(--accent);
  }
  .chunk-body {
    display: flex;
    justify-content: center;
    padding-block: 14px;
  }
  /* a centred row of tiles; its length changes with the chunk (src/scripts/tiles.ts) */
  .chunk-tiles {
    position: relative;
    width: 100%;
    height: 28px;
  }

</style>

<script>
  import { makeSlot, setRow, ORANGE, DIM } from '../../scripts/tiles';
  import type { TileVal } from '../../scripts/tiles';

  // Vocabulary card: last hovered (or focused) row is active. The chunk's tiles flip to the new chunk;
  // the English line swaps with a glitch, scrambling characters before they settle left to right.
  type Parts = [string, string, string];
  const table = document.querySelector<HTMLElement>('[data-vocab]');
  if (table) {
    const data: { zh: Parts; en: Parts }[] = JSON.parse(table.dataset.vocab!);
    const rows = [...table.querySelectorAll<HTMLElement>('[data-row]')];
    const zhEl = document.querySelector<HTMLElement>('[data-chunk-zh]')!;
    const enEl = document.querySelector<HTMLElement>('[data-chunk-en]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const PUNCT = /[\s,.?!？，。、！]/;
    const tilesOf = (parts: Parts): TileVal[] => [
      ...[...parts[0]].filter((c) => !PUNCT.test(c)).map((ch) => ({ ch, bg: DIM.bg, fg: DIM.fg })),
      ...[...parts[1]].map((ch) => ({ ch, bg: ORANGE })),
      ...[...parts[2]].filter((c) => !PUNCT.test(c)).map((ch) => ({ ch, bg: DIM.bg, fg: DIM.fg })),
    ];
    const longest = Math.max(...data.map((d) => tilesOf(d.zh).length));
    const chunkSlots = Array.from({ length: longest }, () => makeSlot(zhEl, 'abs'));
    setRow(zhEl, chunkSlots, tilesOf(data[0].zh), false);
    const LATIN = 'abcdefghijklmnopqrstuvwxyz';
    const DURATION = 460;
    const TICK = 34;
    const timers = new WeakMap<HTMLElement, number>();

    const render = (el: HTMLElement, chars: string[], hl: [number, number]) => {
      const before = chars.slice(0, hl[0]).join('');
      const word = chars.slice(hl[0], hl[1]).join('');
      const after = chars.slice(hl[1]).join('');
      el.replaceChildren(document.createTextNode(before), Object.assign(document.createElement('span'), { className: 'hl', textContent: word }), document.createTextNode(after));
    };

    function glitch(el: HTMLElement, parts: Parts, pool: string) {
      clearInterval(timers.get(el));
      const target = [...parts.join('')];
      const hl: [number, number] = [[...parts[0]].length, [...parts[0]].length + [...parts[1]].length];
      if (reduce) return render(el, target, hl);
      const keep = (c: string) => /[\s,.?!？，。'’]/.test(c);
      const rand = () => pool[(Math.random() * pool.length) | 0];
      const t0 = performance.now();
      const tick = () => {
        const p = Math.min(1, (performance.now() - t0) / DURATION);
        // characters settle left to right; the rest keep flickering
        const settled = Math.floor(p * p * (target.length + 1));
        const chars = target.map((c, i) => (i < settled || keep(c) ? c : rand()));
        render(el, chars, hl);
        if (p >= 1) {
          clearInterval(timers.get(el));
          render(el, target, hl);
        }
      };
      tick();
      timers.set(el, window.setInterval(tick, TICK));
    }

    let active = 0;
    const activate = (i: number) => {
      if (i === active) return;
      rows[active].classList.remove('active');
      rows[i].classList.add('active');
      active = i;
      setRow(zhEl, chunkSlots, tilesOf(data[i].zh));
      zhEl.setAttribute('aria-label', data[i].zh.join(''));
      glitch(enEl, data[i].en, LATIN);
    };
    rows.forEach((row, i) => {
      row.addEventListener('pointerenter', () => activate(i));
      row.addEventListener('focus', () => activate(i));
    });
  }
</script>
