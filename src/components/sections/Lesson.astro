---
// Section 04 — Paper node 2M-0 (bento 9KE-0). Card interactions are added one by one.
import Section from '../Section.astro';
import QuickReview from './QuickReview.astro';
import SpacedReview from './SpacedReview.astro';
import TranslationChat from './TranslationChat.astro';
import DialogueCard from './DialogueCard.astro';

// Vocabulary card: hovering a row makes it active (the last one hovered stays) and swaps the useful
// chunk below for one that uses that word. [before, word, after] so the word can be highlighted.
const vocab = [
  {
    hanzi: '菜单',
    pinyin: 'càidān',
    meaning: 'menu',
    zh: ['请给我', '菜单', ''],
    en: ['The ', 'menu', ', please.'],
  },
  {
    hanzi: '味道',
    pinyin: 'wèidào',
    meaning: 'taste',
    zh: ['', '味道', '怎么样？'],
    en: ['How does it ', 'taste', '?'],
  },
  {
    hanzi: '推荐',
    pinyin: 'tuījiàn',
    meaning: 'recommend',
    zh: ['你有什么', '推荐', '？'],
    en: ['What do you ', 'recommend', '?'],
  },
  {
    hanzi: '打包',
    pinyin: 'dǎbāo',
    meaning: 'to go',
    zh: ['我要', '打包', ''],
    en: ["I'd like it ", 'to go', '.'],
  },
];

---

<Section id="lesson" num="04" title="Every lesson follows the same four steps">
  <p class="prose">
    Review, new words, translation, dialogue. Same order every time, so you always know what comes next, and older
    words keep coming back along the way.
  </p>

  <div class="bento">
    <div class="bento-row">
      <!-- 01 Quick review -->
      <article class="card grow">
        <div class="visual">
          <QuickReview />
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag display">01</span><h3>Quick review</h3></div>
          <p>Short questions on the last lesson, mixed with older chunks that are due to come back.</p>
        </footer>
      </article>

      <!-- + Spaced review -->
      <article class="card spaced">
        <SpacedReview />
        <footer class="foot">
          <div class="foot-head"><span class="tag display">+</span><h3>Spaced review</h3></div>
          <p>Older words return later, so they don’t fade.</p>
        </footer>
      </article>
    </div>

    <div class="bento-row">
      <!-- 02 Vocabulary and chunks -->
      <article class="card half">
        <div class="visual vocab">
          <div class="vtable" data-vocab={JSON.stringify(vocab.map((v) => ({ zh: v.zh, en: v.en })))}>
            <div class="vrow vhead label"><span>Hanzi</span><span>Pinyin</span><span>Meaning</span></div>
            {
              vocab.map((v, i) => (
                <div class:list={['vrow', { active: i === 0 }]} data-row={i} tabindex="0">
                  <span class="hanzi">{v.hanzi}</span>
                  <span>{v.pinyin}</span>
                  <span>{v.meaning}</span>
                </div>
              ))
            }
          </div>
          <div class="fieldset chunk">
            <div class="edge top">
              <span class="line"></span><span class="cap label cap-label">USEFUL CHUNK</span><span class="line"></span>
            </div>
            <div class="body chunk-body" data-chunk-body><span class="hanzi">{vocab[0].zh[0]}<span class="hl">{vocab[0].zh[1]}</span>{vocab[0].zh[2]}</span></div>
            <div class="edge bottom">
              <span class="line"></span><span class="cap cap-en" data-chunk-en>{vocab[0].en[0]}<span class="hl">{vocab[0].en[1]}</span>{vocab[0].en[2]}</span><span
                class="line"></span>
            </div>
          </div>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag display">02</span><h3>Vocabulary and chunks</h3></div>
          <p>A table with hanzi, pinyin and meaning, then the useful phrases.</p>
        </footer>
      </article>

      <!-- 03 Written translation -->
      <article class="card half">
        <TranslationChat />
        <footer class="foot">
          <div class="foot-head"><span class="tag display">03</span><h3>Written translation</h3></div>
          <p>You write in Mandarin, one sentence at a time. Claude corrects it and sends the next.</p>
        </footer>
      </article>
    </div>

    <!-- 04 Dialogue and comprehension -->
    <article class="card">
      <DialogueCard />
      <footer class="foot">
        <div class="foot-head"><span class="tag display">04</span><h3>Dialogue and comprehension</h3></div>
        <p>One to three short dialogues, about 20 seconds each. Listen or read, answer all the questions, get corrected.</p>
      </footer>
    </article>
  </div>
</Section>

<style>
  .bento {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bento-row {
    display: flex;
    gap: 12px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--card-border);
  }
  .card.grow,
  .card.half {
    flex: 1 1 0;
    min-width: 0;
  }
  .card.spaced {
    width: 236px;
    flex-shrink: 0;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px 20px;
  }
  .foot-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .foot .tag {
    font-size: var(--fs-caption);
    line-height: var(--lh-h4);
    color: var(--muted);
  }
  .foot h3 {
    font-family: var(--f-display);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    font-weight: var(--fw-display);
    letter-spacing: var(--tr-display);
    color: var(--text);
  }
  .foot p {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
  }

  .visual {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  /* chat cards */
  .chat {
    gap: 10px;
    padding: 24px 20px 20px;
  }
  .chat.center {
    padding: 20px;
    justify-content: center;
  }
  .step {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-block: 5px;
    font-size: 12px;
    line-height: 16px;
    color: var(--muted);
    white-space: pre;
  }
  .step .chev {
    color: var(--muted-2);
  }
  .q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .fb {
    font-size: 13px;
    line-height: 20px;
    color: var(--text-dim);
  }
  /* hanzi in bubbles share the 20px line of the other messages, so every one-line bubble
     has the same height */
  .a24 {
    font-size: 18px;
    line-height: 20px;
    color: var(--text);
    white-space: pre;
  }
  .a20 {
    font-size: 18px;
    line-height: 20px;
    color: var(--text);
  }
  .ok {
    color: var(--ok);
  }
  /* inside the orange user bubble, highlighted words go dark so they still stand out */
  .chat :global(.bubble.user) .hl-light,
  .chat :global(.bubble.user) .hl-mid {
    color: rgba(242, 242, 242, 0.7);
  }
  .hl-light {
    color: var(--accent-light);
  }
  .hl-mid {
    color: var(--accent-mid);
  }
  .hl {
    color: var(--accent);
  }
  .muted2 {
    color: var(--muted-2);
  }
  /* two-line bubbles: same 20px lines and gap, so they match each other too */
  .chat :global(.bubble.stack) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .chat :global(.bubble.stack) .label {
    line-height: 20px;
  }

  /* vocabulary */
  .vocab {
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .vtable {
    display: flex;
    flex-direction: column;
    width: 268px;
  }
  .vrow {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    border-bottom: 1px solid var(--divider);
    opacity: 0.35;
  }
  .vrow > span {
    width: 84px;
    flex-shrink: 0;
    text-align: center;
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
  }
  .vrow > .hanzi {
    font-size: 24px;
    line-height: 30px;
    white-space: pre;
  }
  .vrow:not(.vhead) {
    cursor: default;
    outline: none;
    transition: opacity 0.18s ease;
  }
  .vrow > span {
    transition: color 0.18s ease;
  }
  .vrow.active {
    opacity: 1;
  }
  .vrow.active > span {
    color: var(--text-soft);
  }
  .vrow.active > .hanzi {
    color: var(--accent);
  }
  .vrow.vhead {
    align-items: flex-start;
    height: 25px;
    padding-bottom: 10px;
    opacity: 1;
  }
  .vrow.vhead > span {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: 14px;
    color: var(--muted-2);
  }
  .chunk {
    width: 200px;
    margin-top: 24px;
  }
  .cap-label {
    font-size: var(--fs-label);
    line-height: 18px;
    color: var(--muted-2);
  }
  .cap-en {
    font-size: var(--fs-caption);
    line-height: 18px;
    color: var(--muted);
    white-space: pre;
  }
  /* the glitch rebuilds these spans in JS, so the highlight must be global */
  .chunk-body :global(.hl),
  .cap-en :global(.hl) {
    color: var(--accent);
  }
  .cap-en :global(.ghost) {
    visibility: hidden;
  }
  .chunk-body {
    position: relative;
    display: grid;
    place-items: center;
    height: 58px;
  }
  /* each chunk is a layer in the same grid cell, so a new one writes on top of the one fading out */
  .chunk-body :global(.zl) {
    grid-area: 1 / 1;
    display: flex;
    transition: opacity 0.3s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .chunk-body :global(.zl.out) {
    opacity: 0;
  }
  .chunk-body :global(.zc) {
    position: relative;
    width: 26px;
    height: 26px;
    color: var(--text);
  }
  .chunk-body :global(.zc.hl) {
    color: var(--accent);
  }
  .chunk-body :global(.zc svg) {
    position: absolute;
    inset: 0;
  }
  .chunk-body :global(.zt) {
    display: block;
    font-family: var(--f-brush);
    font-weight: var(--fw-brush);
    font-size: 23px;
    line-height: 26px;
    text-align: center;
  }
  /* text stays hidden once stroke data is in (unless it failed); while writing, each box waits its turn */
  .chunk-body :global(.zc.drawn:not(.text) .zt) {
    visibility: hidden;
  }
  .chunk-body :global(.zl.writing .zc.text:not(.shown) .zt) {
    visibility: hidden;
  }
  .chunk-body .hanzi {
    font-size: 24px;
    line-height: 30px;
    color: var(--text);
    white-space: pre;
  }

</style>

<script>
  // Vocabulary card: last hovered (or focused) row is active. The useful chunk is written in real stroke
  // order (Hanzi Writer, as in Pace): on a swap the old chunk fades out while the new one writes itself
  // on top, character by character, and the English line below types in. Punctuation has no stroke data,
  // so it appears as text; if stroke data can't load, or reduced motion is on, characters show as text.
  import HanziWriter from 'hanzi-writer';

  type Parts = [string, string, string];
  const table = document.querySelector<HTMLElement>('[data-vocab]');
  if (table) {
    const data: { zh: Parts; en: Parts }[] = JSON.parse(table.dataset.vocab!);
    const rows = [...table.querySelectorAll<HTMLElement>('[data-row]')];
    const body = document.querySelector<HTMLElement>('[data-chunk-body]')!;
    const enEl = document.querySelector<HTMLElement>('[data-chunk-en]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const css = getComputedStyle(document.documentElement);
    const TEXT = css.getPropertyValue('--text').trim() || '#F2F2F2';
    const ACCENT = css.getPropertyValue('--accent').trim() || '#E8590C';
    const BOX = 26;
    const PUNCT = /[？！，。、：；“”‘’?!,.]/;

    // warm the stroke-data cache so the first hover writes straight away
    if (!reduce) {
      const all = new Set(data.flatMap((d) => [...d.zh.join('')]).filter((c) => !PUNCT.test(c)));
      all.forEach((c) => HanziWriter.loadCharacterData(c).catch(() => {}));
    }

    let run = 0; // bumps on every swap so an interrupted chunk stops writing

    function layer(parts: Parts, animate: boolean) {
      const id = ++run;
      const el = document.createElement('span');
      el.className = 'zl';
      el.lang = 'zh-Hans';
      el.setAttribute('aria-label', parts.join(''));
      const queue: { w: ReturnType<typeof HanziWriter.create> | null; box: HTMLElement }[] = [];
      parts.forEach((part, k) => {
        for (const c of part) {
          const box = document.createElement('span');
          box.className = 'zc' + (k === 1 ? ' hl' : '');
          box.setAttribute('aria-hidden', 'true');
          const txt = Object.assign(document.createElement('span'), { className: 'zt', textContent: c });
          box.append(txt);
          el.append(box);
          if (reduce || PUNCT.test(c)) {
            box.classList.add('text');
            queue.push({ w: null, box });
            continue;
          }
          const w = HanziWriter.create(box, c, {
            width: BOX,
            height: BOX,
            padding: 1,
            showOutline: false,
            showCharacter: !animate,
            strokeColor: k === 1 ? ACCENT : TEXT,
            strokeAnimationSpeed: 20,
            delayBetweenStrokes: 0,
            onLoadCharDataSuccess: () => box.classList.add('drawn'),
            onLoadCharDataError: () => box.classList.add('text'),
          });
          queue.push({ w, box });
        }
      });
      body.append(el);
      if (animate) {
        el.classList.add('writing');
        // Left to right, one character after the other, with fast strokes so the chunk is down in
        // under a second.
        (async () => {
          for (const { w, box } of queue) {
            if (id !== run) return;
            box.classList.add('shown');
            if (w && !box.classList.contains('text')) {
              try {
                await w.animateCharacter();
              } catch {
                box.classList.add('text');
              }
            }
          }
        })();
      }
      return el;
    }

    // English line: typed in, keeping the highlighted word in its span.
    let typeTimer = 0;
    function typeEn(parts: Parts) {
      clearTimeout(typeTimer);
      const full = parts.join('');
      const a = parts[0].length;
      const b = a + parts[1].length;
      const show = (n: number) => {
        const t = full.slice(0, n);
        enEl.replaceChildren(
          document.createTextNode(t.slice(0, a)),
          Object.assign(document.createElement('span'), { className: 'hl', textContent: t.slice(a, b) }),
          document.createTextNode(t.slice(b)),
          // the untyped rest keeps its space, so the lines either side don't move
          Object.assign(document.createElement('span'), { className: 'ghost', textContent: full.slice(n) }),
        );
      };
      if (reduce) return show(full.length);
      let n = 0;
      const tick = () => {
        show(++n);
        if (n < full.length) typeTimer = window.setTimeout(tick, 30);
      };
      show(0);
      typeTimer = window.setTimeout(tick, 0);
    }

    // first chunk: drawn in place, no animation
    body.replaceChildren();
    layer(data[0].zh, false);

    let active = 0;
    const activate = (i: number) => {
      if (i === active) return;
      rows[active].classList.remove('active');
      rows[i].classList.add('active');
      active = i;
      // old chunk(s) fade to 0 while the new one is written on top
      body.querySelectorAll<HTMLElement>('.zl:not(.out)').forEach((old) => {
        old.classList.add('out');
        setTimeout(() => old.remove(), 400);
      });
      layer(data[i].zh, true);
      typeEn(data[i].en);
    };
    rows.forEach((row, i) => {
      row.addEventListener('pointerenter', () => activate(i));
      row.addEventListener('focus', () => activate(i));
    });
  }
</script>
