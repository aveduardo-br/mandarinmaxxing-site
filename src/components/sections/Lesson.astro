---
// Section 04 — Paper node 2M-0 (bento 9KE-0). Card interactions are added one by one.
import Section from '../Section.astro';
import Bubble from '../Bubble.astro';
import SpacedReview from './SpacedReview.astro';

// Vocabulary card: hovering a row makes it active (the last one hovered stays) and swaps the useful
// chunk below for one that uses that word. [before, word, after] so the word can be highlighted.
const vocab = [
  {
    hanzi: '菜单',
    pinyin: 'càidān',
    meaning: 'menu',
    zh: ['请给我', '菜单', ''],
    en: ['The ', 'menu', ', please.'],
  },
  {
    hanzi: '味道',
    pinyin: 'wèidào',
    meaning: 'taste',
    zh: ['', '味道', '怎么样？'],
    en: ['How does it ', 'taste', '?'],
  },
  {
    hanzi: '推荐',
    pinyin: 'tuījiàn',
    meaning: 'recommend',
    zh: ['你有什么', '推荐', '？'],
    en: ['What do you ', 'recommend', '?'],
  },
  {
    hanzi: '打包',
    pinyin: 'dǎbāo',
    meaning: 'to go',
    zh: ['我要', '打包', ''],
    en: ["I'd like it ", 'to go', '.'],
  },
];

const wave = [6, 10, 16, 8, 20, 24, 14, 10, 18, 26, 12, 8, 16, 22, 10, 6, 14, 20, 8, 12, 18, 10, 6, 16, 12, 8];
const PLAYED = 11;
---

<Section id="lesson" num="04" title="Every lesson follows the same four steps">
  <p class="prose">
    Review, new words, translation, dialogue. Same order every time, so you always know what comes next, and older
    words keep coming back along the way.
  </p>

  <div class="bento">
    <div class="bento-row">
      <!-- 01 Quick review -->
      <article class="card grow">
        <div class="visual chat">
          <div class="step">
            <span class="pixel">↺</span>
            <span>Mixed 2 chunks from earlier lessons with today's words</span>
            <span class="chev">›</span>
          </div>
          <Bubble from="ai"><p class="q">Tell your friend you’ll take the subway home after dinner.</p></Bubble>
          <Bubble from="user"><p class="hanzi a24">吃完饭我<span class="hl-light">坐地铁</span>回家。</p></Bubble>
          <Bubble from="ai"><p class="fb"><span class="ok">✓ Natural.</span> Nice, 坐地铁 is sticking.</p></Bubble>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">01</span><h3>Quick review</h3></div>
          <p>Short questions on the last lesson, mixed with older chunks that are due to come back.</p>
        </footer>
      </article>

      <!-- + Spaced review -->
      <article class="card spaced">
        <SpacedReview />
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">+</span><h3>Spaced review</h3></div>
          <p>Older words return later, so they don’t fade.</p>
        </footer>
      </article>
    </div>

    <div class="bento-row">
      <!-- 02 Vocabulary and chunks -->
      <article class="card half">
        <div class="visual vocab">
          <div class="vtable" data-vocab={JSON.stringify(vocab.map((v) => ({ zh: v.zh, en: v.en })))}>
            <div class="vrow vhead label"><span>Hanzi</span><span>Pinyin</span><span>Meaning</span></div>
            {
              vocab.map((v, i) => (
                <div class:list={['vrow', { active: i === 0 }]} data-row={i} tabindex="0">
                  <span class="hanzi">{v.hanzi}</span>
                  <span>{v.pinyin}</span>
                  <span>{v.meaning}</span>
                </div>
              ))
            }
          </div>
          <div class="fieldset chunk">
            <div class="edge top">
              <span class="line"></span><span class="cap pixel cap-label">USEFUL CHUNK</span><span class="line"></span>
            </div>
            <div class="body chunk-body"><span class="hanzi" data-chunk-zh>{vocab[0].zh[0]}<span class="hl">{vocab[0].zh[1]}</span>{vocab[0].zh[2]}</span></div>
            <div class="edge bottom">
              <span class="line"></span><span class="cap cap-en" data-chunk-en>{vocab[0].en[0]}<span class="hl">{vocab[0].en[1]}</span>{vocab[0].en[2]}</span><span
                class="line"></span>
            </div>
          </div>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">02</span><h3>Vocabulary and chunks</h3></div>
          <p>A table with hanzi, pinyin and meaning, then the useful phrases.</p>
        </footer>
      </article>

      <!-- 03 Written translation -->
      <article class="card half">
        <div class="visual chat center">
          <Bubble from="ai" class="stack">
            <span class="label muted2">Translate · 3 / 8</span>
            <p class="q">Can you recommend a dish?</p>
          </Bubble>
          <Bubble from="user"><p class="hanzi a20">你可以推荐一<span class="hl-mid">个</span>菜吗？</p></Bubble>
          <Bubble from="ai" class="stack">
            <p class="hanzi a20 white">你可以推荐一<span class="ok">道</span>菜吗？</p>
            <p class="fb">Dishes take 道, not 个. Next one ↓</p>
          </Bubble>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">03</span><h3>Written translation</h3></div>
          <p>You write in Mandarin, one sentence at a time. Claude corrects it and sends the next.</p>
        </footer>
      </article>
    </div>

    <!-- 04 Dialogue and comprehension -->
    <article class="card">
      <div class="visual dialogue">
        <div class="fieldset">
          <div class="edge top">
            <span class="line stub"></span><span class="cap pixel cap-label">AUDIO · LESSON 08 · HSK 4</span><span
              class="line"></span>
          </div>
          <div class="body audio-body">
            <div class="player-wrap">
              <div class="player">
                <button class="play" type="button" aria-label="Play dialogue (audio coming soon)">
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5 L10.5 6 L3 10.5 Z" fill="#121212"></path></svg>
                </button>
                <div class="wave" aria-hidden="true">
                  {wave.map((h, i) => <i class:list={{ played: i < PLAYED }} style={`height:${h}px`} />)}
                </div>
                <span class="time pixel">0:08</span>
              </div>
            </div>
            <div class="convo">
              <div class="lines">
                <div class="line-a"><span class="who pixel">A</span><span class="hanzi">请问，你们有什么推荐？</span></div>
                <div class="line-b">
                  <span class="hanzi"
                    >我们的宫保鸡<span style="color:#B0B0B0">丁</span><span style="color:#6A6A6A">很</span><span
                      style="color:#3A3A3A">好</span
                    ><span style="color:#222222">吃</span></span
                  ><span class="who pixel">B</span>
                </div>
              </div>
              <ul class="questions">
                <li class="done"><span class="mark">✓</span>What does she ask the waiter?</li>
                <li><span class="mark">○</span>What does the waiter recommend?</li>
                <li><span class="mark">○</span>How does he describe it?</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <footer class="foot">
        <div class="foot-head"><span class="tag pixel">04</span><h3>Dialogue and comprehension</h3></div>
        <p>One to three short dialogues, about 20 seconds each. Listen or read, answer all the questions, get corrected.</p>
      </footer>
    </article>
  </div>
</Section>

<style>
  .bento {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bento-row {
    display: flex;
    gap: 12px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--card-border);
  }
  .card.grow,
  .card.half {
    flex: 1 1 0;
    min-width: 0;
  }
  .card.spaced {
    width: 236px;
    flex-shrink: 0;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px 20px;
  }
  .foot-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .foot .tag {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted);
  }
  .foot h3 {
    font-family: var(--f-body); /* Geist instead of Zpix (Eduarda), size as in Paper */
    font-size: 16px;
    line-height: 22px;
    font-weight: 500;
    color: var(--text);
  }
  .foot p {
    font-size: 13px;
    line-height: 19px;
    color: var(--muted);
  }

  .visual {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  /* chat cards */
  .chat {
    gap: 10px;
    padding: 24px 20px 20px;
  }
  .chat.center {
    padding: 20px;
    justify-content: center;
  }
  .step {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-block: 5px;
    font-size: 12px;
    line-height: 16px;
    color: var(--muted);
    white-space: pre;
  }
  .step .chev {
    color: var(--muted-2);
  }
  .q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .fb {
    font-size: 13px;
    line-height: 18px;
    color: var(--text-dim);
  }
  .a24 {
    font-size: 24px;
    line-height: 30px;
    color: var(--text);
    white-space: pre;
  }
  .a20 {
    font-size: 20px;
    line-height: 26px;
    color: var(--text);
  }
  .ok {
    color: var(--ok);
  }
  .hl-light {
    color: var(--accent-light);
  }
  .hl-mid {
    color: var(--accent-mid);
  }
  .hl {
    color: var(--accent);
  }
  .muted2 {
    color: var(--muted-2);
  }
  .chat :global(.bubble.stack) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat :global(.bubble.stack:last-child) {
    gap: 4px;
  }

  /* vocabulary */
  .vocab {
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .vtable {
    display: flex;
    flex-direction: column;
    width: 268px;
  }
  .vrow {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    border-bottom: 1px solid var(--divider);
    opacity: 0.35;
  }
  .vrow > span {
    width: 84px;
    flex-shrink: 0;
    text-align: center;
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
  }
  .vrow > .hanzi {
    font-size: 24px;
    line-height: 30px;
    white-space: pre;
  }
  .vrow:not(.vhead) {
    cursor: default;
    outline: none;
    transition: opacity 0.18s ease;
  }
  .vrow > span {
    transition: color 0.18s ease;
  }
  .vrow.active {
    opacity: 1;
  }
  .vrow.active > span {
    color: var(--text-soft);
  }
  .vrow.active > .hanzi {
    color: var(--accent);
  }
  .vrow.vhead {
    align-items: flex-start;
    height: 25px;
    padding-bottom: 10px;
    opacity: 1;
  }
  .vrow.vhead > span {
    font-family: var(--f-geist-pixel);
    font-size: 11px;
    line-height: 14px;
    color: var(--muted-2);
  }
  .chunk {
    width: 200px;
    margin-top: 24px;
  }
  .cap-label {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted-2);
  }
  .cap-en {
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
    white-space: pre;
  }
  /* the glitch rebuilds these spans in JS, so the highlight must be global */
  .chunk-body :global(.hl),
  .cap-en :global(.hl) {
    color: var(--accent);
  }
  .chunk-body {
    display: flex;
    justify-content: center;
    padding-block: 14px;
  }
  .chunk-body .hanzi {
    font-size: 24px;
    line-height: 30px;
    color: var(--text);
    white-space: pre;
  }

  /* dialogue */
  .dialogue {
    padding: 20px;
  }
  .dialogue .line.stub {
    flex: 0 0 20px;
  }
  .audio-body {
    display: flex;
    padding: 16px 20px 20px;
    border-bottom: 1px solid var(--outline);
  }
  .player-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 260px;
    flex-shrink: 0;
    padding-right: 24px;
  }
  .player {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    background: #1a1a1a;
  }
  .play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    cursor: pointer;
  }
  .play svg {
    width: 12px;
    height: 12px;
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 28px;
  }
  .wave i {
    display: block;
    width: 3px;
    flex-shrink: 0;
    background: #3a3a3a;
  }
  .wave i.played {
    background: var(--accent);
  }
  .time {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted-2);
  }
  .convo {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: 24px;
    border-left: 1px solid var(--divider);
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .line-a,
  .line-b {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .line-a {
    align-self: flex-start;
  }
  .line-b {
    align-self: flex-end;
  }
  .who {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted-2);
  }
  .lines .hanzi {
    font-size: 20px;
    line-height: 26px;
    white-space: pre;
  }
  .line-a .hanzi {
    color: var(--muted);
  }
  .line-b .hanzi {
    color: var(--text);
  }
  .questions {
    list-style: none;
    margin: 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--divider);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .questions li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
  }
  .questions .mark {
    font-size: 12px;
    line-height: 16px;
    color: var(--muted-2);
  }
  .questions .done {
    color: var(--text-soft);
  }
  .questions .done .mark {
    color: var(--ok);
  }
</style>

<script>
  // Vocabulary card: last hovered (or focused) row is active; the useful chunk swaps with a glitch,
  // scrambling characters before they settle left to right.
  type Parts = [string, string, string];
  const table = document.querySelector<HTMLElement>('[data-vocab]');
  if (table) {
    const data: { zh: Parts; en: Parts }[] = JSON.parse(table.dataset.vocab!);
    const rows = [...table.querySelectorAll<HTMLElement>('[data-row]')];
    const zhEl = document.querySelector<HTMLElement>('[data-chunk-zh]')!;
    const enEl = document.querySelector<HTMLElement>('[data-chunk-en]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const HANZI =
      '的一是不了人我在有他这中大来上个到说们为子和你地出道也时年得就那要下以生会自着去过家学对可里后小么心多天能好都没日起还发成事只作当想看开手用主行方又如前本见经头面公同三老从动两长知样现分外但身些高意进把法回二理美点月明种声全工己话者向情部正名定女问力机给等几很最间新什打便位因重走电四门相次东海口西再平真听世气信北少关先山五水万市眼体别处才场书比住九笑通目报立马命张活难数件安表原车白应路期叫常提感金何更反合放做系计或司利受光王果亲界今京务解各任至清物台记边共风干接许特觉望直服林题建南度色字请交爱让认算百吃义怎元功指思流每青管夫连远资队跟带花快条院变言往展该领近留红决周保达办运半候七必城父强步完深区求品转量空众轻程告江语基派满式写呢识极令黄收脸钱倒未持取设始双越商千片容像找友孩站广改议形早房音火则首单据导影失拿网香似专石若兵弟谁校读飞观争究包组造落视喜离虽坏兴切团夜鸡';
    const LATIN = 'abcdefghijklmnopqrstuvwxyz';
    const DURATION = 460;
    const TICK = 34;
    const timers = new WeakMap<HTMLElement, number>();

    const render = (el: HTMLElement, chars: string[], hl: [number, number]) => {
      const before = chars.slice(0, hl[0]).join('');
      const word = chars.slice(hl[0], hl[1]).join('');
      const after = chars.slice(hl[1]).join('');
      el.replaceChildren(document.createTextNode(before), Object.assign(document.createElement('span'), { className: 'hl', textContent: word }), document.createTextNode(after));
    };

    function glitch(el: HTMLElement, parts: Parts, pool: string) {
      clearInterval(timers.get(el));
      const target = [...parts.join('')];
      const hl: [number, number] = [[...parts[0]].length, [...parts[0]].length + [...parts[1]].length];
      if (reduce) return render(el, target, hl);
      const keep = (c: string) => /[\s,.?!？，。'’]/.test(c);
      const rand = () => pool[(Math.random() * pool.length) | 0];
      const t0 = performance.now();
      const tick = () => {
        const p = Math.min(1, (performance.now() - t0) / DURATION);
        // characters settle left to right; the rest keep flickering
        const settled = Math.floor(p * p * (target.length + 1));
        const chars = target.map((c, i) => (i < settled || keep(c) ? c : rand()));
        render(el, chars, hl);
        if (p >= 1) {
          clearInterval(timers.get(el));
          render(el, target, hl);
        }
      };
      tick();
      timers.set(el, window.setInterval(tick, TICK));
    }

    let active = 0;
    const activate = (i: number) => {
      if (i === active) return;
      rows[active].classList.remove('active');
      rows[i].classList.add('active');
      active = i;
      glitch(zhEl, data[i].zh, HANZI);
      glitch(enEl, data[i].en, LATIN);
    };
    rows.forEach((row, i) => {
      row.addEventListener('pointerenter', () => activate(i));
      row.addEventListener('focus', () => activate(i));
    });
  }
</script>
