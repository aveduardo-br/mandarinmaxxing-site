---
// Section 04 — Paper node 2M-0 (bento 9KE-0). Static default states; card interactions come in step 4.
import Section from '../Section.astro';
import Bubble from '../Bubble.astro';

// Spaced review timeline: lessons 0–20, learned in 4, reviewed in 5, 7, 11, 18.
const LEARNED = 4;
const REVIEWS = [5, 7, 11, 18];
const CENTER = 10;
const timeline = Array.from({ length: 21 }, (_, i) => {
  const kind = i === LEARNED ? 'learned' : REVIEWS.includes(i) ? 'review' : 'idle';
  const fade = Math.max(0.06, 1 - ((i - CENTER) / CENTER) ** 2);
  const opacity = kind === 'idle' ? fade : Math.max(fade, 0.9);
  return { i, kind, opacity: +opacity.toFixed(2) };
});

const vocab = [
  { hanzi: '菜单', pinyin: 'càidān', meaning: 'menu' },
  { hanzi: '味道', pinyin: 'wèidào', meaning: 'taste' },
  { hanzi: '推荐', pinyin: 'tuījiàn', meaning: 'recommend' },
  { hanzi: '打包', pinyin: 'dǎbāo', meaning: 'to go' },
];

const wave = [6, 10, 16, 8, 20, 24, 14, 10, 18, 26, 12, 8, 16, 22, 10, 6, 14, 20, 8, 12, 18, 10, 6, 16, 12, 8];
const PLAYED = 11;
---

<Section id="lesson" num="04" title="Every lesson follows the same four steps">
  <p class="prose">
    Review, new words, translation, dialogue. Same order every time, so you always know what comes next, and older
    words keep coming back along the way.
  </p>

  <div class="bento">
    <div class="bento-row">
      <!-- 01 Quick review -->
      <article class="card grow">
        <div class="visual chat">
          <div class="step">
            <span class="pixel">↺</span>
            <span>Mixed 2 chunks from earlier lessons with today's words</span>
            <span class="chev">›</span>
          </div>
          <Bubble from="ai"><p class="q">Tell your friend you’ll take the subway home after dinner.</p></Bubble>
          <Bubble from="user"><p class="hanzi a24">吃完饭我<span class="hl-light">坐地铁</span>回家。</p></Bubble>
          <Bubble from="ai"><p class="fb"><span class="ok">✓ Natural.</span> Nice, 坐地铁 is sticking.</p></Bubble>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">01</span><h3 class="pixel">Quick review</h3></div>
          <p>Short questions on the last lesson, mixed with older chunks that are due to come back.</p>
        </footer>
      </article>

      <!-- + Spaced review -->
      <article class="card spaced">
        <div class="visual sr">
          <div class="sr-slot">
            <div class="sr-line">
              <span class="nb pixel l">打包</span>
              <span class="arrow pixel">‹</span>
              <span class="hanzi sr-main">坐地铁</span>
              <span class="arrow pixel">›</span>
              <span class="nb pixel">推荐</span>
            </div>
            <span class="sr-en">take the subway</span>
          </div>
          <div class="timeline" aria-label="Learned in lesson 4, reviewed in lessons 5, 7, 11 and 18">
            {
              timeline.map((t) => (
                <div class={`tcol ${t.kind}`} style={`opacity:${t.opacity}`}>
                  <i />
                  <span class="pixel">{t.kind === 'review' ? t.i : '·'}</span>
                </div>
              ))
            }
          </div>
          <div class="sr-legend label">
            <span><i class="learned"></i>learned</span>
            <span><i class="review"></i>review</span>
          </div>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">+</span><h3 class="pixel">Spaced review</h3></div>
          <p>Older words return later, so they don’t fade.</p>
        </footer>
      </article>
    </div>

    <div class="bento-row">
      <!-- 02 Vocabulary and chunks -->
      <article class="card half">
        <div class="visual vocab">
          <div class="vtable">
            <div class="vrow vhead label"><span>Hanzi</span><span>Pinyin</span><span>Meaning</span></div>
            {
              vocab.map((v, i) => (
                <div class:list={['vrow', { active: i === 0 }]}>
                  <span class="hanzi">{v.hanzi}</span>
                  <span>{v.pinyin}</span>
                  <span>{v.meaning}</span>
                </div>
              ))
            }
          </div>
          <div class="fieldset chunk">
            <div class="edge top">
              <span class="line"></span><span class="cap pixel cap-label">USEFUL CHUNK</span><span class="line"></span>
            </div>
            <div class="body chunk-body"><span class="hanzi">请给我<span class="hl">菜单</span></span></div>
            <div class="edge bottom">
              <span class="line"></span><span class="cap cap-en">The <span class="hl">menu</span>, please.</span><span
                class="line"></span>
            </div>
          </div>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">02</span><h3 class="pixel">Vocabulary and chunks</h3></div>
          <p>A table with hanzi, pinyin and meaning, then the useful phrases.</p>
        </footer>
      </article>

      <!-- 03 Written translation -->
      <article class="card half">
        <div class="visual chat center">
          <Bubble from="ai" class="stack">
            <span class="label muted2">Translate · 3 / 8</span>
            <p class="q">Can you recommend a dish?</p>
          </Bubble>
          <Bubble from="user"><p class="hanzi a20">你可以推荐一<span class="hl-mid">个</span>菜吗？</p></Bubble>
          <Bubble from="ai" class="stack">
            <p class="hanzi a20 white">你可以推荐一<span class="ok">道</span>菜吗？</p>
            <p class="fb">Dishes take 道, not 个. Next one ↓</p>
          </Bubble>
        </div>
        <footer class="foot">
          <div class="foot-head"><span class="tag pixel">03</span><h3 class="pixel">Written translation</h3></div>
          <p>You write in Mandarin, one sentence at a time. Claude corrects it and sends the next.</p>
        </footer>
      </article>
    </div>

    <!-- 04 Dialogue and comprehension -->
    <article class="card">
      <div class="visual dialogue">
        <div class="fieldset">
          <div class="edge top">
            <span class="line stub"></span><span class="cap pixel cap-label">AUDIO · LESSON 08 · HSK 4</span><span
              class="line"></span>
          </div>
          <div class="body audio-body">
            <div class="player-wrap">
              <div class="player">
                <button class="play" type="button" aria-label="Play dialogue (audio coming soon)">
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5 L10.5 6 L3 10.5 Z" fill="#121212"></path></svg>
                </button>
                <div class="wave" aria-hidden="true">
                  {wave.map((h, i) => <i class:list={{ played: i < PLAYED }} style={`height:${h}px`} />)}
                </div>
                <span class="time pixel">0:08</span>
              </div>
            </div>
            <div class="convo">
              <div class="lines">
                <div class="line-a"><span class="who pixel">A</span><span class="hanzi">请问，你们有什么推荐？</span></div>
                <div class="line-b">
                  <span class="hanzi"
                    >我们的宫保鸡<span style="color:#B0B0B0">丁</span><span style="color:#6A6A6A">很</span><span
                      style="color:#3A3A3A">好</span
                    ><span style="color:#222222">吃</span></span
                  ><span class="who pixel">B</span>
                </div>
              </div>
              <ul class="questions">
                <li class="done"><span class="mark">✓</span>What does she ask the waiter?</li>
                <li><span class="mark">○</span>What does the waiter recommend?</li>
                <li><span class="mark">○</span>How does he describe it?</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <footer class="foot">
        <div class="foot-head"><span class="tag pixel">04</span><h3 class="pixel">Dialogue and comprehension</h3></div>
        <p>One to three short dialogues, about 20 seconds each. Listen or read, answer all the questions, get corrected.</p>
      </footer>
    </article>
  </div>
</Section>

<style>
  .bento {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bento-row {
    display: flex;
    gap: 12px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--card-border);
  }
  .card.grow,
  .card.half {
    flex: 1 1 0;
    min-width: 0;
  }
  .card.spaced {
    width: 236px;
    flex-shrink: 0;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px 20px;
  }
  .foot-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .foot .tag {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted);
  }
  .foot h3 {
    font-size: 16px;
    line-height: 22px;
    font-weight: 500;
    color: var(--text);
  }
  .foot p {
    font-size: 13px;
    line-height: 19px;
    color: var(--muted);
  }

  .visual {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  /* chat cards */
  .chat {
    gap: 10px;
    padding: 24px 20px 20px;
  }
  .chat.center {
    padding: 20px;
    justify-content: center;
  }
  .step {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-block: 5px;
    font-size: 12px;
    line-height: 16px;
    color: var(--muted);
    white-space: pre;
  }
  .step .chev {
    color: var(--muted-2);
  }
  .q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .fb {
    font-size: 13px;
    line-height: 18px;
    color: var(--text-dim);
  }
  .a24 {
    font-size: 24px;
    line-height: 30px;
    color: var(--text);
    white-space: pre;
  }
  .a20 {
    font-size: 20px;
    line-height: 26px;
    color: var(--text);
  }
  .ok {
    color: var(--ok);
  }
  .hl-light {
    color: var(--accent-light);
  }
  .hl-mid {
    color: var(--accent-mid);
  }
  .hl {
    color: var(--accent);
  }
  .muted2 {
    color: var(--muted-2);
  }
  .chat :global(.bubble.stack) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat :global(.bubble.stack:last-child) {
    gap: 4px;
  }

  /* spaced review */
  .sr {
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 44px 0 12px;
    overflow: hidden;
  }
  .sr-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 100%;
  }
  .sr-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
  }
  .nb,
  .arrow {
    font-size: 12px;
    line-height: 18px;
    color: var(--accent);
    opacity: 0.4;
    white-space: pre;
  }
  .nb {
    width: 38px;
    flex-shrink: 0;
  }
  .nb.l {
    text-align: right;
  }
  .sr-main {
    font-size: 32px;
    line-height: 40px;
    color: var(--text);
    white-space: pre;
  }
  .sr-en {
    font-size: 13px;
    line-height: 18px;
    color: var(--text);
    opacity: 0.7;
    white-space: pre;
  }
  .timeline {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    width: 100%;
  }
  .tcol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 7px;
    flex-shrink: 0;
  }
  .tcol i {
    display: block;
    width: 7px;
    height: 14px;
    background: #2e2e2e;
  }
  .tcol span {
    font-size: 12px;
    line-height: 18px;
    color: var(--outline);
    white-space: pre;
  }
  .tcol.learned i {
    background: var(--muted);
  }
  .tcol.review i {
    height: 20px;
    background: var(--accent);
  }
  .tcol.review span {
    color: var(--accent);
  }
  .sr-legend {
    display: flex;
    gap: 16px;
    line-height: 14px;
    color: var(--muted-2);
  }
  .sr-legend span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sr-legend i {
    display: block;
    width: 6px;
    height: 6px;
  }
  .sr-legend .learned {
    background: var(--muted);
  }
  .sr-legend .review {
    background: var(--accent);
  }

  /* vocabulary */
  .vocab {
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .vtable {
    display: flex;
    flex-direction: column;
    width: 268px;
  }
  .vrow {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    border-bottom: 1px solid var(--divider);
    opacity: 0.35;
  }
  .vrow > span {
    width: 84px;
    flex-shrink: 0;
    text-align: center;
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
  }
  .vrow > .hanzi {
    font-size: 24px;
    line-height: 30px;
    white-space: pre;
  }
  .vrow.active {
    opacity: 1;
  }
  .vrow.active > span {
    color: var(--text-soft);
  }
  .vrow.active > .hanzi {
    color: var(--accent);
  }
  .vrow.vhead {
    align-items: flex-start;
    height: 25px;
    padding-bottom: 10px;
    opacity: 1;
  }
  .vrow.vhead > span {
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 14px;
    color: var(--muted-2);
  }
  .chunk {
    width: 200px;
    margin-top: 24px;
  }
  .cap-label {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted-2);
  }
  .cap-en {
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
    white-space: pre;
  }
  .chunk-body {
    display: flex;
    justify-content: center;
    padding-block: 14px;
  }
  .chunk-body .hanzi {
    font-size: 24px;
    line-height: 30px;
    color: var(--text);
    white-space: pre;
  }

  /* dialogue */
  .dialogue {
    padding: 20px;
  }
  .dialogue .line.stub {
    flex: 0 0 20px;
  }
  .audio-body {
    display: flex;
    padding: 16px 20px 20px;
    border-bottom: 1px solid var(--outline);
  }
  .player-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 260px;
    flex-shrink: 0;
    padding-right: 24px;
  }
  .player {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    background: #1a1a1a;
  }
  .play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    cursor: pointer;
  }
  .play svg {
    width: 12px;
    height: 12px;
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 28px;
  }
  .wave i {
    display: block;
    width: 3px;
    flex-shrink: 0;
    background: #3a3a3a;
  }
  .wave i.played {
    background: var(--accent);
  }
  .time {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted-2);
  }
  .convo {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: 24px;
    border-left: 1px solid var(--divider);
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .line-a,
  .line-b {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .line-a {
    align-self: flex-start;
  }
  .line-b {
    align-self: flex-end;
  }
  .who {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted-2);
  }
  .lines .hanzi {
    font-size: 20px;
    line-height: 26px;
    white-space: pre;
  }
  .line-a .hanzi {
    color: var(--muted);
  }
  .line-b .hanzi {
    color: var(--text);
  }
  .questions {
    list-style: none;
    margin: 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--divider);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .questions li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
  }
  .questions .mark {
    font-size: 12px;
    line-height: 16px;
    color: var(--muted-2);
  }
  .questions .done {
    color: var(--text-soft);
  }
  .questions .done .mark {
    color: var(--ok);
  }
</style>
