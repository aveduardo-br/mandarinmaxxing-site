---
// Bento card "04 Dialogue and comprehension" — visual part.
// Everything is driven by the audio's current time, so playing, dragging the waveform or using the
// arrow keys all give the same picture: the dialogue is written in as it is spoken, and each
// question turns white while it's the current one, then gets struck through and ticked once the
// audio passes the moment that answers it.
//
// Timings were mapped from public/audio/dialogue-restaurant.mp3 (8.2 s) by detecting the pauses
// with ffmpeg (silencedetect, -35 dB). Each part is [text, from, to] in seconds; characters inside
// a line is revealed as one continuous sweep from its first to its last checkpoint.

type Part = [string, number, number];
type Line = { who: 'A' | 'B'; parts: Part[] };

const lines: Line[] = [
  { who: 'A', parts: [['请问', 0.0, 0.49], ['，', 0.49, 0.49], ['你们有什么推荐', 0.83, 1.9], ['？', 1.9, 1.9]] },
  { who: 'B', parts: [['我推荐主厨的红烧鱼', 2.22, 4.0], ['。', 4.0, 4.0]] },
  { who: 'A', parts: [['好的', 4.35, 4.67], ['，', 4.67, 4.67], ['多少钱', 4.99, 5.58], ['？', 5.58, 5.58]] },
  { who: 'B', parts: [['三十块', 5.83, 6.46], ['。', 6.46, 6.46]] },
  { who: 'A', parts: [['好', 6.78, 7.01], ['，', 7.01, 7.01], ['就点这个吧', 7.25, 8.0], ['。', 8.0, 8.0]] },
];

const questions = [
  { q: 'What does she ask the waiter?', at: 1.9 },
  { q: 'What does the waiter recommend?', at: 4.0 },
  { q: 'How much is it?', at: 6.46 },
];

const DURATION = 8.2;

// each line has two checkpoints, start and end; between them it is revealed in one smooth sweep
const lineData = lines.map((l) => ({
  who: l.who,
  text: l.parts.map((p) => p[0]).join(''),
  start: l.parts[0][1],
  end: l.parts[l.parts.length - 1][2],
}));

const fmt = (s: number) => `0:${String(Math.round(s)).padStart(2, '0')}`;
---

<div class="dlg" data-dlg data-duration={DURATION} data-questions={JSON.stringify(questions.map((q) => q.at))}>
  <div class="fieldset">
    <div class="edge top">
      <span class="line stub"></span><span class="cap label cap-label">AUDIO · EXAMPLE</span><span
        class="line"></span>
    </div>
    <div class="body audio-body">
      <div class="player-wrap">
        <div class="player">
          <audio preload="auto" src="/audio/dialogue-restaurant.mp3" data-audio></audio>
          <button class="play" type="button" aria-label="Play dialogue" data-play>
            <svg viewBox="0 0 12 12" aria-hidden="true">
              <path class="i-play" d="M3 1.5 L10.5 6 L3 10.5 Z"></path>
              <path class="i-pause" d="M2.5 1.5 H5 V10.5 H2.5 Z M7 1.5 H9.5 V10.5 H7 Z"></path>
            </svg>
          </button>
          <div
            class="wave"
            data-wave
            role="slider"
            tabindex="0"
            aria-label="Dialogue position"
            aria-valuemin="0"
            aria-valuemax={DURATION}
            aria-valuenow="0"
          >
            <div class="wave-ws" data-ws></div>
          </div>
          <span class="time" data-time>{fmt(DURATION)}</span>
        </div>
      </div>

      <div class="convo">
        <div class="lines-view" aria-hidden="true">
          <div class="lines" data-lines>
            {
              lineData.map((l, i) => (
                <div class={`line ${l.who === 'A' ? 'a' : 'b'} future`} data-line={i} data-start={l.start} data-end={l.end}>
                  {l.who === 'A' && <span class="who display">A</span>}
                  <span class="hanzi">{l.text}</span>
                  {l.who === 'B' && <span class="who display">B</span>}
                </div>
              ))
            }
          </div>
        </div>
        <p class="sr-only" aria-live="off">
          {lines.map((l) => `${l.who}: ${l.parts.map((p) => p[0]).join('')}`).join(' ')}
        </p>
        <ul class="questions" data-questions-list>
          {
            questions.map((q, i) => (
              <li class:list={{ current: i === 0 }} data-q={i}>
                <span class="mark" aria-hidden="true">
                  <span class="o">○</span>
                  <svg class="tick" viewBox="0 0 12 12" width="12" height="12">
                    <path d="M2.5 6.4 L5 8.9 L9.6 3.4" pathLength="1"></path>
                  </svg>
                </span>
                <span class="qt">{q.q}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .dlg {
    padding: 20px;
  }
  .dlg .line.stub {
    flex: 0 0 20px;
  }
  /* the caption cut into the box's top border */
  .cap-label {
    font-size: var(--fs-label);
    line-height: 18px;
    color: var(--muted-2);
  }
  .audio-body {
    display: flex;
    padding: 16px 20px 20px;
    border-bottom: 1px solid var(--outline);
  }

  /* player */
  .player-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 260px;
    flex-shrink: 0;
    padding-right: 24px;
  }
  .player {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    background: #1a1a1a;
  }
  .play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    cursor: pointer;
  }
  .play svg {
    width: 12px;
    height: 12px;
    fill: #121212;
  }
  .play .i-pause,
  .play.playing .i-play {
    display: none;
  }
  .play.playing .i-pause {
    display: inline;
  }
  .play:focus-visible,
  .wave:focus-visible {
    outline: 1px dashed var(--accent-light);
    outline-offset: 3px;
  }
  /* waveform drawn by WaveSurfer.js from the audio itself */
  .wave {
    width: 128px;
    height: 28px;
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }
  .wave-ws {
    width: 100%;
    height: 28px;
  }
  .time {
    min-width: 28px;
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: 18px;
    color: var(--muted-2);
  }

  /* conversation: the last two lines are visible, newest at the bottom */
  .convo {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: 24px;
  }
  .lines-view {
    position: relative;
    height: 58px; /* two 26px lines + 6px gap */
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 30%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 30%);
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 10px;
    transition: opacity 0.2s ease;
  }
  .line.a {
    align-self: flex-start;
  }
  .line.b {
    align-self: flex-end;
  }
  .line.future {
    opacity: 0;
  }
  .who {
    font-size: var(--fs-caption);
    line-height: 18px;
    color: var(--muted-2);
  }
  .line .hanzi {
    font-size: 20px;
    line-height: 26px;
    white-space: pre;
  }
  /* the whole line appears at once (dim) and a soft white sweep runs across it, from the
     line's start checkpoint to its end checkpoint */
  .line .hanzi {
    --p: 0;
    background-image: linear-gradient(
      90deg,
      var(--text) calc(var(--p) * 120% - 20%),
      #4a4a4a calc(var(--p) * 120%)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .line.past .hanzi {
    background-image: none;
    -webkit-text-fill-color: var(--muted);
    color: var(--muted);
  }

  /* questions */
  .questions {
    list-style: none;
    margin: 0;
    padding: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .questions li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: 18px;
    color: var(--muted);
    transition: color 0.8s ease;
  }
  /* ○ and ✓ share one centred 14×18 box */
  .mark {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 14px;
    height: 18px;
    font-size: 12px;
    line-height: 1;
    color: var(--muted-2);
  }
  .mark > * {
    grid-area: 1 / 1;
  }
  .mark .o {
    transition: opacity 0.2s ease;
  }
  /* green tick drawn like a trim path: the stroke grows from the short leg to the tip */
  .mark .tick {
    overflow: visible;
  }
  .mark .tick path {
    fill: none;
    stroke: var(--ok);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .qt {
    position: relative;
  }
  /* strike line drawn across the question once it's answered */
  .qt::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    height: 1px;
    width: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.8s cubic-bezier(0.45, 0, 0.25, 1);
  }
  .questions li.current {
    color: var(--text);
  }
  .questions li.current .mark {
    color: var(--text);
  }
  .questions li.done {
    color: var(--muted-2);
  }
  .questions li.done .qt::after {
    transform: scaleX(1);
  }
  .questions li.done .o {
    opacity: 0;
  }
  /* the tick starts drawing at the same moment as the strike */
  .questions li.done .tick path {
    stroke-dashoffset: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .lines,
    .qt::after,
    .mark .tick path {
      transition: none;
    }
  }
</style>

<script>
  import WaveSurfer from 'wavesurfer.js';

  const root = document.querySelector<HTMLElement>('[data-dlg]');
  if (root) {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const wave = root.querySelector<HTMLElement>('[data-wave]')!;
    const timeEl = root.querySelector<HTMLElement>('[data-time]')!;
    const linesEl = root.querySelector<HTMLElement>('[data-lines]')!;
    const view = linesEl.parentElement!;
    const lines = [...linesEl.querySelectorAll<HTMLElement>('[data-line]')].map((el) => ({
      el,
      start: Number(el.dataset.start),
      end: Number(el.dataset.end),
      text: el.querySelector<HTMLElement>('.hanzi')!,
    }));
    const qEls = [...root.querySelectorAll<HTMLElement>('[data-q]')];
    const qAt: number[] = JSON.parse(root.dataset.questions!);
    let duration = Number(root.dataset.duration);

    const fmt = (s: number) => `0:${String(Math.floor(s)).padStart(2, '0')}`;

    let t = 0;
    let started = false;

    function render() {
      // dialogue
      // before playing, the first line is shown as a ghost hint
      let cur = 0;
      lines.forEach((l, i) => {
        if (t >= l.start && started) cur = i;
      });
      lines.forEach((l, i) => {
        l.el.classList.toggle('future', i > cur);
        l.el.classList.toggle('past', i < cur);
        l.el.classList.toggle('now', i === cur);
        if (i !== cur) return;
        const p = started ? Math.max(0, Math.min(1, (t - l.start) / (l.end - l.start))) : 0;
        l.text.style.setProperty('--p', p.toFixed(4));
      });
      // keep the current line at the bottom of the two-line view
      const target = lines[Math.max(cur, 0)].el;
      const y = view.clientHeight - (target.offsetTop + target.offsetHeight);
      linesEl.style.transform = `translateY(${y}px)`;

      // questions
      let currentQ = qAt.findIndex((at) => !(started && t >= at));
      qEls.forEach((li, i) => {
        li.classList.toggle('done', started && t >= qAt[i]);
        li.classList.toggle('current', i === currentQ);
      });

      // player (the waveform's played part is drawn by WaveSurfer)
      timeEl.textContent = started ? fmt(t) : fmt(duration);
      wave.setAttribute('aria-valuenow', t.toFixed(1));
      wave.setAttribute('aria-valuetext', `${fmt(t)} of ${fmt(duration)}`);
    }

    // smooth updates while playing
    let raf = 0;
    const loop = () => {
      t = audio.currentTime;
      render();
      if (!audio.paused) raf = requestAnimationFrame(loop);
    };

    function setPlaying(on: boolean) {
      playBtn.classList.toggle('playing', on);
      playBtn.setAttribute('aria-label', on ? 'Pause dialogue' : 'Play dialogue');
    }

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        if (t >= duration - 0.05) audio.currentTime = 0;
        started = true;
        audio.play().catch(() => {});
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', () => {
      setPlaying(true);
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
    });
    audio.addEventListener('pause', () => {
      setPlaying(false);
      t = audio.currentTime;
      render();
    });
    audio.addEventListener('ended', () => {
      setPlaying(false);
      t = duration;
      render();
    });
    audio.addEventListener('loadedmetadata', () => {
      if (isFinite(audio.duration)) duration = audio.duration;
      render();
    });

    // Waveform: WaveSurfer.js reads the real audio and draws it as bars; clicking or dragging on it
    // seeks the same <audio> element, so everything above stays driven by audio.currentTime.
    WaveSurfer.create({
      container: root.querySelector<HTMLElement>('[data-ws]')!,
      media: audio,
      height: 28,
      barWidth: 3,
      barGap: 2,
      barRadius: 0,
      barHeight: 0.9,
      normalize: true,
      waveColor: '#3a3a3a',
      progressColor: getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#d2430e',
      cursorWidth: 0,
      interact: true,
      dragToSeek: true,
    });
    audio.addEventListener('seeking', () => {
      started = true;
      t = audio.currentTime;
      render();
    });

    // keyboard: ←/→ one second, Home/End
    wave.addEventListener('keydown', (e) => {
      let next: number | null = null;
      if (e.key === 'ArrowRight') next = t + 1;
      else if (e.key === 'ArrowLeft') next = t - 1;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = duration;
      if (next === null) return;
      e.preventDefault();
      started = true;
      t = Math.max(0, Math.min(duration, next));
      audio.currentTime = t;
      render();
    });

    render();
  }
</script>
