---
// Section 02 — Paper "Topics — bar A v2".
// Intro compares a textbook lesson with mandarinmaxxing's situations. Below, ten situations of one HSK
// level, as an example of how the level goes (renumbered 01-10, so the numbers here are not the map's):
// closed / hover (arrow head slides in, row turns light orange) / open (accordion with the lesson's
// words). Above the list, "HSK 1" in tiles switches the level: a click turns the number tile to the next
// level (1 → 6, then back to 1) and the ten rows change in a wave. HSK 1 to 4 come from the skill's maps;
// HSK 5 and 6 have no map (the skill builds it when you get there), so their ten are examples made the
// same way, and a note under the selector says so. Data: situations.ts (HSK 1) and topics.ts (HSK 2-6). Under the list a bar sticks to the bottom of the screen while the list is in view
// and stays attached under it afterwards. Its strip is the textbook series: HSK Standard Course 1 to 6,
// one square per lesson, in six groups (one per book). A lesson lights up when it teaches a word of the
// situation, so you can see the situation's words spread over lessons, and sometimes over later books.
// The open situation's words show white, the hovered one's light orange, where the books teach them.
// Only words the books also teach can light up; the label says how many. Data: src/data/book.ts.
import Section from '../Section.astro';
import { situations, bookLesson } from '../../data/situations';
import { bookLessons, HSK1_HANZI } from '../../data/book';
import { levelTopics } from '../../data/topics';

// HSK 1: ten examples, spread from the start of the level to the end (the map's numbers).
type Topic = { num: string; name: string; count: number; words: { hanzi: string; en: string }[]; rest: string[] };
const SAMPLE = ['01', '02', '05', '07', '08', '12', '13', '16', '18', '22'];
const hsk1: Topic[] = SAMPLE.map((num, i) => {
  const s = situations.find((x) => x.num === num)!;
  return { num: String(i + 1).padStart(2, '0'), name: s.name, count: s.count, words: s.words, rest: s.rest.map((n) => HSK1_HANZI[n]) };
});
const LEVELS = [1, 2, 3, 4, 5, 6].map((level) => ({
  level,
  mapped: level === 1 || levelTopics[level].mapped,
  topics: level === 1 ? hsk1 : (levelTopics[level].topics as Topic[]),
}));
const topics = LEVELS[0].topics; // the page opens on HSK 1
const ROWS = 3;
// On a phone the textbook lesson shows four words on one line: watch, milk, husband, red, the four
// least related to each other (newspaper and room are left out).
const PHONE_HIDE = ['报纸', '房间'];
// one cell per textbook lesson, in six groups (one per book). Each book fills columns of ROWS lessons,
// and a gap of GAP columns separates the books.
const GAP = 2;
type Cell = { x: number; y: number; book: number; lesson: number };
const cells: Cell[] = [];
let col = 0;
let k = 0;
bookLessons.forEach((l, li) => {
  if (li > 0 && l.book !== bookLessons[li - 1].book) {
    col += Math.ceil(k / ROWS) + GAP;
    k = 0;
  }
  cells.push({ x: col + Math.floor(k / ROWS), y: k % ROWS, book: l.book, lesson: l.lesson });
  k++;
});
const COLS = col + Math.ceil(k / ROWS);
// lessonOf: the first lesson that teaches a word
const lessonOf = new Map<string, number>();
bookLessons.forEach((l, li) => l.words.forEach((w) => lessonOf.has(w) || lessonOf.set(w, li)));
// The books list some of today's HSK 1 words only inside another entry, or as their parts:
// - 你好: lesson 1 is titled 你好 and lists 你 and 好 as its first two words;
// - 他们, 她们: the books list 他 and 她 (and 我们, 你们), never the plural on its own;
// - a word that is part of a longer entry: 电话 is taught as 打电话, 火车 as 火车站.
// find() returns the textbook cell for a word and, when it is not the word itself, the entry it is in.
const PART: Record<string, string> = { 你好: '你', 他们: '他', 她们: '她' };
const entries = bookLessons.flatMap((l) => l.words);
const find = (h: string): { cell: number; via: string } => {
  if (lessonOf.has(h)) return { cell: lessonOf.get(h)!, via: '' };
  if (PART[h]) return { cell: lessonOf.get(PART[h])!, via: h === '你好' ? '' : PART[h] };
  // only for words of two characters or more: one character is inside too many unrelated entries
  const e = [...h].length > 1 ? entries.find((w) => w.includes(h)) : undefined;
  return e ? { cell: lessonOf.get(e)!, via: e } : { cell: -1, via: '' };
};
// For each situation: the lessons that teach any of its words, and those that teach its other words
// (the ones behind "+N more").
const stripOf = (t: Topic) => {
  const shown = t.words.map((w) => w.hanzi);
  const rest = t.rest;
  const found = [...shown, ...rest].map((h) => find(h).cell).filter((c) => c >= 0);
  const restCells = [...new Set(rest.map((h) => find(h).cell).filter((c) => c >= 0))];
  const lessons = [...new Set(found)];
  return {
    count: t.count,
    inBook: found.length,
    lessons,
    rest: restCells,
    words: t.words.map((w) => {
      const { cell, via } = find(w.hanzi);
      const at = cell < 0 ? '' : `HSK Standard Course ${cells[cell].book}, lesson ${cells[cell].lesson}`;
      return { zh: w.hanzi, en: w.en, cell, where: at && via ? `taught as ${via} · ${at}` : at };
    }),
  };
};
// everything the level switch needs, per level: the rows (name, preview, words) and the strip data
const levelData = LEVELS.map((L) => ({
  level: L.level,
  mapped: L.mapped,
  topics: L.topics.map((t) => ({ name: t.name, count: t.count, words: t.words, strip: stripOf(t) })),
}));
const stripData = levelData[0].topics.map((t) => t.strip);
---

<Section id="topics" num="02" title="Situations, not chapters" tiled>
  <p class="prose">
    If you study with the HSK Standard Course, the textbook series made for the test, the words come chapter by
    chapter, around each chapter’s grammar. A lesson can look like this:
  </p>
  <div class="book">
    <div class="book-head">
      <p class="label book-label">{bookLesson.label}</p>
      <span class="info" data-info>
        <button class="info-btn" type="button" data-cuelume-tap data-cuelume-emphasis="subtle" aria-label="About this lesson" aria-describedby="book-info" aria-expanded="false">
          <svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25"></circle><path d="M7 6.2v3.6M7 4.2v.01"></path></svg>
        </button>
        <span class="info-pop" id="book-info" role="tooltip">
          <span class="info-intro">{bookLesson.info.intro}</span>
          <span class="info-rows">
            {
              bookLesson.info.rows.map((r) => (
                <span class="info-row">
                  <span class="info-where">{r.where}</span>
                  <span class="info-words hanzi">{r.words}</span>
                </span>
              ))
            }
          </span>
          <span class="info-note">{bookLesson.info.note}</span>
          <a href={bookLesson.source} target="_blank" rel="noopener">Source ↗</a>
        </span>
      </span>
    </div>
    <div class="book-words">
      {
        bookLesson.words.map((w) => (
          <div class:list={['bw', { 'm-hide': PHONE_HIDE.includes(w.hanzi) }]}>
            <span class="hanzi">{w.hanzi}</span>
            <span class="en">{w.en}</span>
          </div>
        ))
      }
    </div>
    <p class="book-note">What ties them together is the chapter’s grammar, not a moment where you’d use them.</p>
  </div>
  <p class="prose">
    Here the same words are grouped by the moment you’d use them.
  </p>

  <!-- outside .topics-wrap, whose overflow clip would cut the examples tag. The level switch: HSK in black tiles, the level in an orange one; a click shows the next level -->
  <div class="lvl">
    <span class="tile-tag lvl-tag" data-lvl-note hidden aria-hidden="true">Examples · the skill maps it when you start</span>
    <button class="lvl-btn" type="button" data-lvl data-cuelume-select aria-label="HSK 1. Show the next level">
      <span class="lt" aria-hidden="true">H</span><span class="lt" aria-hidden="true">S</span><span class="lt" aria-hidden="true">K</span><span class="lt lt-num" data-lvl-num aria-hidden="true">1</span>
      <span class="lvl-hint" aria-hidden="true">Next level →</span>
    </button>
    <p class="sr-only" aria-live="polite" data-lvl-live></p>
  </div>
  <div class="topics-wrap" data-levels={JSON.stringify(levelData)}>
    <div class="list" data-topics>
      {
        topics.map((t, ti) => (
          <div class="topic" data-topic data-i={ti}>
            <button class="row" type="button" aria-expanded="false" aria-controls={`topic-${t.num}`}>
              <span class="arrow display" aria-hidden="true">
                <span class="dash">--</span>&gt;
              </span>
              <span class="num">{t.num}</span>
              <span class="name">{t.name}</span>
              <span class="preview" aria-hidden="true">
                {t.words.slice(0, 3).map((w, i) => (
                  <span class="pw" style={`--i:${i}`}>
                    {[...w.hanzi].map((ch) => (
                      <span class="pt">
                        <span>{ch}</span>
                      </span>
                    ))}
                  </span>
                ))}
              </span>
            </button>
            <div class="panel" id={`topic-${t.num}`} role="region" aria-label={t.name}>
              <div class="panel-inner">
                <div class="words">
                  {t.words.map((w, i) => (
                    <div class="word" style={`--i:${i}`} data-w={i}>
                      <span class="hanzi">{w.hanzi}</span>
                      <span class="en">{w.en}</span>
                    </div>
                  ))}
                  {t.count > t.words.length && (
                    <div class="word more" style={`--i:${t.words.length}`} data-w="more">
                      <span class="hanzi">…</span>
                      <span class="en">+{t.count - t.words.length} more</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="bar" data-bar data-strip={JSON.stringify(stripData)}>
      <p class="bar-label" data-bar-label aria-live="polite">
        <span class="l1" data-l1>HSK Standard Course 1 to 6: {cells.length} lessons.</span>
        <span class="l2" data-l2><span class="dim">One square per lesson, in the order the six books teach them.</span></span>
      </p>
      <svg class="strip" viewBox={`0 0 ${COLS * 4 - 1} ${ROWS * 4 - 1}`} aria-hidden="true">
        {
          cells.map((c) => <rect x={c.x * 4} y={c.y * 4} width="3" height="3" />)
        }
      </svg>
    </div>
  </div>
</Section>

<style>
  /* ---------- intro: a textbook lesson ---------- */
  .book {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .book-label {
    color: var(--muted-2);
  }
  .book-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* (i) next to the lesson label: hover, focus or tap shows where the words come from */
  .info {
    position: relative;
    display: inline-flex;
  }
  .info-btn {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted-2);
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .info-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .info:hover .info-btn,
  .info-btn:focus-visible,
  .info.open .info-btn {
    color: var(--text);
  }
  .info-btn:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 2px;
  }
  .info-pop {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: calc(100% + 10px);
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    background: #181818;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-dim);
    opacity: 0;
    translate: -50% 4px;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      translate 0.15s ease;
  }
  /* invisible bridge so the pointer can travel from the (i) to the pop-up */
  .info-pop::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 12px;
  }
  .info:hover .info-pop,
  .info:focus-within .info-pop,
  .info.open .info-pop {
    opacity: 1;
    translate: -50% 0;
    pointer-events: auto;
  }
  /* a bigger area to tap than the 16px icon */
  .info-btn {
    position: relative;
  }
  .info-btn::after {
    content: '';
    position: absolute;
    inset: -14px;
  }
  /* phones: the (i) sits at the right edge, so the pop-up opens leftwards from it instead of centred */
  @media (max-width: 720px) {
    .info-pop {
      left: auto;
      right: -6px;
      width: min(280px, calc(100vw - 32px));
      translate: 0 4px;
    }
    .info:hover .info-pop,
    .info:focus-within .info-pop,
    .info.open .info-pop {
      translate: 0 0;
    }
  }
  .info-intro {
    color: var(--text-dim);
  }
  /* borderless table: where in the lesson → which words */
  .info-rows {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 16px;
    row-gap: 4px;
  }
  .info-row {
    display: contents;
  }
  .info-where {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
    line-height: 22px;
  }
  .info-words {
    font-size: 16px;
    line-height: 22px;
    color: var(--text);
  }
  .info-note {
    color: var(--muted);
  }
  .info-pop a {
    align-self: flex-start;
    color: var(--accent-light);
  }
  .info-pop a:hover {
    color: var(--text);
  }
  .book-words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 28px;
    row-gap: 12px;
  }
  .bw {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .bw .hanzi {
    font-size: 24px;
    line-height: 32px;
    color: var(--text-80);
  }
  .bw .en,
  .book-note {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
  }

  /* ---------- level switch ---------- */
  .lvl {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 8px;
  }
  .lvl-btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 8px 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .lvl-btn:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 4px;
  }
  /* a tile like the others (28px, 1px of air around the colour); HSK in black, the level in orange */
  .lt {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: var(--tile-gap, 1px);
    background: #000;
    background-clip: content-box;
    font-family: var(--f-body);
    font-weight: 600;
    font-size: 15px;
    line-height: 1;
    color: var(--text);
  }
  .lt-num {
    background-color: var(--accent);
    color: #161616;
  }
  .lvl-hint {
    margin-left: 12px;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted-2);
    transition: color 0.15s ease;
  }
  @media (hover: hover) {
    .lvl-btn:hover .lvl-hint {
      color: var(--text-dim);
    }
  }
  /* HSK 5 and 6: a black tag above the tiles says the ten are examples. It sits over the space above
     the selector (out of the flow), so showing it never moves the list. */
  .lvl {
    position: relative;
    margin-bottom: -16px; /* sits right on top of the list, as when it was inside it (the section's gap is 16px) */
  }
  .lvl-tag {
    position: absolute;
    left: 0;
    bottom: calc(100% - 8px);
    transform-origin: 50% 100%;
    white-space: nowrap;
  }
  .lvl-tag[hidden] {
    display: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- list ---------- */
  /* the list is its own stacking layer under the bar, so animated rows/words (which get their own
     compositing layers while they move) can never paint over the bar or its cover */
  .list {
    position: relative;
    z-index: 1;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }

  /* row: closed / hover / open */
  .row {
    display: flex;
    align-items: baseline;
    width: 100%;
    padding: 8px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  .arrow,
  .num,
  .name {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    transform-origin: left center;
    transition: color 0.15s ease;
  }
  /* the arrow starts in the numbers' column and pushes the number along */
  .arrow {
    display: inline-block;
    overflow: hidden;
    white-space: pre;
    max-width: 0;
    margin-right: 0;
    color: var(--accent-light);
    transition:
      max-width 0.18s ease,
      margin-right 0.18s ease;
  }
  .num {
    width: 24px;
    flex-shrink: 0;
    margin-right: 12px;
    color: var(--muted-2);
  }
  .name {
    flex: 1;
    min-width: 0;
    color: var(--text-dim);
  }
  /* the first words of the situation as small tiles (docs/ladrilhos.md): dimmed at rest; when the
     row is hovered they flip, in a wave, to the same light orange as the row's text */
  .preview {
    flex-shrink: 0;
    display: flex;
    gap: 8px;
  }
  .pw {
    display: flex;
  }
  .pt {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    background: #1e1e1e;
  }
  .pt.on {
    background: var(--accent-light);
  }
  /* Zpix glyphs sit at the left of their box with a 4/24 gap on the right: centred box, pushed right */
  .pt > span {
    position: absolute;
    left: -10px;
    right: -10px;
    padding-left: 3px;
    top: 0.5px;
    text-align: center;
    font-family: 'Zpix', var(--f-display);
    font-size: 18px;
    line-height: 18px;
    font-weight: 500;
    color: #8a8a8a;
    white-space: pre;
  }
  .pt.on > span {
    color: #161616;
  }

  /* hover (and keyboard focus): arrow head slides in, the whole row turns light orange */
  .row:focus-visible .arrow,
  .topic.open .arrow {
    max-width: 3em;
    margin-right: 12px;
  }
  .row:focus-visible :is(.num, .name, .pw) {
    color: var(--accent-light);
  }
  @media (hover: hover) {
    .row:hover .arrow {
      max-width: 3em;
      margin-right: 12px;
    }
    .row:hover :is(.num, .name, .pw) {
      color: var(--accent-light);
    }
  }
  .row:focus-visible {
    outline: none;
  }
  /* hover shows only the arrow head; the dashes join it once the topic is open */
  .dash {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    max-width: 0;
  }
  .topic.open .dash {
    max-width: 2em;
  }

  /* open: white, semibold, header grows to h3 (animated in place by the script), preview hides.
     The negative margin keeps the title's centre on the same line it had when closed. */
  .topic.open .row {
    margin-top: calc((var(--lh-h4) - var(--lh-h3)) / 2);
  }
  .topic.open :is(.arrow, .num, .name) {
    font-weight: var(--fw-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--text);
  }
  .topic.open .num {
    width: auto;
  }
  /* preview hanzi leave one by one, left to right: they rise slowly, speed up (ease-in) and
     vanish at their fastest point instead of fading */
  .topic.open .pw {
    animation: preview-out 0.14s cubic-bezier(0.3, 0, 0.9, 0.4) forwards;
    animation-delay: calc(var(--i) * 28ms);
  }
  /* on close they come back the reverse way, right to left: they appear at speed and settle */
  .topic.closing .pw {
    animation: preview-in 0.16s cubic-bezier(0.1, 0.6, 0.7, 1) both;
    animation-delay: calc((2 - var(--i)) * 28ms);
  }
  @keyframes preview-in {
    0% {
      translate: 0 -14px;
      opacity: 0;
    }
    0.1% {
      translate: 0 -14px;
      opacity: 1;
    }
    100% {
      translate: 0 0;
      opacity: 1;
    }
  }
  @keyframes preview-out {
    0% {
      translate: 0 0;
      opacity: 1;
    }
    99.9% {
      translate: 0 -14px;
      opacity: 1;
    }
    100% {
      translate: 0 -14px;
      opacity: 0;
    }
  }

  /* ---------- panel (accordion) ---------- */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
  }
  .panel-inner {
    min-height: 0;
    overflow: hidden;
    padding-left: 48px;
  }
  .topic.open .panel {
    grid-template-rows: 1fr;
  }
  .words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 28px;
    row-gap: 16px;
    margin: 16px 0 24px;
  }
  .word {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    /* contents come in one by one; on close they fade out together */
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.16s ease,
      translate 0s linear 0.16s;
  }
  .topic.open .word {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.3s ease,
      translate 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(120ms + var(--i) * 45ms);
  }
  .word .hanzi {
    font-size: 32px;
    line-height: 38px;
    color: var(--text-80);
    transition: color 0.2s ease; /* hover fades to orange and back */
  }
  .word .en {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
    transition: color 0.2s ease;
  }
  /* each word arrives light orange and settles to its colour */
  .topic.open .word:not(.more) :is(.hanzi, .en) {
    animation: word-tint 0.5s ease-out backwards;
    animation-delay: calc(120ms + var(--i) * 45ms);
  }
  @keyframes word-tint {
    from,
    30% {
      color: var(--accent-light);
    }
  }
  .word.more .hanzi {
    color: #3a3a3a;
  }
  .word.more .en {
    color: var(--muted-2);
  }


  /* ---------- phones ---------- */
  @media (max-width: 720px) {
    /* the textbook lesson on one line */
    .book-words {
      column-gap: 20px;
      flex-wrap: nowrap;
    }
    .bw.m-hide {
      display: none;
    }
    /* two preview words, so a long situation name never runs into them */
    .pw:nth-child(3) {
      display: none;
    }
    .name {
      padding-right: 12px;
    }
    /* open: a smaller step up (18px, not 20px), and the name always on one line */
    .topic.open .row {
      margin-top: -1px;
    }
    .topic.open :is(.arrow, .num, .name) {
      font-size: 18px;
      line-height: 26px;
    }
    .topic.open .name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* the words in even rows: three per row (3 + 3, or 3 + 2) */
    .panel-inner {
      padding-left: 36px;
    }
    .words {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 12px;
      row-gap: 16px;
    }
    .word .hanzi {
      font-size: 28px;
      line-height: 34px;
    }
    .word .en {
      text-align: center;
    }
  }
  /* ---------- sticky bar ---------- */
  /* the list and its bar: overflow clip keeps the bar's cover (below) inside the section */
  .topics-wrap {
    overflow: clip;
    overflow-clip-margin: 0px;
  }
  /* The bar sticks at --stick from the bottom of the screen (set by the script: a little above the
     bottom edge). Below the bar a cover hides the rows that haven't
     scrolled up yet, so the list always "closes" with the bar. */
  .bar {
    position: sticky;
    bottom: var(--stick, 0px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
    padding: 16px 0 20px;
    border-top: 1px solid var(--text-dim); /* same grey as the inactive topic names */
    background: var(--bg);
    /* own compositing layer: Safari otherwise sometimes skips repainting the cover until hover */
    transform: translateZ(0);
  }
  /* while stuck, rows fade out as they reach the bar instead of being cut */
  .bar::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 1px);
    height: 56px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .bar.stuck::before {
    opacity: 1;
  }
  .bar::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 100vh;
    background: var(--bg);
    pointer-events: none;
  }
  .bar-label {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--muted);
  }
  /* always two lines: the first says what you're looking at, the second adds to it. Each line is
     rewritten word by word when it changes (src/scripts/write.ts). */
  .bar-label > span {
    /* a one-cell grid, so the old and new text of a rewrite sit on top of each other */
    display: grid;
    height: var(--lh-small); /* one line each, always: the bar never changes height */
    white-space: nowrap;
    overflow: hidden;
  }
  .bar-label :global(.w) {
    color: var(--text);
  }
  .bar-label :global(.o) {
    color: var(--accent-light);
  }
  .bar-label :global(.dim) {
    color: var(--muted-2);
  }
  /* square lessons: the strip keeps the viewBox's proportions */
  .strip {
    display: block;
    width: 100%;
    height: auto;
  }
  .strip rect {
    fill: #2e2e2e;
    transition: fill 0.2s ease;
  }
  .strip rect.on {
    fill: var(--text-80);
  }
  .strip rect.dim {
    fill: #3a3a3a;
  }
  .word[data-w] {
    cursor: default;
  }
  .topic.open .word:hover .hanzi,
  .topic.open .word:hover .en {
    color: var(--accent-light);
  }
  .strip rect.hov {
    fill: var(--accent-light);
  }

  /* phones: the second line of the label may take two lines */
  @media (max-width: 720px) {
    .bar-label {
      font-size: var(--fs-caption);
      line-height: 18px;
    }
    .bar-label > span {
      height: 18px;
    }
    .bar-label > .l2 {
      height: 36px;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic.open .pw {
      animation: none;
      opacity: 0;
    }
    .topic.closing .pw {
      animation: none;
    }
    .arrow,
    .panel,
    .strip rect,
    .topic.open .word {
      transition: none;
    }
    .topic.open .word :is(.hanzi, .en) {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DUR, EASE_CLOSE, EASE_OPEN, WAVE, playFlipSound } from '../../scripts/tiles';
  import { writeLine } from '../../scripts/write';
  import { cue } from '../../scripts/sound';

  // Accordion: click a topic to open it, click again to close. One open at a time.
  // The header grows from h4 to h3 in place (FLIP): record where the arrow, number and title are, let
  // the class change their size, then GSAP animates each from its old spot and size (one uniform
  // scale, so the text never stretches) with the site's overshoot (back.out = Penner's easeOutBack).
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const items = [...document.querySelectorAll<HTMLElement>('[data-topic]')];
  const pGen = new WeakMap<Element, number>(); // a generation per preview tile, so a newer flip wins

  function setOpen(item: HTMLElement, open: boolean) {
    const btn = item.querySelector<HTMLButtonElement>('.row')!;
    if (item.classList.contains('open') === open) return;
    const parts = [...btn.querySelectorAll<HTMLElement>('.arrow, .num, .name')];
    gsap.killTweensOf(parts);
    gsap.set(parts, { clearProps: 'transform' });
    const before = parts.map((p) => p.getBoundingClientRect());
    item.classList.toggle('open', open);
    // closing: play the preview hanzi's return animation
    clearTimeout(Number(item.dataset.closingTimer));
    item.classList.toggle('closing', !open);
    if (!open) item.dataset.closingTimer = String(setTimeout(() => item.classList.remove('closing'), 320));
    btn.setAttribute('aria-expanded', String(open));
    if (reduce) return;
    parts.forEach((p, i) => {
      const b = before[i];
      const a = p.getBoundingClientRect();
      if (!a.height) return;
      gsap.from(p, {
        x: b.left - a.left,
        y: b.top + b.height / 2 - (a.top + a.height / 2),
        scale: b.height / a.height,
        transformOrigin: 'left center',
        duration: 0.38,
        // phones get a smaller step up (18px) and a gentler overshoot
        ease: matchMedia('(max-width: 720px)').matches ? 'back.out(1.1)' : 'back.out(1.70158)',
        clearProps: 'transform',
      });
    });
  }

  // (i) next to the book lesson: tap toggles the pop-up (hover/focus already show it)
  const info = document.querySelector<HTMLElement>('[data-info]');
  if (info) {
    const btn = info.querySelector<HTMLButtonElement>('.info-btn')!;
    btn.addEventListener('click', () => {
      const open = info.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!info.contains(e.target as Node)) {
        info.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // ---- sticky bar: open topic in white, hovered topic in light orange, summed in the label ----
  const bar = document.querySelector<HTMLElement>('[data-bar]')!;
  const label = bar.querySelector<HTMLElement>('[data-bar-label]')!;
  type WordCell = { zh: string; en: string; cell: number; where: string };
  // lessons: every lesson that teaches a word of the situation; rest: those teaching its other words
  type Strip = { count: number; inBook: number; lessons: number[]; rest: number[]; words: WordCell[] };
  let data: Strip[] = JSON.parse(bar.dataset.strip!);
  const les = (n: number) => `${n} lesson${n === 1 ? '' : 's'}`;
  const rects = [...bar.querySelectorAll<SVGRectElement>('rect')].map((r, i) => ({ r, i }));
  let sets = data.map((d) => new Set(d.lessons));
  let active = -1;
  let hover = -1;
  let wordFocus: number | 'more' | null = null; // a word (or "+N more") hovered in the open topic

  const l1 = label.querySelector<HTMLElement>('[data-l1]')!;
  const l2 = label.querySelector<HTMLElement>('[data-l2]')!;
  // Only the word hover inside an open situation rewrites (the second line, word by word); moving
  // between situations swaps the text at once.
  let wordMode = false;
  const lines = (a: string, b: string, animate = false) => {
    writeLine(l1, a, false);
    writeLine(l2, b, animate);
  };

  function render() {
    const h = hover === active ? -1 : hover;
    const span = (cls: string, text: string) => `<span class="${cls}">${text}</span>`;
    const head = (d: (typeof data)[number], cls: string) =>
      `${span(cls, String(d.inBook))} of this situation’s ${d.count} words are in the textbooks.`;

    // a word of the open topic: its square lights up, the rest of the topic dims. The first line
    // stays; only the second one changes to the word.
    if (active >= 0 && wordFocus !== null) {
      const d = data[active];
      const lit = (i: number) => (wordFocus === 'more' ? d.rest.includes(i) : i === d.words[wordFocus as number].cell);
      for (const { r, i } of rects) {
        const mine = sets[active].has(i);
        r.classList.toggle('hov', mine && lit(i));
        r.classList.toggle('dim', mine && !lit(i));
        r.classList.toggle('on', false);
      }
      wordMode = true;
      if (wordFocus === 'more') {
        lines(head(d, 'w'), `${span('o', String(d.count - d.words.length))} more words ` + span('dim', '· lit where the textbooks teach them'), true);
      } else {
        const w = d.words[wordFocus];
        lines(head(d, 'w'), `${span('o', w.zh)} ${w.en} ` + span('dim', w.where ? `· ${w.where}` : '· not in any of the textbooks'), true);
      }
      return;
    }
    // leaving a word for the open situation's own line rewrites back; anything else is instant
    const back = wordMode && active >= 0 && h < 0;
    wordMode = false;
    for (const { r, i } of rects) {
      r.classList.toggle('on', active >= 0 && sets[active].has(i));
      r.classList.toggle('hov', h >= 0 && sets[h].has(i));
      r.classList.remove('dim');
    }
    if (active < 0 && h < 0) {
      lines(`HSK Standard Course 1 to 6: ${rects.length} lessons.`, span('dim', 'One square per lesson, in the order the six books teach them.'));
    } else {
      // the hovered situation if there is one, otherwise the open one
      const d = data[h < 0 ? active : h];
      lines(head(d, h < 0 ? 'w' : 'o'), span('dim', `Spread over ${les(d.lessons.length)} in the books. Here they’re one situation.`), back);
    }
  }
  render();

  // Where the bar sticks: centred with the list when there's room, but never more than 8% of the
  // screen above the bottom, so the section title and most of the list (even with a topic open)
  // fit on screen before the bar starts covering rows.
  const wrap = bar.parentElement!;
  const placeBar = () => {
    const centred = (innerHeight - wrap.offsetHeight) / 2;
    const stick = Math.max(16, Math.min(centred, innerHeight * 0.08));
    wrap.style.setProperty('--stick', `${Math.round(stick)}px`);
  };
  // stuck = the list still continues below the bar (rows hidden under it)
  const checkStuck = () => {
    const stick = parseFloat(wrap.style.getPropertyValue('--stick')) || 0;
    bar.classList.toggle('stuck', wrap.getBoundingClientRect().bottom > innerHeight - stick + 1);
  };
  placeBar();
  checkStuck();
  addEventListener('resize', () => {
    placeBar();
    checkStuck();
  });
  addEventListener('scroll', checkStuck, { passive: true });
  new ResizeObserver(() => {
    placeBar();
    checkStuck();
  }).observe(wrap);

  items.forEach((item, i) => {
    const row = item.querySelector<HTMLElement>('.row')!;
    row.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      cue(willOpen ? 'open' : 'close');
      for (const other of items) if (other !== item) setOpen(other, false);
      setOpen(item, willOpen);
      active = willOpen ? i : -1;
      wordFocus = null;
      render();
    });
    const enter = () => {
      hover = i;
      render();
    };
    const leave = () => {
      if (hover === i) hover = -1;
      render();
    };
    // preview tiles: flip to light orange on hover, back to dim when the cursor leaves. The tiles are
    // looked up each time, since the level switch replaces them.
    const flipPreview = (on: boolean) =>
      [...item.querySelectorAll<HTMLElement>('.pt')].forEach((el, k) => {
        const g = (pGen.get(el) ?? 0) + 1;
        pGen.set(el, g);
        window.setTimeout(() => {
          if (pGen.get(el) !== g || el.classList.contains('on') === on) return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return void el.classList.toggle('on', on);
          playFlipSound(); // the preview only flips on hover, so it always comes from the person
          const a = el.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }], { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
          a.onfinish = () => {
            a.cancel();
            if (pGen.get(el) !== g) return;
            el.classList.toggle('on', on);
            el.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], { duration: DUR, easing: EASE_OPEN });
          };
        }, k * 28);
      });
    row.addEventListener('mouseenter', () => flipPreview(true));
    row.addEventListener('mouseleave', () => flipPreview(false));
    row.addEventListener('mouseenter', enter);
    row.addEventListener('mouseleave', leave);
    row.addEventListener('focus', enter);
    row.addEventListener('blur', leave);

    // words of the open topic → their square on the strip (delegated: the level switch rebuilds them)
    const words = item.querySelector<HTMLElement>('.words')!;
    const keyOf = (t: EventTarget | null) => {
      const el = (t as HTMLElement | null)?.closest<HTMLElement>('[data-w]');
      return el ? (el.dataset.w === 'more' ? 'more' : Number(el.dataset.w)) : null;
    };
    words.addEventListener('mouseover', (e) => {
      const key = keyOf(e.target);
      if (key === null || active !== i || wordFocus === key) return;
      wordFocus = key;
      render();
    });
    words.addEventListener('mouseout', (e) => {
      const key = keyOf(e.target);
      if (key === null || keyOf(e.relatedTarget) === key) return;
      if (wordFocus === key) wordFocus = null;
      render();
    });
  });

  // ---- level switch: HSK 1 → 6 → 1. The number tile turns, then the ten rows change in a wave ----
  type LevelTopic = { name: string; count: number; words: { hanzi: string; en: string }[]; strip: Strip };
  const levels: { level: number; mapped: boolean; topics: LevelTopic[] }[] = JSON.parse(wrap.dataset.levels!);
  const lvlBtn = document.querySelector<HTMLButtonElement>('[data-lvl]')!;
  const lvlNum = lvlBtn.querySelector<HTMLElement>('[data-lvl-num]')!;
  const lvlNote = document.querySelector<HTMLElement>('[data-lvl-note]')!;
  const lvlLive = document.querySelector<HTMLElement>('[data-lvl-live]')!;
  const OUT = [{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }];
  const IN = [{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }];
  const ROW_STEP = 55; // ms between rows in the wave
  let level = 1;
  let lvlGen = 0;
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const previewHtml = (t: LevelTopic) =>
    t.words
      .slice(0, 3)
      .map((w, k) => `<span class="pw" style="--i:${k}">${[...w.hanzi].map((ch) => `<span class="pt"><span>${esc(ch)}</span></span>`).join('')}</span>`)
      .join('');
  const wordsHtml = (t: LevelTopic) =>
    t.words.map((w, k) => `<div class="word" style="--i:${k}" data-w="${k}"><span class="hanzi">${esc(w.hanzi)}</span><span class="en">${esc(w.en)}</span></div>`).join('') +
    (t.count > t.words.length
      ? `<div class="word more" style="--i:${t.words.length}" data-w="more"><span class="hanzi">…</span><span class="en">+${t.count - t.words.length} more</span></div>`
      : '');

  // One row: its text and its preview tiles leave together. The name is rewritten word by word while
  // the old tiles turn away one after the other, left to right (the site's tile flip); once they are all
  // closed the new tiles take their place and turn in, left to right. Nothing slides: a tile only ever
  // turns in its own spot.
  function swapRow(item: HTMLElement, t: LevelTopic, delay: number, gen: number) {
    const preview = item.querySelector<HTMLElement>('.preview')!;
    const name = item.querySelector<HTMLElement>('.name')!;
    window.setTimeout(() => {
      if (gen !== lvlGen) return;
      writeLine(name, esc(t.name), !reduce);
      item.querySelector('.panel')!.setAttribute('aria-label', t.name);
      item.querySelector<HTMLElement>('.words')!.innerHTML = wordsHtml(t);
      const old = [...preview.querySelectorAll<HTMLElement>('.pt')];
      if (reduce || !old.length) return void (preview.innerHTML = previewHtml(t));
      old.forEach((el, k) =>
        window.setTimeout(() => {
          if (gen !== lvlGen) return;
          playFlipSound();
          el.animate(OUT, { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
        }, k * WAVE),
      );
      window.setTimeout(() => {
        if (gen !== lvlGen) return;
        preview.innerHTML = previewHtml(t);
        preview.querySelectorAll<HTMLElement>('.pt').forEach((el, k) => {
          el.style.transform = 'scaleY(0)';
          window.setTimeout(() => {
            if (gen !== lvlGen) return;
            el.style.transform = '';
            el.animate(IN, { duration: DUR, easing: EASE_OPEN });
          }, k * WAVE);
        });
      }, (old.length - 1) * WAVE + DUR);
    }, delay);
  }

  // the examples tag opens like a flap once the number has turned, and closes the same way
  let noteOn = false;
  function setNote(on: boolean) {
    if (on === noteOn) return;
    noteOn = on;
    lvlNote.getAnimations().forEach((a) => a.cancel());
    if (reduce) return void (lvlNote.hidden = !on);
    if (on) {
      lvlNote.hidden = false;
      lvlNote.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], { duration: DUR, delay: DUR, easing: EASE_OPEN, fill: 'backwards' });
    } else {
      const a = lvlNote.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }], { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
      a.onfinish = () => {
        a.cancel();
        if (!noteOn) lvlNote.hidden = true;
      };
    }
  }

  function setLevel(next: number) {
    const gen = ++lvlGen;
    level = next;
    const L = levels[level - 1];
    // close the open situation and forget hovers: the rows are about to change
    items.forEach((it) => {
      setOpen(it, false);
      clearTimeout(Number(it.dataset.closingTimer));
      it.classList.remove('closing'); // the previews are replaced below: no return animation
    });
    active = -1;
    hover = -1;
    wordFocus = null;
    data = L.topics.map((t) => t.strip);
    sets = data.map((d) => new Set(d.lessons));
    render();
    // the number tile turns to the new level
    if (reduce) lvlNum.textContent = String(level);
    else {
      playFlipSound();
      const a = lvlNum.animate(OUT, { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
      a.onfinish = () => {
        a.cancel();
        if (gen !== lvlGen) return;
        lvlNum.textContent = String(level);
        lvlNum.animate(IN, { duration: DUR, easing: EASE_OPEN });
      };
    }
    lvlBtn.setAttribute('aria-label', `HSK ${level}. Show the next level`);
    setNote(!L.mapped);
    lvlLive.textContent = `HSK ${level}: ${L.topics.map((t) => t.name).join(', ')}.${L.mapped ? '' : ' Examples: the skill builds the map for this level when you start it.'}`;
    items.forEach((it, i) => swapRow(it, L.topics[i], DUR + i * ROW_STEP, gen));
  }
  lvlBtn.addEventListener('click', () => setLevel((level % levels.length) + 1));
  // the names start as rewritable lines, so the first switch already rewrites them word by word
  items.forEach((it) => {
    const n = it.querySelector<HTMLElement>('.name')!;
    writeLine(n, esc((n.textContent ?? '').trim()), false);
  });
</script>
