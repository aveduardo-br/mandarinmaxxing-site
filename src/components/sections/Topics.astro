---
// Section 02 — Paper "Topics — bar A v2".
// Intro compares a textbook lesson with mandarinmaxxing's topics. Below, the ten topics: closed /
// hover (arrow head slides in, row turns light orange) / open (accordion with the topic's words).
// Under the list a bar sticks to the bottom of the screen while the list is in view and stays
// attached under it afterwards. Its strip is the HSK 4 book (1,000 words) in chapter order: the open
// topic's words show white, the hovered topic's light orange, scattered across the book.
import Section from '../Section.astro';
import { topics, bookLesson, HSK4_TOTAL } from '../../data/topics';

// ---- the strip: 2 rows of squares, each square ≈ 3 words, every square owned by one topic ----
const COLS = 170;
const ROWS = 2;
const CELLS = COLS * ROWS;
const CHAPTERS = 20; // an HSK 4 textbook has 20 lessons
let seed = 7;
const rnd = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
// squares per topic, proportional to its word count
const share = topics.map((t) => Math.round((t.count / HSK4_TOTAL) * CELLS));
share[share.length - 1] += CELLS - share.reduce((a, b) => a + b, 0);
// cut each topic into small clusters (1–3 squares), shuffle them, lay them out column by column
const chunks: number[][] = [];
share.forEach((n, ti) => {
  while (n > 0) {
    const k = Math.min(n, 1 + Math.floor(rnd() * 3));
    chunks.push(Array(k).fill(ti));
    n -= k;
  }
});
for (let i = chunks.length - 1; i > 0; i--) {
  const j = Math.floor(rnd() * (i + 1));
  [chunks[i], chunks[j]] = [chunks[j], chunks[i]];
}
const owner = chunks.flat(); // index = col * ROWS + row
// how many textbook chapters each topic's words are spread over
const chapters = topics.map((_, ti) => {
  const set = new Set<number>();
  owner.forEach((o, i) => o === ti && set.add(Math.floor((i / CELLS) * CHAPTERS)));
  return set.size;
});
// Each word shown in an open topic gets one square of its topic (spread along the strip); "+N more"
// is all the topic's other squares. TODO (pendência): real positions once the word lists exist.
const chapterOf = (cell: number) => Math.floor((cell / CELLS) * CHAPTERS) + 1;
const stripData = topics.map((t, ti) => {
  const mine = owner.map((o, i) => (o === ti ? i : -1)).filter((i) => i >= 0);
  const k = t.words.length;
  // one square from the middle of each fifth of the topic's squares, so the words sit apart
  const cells = Array.from({ length: k }, (_, j) => mine[Math.floor(((j + 0.5) / k) * mine.length)]);
  const rest = new Set(mine.filter((c) => !cells.includes(c)).map(chapterOf));
  return {
    count: t.count,
    chapters: chapters[ti],
    words: t.words.map((w, j) => ({ zh: w.hanzi, en: w.en, cell: cells[j], chapter: chapterOf(cells[j]) })),
    moreChapters: rest.size,
  };
});
---

<Section id="topics" num="02" title="Topics, not chapters">
  <p class="prose">
    HSK 3.0 is the official vocabulary list for each level of the Chinese proficiency test. A prep book teaches it
    chapter by chapter, in the order the book chose — so one lesson can look like this:
  </p>
  <div class="book">
    <div class="book-head">
      <p class="label book-label">{bookLesson.label}</p>
      <span class="info" data-info>
        <button class="info-btn" type="button" aria-label="About this lesson" aria-describedby="book-info" aria-expanded="false">
          <svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25"></circle><path d="M7 6.2v3.6M7 4.2v.01"></path></svg>
        </button>
        <span class="info-pop" id="book-info" role="tooltip">
          <span class="info-intro">{bookLesson.info.intro}</span>
          <span class="info-rows">
            {
              bookLesson.info.rows.map((r) => (
                <span class="info-row">
                  <span class="info-where">{r.where}</span>
                  <span class="info-words hanzi">{r.words}</span>
                </span>
              ))
            }
          </span>
          <span class="info-note">{bookLesson.info.note}</span>
          <a href={bookLesson.source} target="_blank" rel="noopener">Source ↗</a>
        </span>
      </span>
    </div>
    <div class="book-words">
      {
        bookLesson.words.map((w) => (
          <div class="bw">
            <span class="hanzi">{w.hanzi}</span>
            <span class="en">{w.en}</span>
          </div>
        ))
      }
    </div>
    <p class="book-note">Together because they show up in the same story, not because you’d use them together.</p>
  </div>
  <p class="prose">
    mandarinmaxxing covers the same words, grouped by situation — getting around, eating out, at work — so each lesson
    is words you’d actually use together. Open all ten topics and you’ve covered HSK 4.
  </p>

  <div class="topics-wrap">
    <div class="list" data-topics>
      {
        topics.map((t, ti) => (
          <div class="topic" data-topic data-i={ti}>
            <button class="row" type="button" aria-expanded="false" aria-controls={`topic-${t.num}`}>
              <span class="arrow display" aria-hidden="true">
                <span class="dash">--</span>&gt;
              </span>
              <span class="num">{t.num}</span>
              <span class="name">{t.name}</span>
              <span class="preview hanzi" aria-hidden="true">
                {t.words.slice(0, 3).map((w, i) => (
                  <>
                    {i > 0 && ' '}
                    <span class="pw" style={`--i:${i}`}>
                      {w.hanzi}
                    </span>
                  </>
                ))}
              </span>
            </button>
            <div class="panel" id={`topic-${t.num}`} role="region" aria-label={t.name}>
              <div class="panel-inner">
                <div class="words">
                  {t.words.map((w, i) => (
                    <div class="word" style={`--i:${i}`} data-w={i}>
                      <span class="hanzi">{w.hanzi}</span>
                      <span class="en">{w.en}</span>
                    </div>
                  ))}
                  <div class="word more" style={`--i:${t.words.length}`} data-w="more">
                    <span class="hanzi">…</span>
                    <span class="en">+{t.count - t.words.length} more</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="bar" data-bar data-strip={JSON.stringify(stripData)}>
      <p class="bar-label" data-bar-label aria-live="polite">
        The HSK 4 book: {HSK4_TOTAL.toLocaleString('en-US')} words, in the order its chapters teach them.
      </p>
      <svg class="strip" viewBox={`0 0 ${COLS * 4 - 1} ${ROWS * 4 - 1}`} preserveAspectRatio="none" aria-hidden="true">
        {
          owner.map((o, i) => (
            <rect x={Math.floor(i / ROWS) * 4} y={(i % ROWS) * 4} width="3" height="3" data-t={o} />
          ))
        }
      </svg>
    </div>
  </div>
</Section>

<style>
  /* ---------- intro: a textbook lesson ---------- */
  .book {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .book-label {
    color: var(--muted-2);
  }
  .book-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* (i) next to the lesson label: hover, focus or tap shows where the words come from */
  .info {
    position: relative;
    display: inline-flex;
  }
  .info-btn {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted-2);
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .info-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .info:hover .info-btn,
  .info-btn:focus-visible,
  .info.open .info-btn {
    color: var(--text);
  }
  .info-btn:focus-visible {
    outline: 1px dashed var(--outline);
    outline-offset: 2px;
  }
  .info-pop {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: calc(100% + 10px);
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    background: #181818;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-dim);
    opacity: 0;
    translate: -50% 4px;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      translate 0.15s ease;
  }
  /* invisible bridge so the pointer can travel from the (i) to the pop-up */
  .info-pop::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 12px;
  }
  .info:hover .info-pop,
  .info:focus-within .info-pop,
  .info.open .info-pop {
    opacity: 1;
    translate: -50% 0;
    pointer-events: auto;
  }
  .info-intro {
    color: var(--text-dim);
  }
  /* borderless table: where in the lesson → which words */
  .info-rows {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 16px;
    row-gap: 4px;
  }
  .info-row {
    display: contents;
  }
  .info-where {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
    line-height: 22px;
  }
  .info-words {
    font-size: 16px;
    line-height: 22px;
    color: var(--text);
  }
  .info-note {
    color: var(--muted);
  }
  .info-pop a {
    align-self: flex-start;
    color: var(--accent-light);
  }
  .info-pop a:hover {
    color: #f8b68c;
  }
  .book-words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 28px;
    row-gap: 12px;
  }
  .bw {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .bw .hanzi {
    font-size: 24px;
    line-height: 32px;
    color: var(--text-80);
  }
  .bw .en,
  .book-note {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
  }

  /* ---------- list ---------- */
  /* the list is its own stacking layer under the bar, so animated rows/words (which get their own
     compositing layers while they move) can never paint over the bar or its cover */
  .list {
    position: relative;
    z-index: 1;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }

  /* row: closed / hover / open */
  .row {
    display: flex;
    align-items: baseline;
    width: 100%;
    padding: 8px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  .arrow,
  .num,
  .name {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    transform-origin: left center;
    transition: color 0.15s ease;
  }
  /* the arrow starts in the numbers' column and pushes the number along */
  .arrow {
    display: inline-block;
    overflow: hidden;
    white-space: pre;
    max-width: 0;
    margin-right: 0;
    color: var(--accent-light);
    transition:
      max-width 0.18s ease,
      margin-right 0.18s ease;
  }
  .num {
    width: 24px;
    flex-shrink: 0;
    margin-right: 12px;
    color: var(--muted-2);
  }
  .name {
    flex: 1;
    min-width: 0;
    color: var(--text-dim);
  }
  .preview {
    flex-shrink: 0;
    white-space: pre;
    font-size: 16px;
    line-height: var(--lh-h4);
    color: #3a3a3a;
  }
  .pw {
    display: inline-block;
    transition: color 0.15s ease;
  }

  /* hover (and keyboard focus): arrow head slides in, the whole row turns light orange */
  .row:hover .arrow,
  .row:focus-visible .arrow,
  .topic.open .arrow {
    max-width: 3em;
    margin-right: 12px;
  }
  .row:hover :is(.num, .name, .pw),
  .row:focus-visible :is(.num, .name, .pw) {
    color: var(--accent-light);
  }
  .row:focus-visible {
    outline: none;
  }
  /* hover shows only the arrow head; the dashes join it once the topic is open */
  .dash {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    max-width: 0;
  }
  .topic.open .dash {
    max-width: 2em;
  }

  /* open: white, semibold, header grows to h3 (animated in place by the script), preview hides.
     The negative margin keeps the title's centre on the same line it had when closed. */
  .topic.open .row {
    margin-top: calc((var(--lh-h4) - var(--lh-h3)) / 2);
  }
  .topic.open :is(.arrow, .num, .name) {
    font-weight: var(--fw-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--text);
  }
  .topic.open .num {
    width: auto;
  }
  /* preview hanzi leave one by one, left to right: they rise slowly, speed up (ease-in) and
     vanish at their fastest point instead of fading */
  .topic.open .pw {
    animation: preview-out 0.14s cubic-bezier(0.3, 0, 0.9, 0.4) forwards;
    animation-delay: calc(var(--i) * 28ms);
  }
  /* on close they come back the reverse way, right to left: they appear at speed and settle */
  .topic.closing .pw {
    animation: preview-in 0.16s cubic-bezier(0.1, 0.6, 0.7, 1) both;
    animation-delay: calc((2 - var(--i)) * 28ms);
  }
  @keyframes preview-in {
    0% {
      translate: 0 -14px;
      opacity: 0;
    }
    0.1% {
      translate: 0 -14px;
      opacity: 1;
    }
    100% {
      translate: 0 0;
      opacity: 1;
    }
  }
  @keyframes preview-out {
    0% {
      translate: 0 0;
      opacity: 1;
    }
    99.9% {
      translate: 0 -14px;
      opacity: 1;
    }
    100% {
      translate: 0 -14px;
      opacity: 0;
    }
  }

  /* ---------- panel (accordion) ---------- */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
  }
  .panel-inner {
    min-height: 0;
    overflow: hidden;
    padding-left: 48px;
  }
  .topic.open .panel {
    grid-template-rows: 1fr;
  }
  .words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 28px;
    row-gap: 16px;
    margin: 16px 0 24px;
  }
  .word {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    /* contents come in one by one; on close they fade out together */
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.16s ease,
      translate 0s linear 0.16s;
  }
  .topic.open .word {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.3s ease,
      translate 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(120ms + var(--i) * 45ms);
  }
  .word .hanzi {
    font-size: 32px;
    line-height: 38px;
    color: var(--text-80);
  }
  .word .en {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
  }
  /* each word arrives light orange and settles to its colour */
  .topic.open .word:not(.more) :is(.hanzi, .en) {
    animation: word-tint 0.5s ease-out both;
    animation-delay: calc(120ms + var(--i) * 45ms);
  }
  @keyframes word-tint {
    from,
    30% {
      color: var(--accent-light);
    }
  }
  .word.more .hanzi {
    color: #3a3a3a;
  }
  .word.more .en {
    color: var(--muted-2);
  }

  /* ---------- sticky bar ---------- */
  /* the list and its bar: overflow clip keeps the bar's cover (below) inside the section */
  .topics-wrap {
    overflow: clip;
    overflow-clip-margin: 0px;
  }
  /* The bar sticks at --stick from the bottom of the screen (set by the script: a little above the
     bottom edge). Below the bar a cover hides the rows that haven't
     scrolled up yet, so the list always "closes" with the bar. */
  .bar {
    position: sticky;
    bottom: var(--stick, 0px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
    padding: 16px 0 20px;
    border-top: 1px solid var(--text-dim); /* same grey as the inactive topic names */
    background: var(--bg);
    /* own compositing layer: Safari otherwise sometimes skips repainting the cover until hover */
    transform: translateZ(0);
  }
  /* while stuck, rows fade out as they reach the bar instead of being cut */
  .bar::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 1px);
    height: 56px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .bar.stuck::before {
    opacity: 1;
  }
  .bar::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 100vh;
    background: var(--bg);
    pointer-events: none;
  }
  .bar-label {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--muted);
  }
  .bar-label :global(.w) {
    color: var(--text);
  }
  .bar-label :global(.o) {
    color: var(--accent-light);
  }
  .bar-label :global(.dim) {
    color: var(--muted-2);
  }
  .strip {
    display: block;
    width: 100%;
    height: 7px;
  }
  .strip rect {
    fill: #262626;
    transition: fill 0.2s ease;
  }
  .strip rect.on {
    fill: var(--text-80);
  }
  .strip rect.dim {
    fill: #3a3a3a;
  }
  .word[data-w] {
    cursor: default;
  }
  .topic.open .word:hover .hanzi,
  .topic.open .word:hover .en {
    color: var(--accent-light);
  }
  .strip rect.hov {
    fill: var(--accent-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .topic.open .pw {
      animation: none;
      opacity: 0;
    }
    .topic.closing .pw {
      animation: none;
    }
    .arrow,
    .panel,
    .strip rect,
    .topic.open .word {
      transition: none;
    }
    .topic.open .word :is(.hanzi, .en) {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Accordion: click a topic to open it, click again to close. One open at a time.
  // The header grows from h4 to h3 in place (FLIP): record where the arrow, number and title are, let
  // the class change their size, then GSAP animates each from its old spot and size (one uniform
  // scale, so the text never stretches) with the site's overshoot (back.out = Penner's easeOutBack).
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const items = [...document.querySelectorAll<HTMLElement>('[data-topic]')];

  function setOpen(item: HTMLElement, open: boolean) {
    const btn = item.querySelector<HTMLButtonElement>('.row')!;
    if (item.classList.contains('open') === open) return;
    const parts = [...btn.querySelectorAll<HTMLElement>('.arrow, .num, .name')];
    gsap.killTweensOf(parts);
    gsap.set(parts, { clearProps: 'transform' });
    const before = parts.map((p) => p.getBoundingClientRect());
    item.classList.toggle('open', open);
    // closing: play the preview hanzi's return animation
    clearTimeout(Number(item.dataset.closingTimer));
    item.classList.toggle('closing', !open);
    if (!open) item.dataset.closingTimer = String(setTimeout(() => item.classList.remove('closing'), 320));
    btn.setAttribute('aria-expanded', String(open));
    if (reduce) return;
    parts.forEach((p, i) => {
      const b = before[i];
      const a = p.getBoundingClientRect();
      if (!a.height) return;
      gsap.from(p, {
        x: b.left - a.left,
        y: b.top + b.height / 2 - (a.top + a.height / 2),
        scale: b.height / a.height,
        transformOrigin: 'left center',
        duration: 0.38,
        ease: 'back.out(1.70158)',
        clearProps: 'transform',
      });
    });
  }

  // (i) next to the book lesson: tap toggles the pop-up (hover/focus already show it)
  const info = document.querySelector<HTMLElement>('[data-info]');
  if (info) {
    const btn = info.querySelector<HTMLButtonElement>('.info-btn')!;
    btn.addEventListener('click', () => {
      const open = info.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!info.contains(e.target as Node)) {
        info.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // ---- sticky bar: open topic in white, hovered topic in light orange, summed in the label ----
  const bar = document.querySelector<HTMLElement>('[data-bar]')!;
  const label = bar.querySelector<HTMLElement>('[data-bar-label]')!;
  type WordCell = { zh: string; en: string; cell: number; chapter: number };
  const data: { count: number; chapters: number; words: WordCell[]; moreChapters: number }[] = JSON.parse(bar.dataset.strip!);
  const rects = [...bar.querySelectorAll<SVGRectElement>('rect')].map((r, i) => ({ r, t: Number(r.dataset.t), i }));
  const TOTAL = '1,000';
  let active = -1;
  let hover = -1;
  let wordFocus: number | 'more' | null = null; // a word (or "+N more") hovered in the open topic

  function render() {
    const h = hover === active ? -1 : hover;
    const span = (cls: string, text: string) => `<span class="${cls}">${text}</span>`;

    // a word of the open topic: its square lights up, the rest of the topic dims
    if (active >= 0 && wordFocus !== null) {
      const d = data[active];
      const wordCells = d.words.map((w) => w.cell);
      const lit = (i: number) => (wordFocus === 'more' ? !wordCells.includes(i) : i === d.words[wordFocus as number].cell);
      for (const { r, t, i } of rects) {
        const mine = t === active;
        r.classList.toggle('hov', mine && lit(i));
        r.classList.toggle('dim', mine && !lit(i));
        r.classList.toggle('on', false);
      }
      if (wordFocus === 'more') {
        label.innerHTML =
          `${span('o', String(d.count - d.words.length))} more words ` +
          span('dim', `· spread across ${d.moreChapters} chapters in the book`);
      } else {
        const w = d.words[wordFocus];
        label.innerHTML = `${span('o', w.zh)} ${w.en} ` + span('dim', `· chapter ${w.chapter} of 20 in the book`);
      }
      return;
    }
    for (const { r, t } of rects) {
      r.classList.toggle('on', t === active);
      r.classList.toggle('hov', t === h);
      r.classList.remove('dim');
    }
    if (active < 0 && h < 0) {
      label.innerHTML = `The HSK 4 book: ${TOTAL} words, in the order its chapters teach them.`;
    } else if (h < 0) {
      label.innerHTML =
        `${span('w', String(data[active].count))} of ${TOTAL} HSK 4 words ` +
        span('dim', '· the strip is the HSK 4 book, in chapter order');
    } else {
      const lead = active < 0 ? span('o', String(data[h].count)) : `${span('w', String(data[active].count))} ${span('o', '+ ' + data[h].count)}`;
      label.innerHTML =
        `${lead} of ${TOTAL} HSK 4 words ` +
        span('dim', `· in the book, these ${data[h].count} are spread across ${data[h].chapters} chapters. Here they’re one topic.`);
    }
  }

  // Where the bar sticks: centred with the list when there's room, but never more than 8% of the
  // screen above the bottom, so the section title and most of the list (even with a topic open)
  // fit on screen before the bar starts covering rows.
  const wrap = bar.parentElement!;
  const placeBar = () => {
    const centred = (innerHeight - wrap.offsetHeight) / 2;
    const stick = Math.max(16, Math.min(centred, innerHeight * 0.08));
    wrap.style.setProperty('--stick', `${Math.round(stick)}px`);
  };
  // stuck = the list still continues below the bar (rows hidden under it)
  const checkStuck = () => {
    const stick = parseFloat(wrap.style.getPropertyValue('--stick')) || 0;
    bar.classList.toggle('stuck', wrap.getBoundingClientRect().bottom > innerHeight - stick + 1);
  };
  placeBar();
  checkStuck();
  addEventListener('resize', () => {
    placeBar();
    checkStuck();
  });
  addEventListener('scroll', checkStuck, { passive: true });
  new ResizeObserver(() => {
    placeBar();
    checkStuck();
  }).observe(wrap);

  items.forEach((item, i) => {
    const row = item.querySelector<HTMLElement>('.row')!;
    row.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      for (const other of items) if (other !== item) setOpen(other, false);
      setOpen(item, willOpen);
      active = willOpen ? i : -1;
      wordFocus = null;
      render();
    });
    const enter = () => {
      hover = i;
      render();
    };
    const leave = () => {
      if (hover === i) hover = -1;
      render();
    };
    row.addEventListener('mouseenter', enter);
    row.addEventListener('mouseleave', leave);
    row.addEventListener('focus', enter);
    row.addEventListener('blur', leave);

    // words of the open topic → their square on the strip
    item.querySelectorAll<HTMLElement>('[data-w]').forEach((el) => {
      const key = el.dataset.w === 'more' ? 'more' : Number(el.dataset.w);
      el.addEventListener('mouseenter', () => {
        if (active !== i) return;
        wordFocus = key;
        render();
      });
      el.addEventListener('mouseleave', () => {
        if (wordFocus === key) wordFocus = null;
        render();
      });
    });
  });
</script>
