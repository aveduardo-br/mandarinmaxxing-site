---
// Section 02 — Paper node 1V-0.
// Three states per topic: closed, hover (arrow slides in, row turns white, preview hanzi light up)
// and open (accordion, like 08 in Paper). One topic open at a time; all start closed.
import Section from '../Section.astro';
import { topics, levelNames, type Topic } from '../../data/topics';

const groups: Topic[][] = [];
for (let i = 0; i < topics.length; i += 2) groups.push(topics.slice(i, i + 2));
---

<Section id="topics" num="02" title="Topics, not chapters">
  <p class="prose">
    HSK 3.0 is the official vocabulary list for each level of the Chinese proficiency test. mandarinmaxxing uses it as
    the reference for what to learn. What changes is the order.
  </p>
  <p class="prose">
    A prep book teaches words in the order its chapters introduce them. mandarinmaxxing groups the words of your level
    by the situation you'll use them in, like getting around town or ordering food. When a word from another level
    makes a useful chunk, it comes in too, marked as an extra.
  </p>
  <p class="prose">Neither order is the right one. This is an option for people who'd rather study by topic.</p>

  <div class="list" data-topics>
    {
      groups.map((g) => (
        <div class="group">
          {g.map((t) => (
            <div class="topic" data-topic>
              <button class="row" type="button" aria-expanded="false" aria-controls={`topic-${t.num}`}>
                <span class="arrow pixel" aria-hidden="true">--&gt;</span>
                <span class="num pixel">{t.num}</span>
                <span class="name pixel">{t.name}</span>
                <span class="preview hanzi" aria-hidden="true">{t.preview}</span>
              </button>
              <div class="panel" id={`topic-${t.num}`} role="region" aria-label={t.name}>
                <div class="panel-inner">
                  <div class="words">
                    {t.words?.map((w, i) => (
                      <div class={`word ${w.level}`} style={`--i:${i}`}>
                        <span class="hanzi">{w.hanzi}</span>
                        <span class="en">{w.en}</span>
                      </div>
                    ))}
                    {t.more && (
                      <div class="word more" style={`--i:${t.words?.length ?? 0}`}>
                        <span class="hanzi">…</span>
                        <span class="en">+{t.more} more</span>
                      </div>
                    )}
                  </div>
                  {t.counts && (
                    <div class="levels">
                      <div class="bar-row">
                        <div class="squares" aria-hidden="true">
                          {[
                            ...Array.from({ length: t.counts.base }, () => 'base'),
                            ...Array.from({ length: t.counts.below }, () => 'below'),
                            ...Array.from({ length: t.counts.above }, () => 'above'),
                          ].map((lvl, i) => (
                            <i class={`sq ${lvl}`} style={`--i:${i}`} />
                          ))}
                        </div>
                        <div class="legend pixel">
                          <span class="base">
                            <i class="sq" />
                            {levelNames.base} · {t.counts.base}
                          </span>
                          <span class="below">
                            <i class="sq" />
                            {levelNames.below} · {t.counts.below}
                          </span>
                          <span class="above">
                            <i class="sq" />
                            {levelNames.above} · {t.counts.above}
                          </span>
                        </div>
                      </div>
                      <p class="note">Extras from a level below or above come in when they make a useful chunk with the rest.</p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</Section>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 24px;
  }
  .group {
    display: flex;
    flex-direction: column;
  }

  /* ---------- row: closed / hover / open ---------- */
  .row {
    display: flex;
    align-items: baseline;
    width: 100%;
    padding: 8px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }
  .arrow {
    display: inline-block;
    overflow: hidden;
    white-space: pre;
    max-width: 0;
    margin-right: 0;
    font-size: 12px;
    line-height: 20px;
    color: var(--text);
    transition:
      max-width 0.18s ease,
      margin-right 0.18s ease;
  }
  .num {
    width: 20px;
    flex-shrink: 0;
    margin-right: 14px;
    font-size: 12px;
    line-height: 20px;
    color: var(--muted-2);
  }
  .name {
    flex: 1;
    min-width: 0;
    font-size: 12px;
    line-height: 20px;
    color: var(--text-dim);
  }
  .preview {
    flex-shrink: 0;
    width: 128px;
    padding-right: 4px;
    text-align: right;
    white-space: pre;
    font-size: 16px;
    line-height: 20px;
    color: #3a3a3a;
  }
  .num,
  .name,
  .preview {
    transition: color 0.15s ease;
  }
  .arrow,
  .num,
  .name {
    transform-origin: left center;
  }

  /* hover (and keyboard focus): arrow slides in, everything turns white */
  .row:hover .arrow,
  .row:focus-visible .arrow,
  .topic.open .arrow {
    max-width: 3em;
    margin-right: 14px;
  }
  .row:hover :is(.num, .name, .preview),
  .row:focus-visible :is(.num, .name, .preview),
  .topic.open :is(.num, .name) {
    color: var(--text);
  }
  .row:focus-visible {
    outline: none;
  }

  /* open: header grows to 24px like 08 in Paper (animated in place by the script), preview hides */
  .topic.open :is(.arrow, .num, .name) {
    font-size: 24px;
    line-height: 32px;
  }
  .topic.open .num {
    width: auto;
  }
  .topic.open .preview {
    display: none;
  }

  /* ---------- panel (accordion) ---------- */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
  }
  .panel-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-left: 56px;
  }
  .topic.open .panel {
    grid-template-rows: 1fr;
  }
  .panel-inner > :first-child {
    margin-top: 20px;
  }
  .panel-inner > :last-child {
    margin-bottom: 28px;
  }

  /* contents come in one by one; on close they reset at once */
  .word,
  .legend,
  .note {
    opacity: 0;
    translate: 0 6px;
  }
  .topic.open .word,
  .topic.open .legend,
  .topic.open .note {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.3s ease,
      translate 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .topic.open .word {
    transition-delay: calc(120ms + var(--i) * 45ms);
  }
  .topic.open .legend {
    transition-delay: 620ms;
  }
  .topic.open .note {
    transition-delay: 720ms;
  }

  .words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 24px;
    row-gap: 16px;
    max-width: 499px;
  }
  .word {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .word .hanzi {
    font-size: 32px;
    line-height: 38px;
    color: var(--text);
  }
  .word .en {
    font-size: 12px;
    line-height: 16px;
    color: var(--muted);
    text-align: center;
  }
  .word.below .hanzi,
  .word.below .en {
    color: var(--accent-light);
  }
  .word.above .hanzi,
  .word.above .en {
    color: var(--accent);
  }
  .word.more .hanzi {
    color: #3a3a3a;
  }
  .word.more .en {
    color: var(--muted-2);
  }

  .levels {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 4px;
  }
  .bar-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .squares {
    display: flex;
    gap: 2px;
  }
  .sq {
    display: block;
    width: 6px;
    height: 6px;
    flex-shrink: 0;
  }
  .squares .sq {
    background: #262626;
  }
  .topic.open .squares .sq {
    transition: background-color 0.12s ease;
    transition-delay: calc(560ms + var(--i) * 35ms);
  }
  .topic.open .squares .base {
    background: rgba(242, 242, 242, 0.8);
  }
  .topic.open .squares .below {
    background: var(--accent-light);
  }
  .topic.open .squares .above {
    background: var(--accent);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    line-height: 16px;
    white-space: pre;
  }
  .legend > span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend .base {
    color: var(--text);
    opacity: 0.8;
  }
  .legend .below {
    color: var(--accent-light);
  }
  .legend .above {
    color: var(--accent);
  }
  .legend .sq {
    background: currentColor;
  }
  .note {
    max-width: 440px;
    font-size: 13px;
    line-height: 19px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .panel,
    .topic.open :is(.word, .legend, .note, .squares .sq) {
      transition: none;
    }
  }
</style>

<script>
  // Accordion: click a topic to open it, click again to close. One open at a time.
  // The header grows from 12px to 24px in place (FLIP + easeOutBack overshoot), no jump.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DURATION = 380;
  const C1 = 1.70158;
  const C3 = C1 + 1;
  const easeOutBack = (t: number) => 1 + C3 * Math.pow(t - 1, 3) + C1 * Math.pow(t - 1, 2);

  const items = [...document.querySelectorAll<HTMLElement>('[data-topic]')];

  function setOpen(item: HTMLElement, open: boolean) {
    const btn = item.querySelector<HTMLButtonElement>('.row')!;
    if (item.classList.contains('open') === open) return;
    const parts = [...btn.querySelectorAll<HTMLElement>('.arrow, .num, .name')];
    parts.forEach((p) => (p.style.transform = ''));
    const before = parts.map((p) => p.getBoundingClientRect());
    item.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    if (reduce) return;
    const after = parts.map((p) => p.getBoundingClientRect());
    const t0 = performance.now();
    const frame = (now: number) => {
      const t = Math.min(1, (now - t0) / DURATION);
      const k = 1 - easeOutBack(t); // 1 → 0, overshooting past 0 at the end
      parts.forEach((p, i) => {
        const b = before[i], a = after[i];
        if (!a.height) return;
        const s = 1 + (b.height / a.height - 1) * k;
        const dx = (b.left - a.left) * k;
        const dy = (b.top + b.height / 2 - (a.top + a.height / 2)) * k;
        p.style.transform = `translate(${dx.toFixed(2)}px, ${dy.toFixed(2)}px) scale(${s.toFixed(4)})`;
      });
      if (t < 1) requestAnimationFrame(frame);
      else parts.forEach((p) => (p.style.transform = ''));
    };
    requestAnimationFrame(frame);
  }

  for (const item of items) {
    item.querySelector('.row')!.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      for (const other of items) if (other !== item) setOpen(other, false);
      setOpen(item, willOpen);
    });
  }
</script>
