---
// FAQ. The first answer is the only place where Eduardo speaks in the first person.
// Answers are plain strings; a few carry a link, so they are rendered as HTML.
// Each question is collapsible. A tile before the question holds the arrow: grey with a down arrow
// while closed; on opening it flips (the same flip as every tile) to orange with a dark up arrow.
// The first question starts open. Without JavaScript every answer is shown.
import { SKILL_ISSUES } from '../../data/site';

const items = [
  {
    id: 'faq-why',
    q: 'Why did you make this?',
    a: [
      'It started as a tool to help me study. With the textbooks I was learning plenty of words, but when I tried to speak I couldn’t connect them, and my progress felt stuck. So I built this skill to learn by situation: everything around one moment, so I could actually talk about it.',
      'I wrote my own course with it, 67 lessons covering HSK 1 and 2. I remembered words better and connected ideas faster. That’s my experience, not a promise.',
      'A friend who was also studying tried it, liked it, and switched to learning with the skill. That’s when I opened it up to anyone.',
      `The goal is a clear, direct way to learn Mandarin, closer to how I learned English, free for anyone who uses Claude. Anyone who studies with it can make it better for the next person: if a lesson feels off or a word sits in the wrong situation, <a href="${SKILL_ISSUES}" target="_blank" rel="noopener">open an issue on GitHub ↗</a>.`,
    ],
  },
  {
    id: 'faq-saved',
    q: 'Where does my course live?',
    a: [
      'In your Claude project. The skill keeps one small file there with your settings, your lesson list and what you’ve finished. Open a new chat in the same project, on any device, and say “next lesson”. There’s nothing to attach or paste.',
      'The skill also runs in Claude Code and Codex, where the course is saved in your working folder. I test it mostly in the Claude app.',
    ],
  },
  {
    id: 'faq-levels',
    q: 'Which levels does it cover?',
    a: [
      'HSK 1 to 4 are ready: 2,000 words, grouped by hand into 134 situations. Each level opens with a short jump start: the words every later lesson uses.',
      'When you finish a level, the course moves on to the next one, and words from the level you finished keep coming back. For HSK 5 and 6 the official word lists are included, and the skill builds the map when you start the level.',
      'The word list is the HSK syllabus released in November 2025.',
    ],
  },
  {
    id: 'faq-not',
    q: 'What doesn’t it do?',
    a: [
      'It doesn’t check your pronunciation or tones. Speaking practice is up to you.',
      'It doesn’t replace flashcards for long-term memory. Older words come back inside lessons, but the skill doesn’t track every word you’ve missed.',
      'It doesn’t promise fluency or a passing score. It covers the vocabulary. The exam also tests grammar, handwriting and speaking.',
    ],
  },
  {
    id: 'faq-free',
    q: 'Is it free? Is it official?',
    a: [
      'The skill is free. You need a Claude account, and a voice provider, if you connect one, has its own plans.',
      'mandarinmaxxing is an independent project. It uses the official HSK word list and isn’t affiliated with the organization that runs the test.',
    ],
  },
];
---

<section id="faq" class="faq" data-section>
  <p class="kicker">FAQ</p>
  <h2 class="title display">Questions</h2>
  {
    items.map((it, i) => (
      <div id={it.id} class:list={['item', { open: i === 0 }]} data-faq>
        <h3 class="q display">
          <button class="head" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`${it.id}-a`}>
            <span class:list={['ftile', { on: i === 0 }]} aria-hidden="true">
              <svg viewBox="0 0 7 6" shape-rendering="crispEdges">
                <path d="M3 0h1v3h-1zM1 3h1v1h-1zM5 3h1v1h-1zM2 4h3v1h-3zM3 3h1v3h-1z" />
              </svg>
            </span>
            <span>{it.q}</span>
          </button>
        </h3>
        <div class="body" id={`${it.id}-a`}>
          <div class="inner">
            {it.a.map((p) => (
              <p class="prose" set:html={p} />
            ))}
          </div>
        </div>
      </div>
    ))
  }
</section>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 48px;
    border-top: 2px solid var(--text);
  }
  .kicker {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--text);
  }
  .item {
    border-top: 1px solid var(--outline);
    scroll-margin-top: 48px;
  }
  .item:last-child {
    border-bottom: 1px solid var(--outline);
  }
  .item :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .q {
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    color: var(--text);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .head:focus-visible {
    outline: 1px dashed var(--accent-light);
    outline-offset: -2px;
  }
  /* the arrow tile: like a tile that is "off" (grey, light arrow) while closed, orange with a dark
     arrow pointing up while open */
  .ftile {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: #1e1e1e;
  }
  .ftile svg {
    width: 14px;
    height: 12px;
    fill: #8a8a8a;
  }
  .ftile.on {
    background: #d2430e;
  }
  .ftile.on svg {
    fill: #161616;
    transform: scaleY(-1);
  }
  .head:hover .ftile:not(.on) svg {
    fill: var(--text);
  }
  /* the answer: opens by growing its grid row, so it works for any length */
  .body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 42px; /* under the question, past the tile */
  }
  .inner > :last-child {
    padding-bottom: 20px;
  }
  /* closed only when the script is there to open it again */
  :global(.js) .item:not(.open) .body {
    grid-template-rows: 0fr;
  }
  :global(.js) .item:not(.open) .inner {
    visibility: hidden;
    transition: visibility 0s 0.4s;
  }
  @media (max-width: 720px) {
    .inner {
      padding-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .body {
      transition: none;
    }
  }
</style>

<script>
  import { DUR, EASE_CLOSE, EASE_OPEN, reduceMotion } from '../../scripts/tiles';

  const items = [...document.querySelectorAll<HTMLElement>('[data-faq]')];
  const set = (item: HTMLElement, open: boolean) => {
    if (item.classList.contains('open') === open) return;
    item.classList.toggle('open', open);
    item.querySelector('button')!.setAttribute('aria-expanded', String(open));
    const tile = item.querySelector<HTMLElement>('.ftile')!;
    if (reduceMotion()) return void tile.classList.toggle('on', open);
    // the tile closes, changes colour and arrow, and opens again
    const a = tile.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }], { duration: DUR, easing: EASE_CLOSE, fill: 'forwards' });
    a.onfinish = () => {
      a.cancel();
      tile.classList.toggle('on', item.classList.contains('open'));
      tile.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], { duration: DUR, easing: EASE_OPEN });
    };
  };
  for (const item of items) item.querySelector('button')!.addEventListener('click', () => set(item, !item.classList.contains('open')));
  // a link to a question (the side nav, or a shared address) opens it
  const fromHash = () => {
    const item = items.find((i) => `#${i.id}` === location.hash);
    if (item) set(item, true);
  };
  addEventListener('hashchange', fromHash);
  fromHash();
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#faq-"]');
    const item = link && items.find((i) => `#${i.id}` === link.getAttribute('href'));
    if (item) set(item, true);
  });
</script>
