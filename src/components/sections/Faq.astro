---
// FAQ. The first answer is the only place where Eduardo speaks in the first person.
// Answers are plain strings; a few carry a link, so they are rendered as HTML.
import { SKILL_ISSUES } from '../../data/site';

const items = [
  {
    id: 'faq-why',
    q: 'Why did you make this?',
    a: [
      'I made it for myself first. In the textbook I was using, one lesson taught the word for room next to the word for watch, because that chapter’s grammar needed them. I wanted the opposite: to learn everything around one moment, and be able to talk about it.',
      'So I wrote my own course, in Portuguese: 67 lessons covering HSK levels 1 and 2, each one built around a situation. I felt more progress that way. I remembered words better and connected ideas faster. That’s my experience, not a promise.',
      'A friend who was also studying tried it and ended up preferring it. That’s when I turned it into a skill anyone can use.',
      `I keep improving it as I study. If a lesson feels off, <a href="${SKILL_ISSUES}" target="_blank" rel="noopener">tell me on GitHub ↗</a>.`,
    ],
  },
  {
    id: 'faq-saved',
    q: 'Where does my course live?',
    a: [
      'In your Claude project. The skill keeps one small file there with your settings, your lesson list and what you’ve finished. Open a new chat in the same project, on any device, and say “next lesson”. There’s nothing to attach or paste.',
      'The skill also runs in Claude Code and Codex, where the course is saved in your working folder. I test it mostly in the Claude app.',
    ],
  },
  {
    id: 'faq-levels',
    q: 'Which levels does it cover?',
    a: [
      'HSK 1 is ready: all 300 words, in 22 situations mapped by hand. The first seven are a jump start: greetings, saying what you want, saying who you are.',
      'For HSK 2 to 6 the official word lists are included, and the skill builds the lesson map for your level when you start it. Hand-checked maps are coming, HSK 2 first.',
      'The word list is the HSK syllabus released in November 2025.',
    ],
  },
  {
    id: 'faq-not',
    q: 'What doesn’t it do?',
    a: [
      'It doesn’t check your pronunciation or tones. Speaking practice is up to you.',
      'It doesn’t replace flashcards for long-term memory. Older words come back inside lessons, but the skill doesn’t track every word you’ve missed.',
      'It doesn’t promise fluency or a passing score. It covers the vocabulary. The exam also tests grammar, handwriting and speaking.',
    ],
  },
  {
    id: 'faq-free',
    q: 'Is it free? Is it official?',
    a: [
      'The skill is free. You need a Claude account, and a voice provider, if you connect one, has its own plans.',
      'mandarinmaxxing is an independent project. It uses the official HSK word list and isn’t affiliated with the organization that runs the test.',
    ],
  },
];
---

<section id="faq" class="faq" data-section>
  <p class="kicker">FAQ</p>
  <h2 class="title display">Questions</h2>
  {
    items.map((it) => (
      <div id={it.id} class="item">
        <h3 class="q display">{it.q}</h3>
        {it.a.map((p) => (
          <p class="prose" set:html={p} />
        ))}
      </div>
    ))
  }
</section>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 48px;
    border-top: 2px solid var(--text);
  }
  .kicker {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--text);
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 16px;
    border-top: 1px solid var(--outline);
    scroll-margin-top: 48px;
  }
  .item:last-child {
    border-bottom: 1px solid var(--outline);
  }
  .item :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .q {
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    color: var(--text);
  }
</style>
