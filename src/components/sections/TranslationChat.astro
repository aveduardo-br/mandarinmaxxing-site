---
// Bento card "03 Written translation" — visual part.
// Three exercises that loop forever. Each one plays as a chat: Claude's prompt arrives, the person's
// answer is typed in, then Claude's correction arrives with a light-orange "Next one ↓" button.
// Clicking it starts the next exercise: new messages arrive at the bottom and push the chat up, like
// a real chat. The previous exercise stays above and fades out towards the top.

type Exercise = {
  prompt: string;
  answer: string; // what the person types
  mistake?: string; // part of the answer that is wrong (shown at 70% white)
  fixed: string; // Claude's version; '' when the answer was already right
  fix?: string; // part of Claude's version that changed (shown in green)
  note: string;
};

const exercises: Exercise[] = [
  {
    prompt: 'Can you recommend a dish?',
    answer: '你可以推荐一个菜吗？',
    mistake: '个',
    fixed: '你可以推荐一道菜吗？',
    fix: '道',
    note: 'Dishes take 道, not 个.',
  },
  {
    prompt: 'The menu, please.',
    answer: '请给我菜单。',
    fixed: '',
    note: 'That’s exactly how you’d say it.',
  },
  {
    prompt: 'I’d like it to go.',
    answer: '我要外卖。',
    mistake: '外卖',
    fixed: '我要打包。',
    fix: '打包',
    note: '外卖 is delivery. To go is 打包.',
  },
];
---

<div class="tr" data-tr data-exercises={JSON.stringify(exercises)}>
  <div class="tr-track" data-track></div>
  <p class="tr-sr" aria-live="polite" data-live></p>
</div>

<style is:global>
  /* Written translation chat (global: the bubbles are built by the script) */
  .tr {
    position: relative;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 8%, #000 46%);
    mask-image: linear-gradient(180deg, transparent 0%, transparent 8%, #000 46%);
  }
  /* anchored to the bottom like a chat; every message has the same 12px gap */
  .tr-track {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
  }
  /* gap between exercises only once the new one has a visible message (no jump on append) */
  .tr-block + .tr-block:has(> .msg:not(.hidden)) {
    margin-top: 12px;
  }
  .tr-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tr .bubble {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tr .tr-label {
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .tr .tr-q {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-soft);
  }
  .tr .tr-zh {
    font-family: var(--f-brush);
    font-weight: 700;
    font-size: 18px;
    line-height: 20px;
    color: var(--text);
    white-space: pre;
    min-height: 20px;
  }
  .tr .tr-zh .bad {
    color: rgba(242, 242, 242, 0.7);
  }
  .tr .tr-zh .good,
  .tr .tr-ok {
    color: var(--ok);
  }
  .tr .tr-note {
    font-size: 13px;
    line-height: 20px;
    color: var(--text-dim);
  }
  .tr .tr-next {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--accent-light);
    cursor: pointer;
    white-space: nowrap;
  }
  .tr .tr-next:not([disabled]):hover {
    color: #f8b68c;
  }
  .tr .tr-next:focus-visible {
    outline: 1px dashed var(--accent-light);
    outline-offset: 2px;
  }
  /* once clicked (or on the old exercise above) it greys out and can't be pressed again */
  .tr .tr-next[disabled] {
    color: var(--muted-2);
    cursor: default;
    transition: color 0.3s ease;
  }

  /* messages pop in with the site's overshoot, scaling from the corner where the tail is */
  .tr .msg.hidden {
    display: none;
  }
  .tr .bubble.ai.msg {
    transform-origin: 0% 100%;
  }
  .tr .bubble.user.msg {
    transform-origin: 100% 100%;
  }
  .tr .msg.pop {
    animation: tr-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes tr-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .tr-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tr .msg.pop {
      animation: none;
    }
  }
</style>

<script>
  type Exercise = {
    prompt: string;
    answer: string;
    mistake?: string;
    fixed: string;
    fix?: string;
    note: string;
  };

  const root = document.querySelector<HTMLElement>('[data-tr]');
  if (root) {
    const ex: Exercise[] = JSON.parse(root.dataset.exercises!);
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const n = ex.length;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wrap = (i: number) => ((i % n) + n) % n;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, reduce ? 0 : ms));

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const tail = (from: 'ai' | 'user') => {
      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'tail');
      svg.setAttribute('viewBox', '0 0 8 10');
      svg.setAttribute('aria-hidden', 'true');
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', from === 'ai' ? 'M8 0 L8 10 L0 10 Z' : 'M0 0 L0 10 L8 10 Z');
      p.setAttribute('style', `fill: var(--bubble-${from})`);
      svg.appendChild(p);
      return svg;
    };
    const bubble = (from: 'ai' | 'user', children: Node[]) => {
      const b = el('div', `bubble ${from} msg`);
      b.append(...children, tail(from));
      return b;
    };
    // hanzi line with one highlighted part
    const zhLine = (text: string, mark: string | undefined, cls: string, upto = text.length) => {
      const p = el('p', 'tr-zh');
      const shown = [...text].slice(0, upto).join('');
      const at = mark ? text.indexOf(mark) : -1;
      if (at < 0) {
        p.textContent = shown;
        return p;
      }
      const a = [...text.slice(0, at)].length;
      const b = a + [...mark!].length;
      const chars = [...shown];
      p.append(
        document.createTextNode(chars.slice(0, a).join('')),
        el('span', cls, chars.slice(a, b).join('')),
        document.createTextNode(chars.slice(b).join('')),
      );
      return p;
    };

    type Block = { root: HTMLElement; prompt: HTMLElement; user: HTMLElement; reply: HTMLElement; next: HTMLButtonElement; i: number };

    const makeBlock = (i: number): Block => {
      const e = ex[i];
      const blk = el('div', 'tr-block');
      const prompt = bubble('ai', [el('span', 'tr-label', `Translate · ${i + 1} / ${n}`), el('p', 'tr-q', e.prompt)]);
      const user = bubble('user', [zhLine(e.answer, e.mistake, 'bad')]);
      const next = el('button', 'tr-next', 'Next one ↓') as HTMLButtonElement;
      next.type = 'button';
      const note = el('p', 'tr-note', e.note + ' ');
      note.append(next);
      const first = e.fixed ? zhLine(e.fixed, e.fix, 'good') : el('p', 'tr-zh tr-ok', '✓ Natural.');
      const reply = bubble('ai', [first, note]);
      blk.append(prompt, user, reply);
      return { root: blk, prompt, user, reply, next, i };
    };

    let cur = 0;
    let current: Block;
    let busy = false;

    // Reveal a message: the chat slides up by the new message's height (it is anchored to the
    // bottom), and the message pops in with the overshoot.
    function reveal(m: HTMLElement) {
      const before = track.offsetHeight;
      m.classList.remove('hidden');
      const grow = track.offsetHeight - before;
      if (reduce) return;
      m.classList.remove('pop');
      void m.offsetWidth;
      m.classList.add('pop');
      track.style.transition = 'none';
      track.style.transform = `translateY(${grow}px)`;
      void track.offsetHeight;
      track.style.transition = 'transform 0.42s cubic-bezier(0.22, 1, 0.36, 1)';
      track.style.transform = 'translateY(0)';
    }

    function addBlock(i: number, done: boolean) {
      const b = makeBlock(i);
      if (done) {
        b.next.disabled = true;
        b.next.tabIndex = -1;
      } else {
        b.prompt.classList.add('hidden');
        b.user.classList.add('hidden');
        b.reply.classList.add('hidden');
        b.next.addEventListener('click', advance);
      }
      track.append(b.root);
      return b;
    }

    async function play(b: Block) {
      busy = true;
      const e = ex[b.i];
      await wait(150);
      reveal(b.prompt);
      // time to read the prompt before answering
      await wait(1500);
      // the person "types" the answer
      const total = [...e.answer].length;
      const line = (c: number) => b.user.querySelector('.tr-zh')!.replaceWith(zhLine(e.answer, e.mistake, 'bad', c));
      line(1);
      reveal(b.user);
      await wait(260);
      for (let c = 2; c <= total; c++) {
        line(c);
        await wait(90 + Math.random() * 60);
      }
      // a moment before Claude answers
      await wait(1100);
      reveal(b.reply);
      live.textContent = `${e.prompt} — ${e.answer} — ${e.fixed || 'Natural.'} ${e.note}`;
      // the button arrives orange and only greys out once it's clicked (busy blocks early clicks)
      await wait(350);
      busy = false;
    }

    async function advance(this: HTMLButtonElement) {
      if (busy || this !== current.next) return;
      current.next.disabled = true;
      current.next.tabIndex = -1;
      cur = wrap(cur + 1);
      current = addBlock(cur, false);
      // keep only the previous exercise above the current one
      while (track.children.length > 2) track.firstElementChild!.remove();
      await play(current);
    }

    // start: the card is empty, exercise 1 plays when in view and waits on its Next
    current = addBlock(cur, false);
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          io.disconnect();
          play(current);
        }
      },
      { threshold: 0.5 },
    );
    io.observe(root);
  }
</script>
