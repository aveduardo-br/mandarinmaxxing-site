---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'mandarinmaxxing',
  description = 'A topic-based way to study Mandarin with HSK 3.0 vocabulary and phrases you can use in everyday conversations.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0E0E0E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preload" href="/fonts/zpix-site.woff" as="font" type="font/woff" crossorigin />
    <!-- TODO: self-host Geist / Geist Mono in public/fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <SideNav />
    <main class="col">
      <slot />
    </main>
    <Footer />
    <!-- Pixel-font snapping. Zpix is drawn on a pixel grid, so it is only crisp when each glyph
         starts exactly on a screen pixel. Centred or scaled layouts often land text on a fraction
         of a pixel (e.g. 130.31px), which Safari and Retina screens render blurry. This nudges every
         piece of static Zpix text by that fraction (position: relative + left/top, so it never
         affects layout or the animations) and re-runs when the layout or the screen changes. -->
    <script is:inline>
      (() => {
        const skip = '.item, [data-sr], .topic .arrow'; // Chunks columns, the Spaced review carousel and the Topics arrow (its dashes are clipped) move on their own
        let els = [];
        const collect = () => {
          els = [...document.querySelectorAll('body *')].filter((e) => {
            if (e.closest(skip)) return false;
            const cs = getComputedStyle(e);
            if (!/Zpix/.test(cs.fontFamily) || (cs.position !== 'static' && !e.dataset.snap)) return false;
            if (![...e.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim())) return false;
            // text inside a fixed box (the side nav) sits on the screen; the rest on the page
            let a = e;
            while (a && getComputedStyle(a).position !== 'fixed') a = a.parentElement;
            e._fixed = !!a;
            return true;
          });
        };
        const snap = () => {
          const dpr = devicePixelRatio || 1;
          const range = document.createRange();
          const moves = els.map((e) => {
            const node = [...e.childNodes].find((n) => n.nodeType === 3 && n.textContent.trim());
            range.selectNodeContents(node);
            const r = range.getClientRects()[0];
            if (!r) return null;
            const ox = parseFloat(e.style.left) || 0;
            const oy = parseFloat(e.style.top) || 0;
            const x = r.left + (e._fixed ? 0 : scrollX);
            const y = r.top + (e._fixed ? 0 : scrollY);
            const fx = (x * dpr - Math.round(x * dpr)) / dpr;
            const fy = (y * dpr - Math.round(y * dpr)) / dpr;
            return [e, ox - fx, oy - fy];
          });
          for (const m of moves) {
            if (!m) continue;
            const [e, x, y] = m;
            e.dataset.snap = '1';
            e.style.position = 'relative';
            e.style.left = Math.abs(x) < 0.005 ? '' : x.toFixed(3) + 'px';
            e.style.top = Math.abs(y) < 0.005 ? '' : y.toFixed(3) + 'px';
          }
        };
        let queued = false;
        const later = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            snap();
          });
        };
        document.fonts.ready.then(() => {
          collect();
          snap();
          addEventListener('resize', later);
          new ResizeObserver(later).observe(document.body);
        });
      })();
    </script>
    <!-- ?px in the URL shows the screen's pixel ratio (to check why the pixel font isn't crisp) -->
    <script is:inline>
      if (new URLSearchParams(location.search).has('px')) {
        const d = document.createElement('div');
        d.style.cssText = 'position:fixed;right:8px;bottom:8px;z-index:9999;padding:6px 10px;background:#000;color:#fff;font:14px/1.4 system-ui;border:1px solid #444;border-radius:6px';
        const show = () => (d.textContent = 'pixel ratio ' + devicePixelRatio + ' · ' + innerWidth + '×' + innerHeight);
        show();
        addEventListener('resize', show);
        document.body.appendChild(d);
      }
    </script>
  </body>
</html>

<style>
  .col {
    width: min(var(--col), 100% - 32px);
    margin-inline: auto;
  }
</style>
