---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'mandarinmaxxing',
  description = 'A topic-based way to study Mandarin with HSK 3.0 vocabulary and phrases you can use in everyday conversations.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0E0E0E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- reveal-on-scroll only hides content when JS is running -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <!-- TODO: self-host Geist / Geist Mono in public/fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <SideNav />
    <main class="col">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal on scroll (GSAP ScrollTrigger): each section's title, then each block of its content,
      // then each row of a bento grid fade up as they reach reading height (60% down the screen).
      // Items that arrive together come in one after the other, in page order. The motion itself is
      // the CSS transition on .rv / .rv.in (global.css).
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const STEP = 100; // ms between items arriving together
      const items: HTMLElement[] = [];
      document.querySelectorAll<HTMLElement>('[data-section]').forEach((sec) => {
        for (const child of sec.children as HTMLCollectionOf<HTMLElement>) {
          const rows = child.matches('.bento') ? [...child.querySelectorAll<HTMLElement>(':scope > .bento-row')] : [];
          items.push(...(rows.length ? rows : [child]));
        }
      });
      const footer = document.querySelector<HTMLElement>('body > footer');
      if (footer) items.push(footer);
      items.forEach((el) => el.classList.add('rv'));

      ScrollTrigger.batch(items, {
        start: 'top 60%',
        once: true,
        onEnter: (batch) =>
          (batch as HTMLElement[]).forEach((el, i) => {
            el.style.setProperty('--rd', `${i * STEP}ms`);
            el.classList.add('in');
          }),
      });
      // layout changes (fonts, opened topics) move things: keep the trigger points right
      document.fonts?.ready.then(() => ScrollTrigger.refresh());
    </script>
  </body>
</html>

<style>
  .col {
    width: min(var(--col), 100% - 32px);
    margin-inline: auto;
  }
</style>
