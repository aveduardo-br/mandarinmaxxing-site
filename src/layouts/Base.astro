---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'mandarinmaxxing',
  description = 'A skill for Claude that teaches the official HSK vocabulary by everyday situation. The same HSK words, reorganized around everyday conversations.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0E0E0E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- reveal-on-scroll only hides content when JS is running -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <!-- TODO: self-host Geist / Geist Mono in public/fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&family=Ma+Shan+Zheng&display=swap"
    />
  </head>
  <body>
    <SideNav />
    <main class="col">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal on scroll: each section's title, then each block of its content, then each row of a
      // bento grid fade up (global.css .rv) as they reach reading height. Items that arrive together come
      // in one after the other, in page order.
      const STEP = 100; // ms between items arriving together
      const items: HTMLElement[] = [];
      document.querySelectorAll<HTMLElement>('[data-section]').forEach((sec) => {
        for (const child of sec.children as HTMLCollectionOf<HTMLElement>) {
          const rows = child.matches('.bento') ? [...child.querySelectorAll<HTMLElement>(':scope > .bento-row')] : [];
          items.push(...(rows.length ? rows : [child]));
        }
      });
      const footer = document.querySelector<HTMLElement>('body > footer');
      if (footer) items.push(footer);
      items.forEach((el) => el.classList.add('rv'));

      // An item appears once its top reaches 60% down the screen (reading height). Checked on scroll
      // instead of with an IntersectionObserver so items jumped past (nav links, #hash) appear too.
      let pending = items.slice();
      const check = () => {
        const line = innerHeight * 0.6;
        const arriving = pending.filter((el) => el.getBoundingClientRect().top < line);
        if (!arriving.length) return;
        pending = pending.filter((el) => !arriving.includes(el));
        arriving.forEach((el, i) => {
          el.style.setProperty('--rd', `${i * STEP}ms`);
          el.classList.add('in');
        });
        if (!pending.length) removeEventListener('scroll', onScroll);
      };
      const onScroll = () => check(); // a few dozen rect reads, cheap enough to run on every scroll
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      check();
    </script>
  </body>
</html>

<style>
  .col {
    width: min(var(--col), 100% - 32px);
    margin-inline: auto;
  }
</style>
